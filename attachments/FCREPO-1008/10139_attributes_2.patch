> 	 public String rewriteQueryForInsearch(String fgsUserName, String indexName, String query, String[] fedoraRoles, Config config) throws java.rmi.RemoteException {
> 			String rewrittenQuery = null;
> 			
> 			do 
> 				{
> 					 boolean isAdmin = false;
> 					 String clause = "";
> 					 
> 					 // use roles to create disjointed clause for filter
> 					 for (String role : fedoraRoles) 
> 						 {
> 								// admin role trumps everything else
> 								if (role.equals("administrator")) 
> 									{
> 										 isAdmin = true;
> 										 break;
> 									}
> 								
> 								// need to split on first _ and need config to be not null
> 								if (-1 == role.indexOf('_') || null == config) 
> 									{
> 										 continue;
> 									}
> 								
> 								String[] parts = role.split("_", 2);
> 								
> 								// look for specific/fallback filter
> 								String filter = config.getFilterProperty(parts[0], parts[1]);
> 								
> 								// no filter, so go to next role
> 								if (filter.equals("")) 
> 									{
> 										 continue;
> 									}
> 
> 								// not first role, so need OR before this disjunct
> 								if (!clause.equals("")) 
> 									{
> 										 clause += " OR ";
> 									}
> 								
> 								// use filter to add to clause
> 								clause += String.format(filter, parts[0]);
> 						 }
> 					 
> 					 // if admin, then no need to rewrite query
> 					 if (isAdmin) 
> 						 {
> 								rewrittenQuery = query;
> 								break;
> 						 }
> 					 
> 					 // no clause generated, so can't get anything
> 					 if (clause.equals("")) 
> 						 {
> 								rewrittenQuery = " ( " + query + " ) AND NOT ( " + query + " )";
> 								break;
> 						 }
> 					 
> 					 // add clause to query
> 					 rewrittenQuery = " ( " + query + " ) AND ( " + clause + " )";
> 				}
> 			while (false);
> 			
> 			return rewrittenQuery;
