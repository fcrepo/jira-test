 1 files changed, 24 insertions(+), 1 deletions(-)

diff --git a/fcrepo-server/src/main/java/org/fcrepo/server/rest/DatastreamResource.java b/fcrepo-server/src/main/java/org/fcrepo/server/rest/DatastreamResource.java
index 4a6113b..057d9d0 100644
--- a/fcrepo-server/src/main/java/org/fcrepo/server/rest/DatastreamResource.java
+++ b/fcrepo-server/src/main/java/org/fcrepo/server/rest/DatastreamResource.java
@@ -107,7 +107,30 @@ public class DatastreamResource
         }
     }
 
-    /**
+	@Path("/infolist")
+	@GET
+	public Response getDatastreams(@PathParam(RestParam.PID) String pid,
+			@QueryParam(RestParam.AS_OF_DATE_TIME) String dateTime,
+			@QueryParam(RestParam.DS_STATE) String dsState) {
+		try {
+			Date asOfDateTime=DateUtility.parseDateOrNull(dateTime);
+			Datastream[] datastreams = apiMService.getDatastreams(getContext(),
+					pid, asOfDateTime, dsState);
+			StringBuilder xmlBuilder=new StringBuilder("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<datastreams>");
+			for (Datastream ds:datastreams){
+				//leave validation to user via param?
+				String xml = getSerializer(getContext()).datastreamProfileToXML(pid,
+						ds.DatastreamID, ds, asOfDateTime, false);
+				xmlBuilder.append(xml.substring("<?xml version=\"1.0\" encoding=\"UTF-8\"?>".length()));
+			}
+			xmlBuilder.append("</datastreams>");
+			return Response.ok(xmlBuilder.toString(),MediaType.TEXT_XML).build();
+		} catch (Exception ex) {
+			return handleException(ex);
+		}
+	}
+
+	/**
      * Invoke API-M.getDatastream(context, pid, dsID, asOfDateTime)
      * <p/>
      * GET /objects/{pid}/datastreams/{dsID} ? asOfDateTime &
