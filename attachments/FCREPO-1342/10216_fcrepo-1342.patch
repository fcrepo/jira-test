From: Ralf Claussnitzer <ralf.claussnitzer@slub-dresden.de>
Date: Sun, 22 Mar 2015 15:49:01 +0100
Subject: [PATCH] Add missing repository for Eclipse plugin

---
 pom.xml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/pom.xml b/pom.xml
index bf65131..6c11950 100644
--- a/pom.xml
+++ b/pom.xml
@@ -1037,6 +1037,11 @@
 
   <repositories>
     <repository>
+      <id>egit</id>
+      <name>Eclipse egit</name>
+      <url>https://repo.eclipse.org/content/repositories/egit-releases/</url>
+    </repository>
+    <repository>
       <id>fcrepo-snapshot</id>
       <name>Fcrepo Snapshot Repository</name>
       <url>http://maven.fcrepo.org/nexus/content/repositories/snapshots/</url>
