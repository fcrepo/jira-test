From 694cd6ffaa75094b4084b31024bc63e2233d736a Mon Sep 17 00:00:00 2001
From: Ralf Claussnitzer <ralf.claussnitzer@slub-dresden.de>
Date: Tue, 14 Apr 2015 16:22:25 +0200
Subject: [PATCH] Allow content type application/zip for resource /objects/new

Fixes fcrepo-1463
---
 .../src/main/java/org/fcrepo/server/rest/FedoraObjectsResource.java     | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/fcrepo-server/src/main/java/org/fcrepo/server/rest/FedoraObjectsResource.java b/fcrepo-server/src/main/java/org/fcrepo/server/rest/FedoraObjectsResource.java
index f322a50..e269b4e 100644
--- a/fcrepo-server/src/main/java/org/fcrepo/server/rest/FedoraObjectsResource.java
+++ b/fcrepo-server/src/main/java/org/fcrepo/server/rest/FedoraObjectsResource.java
@@ -412,7 +412,7 @@ public class FedoraObjectsResource extends BaseRestResource {
 
     @POST
     @Path("/new")
-    @Consumes({XML, FORM})
+    @Consumes({XML, FORM, ZIP})
     public Response newObject(
                               @javax.ws.rs.core.Context
                               HttpHeaders headers,
-- 
1.9.1

