#!/bin/bash

host="localhost:8080/fp"
#auth="$2:$3"
auth="fedoraAdmin:secret3"

# Create initial container
curl -su ${auth} -X PUT "${host}/stressTest"

# create 10,000 transactions
time for x in {0..10000}; do
  echo -e "\n\nCreating transaction #$x"

  export txuri=`curl -siu ${auth} -X POST ${host}/rest/fcr:tx | grep Location | cut -f2 -d' '`;
  echo "transaction: $txuri"

  # create a container within current txn
  node_ret=`curl -su ${auth} -X POST "$txuri/stressTest"`
  echo $node_ret
  
  curl -siu ${auth} -X POST "${txuri}/fcr:tx/fcr:commit"
done
