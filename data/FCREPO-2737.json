  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When acl:accessControl triple appears in body of a PUT or POST or SPARQL update (PATCH)  validate the value according to rules set out in ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2705"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2705",
       "type": "text"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2687"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2687",
       "type": "text"
      },
      {
       "text": " (ideally reusing the code).  If not valid,  return 409.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
