     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I have started a PR for this change:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-import-export/pull/109"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/fcrepo-import-export/pull/109",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It is not totally complete, but wanted to get this open for feedback.  As I note on the PR there is at least one feature I still need to add, which is cleanup of items deleted between versions, but it should fit fairly straightforwardly into the existing framework.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Apologies for the scope of the changes to the importer class.  I've tried to make sure that it still incorporates existing features.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
