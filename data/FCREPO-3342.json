  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen in the following scenario:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "After creating, deleting and purging an atomic resource, the path to the purged OCFL object remains, which is invalid.",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT -H\"Content-Type: text/turtle\" -d \"<> <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://example.org/#title"
             },
             "type": "link"
            }
           ],
           "text": "http://example.org#title",
           "type": "text"
          },
          {
           "text": "> 'a title'\" localhost:8080/rest/container",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i localhost:8080/rest/container",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "find /tmp/fcrepo.ocfl.storage.root.dir -name container",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XDELETE localhost:8080/rest/container",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i localhost:8080/rest/container/fcr:tombstone",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XDELETE localhost:8080/rest/container/fcr:tombstone",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "// Inspect path returned in the \"find\" command above... notice dangling directory",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "See: ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4/fcrepo4/pull/1687#issuecomment-637912832"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4/fcrepo4/pull/1687#issuecomment-637912832",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "This issue is also being tracked with: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/UW-Madison-Library/ocfl-java/issues/8"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/UW-Madison-Library/ocfl-java/issues/8",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
