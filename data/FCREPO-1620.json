     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I think this sounds awful. The clear implication is that different resources exist, and the clear fact is that they do not. These are just different representations of the same resource. The effort to do proper conneg with headers is just not that great.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
