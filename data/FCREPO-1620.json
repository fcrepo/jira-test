  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The HTTP spec isn't particularly clear, but blog posts like this:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://blog.iandavis.com/2010/11/a-guide-to-publishing-linked-data-without-redirects/"
         },
         "type": "link"
        }
       ],
       "text": "http://blog.iandavis.com/2010/11/a-guide-to-publishing-linked-data-without-redirects/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "make it sound like we should be adding a Content-Location header when we generate content-negotiated responses.  The implication of this would be each RDF serialization would need to have its own URL (e.g., ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/resource.json)"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/resource.json)",
       "type": "text"
      },
      {
       "text": ".",
       "type": "text"
      }
     ],
     "type": "paragraph"
