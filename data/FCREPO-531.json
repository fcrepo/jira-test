       "48x48": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png"
      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "We should consider how ECM does this (if at all).  There was agreement at the london committer meeting[1] to adopt ECM's extensibility approach. Not sure if that's relevant here.  If not, maybe an optional='true' attribute would make sense here.  Regardless of how it's done, a way to specify an optional datastream in a cmodel should be considered in scope for future releases of Fedora.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "[1] ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora-commons.org/confluence/display/FCREPO/Feb+23-24+2010%2C+London+Committer+Meeting"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora-commons.org/confluence/display/FCREPO/Feb+23-24+2010%2C+London+Committer+Meeting",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
