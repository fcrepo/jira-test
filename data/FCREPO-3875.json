     "body": {
      "content": [
       {
        "content": [
         {
          "text": "A few notes:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "When this ticket was created, Archival Groups could have tombstones of resources purged. This will no longer be allowed and Fedora will return a 405.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "content": [
             {
              "content": [
               {
                "content": [
                 {
                  "text": "This is documented in the Delete vs Purge page: ",
                  "type": "text"
                 },
                 {
                  "attrs": {
                   "url": "https://wiki.lyrasis.org/display/FEDORA6x/Delete+vs+Purge"
                  },
                  "type": "inlineCard"
                 },
                 {
                  "text": " ",
                  "type": "text"
                 }
                ],
                "type": "paragraph"
               }
              ],
              "type": "listItem"
             }
            ],
            "type": "bulletList"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "I added an additional note about this to the ",
              "type": "text"
             },
             {
              "attrs": {
               "url": "https://wiki.lyrasis.org/display/FEDORA6x/Glossary#Glossary-ArchivalGroupag"
              },
              "type": "inlineCard"
             },
             {
              "text": "  as well",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "There may be other issues to document around archival groups but this ticket was in relation to issue brought about and resolved by ",
              "type": "text"
             },
             {
              "attrs": {
               "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3881"
              },
              "type": "inlineCard"
             },
             {
              "text": ", ",
              "type": "text"
             },
             {
              "attrs": {
               "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3882"
              },
              "type": "inlineCard"
             },
             {
              "text": ", and ",
              "type": "text"
             },
             {
              "attrs": {
               "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3883"
              },
              "type": "inlineCard"
             },
             {
              "text": "  ",
              "type": "text"
             }
            ],
