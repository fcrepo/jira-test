  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently the OAI provider implementations \"inject\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "this attribute because it's not put into the DC",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "automatically (for historic reasons), but it's required",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "for OAI. It would actually be better/cleaner for",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Fedora to create the DC datastream with the attribute",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "already populated.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
