  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When both fcrepo-audit and audit-triplestore are enabled, two extra events are created for each event:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. The event for the creation of the audit node created by fcrepo-audit",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. The event for the audit container lastModified being updated",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "InternalAuditor has some logic to ignore these updates:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo-audit/blob/master/src/main/java/org/fcrepo/audit/InternalAuditor.java#L157"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo-audit/blob/master/src/main/java/org/fcrepo/audit/InternalAuditor.java#L157",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "audit-triplestore should ignore these too.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
