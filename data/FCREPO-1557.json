    {
     "content": [
      {
       "text": "As of the following commit, the \"mvn site-deploy\" generation of a custom doxia index.html page has been broken:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blame/master/pom.xml#L685"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/blame/master/pom.xml#L685",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This task is to update the doxia/site maven versions/configuration to ensure that a correct index.html page is created based on this template:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/master/src/site/markdown/index.md.vm"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/blob/master/src/site/markdown/index.md.vm",
       "type": "text"
      }
     ],
     "type": "paragraph"
