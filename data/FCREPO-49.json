     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: sjw46",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=1709161",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: YES",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "While installing Fedora 2.2, if the user chooses PostgreSQL and the \"included\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "driver, it fails to be extracted from the installer and put in the appropriate",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "install location as part of the end of the install process.  This causes the",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "initial attempt to start Fedora to fail until the driver is manually put in the",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "correct place.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
