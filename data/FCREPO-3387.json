  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen when attempting to create and view version in the HTML UI.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Start Fedora",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a new resource (/rest/new)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "In the new resource, click the button: \"Create Version\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Notice the UI is redirected to a page with text: \"No versions have been created for this resource.\"",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Go back to new resource, and click the button: \"View Versions\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Notice the UI is redirected to a page with text: \"No versions have been created for this resource.\"",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "From command line, observe that version was actually created:",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "curl -i ",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://localhost:8080/rest/new/fcr:versions"
                 },
                 "type": "link"
                }
               ],
               "text": "http://localhost:8080/rest/new/fcr:versions",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
