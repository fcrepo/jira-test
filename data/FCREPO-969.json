  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Noting ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-890#icft=FCREPO-890"
       },
       "type": "inlineCard"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-891#icft=FCREPO-891"
       },
       "type": "inlineCard"
      },
      {
       "text": " - the new bundled version of Tomcat reports SEVERE messages on shutdown indicating potential memory leaks.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "These should be investigated, and where these are due to Fedora they should be fixed.  For issues outside of Fedora code probably useful to inform the relevant provider of the software component.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
