     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The filestream is now closed after use, but I feel this issue is larger than that. FeSL should not read the file for each api request. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
