     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It would be useful to determine if garbage collection results in the file handle being released, and therefore whether this is likely to be a problem only on heavy load (and possibly therefore ulimit -n might be a work-around until this is fixed).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
