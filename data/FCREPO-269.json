     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Comment from Sourceforge Task]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Comment Submitter: cwilper",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "This task resulted in two branches, one for services/oaiprovider, and one for fedora.  The one for Fedora was done to support the oaiprovider changes.  It:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "improves logging configuration ",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "  (FedoraClient never auto-sets the commons-logging properties)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "implements equals() and hashCode() for the PID class.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Allows 3.0+ client to work with server release 2.2.2",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
