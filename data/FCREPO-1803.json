  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Something has changed in Fedora 4.4 with regard to the way it handles updates to fcr:metadata. The following sequence works in 4.3 but not 4.4:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1) Create a binary",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X POST -H \"Content-Type: text/plain\" -H \"Slug: new-binary\" \"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/rest/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/rest/",
       "type": "text"
      },
      {
       "text": "\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2) GET its fcr:metadata",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -H \"Accept: text/turtle\" \"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/rest/new-binary/fcr:metadata"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/rest/new-binary/fcr:metadata",
       "type": "text"
      },
      {
       "text": "\" > new-binary.rdf",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "3) Add some triples",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.org/bytestreamShape"
         },
         "type": "link"
        }
       ],
       "text": "http://example.org/bytestreamShape",
       "type": "text"
      },
      {
       "text": "> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.org/Bytestream/Shape/Original"
         },
         "type": "link"
        }
       ],
       "text": "http://example.org/Bytestream/Shape/Original",
       "type": "text"
      },
      {
       "text": ">;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.org/bytestreamType"
         },
         "type": "link"
        }
       ],
       "text": "http://example.org/bytestreamType",
       "type": "text"
      },
      {
       "text": "> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.org/Bytestream/Type/Master"
         },
         "type": "link"
        }
       ],
       "text": "http://example.org/Bytestream/Type/Master",
       "type": "text"
      },
      {
       "text": ">;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMimeType"
         },
         "type": "link"
        }
       ],
       "text": "http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#hasMimeType",
       "type": "text"
      },
      {
       "text": "> \"audio/aiff\";",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdfs:Class <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://pcdm.org/models#File"
         },
         "type": "link"
        }
       ],
       "text": "http://pcdm.org/models#File",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "4) PUT it back",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X PUT -H \"Content-Type: text/turtle\" --data-binary \"@new-binary.rdf\" \"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/rest/new-binary/fcr:metadata"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/rest/new-binary/fcr:metadata",
       "type": "text"
      },
      {
       "text": "\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The added triples are present in 4.3 but missing in 4.4.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
