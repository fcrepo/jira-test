  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The task here is to create a REST endpoint to serve as a placeholder for stats retrieval operations.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "All stats calls should live under  /<context>/rest/fcr:stats",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "A placeholder should return the stats summary  :   /<context>/rest/fcr:stats",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "The summary should return  a json map.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "{\n  \"all\": {\n    \"resource_count\": 22\n  },\n  \"binaries\": {\n    \"resource_count\": 12,\n    \"byte_count\": 199\n  },\n  \"mime_types\": [\n    {\n      \"resource_count\": 7,\n      \"byte_count\": 119,\n      \"mime_type\": \"audio/mp4\"\n    },\n    {\n      \"resource_count\": 5,\n      \"byte_count\": 80,\n      \"mime_type\": \"text/plain\"\n    }\n  ]\n}",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    }
   ],
