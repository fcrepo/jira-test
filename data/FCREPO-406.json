       "24x24": "https://secure.gravatar.com/avatar/98e22ada0938a79eb37d48dccb0e7302?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FML-3.png",
