       "48x48": "https://secure.gravatar.com/avatar/98e22ada0938a79eb37d48dccb0e7302?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FML-3.png"
      },
      "displayName": "McClain Looney",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4d65426330072ea685d",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This needs to be fixed. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Currently, because of this issue, only 1 Fedora can ever possibly be installed into a single servlet container. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Furthermore, it's wrong.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
