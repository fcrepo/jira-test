     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This looks good, and it works as advertised when using the webapp.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "However, when trying to deploy in karaf, the following error is thrown:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "> feature:repo-add mvn:org.fcrepo.camel/fcrepo-camel-toolbox/LATEST/xml/features",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "> feature:install fcrepo-fixity",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Caused by: java.lang.ClassNotFoundException: javax.naming.InvalidNameException not found by org.apache.httpcomponents.httpclient [119]",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
