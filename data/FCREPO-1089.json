  "description": {
   "content": [
    {
     "content": [
      {
       "text": "There are a number of places in which we create new SAXPArserFactory objects for non-validating, namespace aware parser creation.  These parser should be pooled, as their creation is expensive.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "eg: The various deserializers (FOXML, sdef-WSDL, etc.)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
