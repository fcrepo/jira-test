  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This includes:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Decide on relationship names (inverse/obverse)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Updating classes to use ServiceMech/ServiceDef ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Updating references to such classes, etc..",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Updating demo objects",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Getting rid of \"fType\"",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "  What is the \"fType\" when RELS-EXT is not present?",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "  A: The default content model.  It should be indexed this way.",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "  This will ultimately be a configurable thing by the repository; ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "  however for 3.0b2 we can define exactly one.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
