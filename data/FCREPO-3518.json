  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Patching an ACL fails. I have a test object ACL that was.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "@prefix webac: <http://fedora.info/definitions/v4/webac#> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "@prefix acl: <http://www.w3.org/ns/auth/acl#> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "@prefix fedora: <http://fedora.info/definitions/v4/repository#> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "@prefix ldp: <http://www.w3.org/ns/ldp#> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "<http://localhost:8080/rest/box/fcr:acl#authorization>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  acl:agent \"testuser\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  acl:mode acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  acl:mode acl:Write ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  acl:accessTo <http://localhost:8080/rest/box> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  acl:default <http://localhost:8080/rest/box> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "<http://localhost:8080/rest/box/fcr:acl>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  fedora:created \"2020-11-06T14:16:25.842650Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  fedora:lastModified \"2020-11-06T14:17:19.091992Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  fedora:createdBy \"fedoraAdmin\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  fedora:lastModifiedBy \"fedoraAdmin\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type webac:Acl ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type ldp:Resource ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type fedora:Resource ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type ldp:RDFSource ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type ldp:Container ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "  rdf:type fedora:Container .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When I execute this request.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "curl -i -ufedoraAdmin:fedoraAdmin -H\"Content-type: application/sparql-update\" -d \" DELETE { <http://localhost:8080/rest/box/fcr:acl#authorization> <http://www.w3.org/ns/auth/acl#default> <http://localhost:8080/rest/box> } WHERE { }\" http://localhost:8080/rest/box/fcr:acl -XPATCH",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "I would expect the acl:default clause to be removed, but nothing changes even though I get the 204 response.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "I think this is because the identifier translator which is operating in the FedoraLdp PATCH section is not in the FedoraAcl PATCH section.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
