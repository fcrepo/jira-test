  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The fcr:fixity endpoint responds oddly to invalid request methods. Generally the results are errors, but not expected ones.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PUT to existing binary (would probably expect a 405 and related message)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -XPUT http://localhost:8080/rest/binary_with_sha1/fcr:fixity\r\n\r\n# HTTP/1.1 409 Conflict\r\n\r\n# NonRdfSource resources cannot contain other resources",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "PATCH or DELETE (would expect a 405)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -XPATCH http://localhost:8080/rest/binary_with_sha1/fcr:fixity\r\n\r\n# HTTP/1.1 404 Not Found\r\n# Error: No OCFL mapping found for info:fedora/binary_with_sha1/fcr:fixity",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "HEAD (would expect a 405)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -I http://localhost:8080/rest/binary_with_sha1/fcr:fixity -v\r\n\r\n# HTTP/1.1 200 OK",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Request to fcr:fixity of a resource that doesn't exist",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -XPUT http://localhost:8080/rest/doesnotexist/fcr:fixity\r\n# HTTP/1.1 201 Created\r\n\r\n\r\ncurl -ufedoraAdmin:fedoraAdmin http://localhost:8080/rest/doesnotexist/fcr:fixity\r\n# 404\r\n# Error: No OCFL mapping found for info:fedora/doesnotexist\r\n\r\ncurl -ufedoraAdmin:fedoraAdmin http://localhost:8080/rest/doesnotexist\r\n# 404\r\n# Error: No OCFL mapping found for info:fedora/doesnotexist\r\n\r\n# Try to create \"doesnotexist\" via POST, thinks the ID is taken\r\ncurl -ufedoraAdmin:fedoraAdmin -XPOST http://localhost:8080/rest/ -H\"Slug: doesnotexist\"\r\n# http://localhost:8080/rest/3cedc11e-e8f8-4c77-91a7-ad50f230078c",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "PUT to fcr:fixity of an existing non-binary resource",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -XPUT http://localhost:8080/rest/helloworld\r\n\r\ncurl -ufedoraAdmin:fedoraAdmin http://localhost:8080/rest/helloworld/fcr:fixity -v\r\n# HTTP/1.1 404 Not Found\r\n# org.fcrepo.kernel.impl.models.ContainerImpl@69dd2e29 is not a binary",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    }
   ],
