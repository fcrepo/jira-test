     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This was resolved by treating http[s]://local.fedora.server/fedora as a special replacement variable itself, so when the Fedora server sees it, it translates it to http[s]://actualHost:actualPort/actualContext when necessary",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Demo objects were updated accordingly.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
