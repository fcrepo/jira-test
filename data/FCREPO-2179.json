  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Document the behaviors that lead to the binding of system-generated namespace prefixes (in the form ns00x) when new namespaces are invoked in content deposited in Fedora.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Develop a recommendation for a workaround or best practice that will allow users to avoid the inadvertent binding of such prefixes.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
