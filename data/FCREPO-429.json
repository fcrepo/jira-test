     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Set to pending; needs discussion.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Things have changed since this feature was entered.  Need to decide what the roadmap for direct Mulgara/MPTStore integration looks like.  Regardless of such decision, I'm not sure what's described here would qualify as a \"feature\".",
          "type": "text"
         }
        ],
        "type": "paragraph"
