       "32x32": "https://secure.gravatar.com/avatar/6dd1dd16192e8de58e6516e9010d229b?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJR-5.png",
