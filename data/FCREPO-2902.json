  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to run the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo/Fedora-API-Test-Suite"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/Fedora-API-Test-Suite",
       "type": "text"
      },
      {
       "text": " against the `master` branch of fcrepo and analyze all of the failures for correctness.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Start up Fedora from within the fcrepo4 project directory:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> mvn jetty:run -Dfcrepo.external.content.allowed=fcrepo-http-api/src/test/resources/allowed_external_paths.txt -pl fcrepo-webapp/",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Build the Test-Suite",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> mvn clean install",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Run the Test-Suite",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> java -jar target/testsuite-1.0-SNAPSHOT-shaded.jar -c config.yml.dist",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "For reference, my local results are:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "===============================================",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Fedora API Specification Test Suite",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Total tests run: 196, Failures: 17, Skips: 0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "===============================================",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
