  "description": {
   "content": [
    {
     "content": [
      {
       "text": "With the upgrade to ocfl-java 1.5.0 new objects are written as OCFL version 1.1.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The PicocliIT has asserts looking for the namaste file 0=ocfl_1.0",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Now that file is 0=ocfl_1.1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
