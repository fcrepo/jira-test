     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This doesn't relate to ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-1340#icft=FCREPO-1340"
          },
          "type": "inlineCard"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This simply allows test code to be written like this:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private Node mockNode1, mockNode2, mockNode3, mockNode4;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "instead of like this:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private Node mockNode1;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private Node mockNode2;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private Node mockNode3;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private Node mockNode4;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
