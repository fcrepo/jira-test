     "body": {
      "content": [
       {
        "content": [
         {
          "text": "OK, I created a ticket for the ldp-fedora-mapping ontology: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://jira.duraspace.org/browse/FCREPO-1749"
            },
            "type": "link"
           }
          ],
          "text": "https://jira.duraspace.org/browse/FCREPO-1749",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I will limit my efforts on this ticket to audit, indexing and oai-pmh.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
