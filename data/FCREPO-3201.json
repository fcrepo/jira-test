  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When writing a binary to OCFL, pass along a checksum of the default OCFL digest algorithm if one is present in order to perform a transmission fixity check between fedora and OCFL. This will likely need to happen when committing the changes in the current fedora persistence session to OCFL",
       "type": "text"
      }
     ],
     "type": "paragraph"
