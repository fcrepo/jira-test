  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to enable fixity checks on Federated content.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "A couple of use cases:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "resources in our digital preservation store (Archvematica AIP store), as noted above",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "large files/datasets that we don't want to store in F4 itself",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "The first is speculative, but the second reflects the way we currently store a lot of data with F3 and at the moment have no checksums or fixity checking.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
