          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The included self-signed certificate is just a ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "convenience for getting people up and running quickly.  ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Certs from established authorities should be obtained ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "by the individual organizations installing/using Fedora, ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "if desired.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
