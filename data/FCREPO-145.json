     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: cwilper",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
