  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The current Fedora SSL certificate in distribution expired on Oct 3 2007. We should update this cert prior to 3.0 release.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We may also want to consider obtaining a \"trusted\" cert instead of the current self-signed certificate.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
