        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2188",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Capture the terminal output of the import and see the WARNing:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "WARN 14:26:22.827 (Importer) Error while importing /tmp/test/desc/rest/a3/34/2f/c2/a3342fc2-16fb-4c66-a9ea-2d2a1b1eabc7.ttl (400): Unable to set existing single-valued property \"ns002:hasFile_ref\" on node \"/a3/34/2f/c2/a3342fc2-16fb-4c66-a9ea-2d2a1b1eabc7\" in workspace \"default\" using multi-value setter methods",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Unable to set existing single-valued property \"ns003:inventorCity\" on node \"/a3/34/2f/c2/a3342fc2-16fb-4c66-a9ea-2d2a1b1eabc7\" in workspace \"default\" using multi-value setter methods",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
