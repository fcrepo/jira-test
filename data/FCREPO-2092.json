  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to resolve the situation when an IndirectContainer uses the inverted pattern of \"ldp:isMemberOfRelation\" to establish a relationship between an indirect resource and a membership resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The issue is demonstrated by the following script:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://gist.github.com/awoods/2f790d6b0e089ef04a352d87dfd7cc3c"
         },
         "type": "link"
        }
       ],
       "text": "https://gist.github.com/awoods/2f790d6b0e089ef04a352d87dfd7cc3c",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "..replacing line:22 \"MAX=10000\" with a smaller number, like \"MAX=5\".",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://gist.github.com/awoods/2f790d6b0e089ef04a352d87dfd7cc3c#file-10k-membersof-sh-L22"
         },
         "type": "link"
        }
       ],
       "text": "https://gist.github.com/awoods/2f790d6b0e089ef04a352d87dfd7cc3c#file-10k-membersof-sh-L22",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
