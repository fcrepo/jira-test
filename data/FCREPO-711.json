  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The responsedate in The internal OAI providers Identify answer is wrong.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "It seems that the calculated timezone and daylight savings offsets are added to the localdate, instead of subtracted.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Example:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Local time here 13:22",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Ingested two objects into fedora. lastModified date 11:23 (which is UTC)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "query OAI Provider with:  ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:9080/fedora/oai?verb=Identify"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:9080/fedora/oai?verb=Identify",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "and the answer is:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<responseDate>2010-05-31T15:13:46Z</responseDate>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The offending code is located in:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/src/java/fedora/oai/OAIResponder.java, line 631",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "where",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "UTCDate.setTime(localDate.getTime() + tzOffset);",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "should be replaced with",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "UTCDate.setTime(localDate.getTime() - tzOffset);",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
  "duedate": null,
