   "content": [
    {
     "content": [
      {
       "text": "linux",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java version \"1.6.0_20\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
