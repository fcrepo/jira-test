       "48x48": "https://secure.gravatar.com/avatar/4c3c28d78092f39461f2430aa3fd39b2?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJR-4.png"
