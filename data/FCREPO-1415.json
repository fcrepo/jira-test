         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://rdf-translator.appspot.com/convert/xml/json-ld/https%3A%2F%2Fraw.githubusercontent.com%2Fduraspace%2Fpcdm%2Fmaster%2Fmodels.rdf"
            },
            "type": "link"
           }
          ],
          "text": "http://rdf-translator.appspot.com/convert/xml/json-ld/https%3A%2F%2Fraw.githubusercontent.com%2Fduraspace%2Fpcdm%2Fmaster%2Fmodels.rdf",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This grabs the RDF XML and returns a json-ld object using ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://rdf-translator.appspot.com/"
            },
            "type": "link"
           }
          ],
          "text": "http://rdf-translator.appspot.com/",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I'm not sure if this qualifies as a  context file.",
