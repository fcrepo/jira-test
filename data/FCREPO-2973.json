     },
     "updated": "2019-01-07T12:07:10.354-0400"
    },
    {
     "author": {
      "accountId": "60785ded115da6006f540529",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It looks like you need to do two things:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1. GET the memento, omitting server-manged triples",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "```",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "curl -H \"Accept: text/turtle\" -H\"Prefer: return=representation; omit=\\\"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora.info/definitions/v4/repository#ServerManaged"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora.info/definitions/v4/repository#ServerManaged\\",
          "type": "text"
         },
         {
          "text": "\"\" ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/version-test/fcr:versions/20180530230244"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/version-test/fcr:versions/20180530230244",
          "type": "text"
         },
         {
          "text": " > version.ttl",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "```",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "2. PUT the memento over the original resource, specifying that no server-managed triples will be included",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "```",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "curl -X PUT -H \"Content-Type: text/turtle\" -H \"Prefer: handling=lenient; received=\\\"minimal\\\"\" --data-binary @version.ttl  ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/version-test"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/version-test",
          "type": "text"
         },
         {
          "text": " -i",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "```",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
