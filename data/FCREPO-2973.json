       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "There are two options:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "If you want the server managed triples from the memento, you must restart Fedora in \"relaxed\" mode:",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://wiki.duraspace.org/display/FEDORA5x/Configuration+Options+Inventory#ConfigurationOptionsInventory-Allowinguserupdatestocertainservermanagedtriples"
                },
                "type": "link"
               }
              ],
              "text": "https://wiki.duraspace.org/display/FEDORA5x/Configuration+Options+Inventory#ConfigurationOptionsInventory-Allowinguserupdatestocertainservermanagedtriples",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Or, if you do not need the SMTs to be the same as what is in the memento, you can use \"Prefere: handling=lenient\"",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://wiki.duraspace.org/display/FEDORA5x/RESTful+HTTP+API+-+Containers#RESTfulHTTPAPI-Containers-YellowPUTCreatearesourcewithaspecifiedpath,orreplacethetriplesassociatedwitharesourcewiththetriplesprovidedintherequestbody"
                },
                "type": "link"
               }
              ],
              "text": "https://wiki.duraspace.org/display/FEDORA5x/RESTful+HTTP+API+-+Containers#RESTfulHTTPAPI-Containers-YellowPUTCreatearesourcewithaspecifiedpath,orreplacethetriplesassociatedwitharesourcewiththetriplesprovidedintherequestbody",
              "type": "text"
             },
             {
              "text": ".",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
