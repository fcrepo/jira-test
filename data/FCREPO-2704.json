     "content": [
      {
       "text": "For NonRDFResources that have an \"acl:accessControl\" triple in their metadata,   acl link header is missing.   To resolve,  the acl:accessControl triple must be extracted from the resource/fcr:metadata and returned in the response header.  c.f.",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#link-rel-acl"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#link-rel-acl",
       "type": "text"
      }
     ],
