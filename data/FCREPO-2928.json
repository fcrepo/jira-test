  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to either remove the link under \"Other Resources\" on individual Mementos; or better yet, to change it back to the previous functionality of linking to hash resources of the Memento.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce in the HTML UI:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "create a resource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "create a version of the resource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "view an individual memento",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Observe a link under \"Other Resources\" that contains the title or URL of the original resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
