     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:b97337af-3737-473c-9779-44d498499536",
           "text": "@Harshakumar Ummerpillai"
          },
          "type": "mention"
         },
         {
          "text": ", it depends on how you have deployed fcrepo. The fcrepo-audit module is compiled into the fcrepo-webapp-plus WAR file by default. However, you can disable it by making sure this line is not present (or commented out) in your spring configuration:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "xml"
        },
        "content": [
         {
          "text": "<bean class=\"org.fcrepo.audit.InternalAuditor\"/>",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
      "type": "doc",
      "version": 1
