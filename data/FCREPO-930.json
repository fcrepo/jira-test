  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Maven is reporting various build warnings because of missing plugin version declarations (and in the case of fcrepo-server, an additional warning because of a duplicate declaration of the exec-maven-plugin), e.g.:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "[WARNING] Some problems were encountered while building the effective model for org.fcrepo:fcrepo-common:jar:3.5-SNAPSHOT",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] 'build.plugins.plugin.version' for org.apache.maven.plugins:maven-jar-plugin is missing. @ line 199, column 15",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "[WARNING] Some problems were encountered while building the effective model for org.fcrepo:fcrepo-server:jar:3.5-SNAPSHOT",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] 'build.plugins.plugin.(groupId:artifactId)' must be unique but found duplicate declaration of plugin org.codehaus.mojo:exec-maven-plugin @ line 311, column 15",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
