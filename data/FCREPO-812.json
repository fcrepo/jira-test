  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The REST API method:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "/objects/{pid}/datastreams/{dsid}/history",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "incorrectly provides URLs with the query parameter \"asOfVersionDate\", which is incorrect.  It should be \"asOfDateTime\".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This means that the URLs do not return the correct versions (all URLs will return the latest version).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
