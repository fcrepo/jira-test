  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Integration tests which use the imagemanip service fail when FeSL is enabled. Call to the imagemanip service hang until eventually timing out.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "With FeSL enabled, an individual request to",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/imagemanip/ImageManipulation?op=resize&newWidth=50&url=http://localhost:8080/tomcat.gif"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/imagemanip/ImageManipulation?op=resize&newWidth=50&url=http://localhost:8080/tomcat.gif",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "hangs and eventually times out.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Workarounds for imagemanip:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "remove fedora.war",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "disable fesl",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "comment out calls to PopulatePolicyDatabase.addDocuments(); and pdp = new PDP(config.getDefaultPDPConfig()); in MelcoePDPImpl",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
   "type": "doc",
   "version": 1
  },
