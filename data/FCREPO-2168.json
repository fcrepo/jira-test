     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Yes, \"nested resources\" would be DirectContainers, like:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "/rest/parent/child",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Cross-object relationships would be something like:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "</rest/parent> pcdm:hasRelatedObject </rest/other>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
