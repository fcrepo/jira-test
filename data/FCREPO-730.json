  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Fedora 3.4 introduces getDatastreamHistory to the REST API - however there's no means of navigating to the HTML view of this method from the existing REST API HTML views.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Provide a \"View the history of this datastream\" on the \"datastream profile view\" using the {pid}/{dsid}/versions URL.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
