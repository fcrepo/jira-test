     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It's the OAI DC schema.  www.openarchives.org/OAI/2.0/oai_dc.xsd - xsi:schemaLocation=\"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.openarchives.org/OAI/2.0/oai_dc/"
            },
            "type": "link"
           }
          ],
          "text": "http://www.openarchives.org/OAI/2.0/oai_dc/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "There's a copy in the fcrepo-server/src/main/resources/xsd directory",
          "type": "text"
         }
        ],
        "type": "paragraph"
