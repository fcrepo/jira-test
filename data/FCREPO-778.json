   "content": [
    {
     "content": [
      {
       "text": "The Dublin Core datastream appears not to be validated (looking at org.fcrepo.server.validation.ValidationUtility and elsewhere).  Maybe that is by design?  Noted in 3.4 but probably the case in earlier versions.",
       "type": "text"
      }
