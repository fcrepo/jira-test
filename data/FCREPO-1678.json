  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Now that NonRdfSourceDescription properties are actually stored on the associated Binary resource, when the client is updating /fcr:metadata its etag (read: caching) is not affected.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -XPUT -H\"Content-Type: image/jpeg\" --data-binary @image.jpg ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/picture"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/picture",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Use your own jpg file",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -I ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/picture/fcr:metadata"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/picture/fcr:metadata",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Note etag value",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -i -XPATCH -H\"Content-Type: application/sparql-update\" --data-binary @update.su localhost:8080/rest/picture/fcr:metadata",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "\"update.su\" is attached",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -I ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/picture/fcr:metadata"
             },
             "type": "link"
            }
