     "body": {
      "content": [
       {
        "content": [
         {
          "text": "There are at least two issues with the current profile:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "AP Trust requires md5 manifests (currently the profile creates sha1 and sha256)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "AP Trust seems to disallow tag files with a space preceding the colon following the tag name.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
