  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When calling modifyDatastream using the REST API with urls such as:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "http://{host}:{port}/fedora/objects/{PID}/datastreams/{dsID}?label=Update",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "or",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "http://{host}:{port}/fedora/objects/{PID}/datastreams/{dsID}?dsLocation={Updated Address}",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "a NullPointerException is generated.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The stacktrace is as follows: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "javax.ws.rs.WebApplicationException: java.lang.NullPointerException",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at fedora.server.rest.BaseRestResource.handleException(BaseRestResource.java:98)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at fedora.server.rest.DatastreamResource.addOrUpdateDatastream(DatastreamResource.java:417)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at fedora.server.rest.DatastreamResource.modifyDatastream(DatastreamResource.java:268)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at sun.reflect.GeneratedMethodAccessor185.invoke(Unknown Source)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at sun.reflect.DelegatingMethodAccessorImpl.invoke(DelegatingMethodAccessorImpl.java:25)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.lang.reflect.Method.invoke(Method.java:585)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.ws.rest.impl.model.method.dispatch.EntityParamDispatchProvider$ResponseOutInvoker._dispatch(EntityParamDispatchProvider.java:128)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "...",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This issue was reported on the Fedora Developer's mailing list by James Chartrand.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
