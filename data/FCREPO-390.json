      },
      "displayName": "Bill Branan",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5d83b5f927bbf40c2c32ceeb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The mediaType is not always provided when calling modifyDatastream in the REST API, but it was always being dereferenced. Updated to check mediaType for null prior to using it as a mimeType value.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Also added tests to TestRESTAPI to make sure modifyDatastream works with a simple label update on a managed datastream and a location update on an external datastream.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
