  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The LDP specification recommends using a trailing slash in the URIs of containers:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/TR/ldp-bp/#include-a-trailing-slash-in-container-uris"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/TR/ldp-bp/#include-a-trailing-slash-in-container-uris",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This task is to:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1) confirm with the F4 committer team that this is a recommendation that we want to enforce",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2) investigate the impact of enforcing this recommendation",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3) implement it",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
