  "description": {
   "content": [
    {
     "content": [
      {
       "text": "To reproduce: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1.   create an RDF resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2. Update it with the following : ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "INSERT\r\n{ <#test>  dc:title \"my hash resource title\" }\r\nWHERE {}",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "3. in the UI hit \"Create VersIon\" or execute the following: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -i -u fedoraAdmin:fedoraAdmin -X POST http://localhost:8080/rest/test/fcr:versions",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Verify the following response: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "HTTP/1.1 403 Forbidden\r\nDate: Wed, 31 Oct 2018 19:32:40 GMT\r\nSet-Cookie: JSESSIONID=12ig4ifffyr1dfpqaqfs3vy2i;Path=/\r\nExpires: Thu, 01 Jan 1970 00:00:00 GMT\r\nSet-Cookie: rememberMe=deleteMe; Path=/; Max-Age=0; Expires=Tue, 30-Oct-2018 19:32:40 GMT\r\nLink: <http://localhost:8080/static/constraints/IncorrectTripleSubjectException.rdf>; rel=\"http://www.w3.org/ns/ldp#constrainedBy\"\r\nContent-Type: text/plain;charset=utf-8\r\nContent-Length: 138\r\nServer: Jetty(9.3.25.v20180904)\r\nhttp://localhost:8080/rest/test#test is not in the topic of this RDF, which is http://localhost:8080/rest/test/fcr:versions/20181031193240",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "The console reports the following: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "ERROR 12:32:40.291 (PersistingRdfStreamConsumer) http://localhost:8080/rest/test#test is not in the topic of this RDF, which is http://localhost:8080/rest/test/fcr:versions/20181031193240.",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
