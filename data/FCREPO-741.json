     "body": {
      "content": [
       {
        "content": [
         {
          "text": "tripleiterator doesn't actually support sparql (see trippi). So this is actually a documentation error unless reimplemented to use tupleiterator.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
