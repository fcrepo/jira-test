     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It would be pretty easy, I think, to put together a SparqlTripleWriter.  Granted, it would just treat the triples as SPO, and mimic the TupleWriter.  Worth it?",
          "type": "text"
         }
        ],
