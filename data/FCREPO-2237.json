  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As a repository manager, when I do an import/export I want an audit log that makes sense.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Definition of done:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Perform a import and export with audit service turned on, investigate audit dates, and very that they make sense.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
