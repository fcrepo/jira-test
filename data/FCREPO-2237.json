     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It would be fantastic if ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "5cdf0dfb3b428d0dcd7c7c4d",
           "text": "@Former user"
          },
          "type": "mention"
         },
         {
          "text": " and ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "5fc7c7e5dd0c59007543ad76",
           "text": "@kestlund"
          },
          "type": "mention"
         },
         {
          "text": " could provide an example format of an acceptable \"audit log\".",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "..such as:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "<date-time> export <URI> to <path>",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "..or",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "<date-time> import <path> to <URI>",
          "type": "text"
         }
