     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The reason for the illegal XML was that running full texts through tika produced characters below 32. This was fixed in GSearch 2.7. All other solr update is valid xml produced by the xslt processor.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
