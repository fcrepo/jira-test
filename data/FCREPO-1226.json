     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This zipfile, and it's contents, can be used to verify GSearch via Islandora zipfile import.  A few of the images contained within, include BAD metadata, which was somehow introduced via Photoshop.   The bad metadata includes the illegal control characters, which causes an GSearch indexing failure.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
