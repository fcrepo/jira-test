  "description": {
   "content": [
    {
     "content": [
      {
       "text": "From ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo/fcrepo/issues/2278"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Fedora version: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "Release: 6.5.1 | Commit 6d5a1bb",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Steps to reproduce",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a new binary file eg with ",
           "type": "text"
          },
          {
           "marks": [
            {
             "type": "code"
            }
           ],
           "text": "curl -u fedoraAdmin:fedoraAdmin -XPUT http://localhost:8080/fcrepo/rest/my-file --data-binary @my-file",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Try to get that file with an unexpected mime-type eg ",
           "type": "text"
          },
          {
           "marks": [
            {
             "type": "code"
            }
           ],
           "text": "curl -v -u fedoraAdmin:fedoraAdmin -XGET http://localhost:8080/fcrepo/rest/my-file -H \"Accept: application/xml",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Expected",
       "type": "text"
      },
      {
       "text": ": A 406 response with the content-length equal to the HTML error message in the body.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Actual",
       "type": "text"
      },
      {
       "text": ": A 406 response with the content-length equal to the binary resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Impact",
       "type": "text"
      },
      {
       "text": ": When the binary file is longer than the returned error message the client will hang waiting for the rest of the message and will eventually timeout. This makes it difficult to properly handle the 406 response.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Notes",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This seems to only affect non-RDF resources.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Tested behaviour with bruno, curl and Spring HTTP clients.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
