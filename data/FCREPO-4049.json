     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The issue is only present where running in a container server like Tomcat. In that situation it returns a tomcat rendered error message with a content-length of the underlying binary. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "If running from ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "mvn jetty:run",
          "type": "text"
         },
         {
          "text": " Fedora returns a 0 length body and a content-length header of 0 to match.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
