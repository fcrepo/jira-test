     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The phase 2 audit system fulfills the write portion of the audit requirements: events are created, contain the required info, persist when the referenced nodes are deleted.  External events can also be posted to the audit container.  Setup is documented in ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FF/Using+Internal+Audit+Phase+II"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FF/Using+Internal+Audit+Phase+II",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The read requirements are fulfilled by the phase 1 audit system (which can be used in conjunction with the phase 2).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "See ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-1495#icft=FCREPO-1495"
          },
          "type": "inlineCard"
         },
         {
          "text": " for comprehensive documentation covering how to use both audit systems together.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
