  "description": {
   "content": [
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "verify that the Audit service phase 2 implementation and documentation satisfy the requirements specified in: ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FF/Design+-+Audit+Service#Design-AuditService-ProposedRequirements"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FF/Design+-+Audit+Service#Design-AuditService-ProposedRequirements",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "verify that other repository functionality isn't impacted by enabling or disabling persisting audit event records in the repository",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "document end-to-end recipe for configuring audit events with in-repository persistence",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
