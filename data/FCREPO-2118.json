  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create a container structure like this",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "/rest/project/inner1/inner2/inner3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a version V1 for /rest/project",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a version V2 for /rest/project/inner1",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a version V3 for /rest/project/inner1/inner2",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a version V4 for /rest/project/inner1/inner2/inner3",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Now traverse the fcr:versions path from /rest/project/fcr:versions/V1",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "You will notice like this ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ldp: contains",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedoradev0.icpsr.umich.edu:8097/fedora/rest/project/inner1/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://fedoradev0.icpsr.umich.edu:8097/fedora/rest/project/inner1/fcr:versions",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Here this is ambiguous because it is unclear which version of inner1 is participating in this version if /inner2 had multiple versions. In fact in this instance V1 was created first so it should be all children listed as-is.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
