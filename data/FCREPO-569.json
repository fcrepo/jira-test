     "updated": "2009-11-02T10:47:48.460-0400"
    },
    {
     "author": {
      "accountId": "6089a4cb543264006867626e",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "24x24": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "32x32": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "48x48": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png"
      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I can confirm Kai's solution - that adding URIEncoding=\"UTF-8\" to the connector in server.xml resolves this on Windows.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Suggest we",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "(1) document this; and",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "(2) modify fedora.utilities.install.container.TomcatServerXML to add this attribute",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "or",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "(1) standardise on ISO-8859-1 url-encoding throughout Fedora; however this may cause more issues as UTF-8 encoding is pretty much standardised on outside of URLs",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "W3C recommendation is to use UTF-8:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/TR/html40/appendix/notes.html#non-ascii-chars"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/TR/html40/appendix/notes.html#non-ascii-chars",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://java.sun.com/j2se/1.5.0/docs/api/java/net/URLEncoder.html#encode%28java.lang.String,%20java.lang.String%29"
            },
            "type": "link"
           }
          ],
          "text": "http://java.sun.com/j2se/1.5.0/docs/api/java/net/URLEncoder.html#encode%28java.lang.String,%20java.lang.String%29",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
