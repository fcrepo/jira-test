     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Sounds like UTF-8 is the right option, I agree with your first solution (document it and modify TomcatServerXML to add the attribute).  Too bad Tomcat doesn't default to that, though.  I wonder what other appservers do.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note: The document to update is ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora-commons.org/confluence/display/FCR30/Installation+and+Configuration+Guide"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora-commons.org/confluence/display/FCR30/Installation+and+Configuration+Guide",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
