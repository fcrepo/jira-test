     "updated": "2009-11-02T07:13:41.338-0400"
    },
    {
     "author": {
      "accountId": "6089a13283b8c6006bf8c461",
      "accountType": "atlassian",
      "active": false,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"
      },
      "displayName": "Former user",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a13283b8c6006bf8c461",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I can reproduce this on OSX. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I believe the UTF based URIs are not properly decoded by Tomcat with the current default configuration. The Tomcat Configuration Reference[1] states:  \"This [URIEncoding] specifies the character encoding used to decode the URI bytes, after %xx decoding the URL. If not specified, ISO-8859-1 will be used.\" The property is not set, so it defaults to ISO-8859-1. After setting this property in server.xml the query seems to be encoded correctly. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "[1] ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://tomcat.apache.org/tomcat-5.5-doc/config/http.html"
            },
            "type": "link"
           }
          ],
          "text": "http://tomcat.apache.org/tomcat-5.5-doc/config/http.html",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
