     "author": {
      "accountId": "5db386745304a60c3a769d36",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png"
      },
      "displayName": "Demian Katz",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5db386745304a60c3a769d36",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Here are the permissions on my OCFL root which causes the failure (when I run Tomcat as my own user):",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "drwxr-xr-x   4 root     root        4096 Jun 20 10:29 base-ocfl/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "And here are the contents of the base-ocfl directory:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "drwxr-xr-x 4 root  root    4096 Jun 20 10:29 ./",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "drwxrwxr-x 6 dkatz techies 4096 Nov 12 12:56 ../",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "drwxr-xr-x 2 root  root    4096 Jun 20 10:29 config/",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "drwxr-xr-x 7 root  root    4096 Nov 12 13:24 data/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "…nothing too surprising there, I think!",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
