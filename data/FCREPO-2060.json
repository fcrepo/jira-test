     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This problem was fixed by using PostgreSQL 9.4 or 9.5.  I've updated the wiki docs to indicate these versions should be used with Modeshape5: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FEDORA4x/Configuring+JDBC+Object+Store"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FEDORA4x/Configuring+JDBC+Object+Store",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
