     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The error happens at this line in our Hydra ingest tool:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/pulibrary/plum/blob/master/app/jobs/ingest_mets_job.rb#L61"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/pulibrary/plum/blob/master/app/jobs/ingest_mets_job.rb#L61",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I'm working to isolate this issue and reproduce with a shell script to make it easier for others to debug this error.  But so far haven't been successful.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
