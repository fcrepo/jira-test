     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "> mvn jetty:run -pl fcrepo-webapp",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The following error is through (see attachment for full output):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
