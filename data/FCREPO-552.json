    {
     "author": {
      "accountId": "6089a4cb543264006867626e",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "24x24": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "32x32": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "48x48": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png"
      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "New parameters in fedora.fcfg (under server) are:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "<param name=\"httpClientTimeoutSecs\" value=\"20\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>Number of seconds Fedora http client will wait for a connection before timing ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "out.</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<param name=\"httpClientSocketTimeoutSecs\" value=\"120\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>Number of seconds Fedora http client will wait for data coming across an ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "established http connection.</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<param name=\"httpClientMaxConnectionsPerHost\" value=\"5\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>Maximum number of Fedora http client connections allowed to a given host.</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<param name=\"httpClientMaxTotalConnections\" value=\"5\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>Maximum number of total Fedora http client connections allowed at once.</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<param name=\"httpClientFollowRedirects\" value=\"true\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>Should the Fedora http client follow redirects?</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<param name=\"httpClientMaxFollowRedirects\" value=\"3\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>Maximun number of redirects the Fedora http client will follow (only if ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "httpClientFollowRedirects is set to true.)</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<param name=\"httpClientUserAgent\" value=\"Fedora\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<comment>The value to be set for the User-Agent HTTP request header.</comment>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</param>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
