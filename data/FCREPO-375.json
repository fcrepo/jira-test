  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Queries in the SPO language do not seem to match typed literals correctly, regardless of triple store used (Mulgara,MPTStore)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "A query such as this:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "<info:fedora/fedora-system:def/view#lastModifiedDate> 2008-07-02T05:09:44.375Z^^<",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://fark.com/"
             },
             "type": "link"
            }
           ],
           "text": "http://fark.com",
           "type": "text"
          },
          {
           "text": ">",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "will result in a positive match to a triple such as (note that object literal types don't match:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<info:fedora/test:123> <info:fedora/fedora-system:def/view#lastModifiedDate> 2008-07-02T05:09:44.375Z^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "In addition, surrounding the typed literal value in quotes results in 500 error:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "'2008-07-02T05:09:44.375Z'^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fark.com/"
         },
         "type": "link"
        }
       ],
       "text": "http://fark.com",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "\"2008-07-02T05:09:44.375Z\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fark.com/"
         },
         "type": "link"
        }
       ],
       "text": "http://fark.com",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "SPOnge queries work as expected (but this language is not available with Mulgara)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
