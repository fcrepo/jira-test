  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Trying to update a datastream using a multipart encoded PUT request does not work. Fedora will save the multipart wrapper in the datastream contents. See attached file for example.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It seems like the problem is here:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-server/src/main/java/org/fcrepo/server/rest/RestUtil.java#L45"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-server/src/main/java/org/fcrepo/server/rest/RestUtil.java#L45",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "because isMultipartContent() only recognizes multipart messages that use the POST method:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://commons.apache.org/proper/commons-fileupload/apidocs/src-html/org/apache/commons/fileupload/servlet/ServletFileUpload.html#line.66"
         },
         "type": "link"
        }
       ],
       "text": "http://commons.apache.org/proper/commons-fileupload/apidocs/src-html/org/apache/commons/fileupload/servlet/ServletFileUpload.html#line.66",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
