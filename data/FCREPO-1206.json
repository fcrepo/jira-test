  "comment": {
   "comments": [
    {
     "author": {
      "accountId": "5fca89892730d8007611d907",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/bf2e136284e0b17b99502dc3a32eef38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-6.png",
       "24x24": "https://secure.gravatar.com/avatar/bf2e136284e0b17b99502dc3a32eef38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-6.png",
       "32x32": "https://secure.gravatar.com/avatar/bf2e136284e0b17b99502dc3a32eef38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-6.png",
       "48x48": "https://secure.gravatar.com/avatar/bf2e136284e0b17b99502dc3a32eef38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-6.png"
      },
      "displayName": "Benjamin Armintor",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5fca89892730d8007611d907",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It is apparently believed that the semantics of PUT are incompatible with multipart request bodies, so I doubt that commons-fileupload regards this as a bug (and Fedora 3 is not going to change this dependency in the foreseeable future). See also ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/Protocols/rfc2616/rfc2616-sec9.html#sec9.6"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/Protocols/rfc2616/rfc2616-sec9.html#sec9.6",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
