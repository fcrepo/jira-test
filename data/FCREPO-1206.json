       "32x32": "https://secure.gravatar.com/avatar/2b40121791d6946b6cdd805dc2ea4b7c?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-3.png",
       "48x48": "https://secure.gravatar.com/avatar/2b40121791d6946b6cdd805dc2ea4b7c?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-3.png"
      },
      "displayName": "Don Brower",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Afb2ff2e4-636b-42c9-89c0-f91bd3f8435c",
      "timeZone": "America/New_York"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Thanks for the answer. I don't completely follow how that section of RFC-2616 precludes multi-part uploads (e.g. what if all the files form a single semantic unit), but that is fine.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "FYI, the docs for modifyDatastream say the content should be multipart encoded.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FEDORA37/REST+API#RESTAPI-modifyDatastream"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FEDORA37/REST+API#RESTAPI-modifyDatastream",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
