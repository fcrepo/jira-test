  "description": {
   "content": [
    {
     "content": [
      {
       "text": "According to the Fedora 6 documentation, a RemoteIpValve must be configured in Tomcat if Fedora is run behind a reverse proxy:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "xml"
     },
     "content": [
      {
       "text": "<Valve className=\"org.apache.catalina.valves.RemoteIpValve\"\n       protocolHeader=\"X-Forwarded-Proto\" />",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    }
   ],
