  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When a digital object has a lot of datastreams (eg. 500) ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "the Object form in fedora-admin app shows a lot of tabs ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(one per datastream) without a scroll. In this case you ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "need to redim the window to see the work area.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
