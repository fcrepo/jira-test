  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Related to: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://www.pivotaltracker.com/story/show/72982948"
         },
         "type": "link"
        }
       ],
       "text": "https://www.pivotaltracker.com/story/show/72982948",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://issues.jboss.org/browse/MODE-2354"
         },
         "type": "link"
        }
       ],
       "text": "https://issues.jboss.org/browse/MODE-2354",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "As described in the above ModeShape ticket, test the following scenario:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Run F4 with AuthZ (ideally once each for RBACL and XACML)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "With fedoraAdmin, create resources: /a/b/c",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "With fedoraAdmin, create read/write/admin ACL on \"c\" of /a/b/c for 'testuser'",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "With testuser, create a child resource /a/b/c/d",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Did it work?",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
