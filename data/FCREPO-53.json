     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: sjw46",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=1709161",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: YES",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "On the client end, if a binding key is incorrect, the error message is a",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "NullPointerException with no additional detail.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "On the server end, a little more detail is logged, but the error message is",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "still unhelpful.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The desired behavior is a human-readable error message to the client when an",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "invalid dissemination binding is given.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
