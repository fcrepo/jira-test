     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fixed for now by setting java.awt.headless=true in the main method for each class that these scripts invoke.  In the future, when ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-603#icft=FCREPO-603"
          },
          "type": "inlineCard"
         },
         {
          "text": " is implemented, running these scripts shouldn't end up causing any java.awt classes to be initialized, so setting java.awt.headless shouldn't be necessary.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
