     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The rebuilder no longer has this issue; it has been modified to NOT attempt early detection of duplicate objects in file storage during a rebuild.  When such a situation occurs, it causes an error and requires manual cleanup.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
