  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Setup:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Download dataset: ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4-labs/fcrepo-sample-dataset/blob/master/plantpatents/plants.tar.gz"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4-labs/fcrepo-sample-dataset/blob/master/plantpatents/plants.tar.gz",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Start up an empty F4",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Upload the sample dataset:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> curl -i -XPOST --data-binary /path/to/1473315261896-0 localhost:8080/rest/fcr:restore",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Export the repository:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> java -jar fcrepo-import-export-driver-0.0.1-SNAPSHOT.jar -b /tmp/bin -m export -d /tmp/rdf -r ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "! Notice output log for each external-body binary:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ERROR 16:10:46.097 (Exporter) Resource is neither an LDP Container nor an LDP NonRDFSource: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/10/69/e9/cd/1069e9cd-3024-442a-a683-4f8930be992d/external"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/10/69/e9/cd/1069e9cd-3024-442a-a683-4f8930be992d/external",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "However, the HEAD request shows correct link headers:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> curl -I ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/10/69/e9/cd/1069e9cd-3024-442a-a683-4f8930be992d/external"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/10/69/e9/cd/1069e9cd-3024-442a-a683-4f8930be992d/external",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Output: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "HTTP/1.1 307 Temporary Redirect",
