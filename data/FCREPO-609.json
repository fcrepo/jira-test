     "body": {
      "content": [
       {
        "content": [
         {
          "text": "We should document this for both the Rest and SOAP apis.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "The actual code in DefaultManagement says:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "if (force) {",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "throw new GeneralException(\"Forced object removal is not \"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "+ \"yet supported.\");",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
