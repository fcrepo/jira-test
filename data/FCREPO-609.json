     "body": {
      "content": [
       {
        "content": [
         {
          "text": "We want to eventually get rid of \"force\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Solution: ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If the next release has major SOAP api changes (like ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-521#icft=FCREPO-521"
          },
          "type": "inlineCard"
         },
         {
          "text": "), drop force=true.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
