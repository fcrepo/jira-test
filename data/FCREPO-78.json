      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: pangloss",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=487398",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: NO",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "TomcatServerXML now throws an InstallationFailedException if the XPath query returns null.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Also started on a JUnit test case (src/test/junit/fedora/utilities/install/container/TestTomcatServerXML.java), but this could use some fleshing out.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Fixed in dev-145635 r6525 (2.2.x) and dev-145636 r6526 (3.0b1). Leaving this open until merged into trunk and maintenance-2.2.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Thanks for the bug report!",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
