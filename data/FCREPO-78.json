         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=1795155",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: YES",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Problem found and solved.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "The installed Tomcat5 had a cut-down server.xml file; the attributes specified in the Xpath statement were absent, hence the null pointer.  A null check after the path search might be nice...",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
