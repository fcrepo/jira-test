  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The URI for the versions container should be advertised, where available, in a Link header similar to the the metadata container:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Link: <./fcr:versions>;rel=\"version-history\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This is following the patterns adhered to by LDP and the conventions outlined in RFC5829  (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://tools.ietf.org/html/rfc5829)"
         },
         "type": "link"
        }
       ],
       "text": "http://tools.ietf.org/html/rfc5829)",
       "type": "text"
      },
      {
       "text": ".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
