        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/issues/957",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It should be caught and a 4xx should be returned instead.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "STATUS: 500 javax.jcr.ItemExistsException: A node definition that allows same name siblings could not be found for the node \"{}42\" in workspace \"default\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
