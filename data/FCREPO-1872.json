       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.http.api.FedoraLdp.createOrReplaceObjectRdf(FedoraLdp.java:301)",
       "type": "text"
      },
      {
