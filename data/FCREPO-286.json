     "content": [
      {
       "text": "When an error condition is detected during on-line access operations, this",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "feature MUST provide a description of the reasons for the error condition",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "to the caller. The feature MUST report conformance with the object's",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "content model and SHOULD report any other available information that",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "enables identification of the error's source. The feature SHOULD be",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "developed to enable extensibility and SHOULD reuse/share code with off-line",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "validation features.",
       "type": "text"
      }
