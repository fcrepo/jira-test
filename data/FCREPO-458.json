     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Was caused with the introduction of SQLUtilityImpl.  Fixed by looping through the field array (the actual fields we're updating in the db) rather than the value array (which is larger than the field array in this case).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "FieldSearchSQLImplIntegrationTest now checks for this case.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
