  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The indexDCFields value in fedora.fcfg controls whether DC fields are actually indexed in the underlying database or not.  Normally, this is true (the default), but when set to false, indexing of modified objects fails with an ArrayIndexOutOfBoundsException.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
