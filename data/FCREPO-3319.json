  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This ticket depends on ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.lyrasis.org/browse/FCREPO-3318"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.lyrasis.org/browse/FCREPO-3318",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task here is to add the following to the fcrepo4/.travis/deploy.sh script after a successful deploy to sonatype",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1) clone the fcrepo-labs/fcrepo-docker  repo",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2) perform a docker build and push to dockerhub.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
