  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The WebACFilter does get an instance of the TransactionManager injected but it is not the same one as created by the JAX-RS application. So existing transaction are treated as non-existent when checking permissions.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "There is an Ignored test in WebACRecipesIT referencing this ticket.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
