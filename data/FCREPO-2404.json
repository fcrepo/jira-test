  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to refactor the webac module such that it no longer has a dependency on the RBACL module.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "In order to minimize impact on the RBACL module, it may be reasonable to simply copy/paste the relevant dependency classes into the webac project.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
