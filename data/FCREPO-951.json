     "body": {
      "content": [
       {
        "content": [
         {
          "text": "FeSL enforcement - see org.fcrepo.server.security.xacml.pep.rest.filters.ListDatastreamsFilter.handleRequest(...)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This will need to detect the query parameter that distinguishes between the existing API-A call and the new API-M call and construct the XACML request context appropriately (ie API-M instead of API-A, and instead of Constants.ACTION.LIST_DATASTREAMS the equivalent API-M method).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
