  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When using the client to create a binary resource with a filename, the client is URI encoding the value of the filename. So in the following example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "client.put(resourceUri)\r\n       .filename(\"this is my file.txt\")\r\n       ...",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "The ebucore:filename field in fedora ends up as \"this+is+my+file.txt\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
