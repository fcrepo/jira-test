     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It would be useful to know the limits of the common case (single server) as well as the clustered case. Those seem like two different tickets. Feel free to cast this ticket towards either scenario and we can create another ticket for the other scenario.",
          "type": "text"
         }
        ],
