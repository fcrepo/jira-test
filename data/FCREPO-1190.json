  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently, we're bundling Tomcat 6.0.35, sourced from the duraspace-thirdparty Maven repo. As of 2013, Tomcat 7 is now available in Maven Central.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We should bump our included version to the latest version (currently 7.0.39).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
