      "accountId": "60785ded115da6006f540529",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Somewhat related to this conversation, there are currently three authorization modules:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "webac - ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://github.com/fcrepo4/fcrepo-module-auth-webac"
                },
                "type": "link"
               }
              ],
              "text": "https://github.com/fcrepo4/fcrepo-module-auth-webac",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "rbacl - ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://github.com/fcrepo4/fcrepo-module-auth-rbacl"
                },
                "type": "link"
               }
              ],
              "text": "https://github.com/fcrepo4/fcrepo-module-auth-rbacl",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "xacml - ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://github.com/fcrepo4/fcrepo-module-auth-xacml"
                },
                "type": "link"
               }
              ],
              "text": "https://github.com/fcrepo4/fcrepo-module-auth-xacml",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "Given that the fcrepo-specification only includes mention of webac, we should be planning on deprecating rbacl and xacml... and therefore consolidating/refactoring webac, auth-common, and parts of rbacl that webac depends upon.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
