  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently the Fedora auth SPI depends directly on org.modeshape.jcr.security.AuthenticationProvider. This is a Modeshape type dependency which should be confined to the Modeshape kernel implementation. Instead, an appropriate Fedora-specific type should be substituted for org.modeshape.jcr.security.AuthenticationProvider.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
