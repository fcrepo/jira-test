  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The TimeMap must, according to the memento spec, return the following link header: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Link:  <link to LDPRv>; rel=\"original\"  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This header should be present on the LDP-RS, LDP-NR, and LDP-NR description timemaps.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
