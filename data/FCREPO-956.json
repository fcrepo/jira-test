     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I removed the JBoss repo entirely, and added the GlassFish repo as part of addressing FCREPO-961. With a clean Maven repo, I'm not getting any errors retrieving artifacts and the tests all pass. I'm not actually sure what dependency the JBoss repo was originally intended to satisfy.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Marked as fixed as of 20130585a473f64a698d32d5cb915c56043f1c1d.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
