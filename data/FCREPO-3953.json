      },
      "displayName": "Ben Pennell",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5bba58f3eb6f6e2ccfd097c6",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This may be addressed now by changes in ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://github.com/fcrepo/fcrepo/pull/2092"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "That PR added in cleanup of the search index transaction tables around server restarts, so on shutdown any entries in this table associated with an open transaction should get rolled back, and if entries survive that process, they would get cleaned up during startup.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
