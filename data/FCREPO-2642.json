    {
     "author": {
      "accountId": "5ed02cb2dacd410c1f9e56ae",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png",
       "24x24": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png",
       "32x32": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png",
       "48x48": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png"
      },
      "displayName": "Aaron Birkland",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5ed02cb2dacd410c1f9e56ae",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This may be a big problem.  It looks like URIs are fundamentally incompatible with basic auth?  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Look at RFC 7617 (The Basic HTTP Authentication Scheme): ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://tools.ietf.org/html/rfc7617"
            },
            "type": "link"
           }
          ],
          "text": "https://tools.ietf.org/html/rfc7617",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": " ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "The user-id and password MUST NOT contain any control characters (see",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "\"CTL\" in [Appendix B.1 of RFC5234]|",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://tools.ietf.org/html/rfc5234#appendix-B.1"
            },
            "type": "link"
           }
          ],
          "text": "https://tools.ietf.org/html/rfc5234#appendix-B.1",
          "type": "text"
         },
         {
          "text": "]).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Furthermore, a user-id containing a colon character is invalid, as",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "the first colon in a user-pass string separates user-id and password",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "from one another; text after the first colon is part of the password.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "User-ids containing colons cannot be encoded in user-pass strings.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note that many user agents produce user-pass strings without checking",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "that user-ids supplied by users do not contain colons; recipients",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "will then treat part of the username input as part of the password.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
