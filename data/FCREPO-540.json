     "body": {
      "content": [
       {
        "content": [
         {
          "text": "When I spoke w/ Aaron in Cambridge last week, he mentioned he was using CXF for an OSGi application he was working on, although if you didn't need all the CXF features (e.g. SOAP support) he advised using RESTEasy.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
