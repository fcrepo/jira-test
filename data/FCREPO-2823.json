     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This has already been implemented--. Verification steps:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "curl -u fedoraAdmin:fedoraAdmin -i -X POST http://localhost:8080/rest/\r\n# returns new resource's URI: http://localhost:8080/rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15\r\n\r\n# HEAD to follow the Link rel=\"acl\" location\r\ncurl -u fedoraAdmin:fedoraAdmin -I http://localhost:8080/rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15\r\n\r\n# create the ACL to the testuser can only append to the container\r\ncurl -u fedoraAdmin:fedoraAdmin -X PUT http://localhost:8080/rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15/fcr:acl -H 'Content-Type: text/turtle' --data-binary @- <<END\r\n@prefix acl: <http://www.w3.org/ns/auth/acl#>.\r\n<#auth> a acl:Authorization;\r\nacl:agent \"testuser\";\r\nacl:accessTo </rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15>;\r\nacl:mode acl:Append .\r\nEND\r\n\r\ncurl -u testuser:testpass http://localhost:8080/rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15\r\n# --> 403 (cannot read the container)\r\n\r\ncurl -u testuser:testpass http://localhost:8080/rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15 -X POST\r\n# --> 201 (can create a child resource)\r\n\r\ncurl -u testuser:testpass http://localhost:8080/rest/ff4f80f3-70f3-4292-9a1e-ef03c4d0df15/a477dd32-da66-42e1-83f8-8f227f889897 -X POST\r\n# --> 201 (can create a child resource of a child resource)",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
      "type": "doc",
      "version": 1
     },
