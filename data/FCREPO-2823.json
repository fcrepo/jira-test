  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Quoting section 5.7.2",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "text": "In addition to requirements in ",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "https://fedora.info/2018/06/25/spec/#append-ldprs"
           },
           "type": "link"
          }
         ],
         "text": "5.7.1 LDP-RS",
         "type": "text"
        },
        {
         "text": ", when a client is allowed to perform ",
         "type": "text"
        },
        {
         "marks": [
          {
           "type": "code"
          }
         ],
         "text": "acl:Append",
         "type": "text"
        },
        {
         "text": " but not ",
         "type": "text"
        },
        {
         "marks": [
          {
           "type": "code"
          }
         ],
         "text": "acl:Write",
         "type": "text"
        },
        {
         "text": " operations on an ",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "https://fedora.info/2018/06/25/spec/#dfn-ldpc"
           },
           "type": "link"
          }
         ],
         "text": "LDPC",
         "type": "text"
        },
        {
         "text": ", a ",
         "type": "text"
        },
        {
         "marks": [
          {
           "type": "code"
          }
         ],
         "text": "POST",
         "type": "text"
        },
        {
         "text": " request ",
         "type": "text"
        },
        {
         "marks": [
          {
           "type": "em"
          }
         ],
         "text": "MUST",
         "type": "text"
        },
        {
         "text": " be allowed. ",
         "type": "text"
        }
       ],
       "type": "paragraph"
      }
     ],
     "type": "blockquote"
    },
    {
     "content": [
      {
       "text": "So if you can acl:Append a LDP-C you can't PUT or PATCH or DELETE, but you can POST to add a new resource inside it.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
