  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create a JMeter test for Test 5 - Number of containers - RDF bodies (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FF/Performance+and+Scalability+Test+Plans)"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FF/Performance+and+Scalability+Test+Plans)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The test should:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create containers with POST requests with RDF bodies at the top of the repository",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "After every 1000 requests, performance requests should be made",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "The fcrepo-jmeter GitHub repo is available here: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo4-jmeter"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo4-jmeter",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
