   "content": [
    {
     "content": [
      {
       "text": "Docker Image: fcrepo/fcrepo:6.2.0.  Running with `docker compose` with PostgreSQL and a volume mount at `/usr/local/tomcat/fcrepo-home/data` ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
