     "content": [
      {
       "text": "On start the fcrepo container returns the following:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "SEVERE [main] org.apache.catalina.session.StandardManager.startInternal Exception loading sessions from persistent storage\njava.io.StreamCorruptedException: invalid type code: 00",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    }
   ],
   "type": "doc",
