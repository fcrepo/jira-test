  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The \"hasTombstone\" link header does not currently check to see if there is already a trailing slash on an identifier before adding \"/fcr:tombstone\". The result is urls like \"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/deleteme//fcr:tombstone"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/deleteme//fcr:tombstone",
       "type": "text"
      },
      {
       "text": "\". This is usually not a problem, but some clients do weird things with consecutive slash characters that cause subsequent requests to fail. See:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/rest-assured/rest-assured/issues/867"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/rest-assured/rest-assured/issues/867",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I haven't verified if this affects 4.7.x.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Here is an example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "text": "curl -vi -XPUT ",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "http://localhost:8080/rest/deleteme"
           },
           "type": "link"
          }
         ],
         "text": "http://localhost:8080/rest/deleteme",
         "type": "text"
        },
        {
         "text": " -ufedoraAdmin:fedoraAdmin",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "content": [
        {
         "text": "curl -vi -XDELETE ",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "http://localhost:8080/rest/deleteme"
           },
           "type": "link"
          }
         ],
         "text": "http://localhost:8080/rest/deleteme",
         "type": "text"
        },
        {
         "text": " -ufedoraAdmin:fedoraAdmin",
         "type": "text"
        }
       ],
       "type": "paragraph"
      },
      {
       "content": [
        {
         "text": "curl -vi ",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "http://localhost:8080/rest/deleteme"
           },
           "type": "link"
          }
         ],
         "text": "http://localhost:8080/rest/deleteme",
         "type": "text"
        },
        {
         "text": " -ufedoraAdmin:fedoraAdmin",
         "type": "text"
        }
       ],
       "type": "paragraph"
      }
     ],
     "type": "blockquote"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "< HTTP/1.1 410 Gone",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "< Link: <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/deleteme/fcr:tombstone"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/deleteme/fcr:tombstone",
           "type": "text"
          },
          {
           "text": ">; rel=\"hasTombstone\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "text": "curl -vi ",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "http://localhost:8080/rest/deleteme/"
           },
           "type": "link"
          }
         ],
         "text": "http://localhost:8080/rest/deleteme/",
         "type": "text"
        },
        {
         "text": " -ufedoraAdmin:fedoraAdmin",
         "type": "text"
        }
       ],
       "type": "paragraph"
      }
     ],
     "type": "blockquote"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "< HTTP/1.1 410 Gone",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "< Link: <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/deleteme//fcr:tombstone"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/deleteme//fcr:tombstone",
           "type": "text"
          },
          {
           "text": ">; rel=\"hasTombstone\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
