  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to ensure that ghost nodes are immutable. In other words, once a ghost node, always a ghost node.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://docs.google.com/document/d/1bzNvqctv_fzZxDYQFPSfc9_O_9EZl9iJ657dByzaKi0/edit#heading=h.o04fva3x471c"
         },
         "type": "link"
        }
       ],
       "text": "https://docs.google.com/document/d/1bzNvqctv_fzZxDYQFPSfc9_O_9EZl9iJ657dByzaKi0/edit#heading=h.o04fva3x471c",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The following script shows that ghost nodes can currently be re-created as Fedora resources:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "#!/usr/bin/bash",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create 'a'  ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT localhost:8080/rest/a",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create 'a/b/c' ('b' is a ghost node)",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT localhost:8080/rest/a/b/c",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "GET 'a/b' - expect 404",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i localhost:8080/rest/a/b",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create 'a/b' - expect 409 – but no!, it is a 201",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT localhost:8080/rest/a/b",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "GET 'a/b' - expect 404 – but, no! it is a 200",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i localhost:8080/rest/a/b",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    }
   ],
