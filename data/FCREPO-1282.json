     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Per the ReadMe.txt in fcrepo-camel-scala, I ran:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "> mvn install",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "followed by:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "> mvn exec:java",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The exec:java command failed with: ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "\"The parameters 'mainClass' for goal org.codehaus.mojo:exec-maven-plugin:1.3.2:java are missing or invalid\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
