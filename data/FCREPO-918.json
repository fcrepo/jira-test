     "body": {
      "content": [
       {
        "content": [
         {
          "text": "RISearch filter behaviour is to allow all.  There is an alternative filter, not tested, which is supposed to be filtering results (with a comment that there is a significant performance impact).  Need to work out what security to apply to this method.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
