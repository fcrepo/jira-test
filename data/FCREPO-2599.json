      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Tomcat (as of 8.0.34, 8.5.1) does not set the Content-Length header when responding to GET requests.  See ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://bz.apache.org/bugzilla/show_bug.cgi?id=59310#c8"
            },
            "type": "link"
           }
          ],
          "text": "https://bz.apache.org/bugzilla/show_bug.cgi?id=59310#c8",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
