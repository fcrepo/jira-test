     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I don't believe there is any action required here — there are tests to verify that the Digest header behaves the same for GET and HEAD (",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-2598#icft=FCREPO-2598"
          },
          "type": "inlineCard"
         },
         {
          "text": "), so I think we can just close this.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
