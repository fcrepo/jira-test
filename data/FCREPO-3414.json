  "customfield_10154": null,
  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen when attempting to create a BasicContainer with an RDF body, but without a provided content-type. The bug is that the body of the HTTP response to the client is an internal stacktrace. The fix should catch the exception, include a simple error message (e.g. \"Content-Type header required\"), and a 400 response code.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To recreate this bug:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$ curl -i -d \"<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://awoods.com/#title"
         },
         "type": "link"
        }
       ],
       "text": "http://awoods.com#title",
       "type": "text"
      },
      {
       "text": "> 'A title'\" -XPUT localhost:8080/rest/test -H'Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#BasicContainer"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#BasicContainer",
       "type": "text"
      },
      {
       "text": ">;rel=\"type\"'",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
