     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As of commit ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo/fcrepo/commit/93a8e636ab22559a9100eedea20f83f8bb9077d6"
            },
            "type": "link"
           }
          ],
          "text": "93a8e63",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I am seeing this:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "{{ > curl -i -d \"<> <",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://awoods.com/#title"
            },
            "type": "link"
           }
          ],
          "text": "http://awoods.com#title",
          "type": "text"
         },
         {
          "text": "> 'A title'\" -XPUT localhost:8080/rest/test -H'Link: <",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/ns/ldp#BasicContainer"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/ns/ldp#BasicContainer",
          "type": "text"
         },
         {
          "text": ">;rel=\"type\"' -ufedoraAdmin:fedoraAdmin}}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "{{ HTTP/1.1 415 Unsupported Media Type}}",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "{{ Date: Fri, 13 Nov 2020 21:13:03 GMT}}",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "{{ Set-Cookie: JSESSIONID=node010g0b7lwj5cyzr869w7hty62v0.node0; Path=/}}",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "{{ Expires: Thu, 01 Jan 1970 00:00:00 GMT}}",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "{{ Set-Cookie: rememberMe=deleteMe; Path=/; Max-Age=0; Expires=Thu, 12-Nov-2020 21:13:04 GMT; SameSite=lax}}",
          "type": "text"
         },
         {
          "type": "hardBreak"
