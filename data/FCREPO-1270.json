  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The message format and headers produced by the sparql processors work fine for fuseki but not for sesame. For example, sesame requires the content-type header to be equal to \"application/x-www-form-urlencoded\" and the body needs to be structured in key=value format like this:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "update={sparql update query}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "That format will work for both Fuseki and Sesame.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
