  "description": {
   "content": [
    {
     "content": [
      {
       "text": "At the moment, there are no restrictions on use of the \"fcr:\" prefix in URLs of resources on creation.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This request creates a resource named \"fcr:stuff\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -XPUT http://localhost:8080/rest/fcr:stuff -v",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "This is different from previous versions of fedora, and can result in creation of resources with names that overlap with reserved endpoints, like \"fcr:tx\". You can create ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/hello/fcr:tx"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/hello/fcr:tx",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
