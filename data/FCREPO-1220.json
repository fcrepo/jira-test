  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Just tried to upgrade a 3.7.2 installation with this snapshot on a Debian Wheezy/Java7/Tomcat6/Postgres9.1 combo, but I hit an error when trying to setup database access:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Database",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "--------\nEnter a value ==> postgresql",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Postgresql JDBC driver",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "----------------------\nEnter a value [default is included] ==>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Database username",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-----------------\nEnter a value ==> myuser",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Database password",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-----------------\nEnter a value ==> secret",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "JDBC URL",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "--------\nEnter a value [default is jdbc:postgresql://localhost/fedora3] ==>",
       "type": "text"
      }
     ],
     "type": "paragraph"
