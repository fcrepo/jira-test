  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The HTTP layers use an awkward call to BatchService::exists before issuing a FedoraSession::commit. That logic should be tucked into an HttpSession class that encapsulates that check, making the use of FedoraSession less error prone to the developer.",
       "type": "text"
      }
     ],
     "type": "paragraph"
