     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It was decided that the existing functionality is preferable, and PR-693 has been ignored/closed.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "As a note, the associated ModeShape PR has been merged into their codebase.",
          "type": "text"
         }
        ],
        "type": "paragraph"
