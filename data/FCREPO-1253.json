      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a45f9889d5006a6c0384",
           "text": "@Michael Durbin"
          },
          "type": "mention"
         },
         {
          "text": ", Could you look at the PR below:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/693"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/693",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The fix at the ModeShape level is in. However, I almost like the \"workaround\" logic better than this PR. As you can see, the PR logic creates a version check-point even if the eventual application of the label will fail due to being a duplicate.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "What are your thoughts?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
