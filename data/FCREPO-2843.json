  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to resolve the issue of users who have acl:READ access on a resource not being able to perform a HEAD request.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The issue can be reproduced as follows:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1. Create a resource",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin -v -X PUT  ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. Give 'testuser' READ access to the above resource",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin -v -X PUT  ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test/fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test/fcr:acl",
       "type": "text"
      },
      {
       "text": " --data-binary \"@acl.ttl\" -H \"Content-Type: text/turtle\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "..where \"acl.ttl\" is:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "@prefix acl: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/auth/acl#"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/auth/acl#",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "@prefix foaf: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://xmlns.com/foaf/0.1/"
         },
         "type": "link"
        }
       ],
       "text": "http://xmlns.com/foaf/0.1/",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<#restricted> a acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "acl:agent \"testuser\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "acl:mode acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "acl:accessTo </rest/test> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. Notice success on GET",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -i -u testuser:testpass -X GET ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "4. BOOM: Notice failure on HEAD",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -i -u testuser:testpass -I ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
