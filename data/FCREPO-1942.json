  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to resolve the bug demonstrated below:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "clear;curl -i -XPUT localhost:8080/rest/collection",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "clear;curl -i -XPUT localhost:8080/rest/collection/child",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "clear;curl -i -XPOST -H\"slug: v0\" localhost:8080/rest/collection/child/fcr:versions",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "clear;curl -i -XPOST -H\"slug: v0\" localhost:8080/rest/collection/fcr:versions",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "clear;curl -i localhost:8080/rest/collection/fcr:versions/v0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "=> BOOM!",
       "type": "text"
      }
     ],
     "type": "paragraph"
