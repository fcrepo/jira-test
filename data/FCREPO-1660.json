      "content": [
       {
        "content": [
         {
          "text": "This looks good and appears to deploy the configuration files correctly into karaf/etc.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "As mentioned in one code review comment, there are a few configuration files that do not map one-to-one with their corresponding blueprint.xml files. If that is intentional, then this is good to go.",
          "type": "text"
         }
