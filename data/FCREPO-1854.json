    {
     "content": [
      {
       "text": "When sending an HTTP DELETE request on a container with a large number of children, the application throws an exception. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The number of children of the container where this happens cannot be easily calculated at the moment; it goes between tens of thousands to over 100k. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Command line to reproduce the error: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
