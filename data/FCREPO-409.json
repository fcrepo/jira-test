       "16x16": "https://secure.gravatar.com/avatar/13bce4184de79f1cc37b9b55754ad34b?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-3.png",
       "24x24": "https://secure.gravatar.com/avatar/13bce4184de79f1cc37b9b55754ad34b?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-3.png",
       "32x32": "https://secure.gravatar.com/avatar/13bce4184de79f1cc37b9b55754ad34b?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-3.png",
       "48x48": "https://secure.gravatar.com/avatar/13bce4184de79f1cc37b9b55754ad34b?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-3.png"
      },
      "displayName": "MHR",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a577248ef60073949bff",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Hi guys .. I got this problem . the main reason that there is a connection object for JDBC  (I suppose its static ) ...so just close it and give it value null in ovverrided function finilize() like this ( con refers to connection Obj. ):",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "@Override",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "protected void finalize() throws Throwable {",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "super.finalize();",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "try{",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "con.close();",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}catch(Exception r){",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "r.getMessage();",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "con=null;",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "This solve my problem, but on the other hand I dont recommand to use connection as static never .. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "M.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
