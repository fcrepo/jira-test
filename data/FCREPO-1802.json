     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This seems useful. It also seems like nothing on which the Fedora core team should be spending time.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
