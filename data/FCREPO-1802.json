  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to investigate (and document in the wiki) potential approaches for enforcing WebAC policies defined on F4 resources when being queried in an external triplestore.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
