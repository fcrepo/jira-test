       "32x32": "https://secure.gravatar.com/avatar/8285187b23d5d8ea87a1ecc2e6d456d6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBB-1.png",
