       "48x48": "https://secure.gravatar.com/avatar/8285187b23d5d8ea87a1ecc2e6d456d6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBB-1.png"
      },
      "displayName": "Bill Branan",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5d83b5f927bbf40c2c32ceeb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "For discussion purposes, these are the methods currently in the REST API which provide a .xml shortcut",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "getObjectHistory (no problem possible)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Example: /objects/demo:29/versions.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "getObjectProfile (possible problem if PID ends in .xml)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Example: /objects/demo:29.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "listDatastreams (no problem possible)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Example: /objects/demo:35/datastreams.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "listMethods (no problem possible)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Example: /objects/demo:29/methods.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "getDatastream (known problem if DSID ends in .xml)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Example: /objects/demo:29/datastreams/myDatastream.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "getNextPID (no problem possible)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Example: /objects/nextPID.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
