     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Verified. This problem is caused by the format query parameter being overloaded in the search method, it is used for both a search result field and the method response. One of these two parameters needs to be renamed.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
