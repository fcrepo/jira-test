  "description": {
   "content": [
    {
     "content": [
      {
       "text": "On fcrepo-webapp-plus, when running: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn clean install -Paudit",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The SanityIT fails with:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "SanityIT.doASanityCheckNoAuth:86 expected:<401> but was:<200>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Regardless of which profile(s) the project is built with, the sanity should test to run successfully.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This ticket will be resolved with the following four commands complete successfully:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn clean install",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn clean install -Prbacl",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn clean install -Pxacml",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn clean install -Paudit",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
