  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The inclusion of UWM ocfl-java ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/uW-Madison-Library/ocfl-java"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/uW-Madison-Library/ocfl-java",
       "type": "text"
      },
      {
       "text": " introduced a dependency clash on commons-codec. We currently require 1.6 in the pom.xml but ocfl-java requires 1.13. As migration-utils only uses the library for a simple Base64 output, I suggest we upgrade the local requirement to match ocfl-java.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Update pom.xml to require commons-codec 1.13 instead of 1.6",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
