       "48x48": "https://secure.gravatar.com/avatar/628068f58d175962c7274ca5ca03993f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAS-3.png"
      },
      "displayName": "A. Soroka",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A24c578cc-15e9-4649-9f68-5eace85735e0",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Nothing wrong with using the ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "EventBus",
          "type": "text"
         },
         {
          "text": " in those modules in which it should be visible (just kernel-modeshape, I think) but otherwise, (e.g. in http-api) I don't think we should assume its existence. In that case, a strong alternative is to use Awaitility features with ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "AtomicBoolean",
          "type": "text"
         },
         {
          "text": " flags, or ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "Semaphore",
          "type": "text"
         },
         {
          "text": " instances, or other ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "java.util.concurrent",
          "type": "text"
         },
         {
          "text": " or ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "java.util.concurrent.atomic",
          "type": "text"
         },
         {
          "text": " features.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
