  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Implement command line system with options. For example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "java -Dfedora.client=ocfl -Dmigration.strategy=minimal -Dmigration.layout=legacy -Dfoxml.object.dir=<path> -Dfoxml.datastreams.dir=<path> -jar target/migration-utils-4.4.1-SNAPSHOT-driver.jar conf/fedora3.xml",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See \"Picocli\" framework: ",
