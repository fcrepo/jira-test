     "content": [
      {
       "text": "Including a prefer header with a trailing semicolon causes a parsing failure, e.g.:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -H \"Prefer: return=minimal; \" ",
       "type": "text"
      },
      {
