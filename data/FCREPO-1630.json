     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've updated the PR to suppress fedora:mimeType/jcr:mimeType, which is now unused (apparently set automatically by Mode): ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/791"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/791",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "When I create a new file, or migrate a file from 4.2 repo, I no longer see fedora:mimeType.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
