  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to update fcrepo4 logic to filter out what is exposed to the user as \"fedora:mimeType\".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Currently, after running the following steps, \"fedora:mimeType\" still exists:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Start a 4.2.0 fcrepo and add a binary resource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Run the fcrepo4-upgrade-utility over that repository",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Start master branch of fcrepo => see fedora:mimeType still exists",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
