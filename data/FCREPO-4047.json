     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "url": "https://github.com/fcrepo/fcrepo/pull/2276"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Also noticed that the resumption functionality for skipping already indexed resources was not working when only using the ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "fcrepo.rebuild",
          "type": "text"
         },
         {
          "text": " flag, it would only trigger when the deprecated (and no longer documented) ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "fcrepo.rebuild.continue",
          "type": "text"
         },
         {
          "text": " flag was set, so I removed that check and it appears to be resuming again.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
