  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently if you POST to the fcr:versions endpoint of a non-versioned resource, it will automatically make it versionable, generate the Timemap container and continue to generate the Memento.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "curl -i -X PUT --user fedoraAdmin:fedoraAdmin http://localhost:8080/rest/versioning/v3",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "curl -i --user fedoraAdmin:fedoraAdmin http://localhost:8080/rest/versioning/v3",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "curl -i -X POST --user fedoraAdmin:fedoraAdmin \"http://localhost:8080/rest/versioning/v3/fcr:versions\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "curl -i --user fedoraAdmin:fedoraAdmin http://localhost:8080/rest/versioning/v3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
