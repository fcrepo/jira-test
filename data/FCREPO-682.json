  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Batch ingests of large \"archival\" base-64 encoded objects were failing with a StorageDeviceException error. The following was also appearing in fedora.log: com.mysql.jdbc.MysqlDataTruncation: Data truncation: Data too long for column 'dcRelation' at row 1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "In the table doFields, the column type for dcRelation was altered from TEXT to LONGTEXT and ingests were successful. Could Fedora automatically create the table with this column type?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
