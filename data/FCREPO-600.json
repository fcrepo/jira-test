  "description": {
   "content": [
    {
     "content": [
      {
       "text": "With FeSL enabled, fedora.test.api.TestRISearch is failing. Queries that ask for a specific format such as \"count\" are rewritten to return RDF/XML.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example, the query: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/risearch?type=triples&lang=spo&format=count&stream=on&query=*%20*%20*"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/risearch?type=triples&lang=spo&format=count&stream=on&query=*%20*%20*",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "always returns RDF/XML (format=Turtle, etc. is also rewritten)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
  "duedate": null,
  "environment": {
   "content": [
    {
     "content": [
      {
       "text": "OS X 10.6, Java5",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
