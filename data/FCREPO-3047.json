     "content": [
      {
       "text": "This task involves  defining java interfaces for Persistent Storage and Transaction interfaces defined here: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/pages/viewpage.action?pageId=133366058"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/pages/viewpage.action?pageId=133366058",
       "type": "text"
      },
      {
       "text": ".   It would also be good to check prior art with respect to Spring's transactional framework(s) to see if it makes sense for us to use established patterns.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
