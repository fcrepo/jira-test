     "content": [
      {
       "text": "Acceptance Criteria:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "As a user I can test if the Fedora Server supports the predefined Digest type used when creating LDP-NR. ",
       "type": "text"
      }
     ],
