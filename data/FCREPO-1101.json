     "body": {
      "content": [
       {
        "content": [
         {
          "text": "So far, I have determined that this issue was introduced when ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-504#icft=FCREPO-504"
          },
          "type": "inlineCard"
         },
         {
          "text": " was merged. The WAR file is no longer modified at all as part of the installer process, so there is no opportunity for the user-provided JDBC jar to be added to it.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
