  "description": {
   "content": [
    {
     "content": [
      {
       "text": "A number of small changes should be made to prepare fcrepo-camel for graduation from the -labs organization. They include:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Decouple fcrepo-camel runtime from fcrepo server code",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Adjust maven configuration to include release-related artifacts; sonatype parent",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Use an embedded fuseki server (rather than a containerized servlet) for the triplestore integration tests",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Improve the integration tests to do more checking of body content",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
