      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a13a248ef600739455eb",
           "text": "@Former user"
          },
          "type": "mention"
         },
         {
          "text": " I had been testing these queries with the web interface, and I actually think the issue related to browser caching (probably the etag issue discussed elsewhere). If I issue the queries without a subsequent \"force\" refresh, the changes are not reflected in the interface. When force-refreshing, the changes show up properly. I'm marking this ticket as closed.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
