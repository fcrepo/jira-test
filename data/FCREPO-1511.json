     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "There is some conversation on the mailing lists about what hash references actually mean in the Fedora model, but little agreement. My suspicion is that they will be most useful to people who insist on doing \"XML-style\" RDF metadata instead of true Linked Data, as replacements for blank nodes.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
