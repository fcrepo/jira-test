  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Audit datastream isn't versioned, but contains information about updates.  Perhaps that information should be incorporated into the API for the org.fcrepo.migration.ObjectVersionReference and a basic implementation should be written to serialize content to Fedora4.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This might have to wait until the fedora 4 audit service discussion is complete.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
