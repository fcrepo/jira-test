     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I just reproduce this bug using the fcr:import rest api",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "The Header Location return the input URL.  ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "e.g. curl -i -X POST --data-binary \"@child1.xml\" \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/fcrepo4/rest/node2/fcr:import?format=jcr/xml"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/fcrepo4/rest/node2/fcr:import?format=jcr/xml",
          "type": "text"
         },
         {
          "text": "\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "the Header Location is ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/fcrepo4/rest/node2"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/fcrepo4/rest/node2",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Should the correct Header Location be ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/fcrepo4/rest/node2/child1"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/fcrepo4/rest/node2/child1",
          "type": "text"
         },
         {
          "text": " and is what this ticket about? ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
