  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The headers returned from RDF Sources, and particularly Containers, have a few minor issues:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "[ ] Content-Length is 0 on a HEAD, and should be the number of bytes of the representation if you had done a GET instead.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
