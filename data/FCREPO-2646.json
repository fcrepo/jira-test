  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Although the internal name of the time-map JCR node is \"TimeMap\", all interactions with time-maps (and mementos) will be served through /fcr:versions endpoints.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "The FedoraResourceImpl.getPath() should be updated to replace occurrences of \"/TimeMap\" with \"/fcr:versions\".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
