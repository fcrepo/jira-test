     "author": {
      "accountId": "557058:09c4b091-d44d-4d9e-9924-126437e1063b",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/94858ef66c252d2ebbc0ee4b97c8108a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDJ-6.png",
       "24x24": "https://secure.gravatar.com/avatar/94858ef66c252d2ebbc0ee4b97c8108a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDJ-6.png",
       "32x32": "https://secure.gravatar.com/avatar/94858ef66c252d2ebbc0ee4b97c8108a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDJ-6.png",
       "48x48": "https://secure.gravatar.com/avatar/94858ef66c252d2ebbc0ee4b97c8108a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDJ-6.png"
      },
      "displayName": "Danny Joris",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A09c4b091-d44d-4d9e-9924-126437e1063b",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The reason why I want to upgrade is because I need recent SPARQL functionality: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://stackoverflow.com/questions/9282846/sparql-combining-variables-with-literals"
            },
            "type": "link"
           }
          ],
          "text": "http://stackoverflow.com/questions/9282846/sparql-combining-variables-with-literals",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I got in touch with Paul Gearon and he told me I had to rewrite the code a bit:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "SELECT * WHERE {",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$object dc:identifier $identifier .",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "LET ($new := IRI(fn:concat(str($object), \"/MODS\")))",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$new fedora-view:disseminationType $mods .",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$new fedora-view:disseminationType $tn .",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "IRI isn't recognized by Mulgara 2.1.4 , so I need an upgrade.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Being able to do optional checks would save us so much time on page loads. I'm using Islandora.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
