      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png",
       "24x24": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png",
       "32x32": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png",
       "48x48": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png"
      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Hi Danny,",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "We don't recommend you try to upgrade the embedded Mulgara due to dependency issues and changes outside of our control, but if you want to stay up to date with the latest version, you configure Fedora to use an ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "strong"
           }
          ],
          "text": "external",
          "type": "text"
         },
         {
          "text": " Mulgara. See this document:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FEDORA35/Resource+Index#ResourceIndex-RemoteMulgaraDatastoreConfiguration"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FEDORA35/Resource+Index#ResourceIndex-RemoteMulgaraDatastoreConfiguration",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Same instructions for 3.4.x. We're also working on making this configuration option more apparent to folks when they first install Fedora.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
