  "description": {
   "content": [
    {
     "content": [
      {
       "text": "People who run Fedora behind a reverse proxy sometimes have issues with schema and hostnames. Several of these issues have been resolved, but the documentation might be lacking or hard to find.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This ticket is generate or maybe make more findable this documentation.",
       "type": "text"
      }
     ],
