  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Mulgara documentation suggests that querying against a datatyping model using the predicates mulgara:gt and mulgara:lt should be possible for XSD datatype int.  However these do not work, but mulgara:before and mulgara:after do work.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "eg RELS-EXT:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<rdf:RDF xmlns:fedora-model=\"info:fedora/fedora-system:def/model#\" xmlns:rdf=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
       "type": "text"
      },
      {
       "text": "\" xmlns:myns=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.example.org/myns#"
         },
         "type": "link"
        }
       ],
       "text": "http://www.example.org/myns#",
       "type": "text"
      },
      {
       "text": "\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<rdf:Description rdf:about=\"info:fedora/ns:pid\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<myns:temperature rdf:datatype=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#int"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#int",
       "type": "text"
      },
      {
       "text": "\">30</myns:temperature>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</rdf:Description>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</rdf:RDF>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Non-working Query:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "select $object $temp from <#ri>                                                      ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "where ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$object <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.example.org/myns#temperature"
         },
         "type": "link"
        }
       ],
       "text": "http://www.example.org/myns#temperature",
       "type": "text"
      },
      {
       "text": "> $temp in <#ri>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "and $temp <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://mulgara.org/mulgara#gt"
         },
         "type": "link"
        }
       ],
       "text": "http://mulgara.org/mulgara#gt",
       "type": "text"
      },
      {
       "text": "> '10'^^<xml-schema:int> in <#xsd>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Working Query:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "select $object $temp from <#ri>                                                      ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "where ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$object <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.example.org/myns#temperature"
         },
         "type": "link"
        }
       ],
       "text": "http://www.example.org/myns#temperature",
       "type": "text"
      },
      {
       "text": "> $temp in <#ri>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "and $temp <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://mulgara.org/mulgara#after"
         },
         "type": "link"
        }
       ],
       "text": "http://mulgara.org/mulgara#after",
       "type": "text"
      },
      {
       "text": "> '10'^^<xml-schema:int> in <#xsd>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
