     "body": {
      "content": [
       {
        "content": [
         {
          "text": "After adding additional JDK7-required methods to the various java.sql wrappers/mock classes, I was able to successfully compile Fedora and run Fedora with OpenJDK 7 for OS X while still supporting Sun/Oracle JDK 6 for OS X.",
          "type": "text"
         }
