  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When a binary is retrieved, a Content-Disposition header including the filename is sent.  In 4.7.0, the filename now includes the datatype URI:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Content-Disposition: attachment; filename=\"newname.jpg ^^ ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#string"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#string",
       "type": "text"
      },
      {
       "text": "\"; creation-date=\"Sat, 19 Nov 2016 22:58:17 GMT\"; modification-date=\"Tue, 22 Nov 2016 19:24:48 GMT\"; size=277448828",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This results in the browser treating the datatype URI as part of the filename.  The filename should simply be a string with the datatype URI removed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/issues/1145"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/issues/1145",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
