     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a594bb0b0500707c78d8",
           "text": "@Dan Field"
          },
          "type": "mention"
         },
         {
          "text": " I think there is a misunderstanding here: ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://github.com/fcrepo-exts/fcrepo-docker/blob/main/Dockerfile"
          },
          "type": "inlineCard"
         },
         {
          "text": "  already uses the tag ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://hub.docker.com/layers/library/tomcat/9-jdk11-openjdk/images/sha256-5a5d1f2d1f71618995c96f55b3939773fa33700bc7601328032512a49e7dffee?context=explore"
            },
            "type": "link"
           }
          ],
          "text": "tomcat:9-jdk11-openjdk",
          "type": "text"
         },
         {
          "text": " as a base image. The problem is, that this tag has not been updated since 2 years.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "We should instead use ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://hub.docker.com/layers/library/tomcat/9-jdk11/images/sha256-26d484513d2b80b3f1be2018769b8d2f9cba6069f3d41742f3311279a725dd3c?context=explore"
            },
            "type": "link"
           }
          ],
          "text": "9-jdk11",
          "type": "text"
         },
         {
          "text": " or on of the following if we want to be more specific on what JDK version is used:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "9.0.88-jdk11-temurin-jammy",
