     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Headers from a RDFSource",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "Link: <http://www.w3.org/ns/ldp#Resource>;rel=\"type\"\r\nLink: <http://www.w3.org/ns/ldp#Container>;rel=\"type\"\r\nLink: <http://www.w3.org/ns/ldp#BasicContainer>;rel=\"type\"",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "But headers for NonRDFSource",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "Link: <http://www.w3.org/ns/ldp#Resource>;rel=\"type\"\r\nLink: <http://www.w3.org/ns/ldp#NonRDFSource>;rel=\"type\"",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "and for a ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "fcr:metadata",
          "type": "text"
         },
         {
          "text": " endpoint",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "Link: <http://www.w3.org/ns/ldp#Resource>;rel=\"type\"\r\nLink: <http://www.w3.org/ns/ldp#RDFSource>;rel=\"type\"",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
      "type": "doc",
      "version": 1
     },
