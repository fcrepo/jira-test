      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "24x24": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "32x32": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "48x48": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png"
      },
      "displayName": "Jared Whiklo",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4c12a753d0071341edb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This behaviour has been in-place since 2014.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/commit/9b6bd6f5bbcfb045a4f7fd9a7e0536efb3bb6126#diff-d372035f89c8d0846920e20bd13e0145R436"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/commit/9b6bd6f5bbcfb045a4f7fd9a7e0536efb3bb6126#diff-d372035f89c8d0846920e20bd13e0145R436",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "In looking at the example requests in the W3C LDP spec I noticed that while the initial responses use",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "Link: <http://www.w3.org/ns/ldp#RDFSource>; rel=\"type\",\r\n<http://www.w3.org/ns/ldp#Resource>; rel=\"type\"",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "once they start to implement a DirectContainer the response headers change to",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "Link: <http://www.w3.org/ns/ldp#DirectContainer>; rel=\"type\",\r\n<http://www.w3.org/ns/ldp#Resource>; rel=\"type\"",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "Replacing the RDFSource with the explicit container definition. I am guessing this is why ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "5fca8a549592df00764ce49c",
           "text": "@cb"
          },
          "type": "mention"
         },
         {
          "text": " did it this way originally.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
