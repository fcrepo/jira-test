      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/200d86ebf05d94227b373f40bb6f84fe?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-4.png",
       "24x24": "https://secure.gravatar.com/avatar/200d86ebf05d94227b373f40bb6f84fe?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-4.png",
       "32x32": "https://secure.gravatar.com/avatar/200d86ebf05d94227b373f40bb6f84fe?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-4.png",
       "48x48": "https://secure.gravatar.com/avatar/200d86ebf05d94227b373f40bb6f84fe?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-4.png"
      },
      "displayName": "Adam Wead",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a519bb0b0500707c7173",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I get this error when importing:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "ERROR 12:01:02.300 (ImportExportDriver) Error performing import/export: Error while importing membership resource /Users/awead/Projects/Fedora/fcrepo-import-export/hydra-export/data/rest/dev/3t/94/5q/76/3t945q76s.ttl (400): javax.jcr.PathNotFoundException: No node exists at path '/dev/3t/94/5q/76/3t945q76s/files/74e5b503-0729-49d4-845a-7b5179ec37f6' in workspace \"default",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I did this using the hydra dataset: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-sample-dataset/blob/master/additional_datasets/hydra/hydra-dataset.tar.gz"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/fcrepo-sample-dataset/blob/master/additional_datasets/hydra/hydra-dataset.tar.gz",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "to replicate, untar the file and run:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "java -jar target/fcrepo-import-export-0.0.1-SNAPSHOT.jar -m export -d hydra-export -g default -r ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8986/rest/dev"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8986/rest/dev",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "java -jar target/fcrepo-import-export-0.0.1-SNAPSHOT.jar -m import -d hydra-export -g default -r ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8986/rest/dev"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8986/rest/dev",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
