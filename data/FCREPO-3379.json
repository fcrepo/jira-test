       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/5fca89ef2730d8007611dc7c/707b4d6e-d492-453c-8971-886c16de2299/32",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/5fca89ef2730d8007611dc7c/707b4d6e-d492-453c-8971-886c16de2299/48"
      },
