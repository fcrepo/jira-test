     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I reviewed the test documentation and made a few edits. In general this looks really good and I was able to run the tests locally. A couple notes:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "There is a _template needed_ note at the bottom of the Python OCFL Validator page: ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://wiki.lyrasis.org/display/FF/Test+Guide+-+Python+OCFL+Validator"
                },
                "type": "link"
               }
              ],
              "text": "https://wiki.lyrasis.org/display/FF/Test+Guide+-+Python+OCFL+Validator",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "There are a couple _template needed_ notes on the migration-utils page: ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://wiki.lyrasis.org/display/FF/Test+Guide+-+Fedora+3+to+6+Migration+Tooling"
                },
                "type": "link"
               }
              ],
              "text": "https://wiki.lyrasis.org/display/FF/Test+Guide+-+Fedora+3+to+6+Migration+Tooling",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "orderedList"
       },
       {
        "content": [
         {
          "text": "We can either create these templates as part of this ticket or close this ticket and open a new one.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
