     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The PR below was merged.  It prevents the tomcat serialization stacktrace by disabling session serialization/deserialization on shutdown/start up.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The other issue with the h2 lock file I believe was resolved by other means which I can’t recall.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
