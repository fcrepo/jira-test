     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Steps to reproduce:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "docker-compose up -d fcrepo",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "docker-compose stop fcrepo",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "You should see errors in the log and the file `/var/lib/docker/volumes/fedora_fcrepo-home/_data/data/fcrepo-h2.lock.db` still present.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
