     "content": [
      {
       "text": "Participants:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "attrs": {
        "accessLevel": "",
        "id": "5ed02d2a7d0c250c236c34d9",
        "text": "@Bethany Seeger"
       },
       "type": "mention"
      },
