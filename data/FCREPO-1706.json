  "description": {
   "content": [
    {
     "content": [
      {
       "text": "A sparql-update will fail if any literal contains the string \"/>\", for instance:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PREFIX dc: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INSERT DATA { ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> dc:title \"Some<br/>Text\" .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This appears to be related to this ticket: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-1409"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-1409",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "and this line in particular: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-kernel-modeshape/src/main/java/org/fcrepo/kernel/modeshape/FedoraResourceImpl.java#L444"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-kernel-modeshape/src/main/java/org/fcrepo/kernel/modeshape/FedoraResourceImpl.java#L444",
       "type": "text"
      },
      {
       "text": " ",
