       "type": "hardBreak"
      },
      {
       "text": "______________________________ test_get_data_dir _______________________________",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "def test_get_data_dir():",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "config.bag = False",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">       data_dir = get_data_dir(config)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "tests/test_utils.py:14: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "config = {}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "def get_data_dir(config):",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "\"\"\"Returns the root directory containing serialized fedora objects",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "based on the configuration.\"\"\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">       return config.dir if not config.bag else config.dir + \"/data\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "E       AttributeError: 'MockConfig' object has no attribute 'dir'",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "fcrepo_verify/utils.py:48: AttributeError",
