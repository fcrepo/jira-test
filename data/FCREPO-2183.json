  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Throughout the codebase we are throwing and catching URISyntaxExceptions. This is because we are using ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "new URI(...)",
       "type": "text"
      },
      {
       "text": " instead of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "URI.create(...)",
       "type": "text"
      },
      {
       "text": ".",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "This task is to replace the former with the later and remove the URISyntaxExceptions throughout the code.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
