  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As a follow-on to: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2688"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2688",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It should not be allowed to create a link to an ACL resource that is outside of the repository.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example, the following should not be allowed:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "create rdf resource with acl on POST",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -v -XPUT  -H \"Link: <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://google.com/"
             },
             "type": "link"
            }
           ],
           "text": "http://google.com",
           "type": "text"
          },
          {
           "text": ">; rel=\\\"acl\\\"\" \"",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/test"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/test",
           "type": "text"
          },
          {
           "text": "\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "Note, the above currently works but explodes on subsequent GET.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
