  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Understand leveldb implementation",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Identify possible issues in hot backup",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Verify backup and restore reliability",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
