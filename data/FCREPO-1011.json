      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Tested using the Mac OS X OpenJDK 7 port[1]. Compiling worked, and when running under this VM, all tests passed except those involving the image manipulation service. I believe they failed because the Mac version of OpenJDK (as of build 1.7.0-b213-20111014) is currently missing a lot of the awt stuff.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "[1] ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://code.google.com/p/openjdk-osx-build/"
            },
            "type": "link"
           }
          ],
          "text": "http://code.google.com/p/openjdk-osx-build/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
