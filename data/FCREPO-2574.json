  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When deployed behind an SSL termination proxy, Google Chrome flags resource pages in UI as insecure with the warning:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Mixed Content: The page at '",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://localhost/fcrepo/rest/test'"
         },
         "type": "link"
        }
       ],
       "text": "https://localhost/fcrepo/rest/test'",
       "type": "text"
      },
      {
       "text": " was loaded over a secure connection, but contains a form which targets an insecure endpoint '",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost/fcrepo/rest/fcr:tx'"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost/fcrepo/rest/fcr:tx'",
       "type": "text"
      },
      {
       "text": ". This endpoint should be made available over a secure connection.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
