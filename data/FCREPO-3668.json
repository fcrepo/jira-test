  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently, Fedora 6 treats the value of the Slug header as an un-encoded string. However, per the spec, it should be treated as a url encoded value.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fedora.info/2018/11/22/spec/#http-post"
         },
         "type": "link"
        }
       ],
       "text": "https://fedora.info/2018/11/22/spec/#http-post",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://www.w3.org/TR/ldp/#h-ldpc-post-slug"
         },
         "type": "link"
        }
       ],
       "text": "https://www.w3.org/TR/ldp/#h-ldpc-post-slug",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://tools.ietf.org/html/rfc5023#section-9.7"
         },
         "type": "link"
        }
       ],
       "text": "https://tools.ietf.org/html/rfc5023#section-9.7",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "echo \"hello world\" | curl -ufedoraAdmin:fedoraAdmin http://localhost:8080/rest/ -H'Link: <http://www.w3.org/ns/ldp#NonRDFSource>; rel=\"type\"' -H\"Slug: %C3%A4bc3\" --data-binary @- -XPOST -v",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Should create the resource \"äbc3\", but it actually creates the resource \"%C3%A4bc3\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
