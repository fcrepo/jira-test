  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When a client is allowed to perform acl:Append operations on an LDP-NR all DELETE, POST, and PUT requests must be denied.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "An acl:Append operation applies when the acl governing a particular LDPR contains a \"<> acl:mode acl:Append\" triple.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "c.f. ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#append-ldprs"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#append-ldprs",
       "type": "text"
      },
      {
       "text": " : 5.7.3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
