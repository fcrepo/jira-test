     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This is in branch ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-549#icft=FCREPO-549"
          },
          "type": "inlineCard"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note that integration tests only pick up an issue if the server platform encoding is not utf-8, eg use java opt -Dfile.encoding=cp1252",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Also bug ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-569#icft=FCREPO-569"
          },
          "type": "inlineCard"
         },
         {
          "text": " discovered whilst implementing integration tests for this; work-around implemented pending resolution of this.",
          "type": "text"
         }
        ],
        "type": "paragraph"
