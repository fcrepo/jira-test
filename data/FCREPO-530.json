  "description": {
   "content": [
    {
     "content": [
      {
       "text": "SimpleDOWriter is converting between strings and bytes without specifying the character encoding - the platform default is used.  The original encoding is ignored resulting in invalid UTF-8 strings.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See this thread for more info, example code and a potential fix:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://sourceforge.net/mailarchive/forum.php?thread_name=439139C994945E41B9886BE89789549B01C5E07882%40EXNSW-MBX05.nexus.csiro.au&forum_name=fedora-commons-developers"
         },
         "type": "link"
        }
       ],
       "text": "http://sourceforge.net/mailarchive/forum.php?thread_name=439139C994945E41B9886BE89789549B01C5E07882%40EXNSW-MBX05.nexus.csiro.au&forum_name=fedora-commons-developers",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
  "duedate": null,
  "environment": {
   "content": [
    {
     "content": [
      {
       "text": "Particularly where the platform default character encoding is not UTF-8, eg Windows",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
