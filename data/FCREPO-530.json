      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Carsten Friedrich has verified that removing the String xmlContent at line 291 and using out.toByteArray() directly to assign to the datastream object fixes this problem.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
