     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Reproduced on Windows.  JVM argument  -Dfile.encoding can be used to change the platform default encoding, so it should be possible to reproduce this on Linux by, for example, using -Dfile.encoding=cp1252",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
