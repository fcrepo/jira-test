     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "OK, I'm closing this issue, and we can revisit whether we want to keep the Content-Disposition header support or just have clients manage the filename using the binary description.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
