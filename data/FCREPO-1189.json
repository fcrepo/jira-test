  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Hi,",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I can't build fedora-client from src. I have faced the following issue:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Could not transfer artifact org.fcrepo:apache-tomcat:zip:7.0.29 from/to duraspace-thirdparty",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I also cannot find apache-tomcat in \"org.fcrepo\" manually.  Full log is in attachment. ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Please check it.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Thank you.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
