       "48x48": "https://secure.gravatar.com/avatar/d87feaf2f6e1f1c2da5333cfaf22933a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FGP-5.png"
      },
      "displayName": "Gert Schmeltz Pedersen",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a44f9889d5006a6c02ad",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I have consulted with Roel de Cock about this issue. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I explained that the configuration of other analyzers was in fact included in GSearch 2.4, but Roel had not seen it. But that was not enough to resolve this issue.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "We agreed on the following, which Roel will consider and report, whether it resolves the issue.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I just committed with this text:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This commit adds fgsindex.lowercaseExpandedTerms",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "to index.properties for the lucene plugin.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Default is true, but if set to false,",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "then the query processor will not change a query",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "with wildcards to lowercase,",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "which is the problem for queries on UN_TOKENIZED fields.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
