     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As Steve pointed out in the thread, the %0 specifies the optional zone index.  Policies now do matching via wildcard, since the zone index can take several possible forms (not just %0, but %eth0, etc).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
