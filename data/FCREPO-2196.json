  "description": {
   "content": [
    {
     "content": [
      {
       "text": "It is possible to see the list of available options by running the export tool or the import tool with out any required arguments, but it also displays an error message.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Add a -h flag, that is able to display the list of options, without the error message.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
