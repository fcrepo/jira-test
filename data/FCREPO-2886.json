     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The documentation looks good... and works.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "There was a good recommendation in Slack today about:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "> keeping the entry on the inventory page very brief and linking out to the full description on another page",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I would second this suggestion. A potential landing page for the details is here:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FEDORA5x/Best+Practices+-+RDF+Namespaces"
            },
            "type": "link"
           }
          ],
