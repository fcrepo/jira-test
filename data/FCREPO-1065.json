      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Agreed, a \"flush\" parameter (optional) on each RI XACML attribute (query) definition would be appropriate; then users can distinguish between attributes that should immediately reflect current repo state vs ones that can be allowed to \"catch up\" once normal background flushing has occured.  Should be trivial to implement.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
