     "body": {
      "content": [
       {
        "content": [
         {
          "text": "To close this, we need to have a comment in the release notes saying:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "For people who can't upgrade immediately, you can still use the old client jar for 3.6, but probably not for future releases (4.0+)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Here's the new library and how to use it",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
