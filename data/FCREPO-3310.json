         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test_indirect/336ca60e-d771-47c7-bba7-eaaf667556a2",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
