  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This tool will live along side fcrepo-import-export for the initial phase.  It will be a commandline tool that is intended to migrate an export of one version of Fedora  (starting with 4.7.x) to a more recent version so that it can be imported accordingly.  The task here would be to set up the commandline interface with minimum set of parameters and possibly stub out the known transformations including:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "transforming versions",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "transforming webacs",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "removing obsolete triples",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    }
