  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Building fails on Windows if the path contains spaces.  Not tested if this is also the case on Linux.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Building with:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn clean install",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "and",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn install -P fedora-installer",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The actual error shown is:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "30-Oct-2009 09:43:07 org.apache.axis.utils.JavaUtils isAttachmentSupported",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "WARNING: Unable to find required classes (javax.activation.DataHandler and javax",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ".mail.internet.MimeMultipart). Attachment support is disabled.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[INFO] ------------------------------------------------------------------------\n[ERROR] BUILD ERROR",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[INFO] ------------------------------------------------------------------------\n[INFO] Error generating Java code from WSDL.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Embedded error: Error running Axis",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "C:\\work space\\fedora-repository\\resources\\fedora-types.xsd (The system cannot fi",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "nd the file specified)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
