  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create subset of production-like Duke data in development environment.  Test various import-export scenarios; e.g.,",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "export entire repository; wipe repository; import entire repository",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "export single object; delete from repository (including tombstone); import object",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "export subset of objects based on membership predicate; delete from repository (including tombstones); import objects",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
