  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The OracleDDLConverter doesn't automatically create indexes for non-primary-key fields that are defined to require an \"index\" in dbspec.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Currently, this includes the following:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "doFields (on pid)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "dcDates (on pid)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Workaround:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "After first startup, create these indexes manually using Oracle management tools.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
