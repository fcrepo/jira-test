       "48x48": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png"
      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The XACML hierarchical resource profile is used to specify resources within collections.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The path resource-id part of this is currently used, ie ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "/collectionTop/collectionNext/.*  specifies all descendents of collectionNext (when collectionNext is a child of collectionTop).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The hierarchical resource profile also supports ancestor and parent attributes, ie the above would be written",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "ancestor(collectionNext)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "We should allow the second form so that we can specify collection policies without having to specify the full path (or without having to deal with the indexing complexities that would result from the \"path\" form).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
