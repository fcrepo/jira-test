  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently when PUTting new RDF to a NonRdfSourceDescription the subject is stored on the OCFL on disk as the full NonRdfSourceDescription URI. This seems incorrect, so we want to alter RDF coming in to ensure that the subject is actually the binary URI.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ie.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/binary"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/binary",
       "type": "text"
      },
      {
       "text": "> NOT <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/binary/fcr:metadata"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/binary/fcr:metadata",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This work would be in the ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-http-api/src/main/java/org/fcrepo/http/api/services/HttpRdfService.java"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
