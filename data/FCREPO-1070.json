     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Moreover, if you do set application/zip, even if you additionally add ignoreMime=true, because the @Consumes annotation for createObject only specifies XML and FORM, I get an HTTP Status 415 - Unsupported Media Type error.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
