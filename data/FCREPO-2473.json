  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The newest version of the import-export tool has some changes to the configuration file that it creates.  The current version looks something like this: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "mode: export",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "external: true",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "predicates: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#contains"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#contains",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "overwriteTombstones: true",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "resource: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/pcdm"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/pcdm",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "inbound: true",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "dir: /Users/westgard/Desktop/test",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "map: foo,foo/bar",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "binaries: true",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdfLang: text/turtle",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The verification tool needs to act in a logical and appropriate manner on all these options.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
