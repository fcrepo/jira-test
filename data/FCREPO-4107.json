      },
      "displayName": "Rastislav Hudak",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5ec7d5f8b12d2b0c2f92cdf8",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "attrs": {
         "localId": "175e83b34a8f"
        },
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "70121:bc4e5839-97af-495c-9ccd-ae12309a105a",
           "localId": "74836ebc45ae",
           "text": "@David Novák"
          },
          "type": "mention"
         },
         {
          "text": " Yes that’s fair. But if Fedora already accepts On-Behalf-Of and uses it in authorization, it would make sense to also emit a provenance triple for it. Leaving this to clients is duplication and creates inconsistency. Since using fedora:createdBy/fedora:lastModifiedBy would mask the actual account, using another triple would be fine for us too. ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a4c12a753d0071341edb",
           "localId": "ca099780-8e3b-491c-a76d-bd2285bb4fbb",
           "text": "@Jared Whiklo"
          },
          "type": "mention"
         },
         {
          "text": " would that be an alternative?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
