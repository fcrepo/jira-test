     "updated": "2026-09-17T12:54:39.348-0300"
    },
    {
     "author": {
      "accountId": "70121:bc4e5839-97af-495c-9ccd-ae12309a105a",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/f734d7c89d0700e7643b52d316dc0c67?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDN-1.png",
       "24x24": "https://secure.gravatar.com/avatar/f734d7c89d0700e7643b52d316dc0c67?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDN-1.png",
       "32x32": "https://secure.gravatar.com/avatar/f734d7c89d0700e7643b52d316dc0c67?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDN-1.png",
       "48x48": "https://secure.gravatar.com/avatar/f734d7c89d0700e7643b52d316dc0c67?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDN-1.png"
      },
      "displayName": "David Novák",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=70121%3Abc4e5839-97af-495c-9ccd-ae12309a105a",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "attrs": {
         "localId": "75c3f33a8bc0"
        },
        "content": [
         {
          "text": "I am slightly reserved this would be a desired behaviour, as the Fedora should keep the persistent audit log of the actual account driving any write operation. With this change, doors would be opened for silent operations which would never be properly attributed unless digging in the system log.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "localId": "f08bac9ddab7"
        },
        "content": [
         {
          "text": "For example in our running instance, we solve this by storing the original identity in a dcterm:creator property of the metadata record of the container. This does not collide with the native provenance record, but keeps the data as needed.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
