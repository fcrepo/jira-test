  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When creating a version, the returned location contains the JCR UUID of the created version.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a resource",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/book"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/book",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create version of the resource",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPOST -H\"slug: v0\" ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/book/fcr:versions"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/book/fcr:versions",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "BAD: notice the response location: ",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://localhost:8080/rest/book/fcr:versions/87a0a8c317f1e7aa5511ed-a01e-4070-880a-bb3d78a3bbff"
                 },
                 "type": "link"
                }
               ],
               "text": "http://localhost:8080/rest/book/fcr:versions/87a0a8c317f1e7aa5511ed-a01e-4070-880a-bb3d78a3bbff",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          },
          {
           "content": [
            {
             "content": [
              {
               "text": "It should be: ",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://localhost:8080/rest/book/fcr:versions/v0"
                 },
                 "type": "link"
                }
               ],
               "text": "http://localhost:8080/rest/book/fcr:versions/v0",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "---------",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Also, if a child of the resource is created:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/book/page"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/book/page",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "And another version of the resource is created:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPOST -H\"slug: v1\" ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/book/fcr:versions"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/book/fcr:versions",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "And the version is retrieved:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i  ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/book/fcr:versions/v1"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/book/fcr:versions/v1",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "BAD: the child resource has a UUID path such as:",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "ldp:contains <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://localhost:8080/rest/book/fcr:versions/87a0a8c317f1e729ba7b74-3ac9-480a-a5f2-7d4e96c24cfb/page"
                 },
                 "type": "link"
                }
               ],
               "text": "http://localhost:8080/rest/book/fcr:versions/87a0a8c317f1e729ba7b74-3ac9-480a-a5f2-7d4e96c24cfb/page",
               "type": "text"
              },
              {
               "text": "> ",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          },
          {
           "content": [
            {
             "content": [
              {
               "text": "It should be:",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "ldp:contains <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://localhost:8080/rest/book/fcr:versions/v1/page"
                 },
                 "type": "link"
                }
               ],
               "text": "http://localhost:8080/rest/book/fcr:versions/v1/page",
               "type": "text"
              },
              {
               "text": "> .",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    }
   ],
   "type": "doc",
   "version": 1
  },
