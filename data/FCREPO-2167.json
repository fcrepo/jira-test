     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Plan is to link to external copies of the same image files as are stored in the repository, currently served our of the Apache webserver here: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.lib.umd.edu/plantpatents/binaries/"
            },
            "type": "link"
           }
          ],
          "text": "http://www.lib.umd.edu/plantpatents/binaries/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If and when those binaries are not longer being served out of that location, this dataset will be less useful and can be updated or replaced with something else.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
