  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to update the transaction API for committing a transaction to omit the '/commit' suffix on the end of the transaction-URI.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "The rationale for this is to be aligned with the rest of the transaction API:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "refresh transaction: POST tx-URI",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "rollback transaction: DELETE tx-URI",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "status of transaction: GET tx-URI",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
