  "description": {
   "content": [
    {
     "content": [
      {
       "text": "After installing the current version from trunk and switching the datastore in fedora.fcfg to \"localPostrgesqlMPTStore\" running server/bin/fedora-rebuild.sh throws the following NPE.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "It seems org.fcrepo.Server.m_context which is declared as GeneralApplicationContext is null.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Server directory is /home/ruckus/dev/fedora-3.6/server",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "---------------------------------------------------------------------\n",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Error: java.lang.NullPointerException",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "java.lang.NullPointerException",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.server.Server.getBeanNamesForType(Server.java:1659)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.server.utilities.rebuild.Rebuild.getRebuilder(Rebuild.java:277)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.server.utilities.rebuild.Rebuild.main(Rebuild.java:459)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at sun.reflect.NativeMethodAccessorImpl.invoke0(Native Method)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at sun.reflect.NativeMethodAccessorImpl.invoke(NativeMethodAccessorImpl.java:39)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at sun.reflect.DelegatingMethodAccessorImpl.invoke(DelegatingMethodAccessorImpl.java:25)",
       "type": "text"
