  "description": {
   "content": [
    {
     "content": [
      {
       "text": "On Thu, Jul 10, 2008 at 5:37 AM, Antony Corfield [awc] <awc@aber.ac.uk> wrote:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> Hi, I've been running some tests depositing zip files using SWORD. When I hit the server with 50 concurrent threads (unlikely in reality!) I get the following error in the fedora code.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> java.util.ConcurrentModificationException",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">        at java.util.Hashtable$Enumerator.next(Hashtable.java:1031)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">        at fedora.server.management.DefaultManagement.putTempStream(DefaultManagement.java:1395)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">        at fedora.server.management.UploadServlet.saveAndGetId(UploadServlet.java:149)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">        at fedora.server.management.UploadServlet.doPost(UploadServlet.java:99)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> Here's a simple patch (Fedora 3.0b1) for fedora.server.management.UploadServlet that fixes this problem.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> Same problem in Fedora 2.2.1 and other versions I guess.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> Index: C:/Users/awc/eclipse/fedora_release-3.0b1/src/java/fedora/server/management/UploadServlet.java",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> ===================================================================",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> — C:/Users/awc/eclipse/fedora_release-3.0b1/src/java/fedora/server/management/UploadServlet.java      (revision 6592)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> +++ C:/Users/awc/eclipse/fedora_release-3.0b1/src/java/fedora/server/management/UploadServlet.java      (working copy)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> @@ -129,8 +129,10 @@",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">     }",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">     private String saveAndGetId(Context context, FilePart filePart)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> -               throws ServerException, IOException {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> -               return s_management.putTempStream(context, filePart.getInputStream());",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> +               throws ServerException, IOException {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> +       synchronized (s_management) {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> +               return s_management.putTempStream(context, filePart.getInputStream());",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> +       }",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">        }",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
