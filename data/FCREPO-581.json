  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Reported by several people on the list, most recently Alex O'Neill and Paul Pound:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://permalink.gmane.org/gmane.comp.cms.fedora-commons.devel/1450"
         },
         "type": "link"
        }
       ],
       "text": "http://permalink.gmane.org/gmane.comp.cms.fedora-commons.devel/1450",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Christian Rohrer has verified that this can be fixed by adding the following after the similar 127.0.0.1 line in the relevant XACML:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<AttributeValue DataType=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#string"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#string",
       "type": "text"
      },
      {
       "text": "\">::1</AttributeValue>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This should allow local connections to API-M by default, regardless of whether the loopback ip address is specified in the IPv4 way, or the IPv6 way.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
