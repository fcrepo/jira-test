    {
     "author": {
      "accountId": "557058:e0aa7fa8-15bc-416f-a400-bd39f84f4169",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/435786e29ee90ecc4c28d9aa6fe34fa2?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCT-1.png",
       "24x24": "https://secure.gravatar.com/avatar/435786e29ee90ecc4c28d9aa6fe34fa2?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCT-1.png",
       "32x32": "https://secure.gravatar.com/avatar/435786e29ee90ecc4c28d9aa6fe34fa2?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCT-1.png",
       "48x48": "https://secure.gravatar.com/avatar/435786e29ee90ecc4c28d9aa6fe34fa2?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCT-1.png"
      },
      "displayName": "Conal Tuohy",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae0aa7fa8-15bc-416f-a400-bd39f84f4169",
      "timeZone": "Australia/Brisbane"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I have a similar problem installing on Centos 5.5 with Tomcat 6 installed from RPM.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I have the following file system structure:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "[root@prov /]# ll /usr/share/tomcat6",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "total 4",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "drwxr-xr-x 2 root root 4096 May 30 12:49 bin",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "lrwxrwxrwx 1 root root   12 May 30 12:49 conf -> /etc/tomcat6",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "lrwxrwxrwx 1 root root   23 May 30 12:49 lib -> /usr/share/java/tomcat6",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "lrwxrwxrwx 1 root root   16 May 30 12:49 logs -> /var/log/tomcat6",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "lrwxrwxrwx 1 root root   23 May 30 12:49 temp -> /var/cache/tomcat6/temp",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "lrwxrwxrwx 1 root root   24 May 30 12:49 webapps -> /var/lib/tomcat6/webapps",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "lrwxrwxrwx 1 root root   23 May 30 12:49 work -> /var/cache/tomcat6/work",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "What I wonder is, why does the JDBC driver have to be installed as a \"common\" jar? Can't it just be part of the Fedora webapp? ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
