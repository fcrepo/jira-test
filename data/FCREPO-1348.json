  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Foxml 1.1 parsing is complete and a basic framework is in place, but no actual migration handlers have been written.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For this ticket:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1.  incorporate basic handlers that use fcrepo4-client to perform some migration",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2.  discover and incorporate practices used by other community members",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3.  incorporate any feedback",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
