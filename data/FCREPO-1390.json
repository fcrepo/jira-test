  "description": {
   "content": [
    {
     "content": [
      {
       "text": "While accessing the fcrepo web UI over HTTPS, the browser notifies about an insecure form.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The Google Chrome console reports: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The page at '",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://myrepo.edu/fcrepo/rest'"
         },
         "type": "link"
        }
       ],
       "text": "https://myrepo.edu/fcrepo/rest'",
       "type": "text"
      },
      {
       "text": " was loaded over HTTPS, but is submitting data to an insecure location at 'fcr:import': this content should also be submitted over HTTPS.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
  "duedate": null,
  "environment": {
   "content": [
    {
     "content": [
      {
       "text": "Server: Tomcat 7, Apache 2.2, fcrepo 4.1.0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Client: OS X, Google Chrome",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
