  "description": {
   "content": [
    {
     "content": [
      {
       "text": "ACL Linking on Resource creation: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#link-acl-on-create"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#link-acl-on-create",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "A client HTTP POST or PUT request to create a new LDPR MAY include a rel=\"acl\" link in the Link header referencing an existing LDP-RS to use as the ACL for the new LDPR.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
