  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Pulled from ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo-exts/fcrepo-camel-toolbox/issues/192"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "isNumberColumnEnabled": false,
      "layout": "default",
      "localId": "78ff23a0-337e-418f-8268-4ad2ddbe6985"
     },
     "content": [
      {
       "content": [
        {
         "attrs": {},
         "content": [
          {
           "content": [
            {
             "text": "I get this error (MurmurHash3 class not found) while performing triplestore indexing by invoking the command:",
             "type": "text"
            }
           ],
           "type": "paragraph"
          },
          {
           "content": [
            {
             "marks": [
              {
               "type": "code"
              }
             ],
             "text": "curl -XPOST localhost:9080/reindexing -H\"Content-Type: application/json\" -d '[\"broker:queue:triplestore.reindex\"]'",
             "type": "text"
            }
           ],
           "type": "paragraph"
          },
          {
           "content": [
            {
             "text": "Is the dependency on the org.apache.commons.codec.digest package missing?",
             "type": "text"
            }
           ],
           "type": "paragraph"
          },
          {
           "content": [
            {
             "text": "The error only comes up for the following resource which contains blank nodes:",
             "type": "text"
            }
           ],
           "type": "paragraph"
          },
          {
           "content": [
            {
             "text": "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix fedora: <http://fedora.info/definitions/v4/repository#> .\n@prefix ldp: <http://www.w3.org/ns/ldp#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n\n<http://localhost:8080/fcrepo/rest/itinerari-digitali/annotations/2916a139-7e1d-4413-8d65-9178611371aa>\n        <http://www.w3.org/ns/oa#motivatedBy>  <http://www.w3.org/ns/oa#describing> ;\n        <http://www.w3.org/ns/oa#hasBody>  _:b0 ;\n        <http://www.w3.org/ns/oa#hasTarget>  _:b1 ;\n        rdf:type  <http://www.w3.org/ns/oa#Annotation> .\n\n_:b1    <http://www.w3.org/ns/oa#hasSource>  <http://localhost:8080/fcrepo/rest/itinerari-digitali/video/video1> ;\n        <http://www.w3.org/ns/oa#hasSelector>  _:b2 .\n\n_:b2    rdf:type            <http://www.w3.org/ns/oa#FragmentSelector> ;\n        dcterms:conformsTo  <http://www.w3.org/TR/media-frags/> ;\n        rdf:value           \"t=0,6\" .\n\n_:b0    rdf:type   <http://www.w3.org/ns/oa#TextualBody> ;\n        rdf:value  \"Annotazione di prova.\" .\n\n<http://localhost:8080/fcrepo/rest/itinerari-digitali/annotations/2916a139-7e1d-4413-8d65-9178611371aa>\n        fedora:created       \"2023-05-17T15:25:49.924575Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\n        fedora:lastModified  \"2023-05-17T15:25:49.924575Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\n        rdf:type             ldp:BasicContainer ;\n        rdf:type             ldp:Resource ;\n        rdf:type             fedora:Resource ;\n        rdf:type             ldp:RDFSource ;\n        rdf:type             ldp:Container ;\n        rdf:type             fedora:Container .",
             "type": "text"
            }
           ],
           "type": "codeBlock"
          },
          {
           "content": [
            {
             "text": "Is there any way to fix this?",
             "type": "text"
            }
           ],
           "type": "paragraph"
          },
          {
           "content": [
            {
             "text": "Attached the fcrepo-camel-toolbox out.log file.",
             "type": "text"
            }
           ],
           "type": "paragraph"
          }
         ],
