     "body": {
      "content": [
       {
        "content": [
         {
          "text": "abandoned; as per committers meeting discussion in Jan, 2.x backports are now mostly being avoided, except critical security-related issues.  This gives committers more time to improve the main line (currently 3.x).  For people still stuck on 2.x, we will still accept community-submitted patches.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
