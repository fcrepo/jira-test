       "32x32": "https://secure.gravatar.com/avatar/64bf6f26854d620d318d4082f2e6a6a7?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FE-3.png",
       "48x48": "https://secure.gravatar.com/avatar/64bf6f26854d620d318d4082f2e6a6a7?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FE-3.png"
      },
      "displayName": "eddie",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5fca8c79aca10c0069e36e33",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Only outstanding issues I'm seeing are two errors in fcrepo-common:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "fedora.server.access.FedoraAPIABindingSOAPHTTPImpl cannot be resolved to a type\tFedoraAPIABindingSOAPHTTPSkeleton.java\t/fcrepo-common/target/generated-sources/axistools/wsdl2java/fedora/server/access\tline 154",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "fedora.server.management.FedoraAPIMBindingSOAPHTTPImpl cannot be resolved to a type\tFedoraAPIMBindingSOAPHTTPSkeleton.java\t/fcrepo-common/target/generated-sources/axistools/wsdl2java/fedora/server/management\tline 334",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "These are generated sources that require classes in fcrepo-server, but we can't add fcrepo-server as a dependency to fcrepo-common without creating a circular dependency",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
