      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "To do this we might need to provide two versions of activemq.xml with ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-configs/src/main/resources/config/activemq.xml#L134"
            },
            "type": "link"
           }
          ],
          "text": "this line",
          "type": "text"
         },
         {
          "text": " either commented out (disabled) or uncommented (enabled). Then provide a [jetty.xml](",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://github.com/apache/activemq/blob/main/assembly/src/release/conf/jetty.xml"
          },
          "type": "inlineCard"
         },
         {
          "text": "). I’m assuming we just set it up fairly simply with http access and simple basic authentication. Anything more complex and you’d need to provide your own activemq.xml ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
