  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to document Fedora's approach to creating OCFL identifiers as an OCFL extension:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/OCFL/extensions/issues/5"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/OCFL/extensions/issues/5",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Considerations:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Identifier mapping varies depending on whether the Fedora resource is: an archival group, an atomic resource, an archival part, or a derivative resource (/fcr:acl, /fcr:metadata)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "This should focus on what Fedora does, not sideloading (although a sideloading footnote may be appropriate)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
