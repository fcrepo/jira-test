  "description": {
   "content": [
    {
     "content": [
      {
       "text": "vocabulary.txt which lists the available xacml policy attributes still includes attributes related to disseminators which are deprecated in 3.0b1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "urn:fedora:names:fedora:2.1:resource:disseminator:id\t",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#string"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#string",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "urn:fedora:names:fedora:2.1:resource:disseminator:state\t",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#string"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#string",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "urn:fedora:names:fedora:2.1:resource:disseminator:method\t",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#string"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#string",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "urn:fedora:names:fedora:2.1:resource:disseminator:asOfDateTime\t",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "urn:fedora:names:fedora:2.1:resource:disseminator:newState\t",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#string"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#string",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "XACML-related code needs to be reviewed and these attributes either removed or flagged as deprecated since disseminators are no longer a formal construct in 3.0b1.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
