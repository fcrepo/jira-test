  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The modified and created dates for the resource should be searchable via the /fcr:search endpoint.  These fields should support >, >=, <=, and < operators.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "You should be able to search between two modified dates using the following urlencoded conditions:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "/rest/fcr:search?condition=modified%3E2020-01-01&condition=modified%3C2020-07-01",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
