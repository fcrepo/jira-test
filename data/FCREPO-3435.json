   "content": [
    {
     "content": [
      {
       "text": "Since FedoraId contains the memento timestamp instant, also passing in a version instant is often unnecessary. We should remove version instant parameters from method signatures where appropriate, such as:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
