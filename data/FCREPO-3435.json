         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-persistence-api/src/main/java/org/fcrepo/persistence/api/PersistentStorageSession.java#L63",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "And other methods in that class, and other classes",
       "type": "text"
      }
     ],
     "type": "paragraph"
