  "description": {
   "content": [
    {
     "content": [
      {
       "text": "With the javadoc plugin as a standard part of the fcrepo4 build, the output becomes extremely verbose (so much that travis won't display it all on the standard screen). By setting the javadoc configuration as \"quiet\", all non-Error and non-Warning output is suppressed.",
       "type": "text"
      }
     ],
