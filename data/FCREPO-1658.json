     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a4c12a753d0071341edb",
           "text": "@Jared Whiklo"
          },
          "type": "mention"
         },
         {
          "text": ", indeed, fcrepo-camel-webapp does not support (or at least it does not work) making authorized requests. As a result of not wanting to maintain two redundant implementations, we will be moving away from fcrepo-camel-webapp [1] towards the Karaf/OSGi deployment of the Camel machinery.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Thanks for the good catch, however.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "[1] ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://jira.duraspace.org/browse/FCREPO-1691"
            },
            "type": "link"
           }
          ],
          "text": "https://jira.duraspace.org/browse/FCREPO-1691",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
