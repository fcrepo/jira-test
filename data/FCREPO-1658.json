       "16x16": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "24x24": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "32x32": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "48x48": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png"
      },
      "displayName": "Jared Whiklo",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4c12a753d0071341edb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This might be expected behaviour but I haven't play with fcrepo-webapp-plus much.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "In install_scripts/config, setting",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "audit=true",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "auth=true",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "you can only access the instance with the admin user ID, nothing is indexed to Solr and only audit events end up in Fuseki.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Log shows some errors",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "ERROR 01:47:57.544 (default) Could not dispatch event: org.fcrepo.audit.InternalAuditor@5facde23 to public void \r\norg.fcrepo.audit.InternalAuditor.recordEvent(org.fcrepo.kernel.api.observer.FedoraEvent) throws \r\norg.fcrepo.kernel.api.exception.RepositoryRuntimeException",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "Probably not related to this ticket, but thought I would point it out before merging.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
