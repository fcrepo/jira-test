       "24x24": "https://secure.gravatar.com/avatar/3707b443358c8c223f9eec7a7d29ba88?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-4.png",
       "32x32": "https://secure.gravatar.com/avatar/3707b443358c8c223f9eec7a7d29ba88?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-4.png",
       "48x48": "https://secure.gravatar.com/avatar/3707b443358c8c223f9eec7a7d29ba88?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-4.png"
      },
      "displayName": "Danny Bernstein",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785e2552404d0070bf1d34",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "To test:  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "start repo : java -Dfcrepo.dynamic.jms.port=61717 -Dfcrepo.dynamic.stomp.port=61713 -jar fcrepo-webapp-4.8.0-SNAPSHOT-jetty-console-a07a1a46.jar --port 8686 --headless --contextPath /f4",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Add an external object:  curl -X PUT -H\"Content-Type: message/external-body; access-type=URL; URL=\\\"",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "https://static01.nyt.com/images/2017/06/11/us/11West-Obit/11West-Obit-master768.jpg"
                },
                "type": "link"
               }
              ],
              "text": "https://static01.nyt.com/images/2017/06/11/us/11West-Obit/11West-Obit-master768.jpg\\",
              "type": "text"
             },
             {
              "text": "\"\" \"",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://localhost:8686/f4/rest/batman"
                },
                "type": "link"
               }
              ],
              "text": "http://localhost:8686/f4/rest/batman",
              "type": "text"
             },
             {
              "text": "\"",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "export java -jar fcrepo-import-export-0.1.1-SNAPSHOT.jar -d export -a -m export -r ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://localhost:8686/f4/rest"
                },
                "type": "link"
               }
              ],
              "text": "http://localhost:8686/f4/rest",
              "type": "text"
             },
             {
              "text": " -b --writeConfig export-config.yml -x",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "verify: fcrepo-verify /Users/danny/code/fcrepo-import-export/target/export-config.yml ",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "orderedList"
       }
      ],
      "type": "doc",
      "version": 1
     },
