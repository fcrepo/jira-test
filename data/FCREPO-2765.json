  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As a follow-on to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strike"
        }
       ],
       "text": "FCREPO-2745",
       "type": "text"
      },
      {
       "text": ". The stable ACL Link header appears for all FedoraResources.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "But for versioning the ACL on the TimeMap should be used for permissions on all Mementos.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Currently the link header does not appear when viewing the TimeMap, it should exist.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Currently the link header does appear when viewing a Memento; it should not or should reference the TimeMap acl.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
