  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to resolve the issue of the LinkHeaderProvider throwing a 404 in the context of a batch operation. ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "The issue was introduced with:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-1795"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-1795",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "..and commit:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo-module-auth-webac/commit/6d7f196f1146378a171d81a44a8cb0454e068be8#diff-d0dbcb31e45df8a047776645dcc10cfbR73"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo-module-auth-webac/commit/6d7f196f1146378a171d81a44a8cb0454e068be8#diff-d0dbcb31e45df8a047776645dcc10cfbR73",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Build and deploy fcrepo-webapp-plus with webac and optionally audit configured",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Start a transaction in the HTML UI",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a container... BOOM!",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
