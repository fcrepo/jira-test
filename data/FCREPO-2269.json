       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a55c52a3d400690692f7/7a62c587-b0f1-4cd4-982c-21b3837dc64a/32",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a55c52a3d400690692f7/7a62c587-b0f1-4cd4-982c-21b3837dc64a/48"
      },
      "displayName": "Ralf Claussnitzer",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a55c52a3d400690692f7",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The description says: ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "text": "Once the kernel-api no longer has a direct dependency on JCR,",
            "type": "text"
           }
          ],
          "type": "paragraph"
         }
        ],
        "type": "blockquote"
       },
       {
        "content": [
         {
          "text": "Is this already the case? If not, I think there should be a blocker ticket associated to track this effort. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
