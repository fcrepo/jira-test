      },
      "displayName": "Jared Whiklo",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4c12a753d0071341edb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As of ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo-exts/migration-utils/commit/25cdf92975afc8b7dda740fb1d4ffbc8df16a226"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo-exts/migration-utils/commit/25cdf92975afc8b7dda740fb1d4ffbc8df16a226",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I can get to 150 levels deep.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "text": "r = ",
            "type": "text"
           },
           {
            "marks": [
             {
              "attrs": {
               "href": "http://localhost:"
              },
              "type": "link"
             }
            ],
            "text": "http://localhost:",
            "type": "text"
           }
          ],
          "type": "paragraph"
         }
        ],
        "type": "blockquote"
       },
       {
        "content": [
         {
          "text": "Before I get a 500 Server Error because ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "text": "Value too long for column \"FEDORA_ID VARCHAR(503)",
            "type": "text"
           }
          ],
          "type": "paragraph"
         }
        ],
        "type": "blockquote"
       },
       {
        "content": [
         {
          "text": "That is a problem (one I think we have discussed with having a single table to hold the Fedora IDs and have all other tables reference it and use a shorter hash internally), but its not this problem.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
