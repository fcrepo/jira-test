  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be observed by running the following script:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "#!/usr/bin/bash",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "x=0; ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "r=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/",
       "type": "text"
      },
      {
       "text": "\"; ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "while true; ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "do x=$(($x + 1));",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "r=`curl -s -H\"Slug: $x\" -XPOST $r`; ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "echo \"r = $r\"; ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "done ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We will likely want to catch PersistentStorageExceptions and send an appropriate response code to the client... instead of a stacktrace.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
