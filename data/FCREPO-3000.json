  "customfield_10052": null,
  "customfield_10053": null,
  "customfield_10054": null,
  "customfield_10087": null,
  "customfield_10121": null,
  "customfield_10154": null,
  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "It appears that the inheritance algorithm is not working correctly with acl:default  when the authorization has an acl:default predicate that references a child resource of the acls owner.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To illustrate: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Create the following resources:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X PUT -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/box -i\r\ncurl -X PUT -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/box/cookies -i\r\ncurl -X PUT -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/box/cookies/cookie -i",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "PUT the following acl to  ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/box/fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/box/fcr:acl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "@prefix acl: <http://www.w3.org/ns/auth/acl#> .\r\n<#authorization1> a acl:Authorization;\r\n acl:accessTo </rest/box/cookies>;\r\n acl:default </rest/box/cookies>;\r\n acl:mode acl:Read;\r\n acl:agent \"testuser\".",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Using the following command:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X PUT -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/box/fcr:acl -H \"Content-Type: text/turtle\" -d \"@acl.ttl\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Then:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "# GET box produces 403 as expected\r\ncurl -u testuser:testpass http://localhost:8080/rest/box -i\r\n\r\n# GET cookies produces 200 as expected\r\ncurl -u testuser:testpass http://localhost:8080/rest/box/cookies -i\r\n\r\n# GET cookie produces 403 when it should return a 200 \r\ncurl -u testuser:testpass http://localhost:8080/rest/box/cookies/cookie -i",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
