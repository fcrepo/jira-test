  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If you pass RDF with a Content-type header including a charset, it fails to match as RDF and so creates a NonRDFSource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This does not happen if you include the explicit Link header for a Container type.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
