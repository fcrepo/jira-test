      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "One more candidate: Apache Clerezza. It's also in incubation, but should come out fairly soon, and the API is really nice:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://incubator.apache.org/clerezza/mvn-site/rdf.core/apidocs/index.html"
            },
            "type": "link"
           }
          ],
          "text": "https://incubator.apache.org/clerezza/mvn-site/rdf.core/apidocs/index.html",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Lightweight but functional, and it was recently defined so it uses modern techniques. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
