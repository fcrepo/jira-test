     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The reason for this discrepancy has been documented in the WSDL section of the documentation at the following URLs:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://fedora-commons.org/confluence/display/FCR30/API-M#API-M-WSDL"
            },
            "type": "link"
           }
          ],
          "text": "https://fedora-commons.org/confluence/display/FCR30/API-M#API-M-WSDL",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://fedora-commons.org/confluence/display/FCR30/API-A#API-A-WSDL"
            },
            "type": "link"
           }
          ],
          "text": "https://fedora-commons.org/confluence/display/FCR30/API-A#API-A-WSDL",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The correct URL to use for on-line WSDL is the /fedora/wsdl?api=API-A or API-M one.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
