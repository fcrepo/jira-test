  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently Fedora allows any user with the fedoraUser role to start a transaction and after ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3827"
       },
       "type": "inlineCard"
      },
      {
       "text": " they will be able to commit/rollback any transaction.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This work is to alter the root ACL to allow a separate set of permissions for the /fcr:tx ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
