  "description": {
   "content": [
    {
     "content": [
      {
       "text": "GET on test/fcr:metadata/fcr:acl on a binary resource fails with a 400.  So does test/fcr:versions/fcr:acl return 400.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "These endpoints should return 404 since they do not exist. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "#To reproduce: \r\n#Create a binary resource:\r\ncurl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/test -X PUT  -H \"Content-Type:text/plain\" -d \"test\"\r\n#Get the metadata: \r\ncurl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/test/fcr:metadata -i\r\n#See the \"acl\" link? No try to get it and verify the 400\r\ncurl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/test/fcr:metadata/fcr:acl -i  \r\n#Same with versions endpoint:\r\ncurl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/test/fcr:versions/fcr:acl -i      \r\ncurl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/test/fcr:metadata/fcr:versions/fcr:acl -i   \r\n#Same is true for container/fcr:versions/fcr:acl\r\n#Same is true for PUTs on the above acl resources.",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
