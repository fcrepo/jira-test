  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is a follow-on to:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-1703"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-1703",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When versioning containers, the UUID of the version shows up in the HTML UI display. To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a container",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPUT localhost:8080/rest/book",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Version the container",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPOST -H\"slug: v0\" localhost:8080/rest/book/fcr:versions",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "View the version in the HTML UI",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "...boom, see UUID in breadcrumb and resource title",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
