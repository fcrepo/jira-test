      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:cc6016b1-6dae-4b52-922c-9076d2e8b96d",
           "text": "@Yinlin Chen"
          },
          "type": "mention"
         },
         {
          "text": ", thank you for taking the initiative to work this ticket. I should have been more clear in the title and description.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Instead of masking the issue in the HTML UI .vsl files, the ideal solution would be to use the version labels instead of the internal UUIDs deeper in the code.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "For example, a GET request following the steps detailed in the description above returns RDF with the version UUID included – we do not want this.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I suspect the full solution will share similarities with:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/commit/6b291ea1cf62712829d3bf7d21fd16ce47675f8e"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/commit/6b291ea1cf62712829d3bf7d21fd16ce47675f8e",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Thoughts, ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a45f9889d5006a6c0384",
           "text": "@Michael Durbin"
          },
          "type": "mention"
         },
         {
          "text": "?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
