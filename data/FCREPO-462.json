  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The DC datastream that is shown with uri's like ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://blabla/get/changeme:001/DC"
         },
         "type": "link"
        }
       ],
       "text": "http://blabla/get/changeme:001/DC",
       "type": "text"
      },
      {
       "text": " uses the wrong namespace. It should be ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/",
       "type": "text"
      },
      {
       "text": " (with trailing slash) instead of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1",
       "type": "text"
      },
      {
       "text": " (without slash).",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Fortunately, the object xml itself and uri's in the RI index are correct.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
