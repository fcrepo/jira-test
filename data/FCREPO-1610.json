  "description": {
   "content": [
    {
     "content": [
      {
       "text": "There is a certain amount of repeated XML in Maven configurations for projects inheriting from org.fcrepo:fcrepo. These projects include:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "⁃\tfcrepo-build-tools",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo4",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-message-consumer",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-module-auth-rbacl",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-module-auth-xacml",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-camel",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tontology",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo4-client",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-audit",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-camel-toolbox",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo-webapp-plus",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo4-release-tests",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo4-oaiprovider",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tfcrepo4-swordserver",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "⁃\tmigration-utils",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This ticket is to find all such redundancies, and move that config up into the pom in org.fcrepo:fcrepo.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
