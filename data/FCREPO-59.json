       {
        "content": [
         {
          "text": "Lynette reported the following typos against the 2.0 version of tutorial2.pdf. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "The page references may be off a bit, but I verified that at least the first two",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "typos still exist in the 2.1 version.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "() - add text",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "[] - remove text",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "P18  3.  ... Also, the",
          "type": "text"
