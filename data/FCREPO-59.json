          },
          "type": "emoji"
         },
         {
          "text": " can ...",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "P22  first bullet   ... provides an[d] implementation ...",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "P22  7.1.2 para 1 ... the new digital (object) with ...",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "P30  para 1 line 3   ... select the [greyscale] (resize) method ...",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "P31  para 1 line 5  ... (h)as at least one ...",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "P35  7.3.4 line 1-2   ... object that [be] (is) the basis of ...",
