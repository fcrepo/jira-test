  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The attached policy basically allows access to apia methods to user \"public\" in group \"public\", but only if",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "the request does not specify a datastream ID; or",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "the request specifies a datastream ID in the \"permitted\" list (which is only DC in the example)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "When doing a listDatastreams, logging in as public, there is an NPE caused by the post-method results filtering.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "java.lang.NullPointerException",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.fcrepo.server.security.xacml.pep.rest.objectshandlers.ListDatastreams.filterHTML(ListDatastreams.java:294)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.fcrepo.server.security.xacml.pep.rest.objectshandlers.ListDatastreams.handleResponse(ListDatastreams.java:203)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.fcrepo.server.security.xacml.pep.rest.filters.ObjectsFilter.handleResponse(ObjectsFilter.java:111)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.fcrepo.server.security.xacml.pep.rest.PEP.doFilter(PEP.java:172)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.security.web.FilterChainProxy$VirtualFilterChain.doFilter(FilterChainProxy.java:380)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.fcrepo.server.security.jaas.AuthFilterJAAS.doFilter(AuthFilterJAAS.java:305)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.security.web.FilterChainProxy$VirtualFilterChain.doFilter(FilterChainProxy.java:380)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.security.web.access.channel.ChannelProcessingFilter.doFilter(ChannelProcessingFilter.java:109)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.security.web.FilterChainProxy$VirtualFilterChain.doFilter(FilterChainProxy.java:380)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.security.web.FilterChainProxy.doFilter(FilterChainProxy.java:169)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.web.filter.DelegatingFilterProxy.invokeDelegate(DelegatingFilterProxy.java:237)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.springframework.web.filter.DelegatingFilterProxy.doFilter(DelegatingFilterProxy.java:167)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
