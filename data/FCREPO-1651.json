  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to update the fcrepo-webapp-plus/xacml configuration such that:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "xacml/webapp/WEB-INF/classes/config/repository.json",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Uses the \"default\" workspace instead of \"fedora\"",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "xacml/webapp/WEB-INF/classes/spring",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "These configurations are in line with the \"audit\" example",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          },
          {
           "content": [
            {
             "content": [
              {
               "text": "For example, when running xacml.war along side the fcrepo-camel-toolbox, camel is unable to connect to the JMS topics",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
