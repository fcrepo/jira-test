      "content": [
       {
        "content": [
         {
          "text": "The duplicate events were being generated because one event was for the file node being added, and the second was for the content property being added.  I've updated the filter that combines events to combine these into single event:",
          "type": "text"
         }
        ],
        "type": "paragraph"
