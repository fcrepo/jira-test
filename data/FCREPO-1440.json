     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've updated ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/763"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/763",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It still uses node path munging to identify events about the same node and collapse them, but it now uses the (superior) logic in FedoraEvent instead of a regex.  I've also included an IT demonstrating that only a single event is emitted when a content node is added.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
