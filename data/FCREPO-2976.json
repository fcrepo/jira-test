  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently the following optional functionality is not supported:  ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#state-tokens"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#state-tokens",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "level": 4
     },
     "content": [
      {
       "text": "From the Spec: ",
       "type": "text"
      }
     ],
     "type": "heading"
    },
    {
     "attrs": {
      "level": 4
     },
     "content": [
      {
       "text": "3.10.1 X-State-Token ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#x-state-token"
         },
         "type": "link"
        }
       ],
       "text": "§",
       "type": "text"
      }
     ],
     "type": "heading"
    },
    {
     "content": [
      {
       "text": "Implementations _may_ include the {{X-State-Token}} header field in {{GET}} and {{HEAD}} responses to provide a token representing the current state of resource. If provided, this value _must_ change whenever the underlying state of the resource has changed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
