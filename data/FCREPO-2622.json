  "description": {
   "content": [
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#general-3"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#general-3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Requests to an LDPCv/TimeMap for a LDPRv must support a \"application/link-format\" response type, as shown in the example ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://tools.ietf.org/html/rfc7089#page-37"
         },
         "type": "link"
        }
       ],
       "text": "https://tools.ietf.org/html/rfc7089#page-37",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "This response type is NOT required to include all statements in the LDPCv's graph, only those that are required by the link-format, outlined in ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://tools.ietf.org/html/rfc7089#page-36"
             },
             "type": "link"
            }
           ],
           "text": "https://tools.ietf.org/html/rfc7089#page-36",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Including: URI of LDPRv for this timemap, all LDPRms in this LDPCv with their memento date times, timegate link, link to the LDPCv",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
