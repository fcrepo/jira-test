  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create a separate project, fc-authn, to house the current AuthN servlet filters so they can be easily re-used by other projects.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This new project should have it's own build.xml, and fedora/trunk should be updated to use it as a dependency.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
