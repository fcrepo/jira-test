  "description": {
   "content": [
    {
     "content": [
      {
       "text": "For some reason we used the property ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "fcrepo.metrics.enable",
       "type": "text"
      },
      {
       "text": " while all the other properties to enable some function end with ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "enabled",
       "type": "text"
      },
      {
       "text": ". We should make this ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "fcrepo.metrics.enabled",
       "type": "text"
      },
      {
       "text": " to be consistent.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
