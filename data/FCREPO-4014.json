     "content": [
      {
       "text": "The ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://hub.docker.com/_/openjdk"
         },
         "type": "link"
        }
       ],
       "text": "openjdk image",
       "type": "text"
      },
      {
       "text": " (currently ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "openjdk:9-jdk11-slim",
       "type": "text"
      },
      {
       "text": " is used) has been deprecated and the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://hub.docker.com/_/maven"
         },
         "type": "link"
        }
       ],
       "text": "maven image",
       "type": "text"
      },
      {
       "text": " (currently ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "maven:3-openjdk-11-slim",
       "type": "text"
      },
      {
       "text": " is used) has switched to Eclipse Temurin by default now.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
