  "description": {
   "content": [
    {
     "content": [
      {
       "text": "listDatastreams request (format=xml) returns a response that does not validate. For example, ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/objects/fedora-system:ContentModel-3.0/datastreams?format=xml"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/objects/fedora-system:ContentModel-3.0/datastreams?format=xml",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "returns a response that is missing the default namespace declaration, and the schemaLocation has an invalid location (at least via REST API)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
