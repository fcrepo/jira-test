     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:c29953be-a155-407e-b409-91cc485b98eb",
           "text": "@ben_cail"
          },
          "type": "mention"
         },
         {
          "text": ", the way that the migration-utils application determines which datastreams should be in a given \"version\" is by using timestamps. All datastream versions that share the same timestamp belong to the same \"version\".",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "See:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-exts/migration-utils/blob/master/src/main/java/org/fcrepo/migration/handlers/VersionAbstractionFedoraObjectHandler.java#L80"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-exts/migration-utils/blob/master/src/main/java/org/fcrepo/migration/handlers/VersionAbstractionFedoraObjectHandler.java#L80",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "and:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-exts/migration-utils/blob/master/src/main/java/org/fcrepo/migration/handlers/VersionAbstractionFedoraObjectHandler.java#L117-L124"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-exts/migration-utils/blob/master/src/main/java/org/fcrepo/migration/handlers/VersionAbstractionFedoraObjectHandler.java#L117-L124",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If you believe Fedora \"versions\" should be constructed by a different means than creation-date, maybe we should make a change.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The Brown U object listed in this ticket: ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://gist.github.com/awoods/760ee7cbd3f84b56ba517f44aea3116d"
            },
            "type": "link"
           }
          ],
          "text": "https://gist.github.com/awoods/760ee7cbd3f84b56ba517f44aea3116d",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
