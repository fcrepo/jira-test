     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The command given by Andrew was used:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "for x in {0..50000}; do echo \"number $x\"; echo \"\"; curl -i -XPOST -H\"Content-Type: text/turtle\" --data-binary @body.rdf localhost:8080/fcrepo/rest; done",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
