  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Doing a search that uses an invalid field as a condition results in a 500 Server Error, should probably be a 400 Bad Request.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "From the Fedora logs",
       "type": "text"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INFO 11:57:14.231 [qtp722306493-28] (FedoraSearch) GET on search with conditions: [fedora_id=*",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "em"
        }
       ],
       "text": ", ",
       "type": "text"
      },
      {
       "text": "myField=*], and fields: null",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "WARN 11:57:14.232 [qtp722306493-28] (WildcardExceptionMapper) Unmapped exception",
