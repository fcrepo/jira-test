       "48x48": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png"
      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I discovered this inconsistency while implementing FCREPO-523:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Although the current REST API documentation (as of Fedora 3.2.1) states that adding is done through POST and modifying is done through PUT (and this is true), it omits the fact that modifying a datastream is also possible via POST. This fact needs to be documented.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
