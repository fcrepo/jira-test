  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If your authentication principal does not have at least one of fedoraUser or fedoraAdmin roles the system tries to add an empty set of roles and Shiro explodes.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Need a check for empty around this line.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/fcrepo-5.0.0-RC-2/fcrepo-auth-common/src/main/java/org/fcrepo/auth/common/ServletContainerAuthenticatingRealm.java#L51"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/blob/fcrepo-5.0.0-RC-2/fcrepo-auth-common/src/main/java/org/fcrepo/auth/common/ServletContainerAuthenticatingRealm.java#L51",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
