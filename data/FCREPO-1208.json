     "body": {
      "content": [
       {
        "content": [
         {
          "text": "We ran into this as well. On startup, the fedora log shows:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "CREATE INDEX fcrepoRebuildStatus_rebuildDate ON fcrepoRebuildStatus (rebuildDate);",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "ERROR 2014-04-10 10:57:05.824 [pool-2-thread-1] (Server) Module (org.fcrepo.server.storage.DOManager) failed to initialize",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "org.fcrepo.server.errors.ModuleInitializationException: Error while attempting to check for and create non-existing table(s): java.sql.SQLSyntaxErrorException: ORA-00902: invalid datatype",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It looks like bigint is also an invalid datatype in Oracle. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
