  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As reported by Arnaud Koster from ARHS:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-----------------------------------------------------\nBTW: It seems that Fedora 3.7.1 is not compatible with Oracle database. In fact, we faced a problem during the startup:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Fedora tries to execute this script:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "CREATE TABLE fcrepoRebuildStatus (",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rebuildDate NUMBER(20,0) NOT NULL,",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "complete boolean NOT NULL,",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "UNIQUE  (rebuildDate)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ");",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
