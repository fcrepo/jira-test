     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I traced this to the following file:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-server/src/main/resources/dbspec/server/org/fcrepo/server/storage/resources/DefaultDOManager.dbspec#L147"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-server/src/main/resources/dbspec/server/org/fcrepo/server/storage/resources/DefaultDOManager.dbspec#L147",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "it seems this is not compatible with Oracle since there is no boolean datatype",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "And the commit from Oct. 2013:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo/fcrepo/commit/97b79b9f1379d8c34c4225e02adde7aa25d46f10"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo/fcrepo/commit/97b79b9f1379d8c34c4225e02adde7aa25d46f10",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
