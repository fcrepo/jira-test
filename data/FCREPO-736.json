  "description": {
   "content": [
    {
     "content": [
      {
       "text": "FeSL AuthN is the default for 3.4 (see ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-671#icft=FCREPO-671"
       },
       "type": "inlineCard"
      },
      {
       "text": ") but this results in some integration test failures:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Eg ConfigA",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Failed tests:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testFindObjects(org.fcrepo.test.api.TestRESTAPI)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testResumeFindObjects(org.fcrepo.test.api.TestRESTAPI)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testFindObjectsBadSyntax(org.fcrepo.test.api.TestRESTAPI)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testUpload(org.fcrepo.test.api.TestRESTAPI)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Failed tests:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testXACMLAPIMAccess(org.fcrepo.test.api.TestXACMLPolicies)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Tests in error:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testXACMLMultiOwnerAccess(org.fcrepo.test.api.TestXACMLPolicies)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testXACMLUnmodifiableContentModel(org.fcrepo.test.api.TestXACMLPolicies)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Not investigated the reason for these - could be issues with the tests rather than fesl AuthN?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
