  "description": {
   "content": [
    {
     "content": [
      {
       "text": "In a similar fashion to the setup detailed in: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2188"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2188",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "...this ticket is to address the situation where resource properties are lost:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "After /fcr:restore of the plantpatents dataset, open a tab with the following resource:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/62/44/53/d5/624453d5-e62a-43ff-b934-a04ab36acc75"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/62/44/53/d5/624453d5-e62a-43ff-b934-a04ab36acc75",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Then go through the export/import cycle, and open a different tab with that same resource:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/62/44/53/d5/624453d5-e62a-43ff-b934-a04ab36acc75"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/62/44/53/d5/624453d5-e62a-43ff-b934-a04ab36acc75",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "! Notice the difference... no properties!",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
