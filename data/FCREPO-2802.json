  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This ticket is only valid once this PR is in: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/pull/1357"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/pull/1357",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The goal is to take the call to setContentSize() out of getContentSize() in UrlBinary.java and LocalBinary.java in fcrepo-kernel-modeshape module. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The setContentSize() call should probably be called in setExternalContent().  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
