  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If fcrepo is built on WIndows using \"mvn clean install\", the fcrepo-webapp-version-jettty-console.jar creates a stack trace and freezes (the console window is not launched).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://gist.github.com/osmandin/67584539e42957cea683"
         },
         "type": "link"
        }
       ],
       "text": "https://gist.github.com/osmandin/67584539e42957cea683",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When built on mac or linux, the jar runs fine on windows.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Refer to IRC discussion on 3/25.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
