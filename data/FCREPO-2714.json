  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to remove the duplicate headers found when performing a GET request on binary resources.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a binary resource (",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/image)"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/image)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -i localhost:8080/rest/image -o image.out",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Inspect image.out for duplicated headers:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
