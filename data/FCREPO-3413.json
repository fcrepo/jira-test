  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen when trying to perform a PATCH request that includes the use of a RDF prefix that is undefined. The bug is that the body of the HTTP response to the client is an internal stacktrace. The fix should catch the exception, include a simple error message (e.g. \"RDF was not parsable: [line: 1, col: 4 ] Unrecognized keyword: unknown\"), and a 400 response code.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. Create a resource",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$ curl -i -XPUT -H\"Content-Type: text/turtle\" -H'Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#BasicContainer"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#BasicContainer",
       "type": "text"
      },
      {
       "text": ">;rel=\"type\"' --data-binary @body.ttl localhost:8080/rest/test0",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Where @body.ttl is:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "<> <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://test.com/#title"
             },
             "type": "link"
            }
           ],
           "text": "http://test.com#title",
           "type": "text"
          },
          {
           "text": "> \"A Title\"",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "2. Verify the new resource includes the triple found in body.ttl",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$ curl -i localhost:8080/rest/test0",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "3. Perform PATCH",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$   512  curl -i -XPATCH -H\"Content-Type: application/sparql-update\" --data-binary @update.su localhost:8080/rest/test0",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Where @update.su is:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "DELETE {",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "   <> unknown:title \"A Title\";",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "}",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "INSERT {",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "   <> unknown:title \"new title\";",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "}",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "WHERE {",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "}",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
