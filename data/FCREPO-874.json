  "description": {
   "content": [
    {
     "content": [
      {
       "text": "1. have a previous 3.3.1 installation in /usr/local/fedora-3.3.1",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "have /usr/local/fedora-3.4.2 directory created",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "have /usr/local/fedora -> fedora-3.4.2",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "have $FEDORA_HOME set to /usr/local/fedora",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2. follow instructions \"Upgrading from 3.x to 3.4.2\" on ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FCR30/Upgrading+from+3.x:"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FCR30/Upgrading+from+3.x:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(2.a) modify /usr/local/fedora-3.4.2/server/config/fedora.fcfg (fedora_db = DB for 3.3.1 instance):",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<param name=\"jdbcURL\" value=\"jdbc:mysql://localhost/fedora_db?useUnicode=true&amp;amp;characterEncoding=UTF-8&amp;amp;autoReconnect=true\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(2.b) modify /usr/local/fedora-3.4.2/server/config/fedora.fcfg:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<module role=\"org.fcrepo.server.storage.lowlevel.ILowlevelStorage\" class=\"org.fcrepo.server.storage.lowlevel.DefaultLowlevelStorageModule\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<param name=\"object_store_base\" value=\"../fedora-3.3.1/data/objects\" isFilePath=\"true\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<param name=\"datastream_store_base\" value=\"../fedora-3.3.1/data/datastreams\" isFilePath=\"true\">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "3. starting the new repository fails:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "org.fcrepo.server.errors.ServerInitializationException: Failed to ingest system object(s)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Caused by: org.fcrepo.server.errors.LowlevelStorageException: file /usr/local/fedora-3.4.2/data/objects/2010/1005/15/54/fedora-system_ContentModel-3.0doesn't exist for reading",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "COMMENTS:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "using full-paths doesn't work either (value=\"/usr/local/fedora-3.3.1/data/objects\")",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "possible solution: rebuild MySQL (and Resource Index ?) using fedora-rebuild.sh",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
