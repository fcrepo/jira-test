  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Container acl:Append prohibits \"DELETE {} INSERT { ... }\" but allows \"DELETE DATA { ... }\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "That is, it disallows a DELETE/INSERT statement with an empty DELETE clause, but does allow a DELETE DATA statement with a non-empty clause.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This behavior should be reversed to allow DELETE/INSERT when the DELETE clause is empty, and prohibit DELETE DATA statements entirely.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
