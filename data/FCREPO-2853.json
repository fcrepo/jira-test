  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If you put up an authorization without an acl:accessTo or acl:accessToClass defined then the authorization is completely useless.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Because we are adding the ACLs to the resource it would be beneficial to assume the current resource if none is specified.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "So a ACL submitted to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test_resource/fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test_resource/fcr:acl",
       "type": "text"
      },
      {
       "text": " of",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "<> a webac:Acl .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "<#authorization1> a acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "   acl:mode acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "   acl:agent \"testuser\" .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Would be parsed and stored as if it was",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "</rest/test_resource/fcr:acl> a webac:Acl .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "</rest/test_resource/fcr:acl#authorization1> a acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "   acl:mode acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "   acl:agent \"testuser\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "   acl:accessTo </rest/test_resource> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
