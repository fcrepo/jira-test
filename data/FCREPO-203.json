      "displayName": "Bill Branan",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5d83b5f927bbf40c2c32ceeb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "There are various reasons why all users do not necessarily want all datastreams which include RDF to be indexed by default. One of these reasons is that these datastreams are often indexed in external triplestores with configuration specific to the expected relationship types. While code could be added to include arbitrary RDF datastreams in the default Fedora triplestore index, this cannot be assumed as a default policy.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
