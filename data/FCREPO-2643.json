      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This is not going to work and instead I am changing this to creating a Memento \"type/mixin\" for Fedora. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This will be added to an Memento generated in Fedora.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This will be used on the WebAC side to ensure that checks for Authorization on Mementos start at the parent container level (and not on the actual Memento, which could still have the old ACL)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
