      "displayName": "A. Soroka",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A24c578cc-15e9-4649-9f68-5eace85735e0",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This is incorrect design. The properties in question are properties of the bitstream, not the description, and should be persisted as close to the bitstream as possible. See ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://jira.duraspace.org/browse/FCREPO-1635"
            },
            "type": "link"
           }
          ],
          "text": "https://jira.duraspace.org/browse/FCREPO-1635",
          "type": "text"
         },
         {
          "text": " for the correct design.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
