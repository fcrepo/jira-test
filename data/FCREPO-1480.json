        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Would need to create a new release in fcrepo-webapp-plus with:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "fcrepo-webapp-plus-rbacl-audit-FEDORA_VERSION.war",
          "type": "text"
         },
         {
