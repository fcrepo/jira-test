     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Here is a very simple implementation that allows the userto run the jar file with a provided Spring XML:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/migration-utils/pull/19"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/migration-utils/pull/19",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "We could also abstract the XML into a properties file, but that would introduce a new class for translating the properties into the appropriate classes. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
