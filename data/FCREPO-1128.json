  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Third-party dependencies in 3.6 ballooned, largely because of the move to CXF and the update to ActiveMQ 5.6.0.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This is an umbrella ticket to cover specific tasks to reduce our library footprint",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
