  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to align the logging functionality with the documentation:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FEDORA4x/Configuring+Logging+With+System+Properties"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FEDORA4x/Configuring+Logging+With+System+Properties",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This ticket is complete when:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1. The default logging level is INFO",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. All logging can be changed by providing a value for the system property: -Dorg.fcrepo",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. Specific package loggers can be changed independently of 1 or 2 above.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Starting Fedora with the following logging settings should work as expected:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> mvn jetty:run -pl fcrepo-webapp/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "log all packages at INFO",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "> mvn -Dfcrepo.log=DEBUG jetty:run -pl fcrepo-webapp/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "log all packages at DEBUG",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "> mvn -Dfcrepo.log=DEBUG -Dfcrepo.log.jms=INFO jetty:run -pl fcrepo-webapp/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "log all packages at DEBUG, except fcrepo.jms at INFO",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "> mvn -Dfcrepo.log=DEBUG -Dfcrepo.log.jms=INFO -Dfcrepo.log.kernel=INFO jetty:run -pl fcrepo-webapp/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "log all packages at DEBUG, except fcrepo.jms and fcrepo.kernel at INFO",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
