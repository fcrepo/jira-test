  "description": {
   "content": [
    {
     "content": [
      {
       "text": "There is a <prerequisite> block in the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-parent/pom.xml#L480-L482"
         },
         "type": "link"
        }
       ],
       "text": "fcrepo-parent pom file",
       "type": "text"
      },
      {
       "text": ".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "During build you get a warning",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] The project org.fcrepo:fcrepo-parent:pom:6.0.0-SNAPSHOT uses prerequisites which is only intended for maven-plugin projects but not for non maven-plugin projects. For such purposes you should use the maven-enforcer-plugin. See ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://maven.apache.org/enforcer/enforcer-rules/requireMavenVersion.html"
         },
         "type": "link"
        }
       ],
       "text": "https://maven.apache.org/enforcer/enforcer-rules/requireMavenVersion.html",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "As such and because we have the maven-enforcer-plugin in the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/master/pom.xml#L661"
         },
         "type": "link"
        }
       ],
       "text": "main pom file",
       "type": "text"
      },
      {
       "text": ", this can be removed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
