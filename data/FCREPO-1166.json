  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Effects Fedora 3.0 to 3.6",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "References an old vocabulary.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FEDORA36/Fedora+XACML+Policy+Writing+Guide"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FEDORA36/Fedora+XACML+Policy+Writing+Guide",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Should also include this information ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-477"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-477",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Note that ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-477"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-477",
       "type": "text"
      },
      {
       "text": " the use of res-ext field hasModel isn't shown in the repositories vocabulary.txt ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
