    {
     "author": {
      "accountId": "6089a594bb0b0500707c78d8",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/16",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/24",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/32",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/48"
      },
      "displayName": "Dan Field",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a594bb0b0500707c78d8",
      "timeZone": "Europe/London"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I am defining my initial dataset, taken from the NLW collections as everything ingested in Feb 2018. This equates to:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "5348 datastreams totalling `170MB` on disk",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "5369 objects totalling `4.3GB` on disk",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "data is stored in legacy FS format, not Akubra",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "Although small, this will only form the initial test dataset. Other larger datasets will follow and will comprise a different ratio of datastreams to objects as well. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I will initially run all tests from local solid state disk, performance stats below:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "$ sudo hdparm -I /dev/sda\r\n/dev/sda:\r\n\r\nATA device, with non-removable media\r\n\tModel Number:       SanDisk SD8SBAT-256G-1006               \r\n\tSerial Number:      164547401752        \r\n\tFirmware Revision:  Z2311006\r\n\tTransport:          Serial, ATA8-AST, SATA 1.0a, SATA II Extensions, SATA Rev 2.5, SATA Rev 2.6, SATA Rev 3.0",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "$ sudo hdparm -Tt /dev/sda\r\n\r\n/dev/sda:\r\n Timing cached reads:   33416 MB in  1.99 seconds = 16816.65 MB/sec\r\n Timing buffered disk reads: 1530 MB in  3.00 seconds = 509.58 MB/sec",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
