  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Discard existing serialization and use activitystream serialization as illustrated in the spec example.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#minimal-notification-example"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#minimal-notification-example",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Translate all existing information into its ActivityStream equivalent, where possible.  Create a new ticket for any information that does not map onto ActivityStream vocabulary, or does not seem appropriate to include.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For now, use a local hash URI #agent for the actor, and populate its name with the string name of the user principal.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
