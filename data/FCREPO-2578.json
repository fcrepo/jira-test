  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The version of JQuery used by the HTML UI (1.9.1) has a cross-site scripting vulnerability:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
