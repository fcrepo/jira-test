   "content": [
    {
     "attrs": {
      "localId": "fb014e519649"
     },
     "content": [
      {
       "text": "According to Claude PATCH requests are not returning the updated e-tag in the response of the PATCH. This is an apparent regression from Fedora 6 behaviour. It does respond with the correct e-tag in subsequent requests. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
