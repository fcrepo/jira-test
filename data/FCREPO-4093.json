     "body": {
      "content": [
       {
        "attrs": {
         "localId": "62f6d07a5287"
        },
        "content": [
         {
          "text": "This was processed by Claude in a live demo during FedoraCamp 2026 with a prompt of nothing more than “Fix this Jira issue  ",
          "type": "text"
         },
         {
          "attrs": {
           "localId": "c6246e51a199",
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-4093"
          },
          "type": "inlineCard"
         },
         {
          "text": " “ In order to encourage participation in the project from non technical contributors.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
