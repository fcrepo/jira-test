     "body": {
      "content": [
       {
        "attrs": {
         "localId": "7656cbfd74b7"
        },
        "content": [
         {
          "text": "Just copying that comment here for readability:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "One Fedora 7 server behavior change surfaced by the integration tests, which",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "client users should be aware of:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "localId": "e06c783581df"
        },
        "content": [
         {
          "attrs": {
           "localId": "caa60053f92d"
          },
          "content": [
           {
            "attrs": {
             "localId": "fb996a20f117"
            },
            "content": [
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "PATCH",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "strong"
               }
              ],
              "text": " responses no longer carry the updated ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "ETag",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "strong"
               }
              ],
              "text": ".",
              "type": "text"
             },
             {
              "text": " Against Fedora 6,",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "the ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "ETag",
              "type": "text"
             },
             {
              "text": " header on a successful ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "PATCH",
              "type": "text"
             },
             {
              "text": " response reflected the new state",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "of the resource. Against Fedora 7.0.0 it reflects the state prior to the",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "update. If you need the post-update ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "ETag",
              "type": "text"
             },
             {
              "text": " (e.g. for optimistic locking with",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "If-Match",
              "type": "text"
             },
             {
              "text": "), issue a fresh ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "HEAD",
              "type": "text"
             },
             {
              "text": "/",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "GET",
              "type": "text"
             },
             {
              "text": " after the ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "PATCH",
              "type": "text"
             },
             {
              "text": ".",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
