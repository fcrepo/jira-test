  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Fedora installer generated web.xml drops all attributes from the web-app element exception version and id, e.g.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<web-app id=\"WebApp_ID\" version=\"2.4\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "even though the original web.xml (fcrepo-server/src/main/webapp/WEB-INF/web.xml) reads:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<web-app id=\"WebApp_ID\" version=\"2.4\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "xmlns=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://java.sun.com/xml/ns/j2ee"
         },
         "type": "link"
        }
       ],
       "text": "http://java.sun.com/xml/ns/j2ee",
       "type": "text"
      },
      {
       "text": "\" xmlns:xsi=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema-instance"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema-instance",
       "type": "text"
      },
      {
       "text": "\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "xsi:schemaLocation=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://java.sun.com/xml/ns/j2ee"
         },
         "type": "link"
        }
       ],
       "text": "http://java.sun.com/xml/ns/j2ee",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd"
         },
         "type": "link"
        }
       ],
       "text": "http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd",
       "type": "text"
      },
      {
       "text": "\">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
