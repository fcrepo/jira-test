     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The next step is to choose a candidate to \"modularize\".  At the on-site, we discussed the possibility of messaging for this, since it isn't likely to change in the next release, except perhaps for the ability to send notification of \"read\" events.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
