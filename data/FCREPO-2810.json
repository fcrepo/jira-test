     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Pending response to code review.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Also, although the scenario in this ticket now result in the correct `</foo/fcr:acl#authz>` subject, there appears to be another block of triples included in the /fcr:acl response:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "<http://localhost:8080/fcrepo/rest/foo/fcr:acl>\r\n        rdf:type               fedora:Resource ;\r\n        rdf:type               webac:Acl ;\r\n        fedora:lastModifiedBy  \"fedoraAdmin\" ;\r\n        fedora:createdBy       \"fedoraAdmin\" ;\r\n        fedora:created         \"2018-07-13T16:06:59.823Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\r\n        fedora:lastModified    \"2018-07-13T16:07:19.059Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> .\r\n\r\n<http://localhost:8080/fcrepo/rest/foo/fcr:acl#authz>\r\n        rdf:type      acl:Authorization ;\r\n        acl:accessTo  <http://localhost:8080/fcrepo/rest/new> ;\r\n        acl:mode      acl:READ ;\r\n        acl:agent     \"testuser\" .\r\n\r\n<http://localhost:8080/fcrepo/rest/foo/fcr:acl>\r\n        rdf:type         ldp:RDFSource ;\r\n        rdf:type         ldp:Container ;\r\n        rdf:type         ldp:BasicContainer ;\r\n        fedora:writable  true .",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
