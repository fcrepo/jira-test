  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When retrieving a FedoraAcl resource, the subjects of the returned triples do not include the \"/fcr:acl\" part of the path.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PUT /foo/fcr:acl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PATCH /foo/fcr:acl",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "INSERT DATA",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "{ <#authz> a acl:Authorization ; ... }",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "GET /foo/fcr:acl",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</foo#authz> a acl:Authorization ; ...",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I would expect the response to the GET request to be:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "</foo/fcr:acl#authz> a acl:Authorization ; ...",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It should also be noted that the non-hash subjects are also incorrect - ie /foo rather than /foo/fcr:acl.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
