     "body": {
      "content": [
       {
        "content": [
         {
          "text": "PR with minor improvement: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/1441"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/1441",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Currently, there are 87 test failures in total.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Failures due to LDP:* namespace change: 38",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Failures due to an ldp-testsuite bug (resolved in master) that does not recognize \"text/turtle;charset=utf-8\" as text/turtle content-type: 49",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Resolving these two issues will not make all the failing tests to pass, I think in some cases it will reveal other failures that are currently masked by these failures.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
