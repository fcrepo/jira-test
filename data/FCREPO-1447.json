  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The following SPARQL query creates duplicate date propeties on NonRdfSourceDescriptions:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "DELETE WHERE",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "{",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.loc.gov/premis/rdf/v1#hasDateCreatedByApplication"
         },
         "type": "link"
        }
       ],
       "text": "http://www.loc.gov/premis/rdf/v1#hasDateCreatedByApplication",
       "type": "text"
      },
      {
       "text": "> ?o0 .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.loc.gov/premis/rdf/v1#hasEventDateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.loc.gov/premis/rdf/v1#hasEventDateTime",
       "type": "text"
      },
      {
       "text": "> ?o1 .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "} ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "INSERT DATA {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.loc.gov/premis/rdf/v1#hasDateCreatedByApplication"
         },
         "type": "link"
        }
       ],
       "text": "http://www.loc.gov/premis/rdf/v1#hasDateCreatedByApplication",
       "type": "text"
      },
      {
       "text": "> \"2015-01-27T19:09:18.112Z\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.loc.gov/premis/rdf/v1#hasEventDateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.loc.gov/premis/rdf/v1#hasEventDateTime",
       "type": "text"
      },
      {
       "text": "> \"2015-01-27T19:09:18.112Z\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "} ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Does not seem to affect Containers.  Non-date properties seem to be safe, as well.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
