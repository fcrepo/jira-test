    {
     "content": [
      {
       "text": "Running the following command to export all objects from repo:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "./jetty/fedora/client/bin/fedora-export.sh localhost:8980 fedoraAdmin fedoraAdmin DMO default default ~/work/fedora_dump http fedo",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "returns the following message:",
