  "description": {
   "content": [
    {
     "content": [
      {
       "text": "There are broken links in the fedora documentation on the wiki:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.lyrasis.org/display/FEDORA51/Configuring+a+JMS+Event+Filter"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.lyrasis.org/display/FEDORA51/Configuring+a+JMS+Event+Filter",
       "type": "text"
      },
      {
       "text": " links to:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-webapp/src/main/resources/spring/eventing.xml"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-webapp/src/main/resources/spring/eventing.xml",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-webapp/src/main/resources/spring/fcrepo-config.xml#L176"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-webapp/src/main/resources/spring/fcrepo-config.xml#L176",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "These are the two I discovered, there might be more.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "By looking at the links I assume the cause is switching the branch from master to main.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
