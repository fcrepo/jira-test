  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to resolve the issue of semantic differences in resources that have been:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1. exported",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. re-imported",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. exported again",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example, create the following resources:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -i -XPUT locahost:8080/f4/rest/book",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -i -XPUT -d @image.jpeg -H\"Content-Type: image/jpeg\" locahost:8080/f4/rest/book/image",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. Export to /data",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -jar target/fcrepo-import-export-0.1.1-SNAPSHOT.jar -b -d data -m export -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/f4/rest/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/f4/rest/",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. Stop, clear, start repo",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. Import",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -jar target/fcrepo-import-export-0.1.1-SNAPSHOT.jar -b -d data -m import -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/f4/rest/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/f4/rest/",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "4. Export to /data2",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -jar target/fcrepo-import-export-0.1.1-SNAPSHOT.jar -b -d data2 -m export -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/f4/rest/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/f4/rest/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "5. Compare the to data directories:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "diff -r data data2",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "See semantic differences:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "metadata.ttl:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": ">         rdf:type                 ldp:NonRDFSource ;",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "book.ttl:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">         rdf:type               ldp:RDFSource ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ">         rdf:type               ldp:Container ;",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
