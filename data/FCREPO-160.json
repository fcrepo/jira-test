  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Kowari and MPTStore backed Resource Index implementations vary in the way XSD dateTimes are returned: Kowari returns un-timezoned values and MPTStore returns timezoned values, i.e.: 2007-11-15T11:27:40.415 vs 2007-11-15T11:27:40.415Z.",
       "type": "text"
      }
     ],
     "type": "paragraph"
