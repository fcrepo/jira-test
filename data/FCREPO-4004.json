  "description": {
   "content": [
    {
     "content": [
      {
       "text": "From Chris Colvard at ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo-exts/fcrepo-upgrade-utils/pull/63"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "text": "When migrating my fedora repository I saw that ",
         "type": "text"
        },
        {
         "marks": [
          {
           "type": "code"
          }
         ],
         "text": "ebucore:filename",
         "type": "text"
        },
        {
         "text": " statements were being dropped from my non-binary resources. I realized that my application has been using a predicate that fedora 6 is now treating as server managed for binary resources. This PR only treats the binary properties as server managed when they appear in fcr:metadata resources attached to binary resources. This allows my migration to succeed without negatively affecting binary resources.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      }
     ],
     "type": "blockquote"
    }
   ],
