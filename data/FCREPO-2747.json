  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Per section 3.9.1 of the fedora spec (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#external-content-options)"
         },
         "type": "link"
        }
       ],
       "text": "https://fcrepo.github.io/fcrepo-specification/#external-content-options)",
       "type": "text"
      },
      {
       "text": " servers supporting external content requests to an LDPR must include an Accept-External-Content-Handling header in the response to an OPTIONS request to that resource. The value must be a comma separated list of supported behaviors.   The supported behaviors for 5.0.0 will be copy and redirect. Thus the header should look like this: \"Accept-External-Content-Handling: copy,redirect\".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
