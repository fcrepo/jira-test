     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Thanks for your contribution and description of the value. That is helpful. I will push this into the master branch, if you can just sign and return the \"icla.pdf\" linked from the following page:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/DSP/Contributor+License+Agreements"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/DSP/Contributor+License+Agreements",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "In order to keep Fedora4 community-owned, all contributions must come with a CLA. Please return the signed icla to \"legal@duraspace.org\". I will see it.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Thanks again.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
