  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Java client should inspect the headers of NonRDFSources to find where the description is, rather than adding fcr:metadata to the end of the NonRDFSource URI.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When creating a NonRDFSource or doing a HEAD on it, there will be a Link rel=\"describedby\" header indicating the URI of the description.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
