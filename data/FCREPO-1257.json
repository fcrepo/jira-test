    {
     "author": {
      "accountId": "60785ded115da6006f540529",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It appears that the test itself, is exhausting socket resources which causes the failure. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/umd-lib/fcrepo4/blob/feature/fcrepo-1257/fcrepo-http-api/src/test/java/org/fcrepo/integration/http/api/FedoraBlankNodesIT.java"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/umd-lib/fcrepo4/blob/feature/fcrepo-1257/fcrepo-http-api/src/test/java/org/fcrepo/integration/http/api/FedoraBlankNodesIT.java",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The following, analogous, test evokes the performance issue (where \"mods.ttl\" is the file: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/umd-lib/fcrepo4/blob/feature/fcrepo-1257/fcrepo-http-api/src/test/resources/test-blank-nodes/with_blank_nodes.ttl):"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/umd-lib/fcrepo4/blob/feature/fcrepo-1257/fcrepo-http-api/src/test/resources/test-blank-nodes/with_blank_nodes.ttl):",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "=================",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "time for x in {0..50000}; do echo \"--- $x\"; curl -s -XPOST --data-binary @mods.ttl -H\"Content-Type: text/turtle\" localhost:8080/fcrepo/rest/test/collection0; done",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "=================",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
