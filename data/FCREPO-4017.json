   "content": [
    {
     "content": [
      {
       "text": "There is a new RFC defining the Content-Disposition header, it has deprecated many of the parts that we use in Fedora. These are now deprecated in Spring and as such we should move away from using them.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
