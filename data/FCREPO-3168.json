  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/test1 -v -H \"Content-Type: text/turtle\" -X PUT --data \"\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "succeeds however the empty OCFL file is missing.  It should result in a zero length file on disk. Also please note that ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "`curl -u fedoraAdmin:fedoraAdmin ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest",
       "type": "text"
      },
      {
       "text": " -v -H \"Content-Type: text/turtle\" -X POST --data \"\"`",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "should behave similarly. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Integration test coverage should be added.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
