       "48x48": "https://secure.gravatar.com/avatar/c60441aa4d768094099cff99ae2f60e3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSC-1.png"
      },
      "displayName": "Stuart Chalk",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Abced279e-0394-4a99-88ab-15a185f84139",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Currently certain of the REST API methods output XML via format=xml and others via xml=true.  This needs to be standardized across all methods.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
