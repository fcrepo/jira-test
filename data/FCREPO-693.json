    {
     "author": {
      "accountId": "557058:e25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png",
       "24x24": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png",
       "32x32": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png",
       "48x48": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png"
      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Hi Stuart, the right way is format=xml, for the REST API.  The documentation page for that, at",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora-commons.org/confluence/display/FCR30/REST+API"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora-commons.org/confluence/display/FCR30/REST+API",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "...was incorrect in stating that xml=true works.  I just fixed that.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The old way, done for \"API-A-Lite\" (which we're trying to move away from) was xml=true.  The old way won't be changed in favor of steering people to use the REST API, which does it consistently.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Thanks,",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Chris",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
