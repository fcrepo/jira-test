  "description": {
   "content": [
    {
     "content": [
      {
       "text": "A LDP-RS that describes a LDP-NR advertises several HTTP methods as allowable that are, in fact, not allowable:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -i localhost:8080/fcrepo/rest/a/binary/fcr:metadata",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Allow: MOVE,COPY,DELETE,POST,HEAD,GET,PUT,PATCH,OPTIONS",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Clearly, POST is not allowed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
