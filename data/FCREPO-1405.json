  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Some of the predicates passed to the JMS producer (in the org.fcrepo.jms.properties header) use the JCR namespace. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.jcp.org/jcr/1.0lastModified,http://www.jcp.org/jcr/1.0createdBy"
         },
         "type": "link"
        }
       ],
       "text": "http://www.jcp.org/jcr/1.0lastModified,http://www.jcp.org/jcr/1.0createdBy",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "These should be replaced the the ",
       "type": "text"
      },
      {
       "marks": [
