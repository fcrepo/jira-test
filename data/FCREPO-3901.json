     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This would appear to be due to the fact that the dockerhub image for fcrepo-camel-toolbox does not yet contain the solr indexing development from ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://github.com/fcrepo-exts/fcrepo-camel-toolbox/pull/191"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:d68ad01c-c97b-42a0-8679-bae8450078ab",
           "text": "@James Alexander"
          },
          "type": "mention"
         },
         {
          "text": " even thoough you may have performed the docker-compose from within my branch containing this PR, the images are pulled from the dockerhub repos which do not yet contain the feature. Can you confirm whether this is how you tested? ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
