     "content": [
      {
       "text": "When exporting with binary excluded (the plantpatents dataset restored from plants.tar.gz), the ResourceNotFoundRuntimeException will be logged for an existing resource like ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/audit/c0/c8/af/98/c0c8af98-72a3-4ce0-96f0-aaf9ac2aa161,"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/audit/c0/c8/af/98/c0c8af98-72a3-4ce0-96f0-aaf9ac2aa161,",
       "type": "text"
      },
      {
       "text": " while it's the reference resource (<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/initialize"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/initialize",
       "type": "text"
      },
      {
       "text": ">) that doesn't exist in the repository:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "INFO 11:05:18.899 (Exporter) Exporting description: ",
