      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "W3C is constructing a recommendation for this kind of activity:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/TR/soapjms/"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/TR/soapjms/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Apache CXF is (so far as I know) the only WS framework moving to implement it right now.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
