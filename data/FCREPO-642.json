      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Some process notes:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Since we're not masochists, we won't craft our manifests by hand. bnd (or, in our case, bnd in its Maven plugin guise*) gives us a reasonably straightforward path to generate the required manifest entries. Sorting out the \"correct\" packages for export and import, writing an Activator for the bundle will require more effort.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "*Apache Felix Maven Bundle Plugin (BND): ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://felix.apache.org/site/apache-felix-maven-bundle-plugin-bnd.html"
            },
            "type": "link"
           }
          ],
          "text": "http://felix.apache.org/site/apache-felix-maven-bundle-plugin-bnd.html",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
