     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Comment from Sourceforge Task]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Comment Submitter: cwilper",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Committed to maintenance-2.2 r6546.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "This fixes the following bugs:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1720485: Null pointer running v2.2 installer",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "TomcatServerXML now throws InstallationFailedException if XPath queries fail.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Also added a (rudimentary) JUnit test case.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1747186: FedoraAccessServlet hardcodes tiny buffer for datastreams.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Set a 4KB buffer.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1816735: Flush and close missing in FieldSearchServlet",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "...and partially addresses the following bug:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1853905: Installer fails if FEDORA_HOME contains a space.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
