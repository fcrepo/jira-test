     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I agree with ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:24c578cc-15e9-4649-9f68-5eace85735e0",
           "text": "@A. Soroka"
          },
          "type": "mention"
         },
         {
          "text": " — this PR is an improvement, but we may be handling too many different things with that exception.  For example, the precondition failure is a good example of normal behavior that probably shouldn't even be a warning.",
          "type": "text"
         }
        ],
        "type": "paragraph"
