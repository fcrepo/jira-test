  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The manifest-SHA.txt produced by the Bag export is not compatible with command-line shasum.  When I try to validate the files in the manifest with shasum, I get the following error:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "$ shasum -c manifest-SHA1.txt ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "shasum: manifest-SHA1.txt: no properly formatted SHA1 checksum lines found",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The BagIt spec for manifest files may not be compatible with shasum, but if it is, then we should make them compatible for ease of validation.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
