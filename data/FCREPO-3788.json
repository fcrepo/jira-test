  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When requesting a list of versions for a binary resource, for example ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "text/turtle returns the correct order of versions, in a descending order:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "ldp:contains           <http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20211018121711> ;\r\n        ldp:contains           <http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20210927124149> ;\r\n        ldp:contains           <http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20210429102326> ;\r\n        ldp:contains           <http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20210416115949> ;",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "but application/ld+json returns a random order:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "\"http://www.w3.org/ns/ldp#contains\": [\r\n            {\r\n                \"@id\": \"http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20210429102326\"\r\n            },\r\n            {\r\n                \"@id\": \"http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20211018121711\"\r\n            },\r\n            {\r\n                \"@id\": \"http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20210927124149\"\r\n            },\r\n            {\r\n                \"@id\": \"http://localhost:8080/rest/karaka3:1187/FILE0/fcr:metadata/fcr:versions/20210416115949\"\r\n            }\r\n        ],",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    }
   ],
