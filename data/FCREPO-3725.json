  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Fedora deadlocks when there are more concurrent requests than db connections in the pool. This is because it needs an additional db connection to create rdf types outside of the main request transaction. If there are no available connections, then none of the requests can complete.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
