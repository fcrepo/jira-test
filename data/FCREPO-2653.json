  "description": {
   "content": [
    {
     "content": [
      {
       "text": "TimeMaps have a specific URI of fedora:timemap, but we address them via the /fcr:versions URI.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ie. a GET returns triples",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/versionableObject/fedora:timemap"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/versionableObject/fedora:timemap",
       "type": "text"
      },
      {
       "text": "> a fedora:Resource",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "this should be",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/versionableObject/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/versionableObject/fcr:versions",
       "type": "text"
      },
      {
       "text": "> a fedora:Resource",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This task builds on the work of ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-2623#icft=FCREPO-2623"
       },
       "type": "inlineCard"
      },
      {
       "text": " to create a converter to change this URI.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
