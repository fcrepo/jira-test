  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The minimum implementation to support Indirect Containers. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The resolution to this ticket should include resolutions to the following Fedora API Test Suite failures, or result in the creation of appropriate follow-on tickets.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpic"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpic",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations MUST set the indirect container's ldp:membershipResource by default when not specified on creation.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpic"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpic",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations SHOULD set the indirect container's ldp:membershipResource to the LDPC by default when not specified on creation.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpic"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpic",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations must allow the indirect container's membership predicate to be set by default to an implementation defined value.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpic"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpic",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations should use the default <> ldp:hasMemberRelation ldp:member",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpic"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpic",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations must allow the ldp:insertedContentRelation property to be set by default to an implementation defined value.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpic"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpic",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations SHOULD allow the ldp:insertedContentRelation property to be set by default to ldp:MemberSubject.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
