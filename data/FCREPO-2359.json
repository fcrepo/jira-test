     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Verified, I used the fcrepo-webapp with WebAC enabled and restored the plantpatents to it. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I then exported the entire repo successfully. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Using ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:bfcf2b10-5443-4304-afe6-3aff38ddf271",
           "text": "@Joshua Allan Westgard"
          },
          "type": "mention"
         },
         {
          "text": "'s ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-2347#icft=FCREPO-2347"
          },
          "type": "inlineCard"
         },
         {
          "text": " branch I did",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "> ./verify.py -u admin1:password3 ../fcrepo-import-export/importexport.yml --csv=./out.csv --log=./out.log\r\nkey (source) and (http://localhost:8080/rest)\r\nkey (resource) and (http://localhost:8080/rest)\r\nkey (binaries) and (True)\r\nkey (predicates) and (http://www.w3.org/ns/ldp#contains)\r\nkey (dir) and (/sw/var/www/fcrepo4/fcrepo-import-export/fcrepo-import-export-temp)\r\nkey (mode) and (export)\r\nkey (rdfLang) and (application/ld+json)\r\n\r\nRunning verification on Fedora 4 export\r\nTraceback (most recent call last):\r\n  File \"./verify.py\", line 455, in <module>\r\n    main()\r\n  File \"./verify.py\", line 368, in main\r\n    original = Resource(filepath, config, logger)\r\n  File \"./verify.py\", line 226, in __init__\r\n    self.graph = Graph().parse(self.origpath)\r\n  File \"/usr/local/lib/python3.5/site-packages/rdflib/graph.py\", line 1033, in parse\r\n    data=data, format=format)\r\n  File \"/usr/local/lib/python3.5/site-packages/rdflib/parser.py\", line 171, in create_input_source\r\n    input_source = URLInputSource(absolute_location, format)\r\n  File \"/usr/local/lib/python3.5/site-packages/rdflib/parser.py\", line 100, in __init__\r\n    file = urlopen(req)\r\n  File \"/usr/local/Cellar/python3/3.5.1/Frameworks/Python.framework/Versions/3.5/lib/python3.5/urllib/request.py\", line 162, in urlopen\r\n    return opener.open(url, data, timeout)\r\n  File \"/usr/local/Cellar/python3/3.5.1/Frameworks/Python.framework/Versions/3.5/lib/python3.5/urllib/request.py\", line 471, in open\r\n    response = meth(req, response)\r\n  File \"/usr/local/Cellar/python3/3.5.1/Frameworks/Python.framework/Versions/3.5/lib/python3.5/urllib/request.py\", line 581, in http_response\r\n    'http', request, response, code, msg, hdrs)\r\n  File \"/usr/local/Cellar/python3/3.5.1/Frameworks/Python.framework/Versions/3.5/lib/python3.5/urllib/request.py\", line 509, in error\r\n    return self._call_chain(*args)\r\n  File \"/usr/local/Cellar/python3/3.5.1/Frameworks/Python.framework/Versions/3.5/lib/python3.5/urllib/request.py\", line 443, in _call_chain\r\n    result = func(*args)\r\n  File \"/usr/local/Cellar/python3/3.5.1/Frameworks/Python.framework/Versions/3.5/lib/python3.5/urllib/request.py\", line 589, in http_error_default\r\n    raise HTTPError(req.full_url, code, msg, hdrs, fp)\r\nurllib.error.HTTPError: HTTP Error 401: Unauthorized",
          "type": "text"
         }
        ],
