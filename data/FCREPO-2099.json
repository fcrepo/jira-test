  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Many web servers support gzip compression of resources via the header: Accept-Encoding: gzip, deflate",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This is a ticket to track the implementation of this, either via a container-level configuration recipe or by implementing a Jersey filter: ",
       "type": "text"
      },
      {
       "marks": [
        {
