     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Closing as out of scope. This is easy to implement in a servlet container or a reverse proxy. For example, here is a possible Nginx configuration:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "gzip on;",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "gzip_types text/javascript text/turtle application/json application/ld+json application/rdf+xml application/n-triples;",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "gzip_proxied no-cache auth;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
