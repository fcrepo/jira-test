      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Hmm...0.3.1 has worked for me for fcrepo-misc (a multi-module project) for a while:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "http://cwilper.github.com/fcrepo-misc/"
            },
            "type": "link"
           }
          ],
          "text": "http://cwilper.github.com/fcrepo-misc/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "With fcrepo-misc's pom, the following steps have worked for me to deploy:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "git checkout v0.1.1 (whatever the just-tagged version is)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "mvn site-deploy -P release-site",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "git checkout master",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "git pull",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
