      "displayName": "Jim Coble",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A6bd70f82-b44c-4b7c-8a0a-fd57d9f0ddb1",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Suggestions made on #fcrepo IRC to make use of `Prefer: return=representation; include=\"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora.info/definitions/v4/repository#InboundReferences"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora.info/definitions/v4/repository#InboundReferences",
          "type": "text"
         },
         {
          "text": "\"` and to have a flag to import-export that says \"traverse via these predicates, and use prefer headers to get the inbound relationships\".",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
