         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-exts/fcrepo4-upgrade-utils/blob/master/src/main/java/org/fcrepo/upgrade/utils/TechnicalMetadataMigrator.java#L51",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Completion of this task is defined by:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "first running a script, TBD (",
           "type": "text"
          },
          {
           "attrs": {
            "accessLevel": "",
            "id": "5fca8aead670b8006e2516cc",
            "text": "@kefo"
           },
           "type": "mention"
          },
          {
           "text": "?), that detects dead references,",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "followed by running this utility",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
