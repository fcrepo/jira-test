       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "stopped",
       "type": "text"
      },
      {
       "text": " Fedora repository, ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "traversing resources, ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "looking for properties of type WEAKREFERENCE or REFERENCE,",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "with values that reference non-existent resources,",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "and removing the dead reference property values.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "This utility will likely follow a similar model as:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
