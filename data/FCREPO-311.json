     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Comment from Sourceforge Task]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Comment Submitter: bbranan",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Added code which logs the completion of all public API-M services at the INFO level. Moved entry/exit type logging to the DEBUG level.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Added code to create audit records on ingestObject and modifyObject. On ingestObject the audit record is only created if a log message is provided. Collected audit record creation work into addAuditRecord(), updated code within DefaultManagement which creates audit records to use this method.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Added tests to verify the creation of audit records. Updated TestAPIM to remove all objects added for tests and resets objects used within tests, this allows the tests to be run consecutively with no side effects in the repository.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
     },
