  "description": {
   "content": [
    {
     "content": [
      {
       "text": "From ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo/fcrepo/issues/2040"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "TL;DR",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I have configured my session timeout for a long time and when long running client dies I don’t know the transaction ID to roll it back. When another user tries to edit it, I just see a 409 Conflict and I would like to see the transaction ID so I can roll it back.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This ticket is to:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "order": 1
     },
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Ensure the transaction ID is included in messages in the log",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Add a configuration parameter to enable displaying the transaction ID to the end users, with a default of being disabled.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "If the new configuration parameter is enabled, add the transaction ID to the outgoing 409 response body.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    }
   ],
