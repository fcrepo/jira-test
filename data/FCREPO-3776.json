       "48x48": "https://secure.gravatar.com/avatar/da85e010de6ab170974f99acaf5d8b09?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FMR-6.png"
      },
      "displayName": "Michael Ritter",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5ffca2ed91bb2e010813c008",
      "timeZone": "America/Denver"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I renamed Auto-versioning page to Versioning in Fedora 6 and updated the diagrams to display as svgs (though confluence makes it a pain to do so another filetype might be better).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I don't think we need a separate page for the Mutable Head information as the current page does a good job outlining its use.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
