      "timeZone": "America/Denver"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Just as a note for any future broken macros: they can be accessed through the page attachments and downloaded as json files. These can then be used with ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://draw.io"
            },
            "type": "link"
           }
          ],
          "text": "draw.io",
          "type": "text"
         },
         {
          "text": " or another service to import/export the diagrams as whatever attachment we want to display it as. Gliffy requires an enterprise edition to export, so it can’t be done using their free trial.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
