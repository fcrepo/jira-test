      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Created a container",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Deleted container",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Attempt to delete container/fcr:tombstone as non-admin user ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Example:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Command:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "$ curl -v -X DELETE -u \"fedoraUser:fedoraUser\" -H \"x-fin-principal: admin\" http://localhost:8080/fcrepo/rest/.services/iiif/fcr:tombstone",
       "type": "text"
      }
     ],
