     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The decision was to leave the Allow methods on the repository root as they are. Given the possibility of a multi-root repository, the DELETE and MOVE operations should be supported.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
