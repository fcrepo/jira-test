  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Allow header for requests to the repository root contains MOVE and DELETE, which seem incorrect.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -I localhost:8080/fcrepo/rest",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Allow: MOVE,COPY,DELETE,POST,HEAD,GET,PUT,PATCH,OPTIONS",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
