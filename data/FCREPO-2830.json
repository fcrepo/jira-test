  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Content-Location",
       "type": "text"
      },
      {
       "text": " header has previously been used in creating binaries, allowing clients to provide the URL for where content should be retrieved from rather than supplying the content in the body of the request.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This is superseded by ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "handling=copy",
       "type": "text"
      },
      {
       "text": ". We should remove support for the Content-Location header on POST/PUT/PATCH, and the supporting code/annotations. See:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
