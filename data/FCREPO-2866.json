  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If you have acl:Write or acl:Append permissions you should be able to perform certain PATCH requests. But if you send your request with a Content-type with a character set.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ie. Content-type: application/sparql; charset=ISO-8859-1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It will fail.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "> curl -i -utestuser:testpass ",
