  "description": {
   "content": [
    {
     "content": [
      {
       "text": "GC is being run unnecessarily at the end of each ingest.  Removing this will improve performance considerably.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "> (DefaultDOManager.java:1075). The garbage collection definitely does",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> hurt performance when triggered this way and it isn't guaranteed to",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> happen at  this point in time anyway. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Further details at ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.fiz-karlsruhe.de/docs/Wiki.jsp?page=Java%20Heap%20%26%20GC%20Tuning"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.fiz-karlsruhe.de/docs/Wiki.jsp?page=Java%20Heap%20%26%20GC%20Tuning",
       "type": "text"
      }
