  "description": {
   "content": [
    {
     "content": [
      {
       "text": "With the move to Memento versioning, the logic related to JCR Frozen Resources should be removed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "> find . -name '*.java'|xargs grep -H -i frozen",
       "type": "text"
      }
     ],
     "type": "paragraph"
