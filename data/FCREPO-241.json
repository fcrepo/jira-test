      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The REST API, prior to the work on this task, was not included in the servlet filtering chain which allows other Fedora interfaces to authenticate users. The changes for this task include adding a new servlet filter which handles determining which REST API requests map to API-A, for the case where API-A AuthN is off. Filter mappings are also added to select the correct filter for the RestServlet, depending on choices made at install time.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
