       "24x24": "https://secure.gravatar.com/avatar/a2c3681358bcdbad6c55767afdba0010?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FEG-6.png",
       "32x32": "https://secure.gravatar.com/avatar/a2c3681358bcdbad6c55767afdba0010?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FEG-6.png",
       "48x48": "https://secure.gravatar.com/avatar/a2c3681358bcdbad6c55767afdba0010?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FEG-6.png"
      },
      "displayName": "Egbert Gramsbergen",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a466248ef60073948ab9",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "For the test suite: a sample SPARQL query with the example above would be",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "SELECT ?s ?o",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "WHERE {",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "?s <",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/2004/02/skos/core#prefLabel"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/2004/02/skos/core#prefLabel",
          "type": "text"
         },
         {
          "text": "> ?o",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "FILTER (LANG(?o)='nl')",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "to retrieve all objects with a skos prefLabel in Dutch.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
