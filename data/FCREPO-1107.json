       "16x16": "https://secure.gravatar.com/avatar/a2c3681358bcdbad6c55767afdba0010?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FEG-6.png",
