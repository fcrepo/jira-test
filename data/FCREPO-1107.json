       "48x48": "https://secure.gravatar.com/avatar/bf2e136284e0b17b99502dc3a32eef38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-6.png"
      },
      "displayName": "Benjamin Armintor",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5fca89892730d8007611d907",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Depending on whether the management APIs should support a language attribute for addRelationship and purgeRelationship, this may require changes to the Management interface as well as the Journaling code.  Supporting the language attribute on whole-datastream changes (such as ingest) is a much less drastic change.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
