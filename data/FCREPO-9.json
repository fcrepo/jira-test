  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Rather than modifying files (especially fedora.fcfg) on the server, this feature would allow web-accessible configuration.  It would:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Provide the ability to change configuration.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Provide a way to re-initialize the server.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
