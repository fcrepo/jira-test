      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As per a long-ago discussion on this topic, I vote to continue with Jersey, as a check on compatibility. If Jersey ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "em"
           }
          ],
          "text": "cannot",
          "type": "text"
         },
         {
          "text": " be used in this role, we have discovered a significant problem with our web services profile.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
