       "48x48": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png"
      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Comment from Nish on developers list - \"the file should only gets parsed when a user authenticates for the first time to a session. Subsequent auth requests pull the Subject from the session instead of authenticating for each request.\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Might still be worth introducing some caching though, particularly if people have scripts etc where they are not maintaining a session between requests.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
