     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Once FeSL is integrated with the module/Spring architecture, the initial load of policies should be better handled rather than by the first instantiation of the PDP, which is the current situation.  ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-795#icft=FCREPO-795"
          },
          "type": "inlineCard"
         },
         {
          "text": " raised for the integration.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
