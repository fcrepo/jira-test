  "customfield_10030": [
   {
    "id": "10026",
    "self": "https://fedora-repository.atlassian.net/rest/api/3/customFieldOption/10026",
    "value": "Services: Authorization"
   }
  ],
  "customfield_10037": null,
  "customfield_10041": [],
  "customfield_10042": null,
  "customfield_10043": null,
  "customfield_10044": null,
  "customfield_10045": null,
  "customfield_10047": null,
  "customfield_10048": null,
  "customfield_10049": null,
  "customfield_10050": null,
  "customfield_10051": null,
  "customfield_10052": null,
  "customfield_10053": null,
  "customfield_10054": null,
  "customfield_10087": null,
  "customfield_10121": null,
  "customfield_10154": null,
  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Because the acl:default predicate means that the specified Authorization should be shared to child resources, then there is no reason to specify both of the acl:accessTo and acl:accessToClass.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "acl:accessToClass would allow you more options (see ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-2854#icft=FCREPO-2854"
       },
       "type": "inlineCard"
      },
      {
       "text": ").",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "But acl:accessTo would be re-written to the child objects URI, voiding any acl:accessToClass statements.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ie.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/rest/test_object",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<> a example:Box .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/rest/test_object/fcr:acl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<> a webac:Acl .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<#auth1> a acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:mode acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:accessTo </rest/test_object> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:accessToClass example:Box ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:agent \"Bob\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:default </rest/test_object> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Any child (ie. /rest/test_object/child) would see an effective Acl of",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<> a webac:Acl .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<#auth1> a acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:mode acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:accessTo </rest/test_object/child> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:accessToClass example:Box ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "   acl:agent \"Bob\" .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Therefore it is probably better to disallow having both acl:accessTo and acl:accessToClass in the same authorization.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
