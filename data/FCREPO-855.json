       "48x48": "https://secure.gravatar.com/avatar/628068f58d175962c7274ca5ca03993f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAS-3.png"
      },
      "displayName": "A. Soroka",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A24c578cc-15e9-4649-9f68-5eace85735e0",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Coming back to this after some time, I now wonder whether any time to spent on this issue wouldn't be better spent moving forward Steve Bayliss' redesign of the Messaging module event stream. His design, working over content URLs in a way that truly captures the spirit of Atom, would solve the problem behind this issue and do much more besides.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
