  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When attempting to view the content of a Redirect-type datastream via the web admin, an error is produced: \"Security error accessing url\" even if the redirect points to url with no security requirements. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To Reproduce: Use the web admin to create an R datastream with location set to: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.yahoo.com,/"
         },
         "type": "link"
        }
       ],
       "text": "http://www.yahoo.com,",
       "type": "text"
      },
      {
       "text": " then attempt to view the content.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
  "duedate": null,
