  "description": {
   "content": [
    {
     "content": [
      {
       "text": "There are numerous test failures while building on Windows, most of them seem to be path-related",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Failed tests:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ArgParserTest.retrieveConfig:319 expected:<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "/tmp/"
         },
         "type": "link"
        }
       ],
       "text": "/tmp/",
       "type": "text"
      },
      {
       "text": "rdf> but was:<[C:\\tmp]rdf>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ArgParserTest.testSerializedConfigCustom:343 expected:<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "/path/to/"
         },
         "type": "link"
        }
       ],
       "text": "/path/to/",
       "type": "text"
      },
      {
       "text": "export> but was:<[C:\\path\\to]export>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ArgParserTest.testSerializedConfigDefault:365 expected:<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "/tmp/"
         },
         "type": "link"
        }
       ],
       "text": "/tmp/",
       "type": "text"
      },
      {
       "text": "rdf> but was:<[C:\\tmp]rdf>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Tests in error:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ImporterTest.testDefaultModeRetainsLastModified:267 ▒ IllegalArgument Illegal ...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ImporterTest.testImportContainer:245 ▒ IllegalArgument Illegal character in pa...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ImporterTest.testLegacyModeStripsLastModified:254 ▒ IllegalArgument Illegal ch...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ImporterTest.testSkipPairtree:286 ▒ IllegalArgument Illegal character in path ...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ImporterTest.testUnauthenticatedImportWhenAuthorizationIsRequired ▒  Unexpecte...",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example,",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "testSkipPairtree(org.fcrepo.importexport.importer.ImporterTest)  Time elapsed: 0.01 sec  <<< ERROR!",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java.lang.IllegalArgumentException: Illegal character in path at index 28: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.org:9999/restab"
         },
         "type": "link"
        }
       ],
       "text": "http://example.org:9999/rest\\ab",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
