  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Add an option to the fcrepo-upgrade-utils tool that is similar to the migration-utils ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "--head-only",
       "type": "text"
      },
      {
       "text": " option. When supplied, only the head version of resources would be migrated to the new fedora 6 version. If archival groups are present, then it should only create a single final version for the AG and all its children.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
