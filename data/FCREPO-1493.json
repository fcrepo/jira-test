  "description": {
   "content": [
    {
     "content": [
      {
       "text": "I would appreciate some instruction on how to issue a SPARQL update to change a property nested in a blank node.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Say I have the following resource (book1): ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "book1  hasAuthor _:a1",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "book1  hasAuthor _:a2",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "_:a1   foaf:name 'Bob'",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "_:a2   foaf:name 'Betty'",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "How would I change _:a2 foaf:name?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "There should also be a test in the suite that shows this is possible",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
