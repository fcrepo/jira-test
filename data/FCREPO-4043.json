  "description": {
   "content": [
    {
     "content": [
      {
       "text": "From GitHub Issue ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo/fcrepo/issues/2269"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "➜  ~ curl --head -s http://fedora.local.lan/rest/ | grep Content\nAccept-External-Content-Handling: copy,redirect,proxy\nContent-Type: text/turtle;charset=utf-8\nContent-Length: 0\n➜  ~ \n",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "According to the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://www.rfc-editor.org/rfc/rfc9110.html#name-content-length"
         },
         "type": "link"
        },
        {
         "type": "underline"
        }
       ],
       "text": "HTTP spec",
       "type": "text"
      },
      {
       "text": ":",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "text": "A server MAY send a Content-Length header field in a response to a HEAD request (",
         "type": "text"
        },
        {
         "marks": [
          {
           "attrs": {
            "href": "https://www.rfc-editor.org/rfc/rfc9110.html#HEAD"
           },
           "type": "link"
          },
          {
           "type": "underline"
          }
         ],
         "text": "Section 9.3.2",
         "type": "text"
        },
        {
         "text": "); a server MUST NOT send Content-Length in such a response unless its field value equals the decimal number of octets that would have been sent in the content of a response if the same request had used the GET method.",
         "type": "text"
        }
       ],
       "type": "paragraph"
      }
     ],
     "type": "blockquote"
    }
   ],
