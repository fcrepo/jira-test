     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This test always passes when I have [client] hyper-v enabled (which I do by default).  On a whim, I tried disabling hyper-v and  was able to reproduce the above errors.  Re-enabling hyper-v resulted in builds consistently passing for me.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Dell XPS 15 laptop.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Enabling hyper-v did not cause ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:cc6016b1-6dae-4b52-922c-9076d2e8b96d",
           "text": "@Yinlin Chen"
          },
          "type": "mention"
         },
         {
          "text": "'s build to pass.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
