  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The maven configuration for fcrepo-camel-toolbox can be cleaned up considerably. For starters, it should inherit from fcrepo-parent, not oss-parent. Secondly, the build-helper plugin is incorrectly configured, preventing a successful ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "mvn install",
       "type": "text"
      },
      {
       "text": " from a subdirectory.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
