     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Re-opening as response is not schema-valid if asOfDateTime is specified",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "cvc-complex-type.3.2.2: Attribute 'dateTime' is not allowed to appear in element 'datastreamProfile' ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "either schema needs updating to allow this (optional) attribute OR don't have the attribute in the response",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
