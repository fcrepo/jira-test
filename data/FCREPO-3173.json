  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to update the import/export tool to compile with Java 11.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "The other Fedora components have moved to Java 11, the import/export likely should as well.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Travis-ci should also be updated:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "jdk:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "openjdk11",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
