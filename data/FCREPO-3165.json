  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The resolution to this ticket should either resolve the follow Fedora API Test Suite failures, or create follow-on tickets for their resolution.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpc"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpc",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "LDP Containers must distinguish [membership] triples.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpdc"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpdc",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations MUST set the ldp:membershipResource by default when not specified on creation.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpdc"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpdc",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations SHOULD set the ldp:membershipResource to the LDPC by default when not specified on creation.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpdc"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpdc",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations must allow the membership predicate to be set by default to an implementation defined value.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://fedora.info/2018/11/22/spec/#ldpdc"
             },
             "type": "link"
            }
           ],
           "text": "https://fedora.info/2018/11/22/spec/#ldpdc",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Implementations should use the default <> ldp:hasMemberRelation ldp:member",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
