  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Now that ext is no longer explicit in the import-export config file, the verification tool needs to infer and set this attribute based on the rdfLang.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This bug was revealed by the fact that the YAML config always sets the lang explicitly, whereas the old config would allow silent defaulting to turtle.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
