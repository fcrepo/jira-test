  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When creating a resource with the following malformed Link header, a NPE is thrown:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -XPUT -H\"Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#ArchivalGroup"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#ArchivalGroup",
       "type": "text"
      },
      {
       "text": ">\" localhost:8080/rest/test-object ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
