  "description": {
   "content": [
    {
     "content": [
      {
       "text": "1. Create a binary: <resource>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2. `curl -I -u fedoraAdmin:fedoraAdmin <resource> -H \"Want-Digest: sha-256\"`",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "3. verify that the Digest response header looks like this",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "`Digest: sha256=<checksum>`",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "instead of like this",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "`Digest: sha-256=<checksum>`",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
