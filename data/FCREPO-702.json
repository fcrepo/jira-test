  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Update Fedora to use the latest version of Mulgara, currently 2.1.8.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Significant fixes over version 2.1.4 (current version) include - the TQL endpoint now works correctly, in 2.1.4 this generated invalid XML in some circumstances, particularly subqueries; improved optimisation of queries that use UNION, which could impact ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-652#icft=FCREPO-652"
       },
       "type": "inlineCard"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-651#icft=FCREPO-651"
       },
       "type": "inlineCard"
      }
     ],
     "type": "paragraph"
    }
   ],
