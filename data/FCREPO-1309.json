     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The next PR: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/ontology/pull/16"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/ontology/pull/16",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This changes the repository:repository* properties to camelCase (from.dot.notation)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It also capitalizes certain owl:Class names such as repository:configuration, repository:nodeConfiguration and repository:relations",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "A corresponding PR for fcrepo4 is forthcoming",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
