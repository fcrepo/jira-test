     "body": {
      "content": [
       {
        "content": [
         {
          "text": "There will be several PRs associated with this issue. The first is here: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/ontology/pull/15"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/ontology/pull/15",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It removes Lock-related properties and classes from the ontology that are no longer used.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
