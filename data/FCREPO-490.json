     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Attached TestClient.cs – see comments within for instructions on compiling and using it.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This works with the .NET SDK 3.5 and Fedora 3.2.x (with WSDL modifications noted in the attached source), or the upcoming Fedora 3.3 (without WSDL modification)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
