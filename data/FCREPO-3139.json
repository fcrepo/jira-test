     "body": {
      "content": [
       {
        "content": [
         {
          "text": "A potentially different approach could be for Fedora to prefix all files it creates with something like \"fcrepo-\". So in the example in this ticket we would have:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "license.txt # user creates",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "fcrepo-license.txt-description.nt (or fcrepo-license.txt.nt)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "license.txt-description.nt # user creates",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "fcrepo-license.txt-description.nt-description.nt (or fcrepo-license.txt-description.nt)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
