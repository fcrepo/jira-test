     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've moved the export SLF4J/Logback config and dependencies into the fcrepo-import-export-driver:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-import-export/pull/15"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/fcrepo-import-export/pull/15",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This makes logging work for export, and provides the foundation for import logging.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
