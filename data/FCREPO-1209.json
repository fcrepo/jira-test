  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Where are problems uploading big files to fedora using  fedora-client v0.7",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Test to reproduce bug:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "@Test",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "public void addLargeStreamToFedora() throws IOException, FedoraClientException {",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "FedoraCredentials fedoraCredentials =",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "new FedoraCredentials(\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8085/fedora"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8085/fedora",
       "type": "text"
      },
      {
       "text": "\", \"fedoraAdmin\",",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "\"<password>\");",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "FedoraClient fedoraClient = new FedoraClient(fedoraCredentials);",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "AddDatastream addStream =",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "new AddDatastream(\"test:atest1\", \"MAIN\");",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "addStream.mimeType(\"application/pdf\");",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "addStream.controlGroup(\"M\");",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "addStream.dsLabel(\"ds_label_1\");",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Path filePath = Paths.get(\"<path to large file>\");",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "InputStream is = Files.newInputStream(filePath);",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "addStream.content(is);",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "new Ingest(\"test:atest1\").ownerId(\"test\").execute(fedoraClient);",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "addStream.execute(fedoraClient); //java.lang.OutOfMemoryError: Java heap space",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "stack trace:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "addLargeStream(...FedoraRepositoryIT)  Time elapsed: 1.802 sec  <<< ERROR!",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java.lang.OutOfMemoryError: Java heap space",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.util.Arrays.copyOf(Arrays.java:2271)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.io.ByteArrayOutputStream.grow(ByteArrayOutputStream.java:113)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.io.ByteArrayOutputStream.ensureCapacity(ByteArrayOutputStream.java:93)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.io.ByteArrayOutputStream.write(ByteArrayOutputStream.java:140)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at sun.net.www.http.PosterOutputStream.write(PosterOutputStream.java:78)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.api.client.CommittingOutputStream.write(CommittingOutputStream.java:90)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.core.util.ReaderWriter.writeTo(ReaderWriter.java:115)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.core.provider.AbstractMessageReaderWriterProvider.writeTo(AbstractMessageReaderWriterProvider.java:76)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.core.impl.provider.entity.InputStreamProvider.writeTo(InputStreamProvider.java:98)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.core.impl.provider.entity.InputStreamProvider.writeTo(InputStreamProvider.java:59)",
       "type": "text"
