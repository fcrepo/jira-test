     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "// FIXME Consider using not-yet-commons-ssl hostnameverifier",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "// config by property: strict, none, etc.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "config.getProperties().put(",
       "type": "text"
      },
      {
