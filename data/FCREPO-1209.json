      },
      {
       "text": "at com.sun.jersey.client.urlconnection.URLConnectionClientHandler.handle(URLConnectionClientHandler.java:149)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.api.client.filter.HTTPBasicAuthFilter.handle(HTTPBasicAuthFilter.java:104)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
