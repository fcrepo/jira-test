       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.sun.jersey.api.client.WebResource$Builder.post(WebResource.java:568)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at com.yourmediashelf.fedora.client.request.AddDatastream.execute(AddDatastream.java:232)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at....addLargeStream(FedoraRepositoryIT.java:115)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I think, this problem is related to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://stackoverflow.com/questions/11176824/preventing-the-jersey-client-from-causing-an-outofmemory-error-when-posting-larg"
         },
         "type": "link"
        }
       ],
       "text": "http://stackoverflow.com/questions/11176824/preventing-the-jersey-client-from-causing-an-outofmemory-error-when-posting-larg",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "And work around would be use ApacheHttpClient instead of HttpURLConection in com.yourmediashelf.fedora.client.FedoraClent constructor.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Something like:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/**",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Constructor for FedoraClient.",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "     *",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "@param fc credentials for a Fedora repository",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "     */",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "    public FedoraClient(FedoraCredentials fc) {",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "        this.fc = fc;",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "// TODO validate fc",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "// null check for username & password",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "// null check for baseUrl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ClientConfig config = new DefaultClientConfig(); //added",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "config.getProperties().put(DefaultApacheHttpClientConfig.PROPERTY_CHUNKED_ENCODING_SIZE, 0); //added",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "// FIXME this isn't very security-minded",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "if (fc.getBaseUrl().toString().startsWith(\"https\")) {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "SSLContext ctx = null;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "try {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ctx = SSLContext.getInstance(\"SSL\");",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ctx.init(null, null, null);",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "} catch (NoSuchAlgorithmException e) {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "logger.error(e.getMessage(), e);",
       "type": "text"
