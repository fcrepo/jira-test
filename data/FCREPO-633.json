     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Guideline: root pom where submodules share a dependency: always define the version in the root",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Sub-modules, when they have a unique dependency, should declare the version themselves.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
