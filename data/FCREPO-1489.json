  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This change to fcrepo-audit leaks JCR exceptions and uses JCR nodes:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo-audit/commit/3d7d6d348424df73940bf992b2770cdbc92dc3d5#commitcomment-10865344"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo-audit/commit/3d7d6d348424df73940bf992b2770cdbc92dc3d5#commitcomment-10865344",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Refactor to hide the JCR implementation and use Fedora abstractions instead.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
