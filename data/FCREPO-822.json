     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Bug solved, will explain further in next comment. It is a simple problem between PolicyFinder, RetrieveObject and Akubra. Many bits of code do not adhere to the interface, but stuff works most of the time. You found a combo that broke the system",
          "type": "text"
         }
        ],
        "type": "paragraph"
