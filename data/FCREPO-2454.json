  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create subset of production-like ICPSR data in development environment. Test various import-export scenarios; e.g., ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "export entire repository; wipe repository; import entire repository ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "export single object; delete from repository (including tombstone); import object ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "export subset of objects based on membership predicate; delete from repository (including tombstones); import objects",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "The following instructions may be helpful in running the import/export utility:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Download the utility: ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4-labs/fcrepo-import-export/releases"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4-labs/fcrepo-import-export/releases",
           "type": "text"
          },
          {
           "text": " ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "See Readme for running the import/export utility:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4-labs/fcrepo-import-export/blob/master/README.md"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4-labs/fcrepo-import-export/blob/master/README.md",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Have a running Fedora ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "If you do not have a Fedora to test with, you may want to start up the \"one-click run\": ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://wiki.duraspace.org/display/FEDORA4x/Quick+Start#QuickStart-One-ClickRun"
             },
             "type": "link"
            }
           ],
           "text": "https://wiki.duraspace.org/display/FEDORA4x/Quick+Start#QuickStart-One-ClickRun",
           "type": "text"
          },
          {
           "text": " ",
           "type": "text"
          }
         ],
