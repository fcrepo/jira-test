     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:b97337af-3737-473c-9779-44d498499536",
           "text": "@Harshakumar Ummerpillai"
          },
          "type": "mention"
         },
         {
          "text": ", You probably need to use a more recent build of the import utility to import without binaries.  You can download a current master build from: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://s3.amazonaws.com/f4-artifacts/fcrepo-import-export-0.1.1-SNAPSHOT-0e42348f.jar"
            },
            "type": "link"
           }
          ],
          "text": "https://s3.amazonaws.com/f4-artifacts/fcrepo-import-export-0.1.1-SNAPSHOT-0e42348f.jar",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If you want to increase the logging, you can add the parameter \"-Dlog.fcrepo.importexport=DEBUG\".",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
