     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Tested export from current DEV instance on 4.5.x using command",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "java -jar fcrepo-import-export-0.1.0.jar -m export -d /usr/csg-nas/harshau/fcrepo-2454/data -u archonnex:xxxx -r ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://fedora.dev.icpsr.umich.edu/fedora/rest/openicpsr"
            },
            "type": "link"
           }
          ],
          "text": "https://fedora.dev.icpsr.umich.edu/fedora/rest/openicpsr",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Seems to work OK with no binaries",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Importing to a new instance on 4.7.3-RC1 is not working, need some assistance to locate the log and verify the config",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "java -jar fcrepo-import-export-0.1.0.jar -m import -d /usr/csg-nas/harshau/fcrepo-2454/data -r ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://cnsdev0.icpsr.umich.edu:8082/fcrepo2/rest"
            },
            "type": "link"
           }
          ],
          "text": "http://cnsdev0.icpsr.umich.edu:8082/fcrepo2/rest",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
