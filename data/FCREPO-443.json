       "24x24": "https://secure.gravatar.com/avatar/76f80ccd5d368a1d141528c413718a38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FLL-1.png",
       "32x32": "https://secure.gravatar.com/avatar/76f80ccd5d368a1d141528c413718a38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FLL-1.png",
       "48x48": "https://secure.gravatar.com/avatar/76f80ccd5d368a1d141528c413718a38?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FLL-1.png"
      },
      "displayName": "Lukas Lukas",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A882d30fe-4a1f-4559-bf2c-8a768cbad5e4",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I believe Fedora should have Shibboleth support by itself, without the required use of Muradora. We (University of Vienna) are using Fedora alone, and we'd like to put it into our Shibboleth infrastructure.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
