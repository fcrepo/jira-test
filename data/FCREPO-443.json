      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Most of this is being dealt with by FESL, please keep an eye on that project.  Right now we're not sure whether FESL is going to handle the Shib redirect to the WAYF.  If it doesn't, a new issue will need to be entered.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
