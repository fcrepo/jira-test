     "attrs": {
      "localId": "c43bd41e443f"
     },
     "content": [
      {
       "text": "Reindexing would probably resolve the issue if it comes up for anyone, or deleting the leftover entries from the DB. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
