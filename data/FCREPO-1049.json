  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Improve the control over writeLimit in getDatastreamFromTika. ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Currently, a writeLimit of 100k characters is enforced by Tika,",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "and those characters are not available in the index field, ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "when exception is thrown.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
