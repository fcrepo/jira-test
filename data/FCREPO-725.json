  "description": {
   "content": [
    {
     "content": [
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-64#icft=FCREPO-64"
       },
       "type": "inlineCard"
      },
      {
       "text": " introduces persisting size of M datastreams in FOXML and reporting these via API calls.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Implement SIZE attribute for E and R datastreams:  eg when the SIZE attribute is requested, do a HEAD request on the external content (following redirects as necessary) and report the HTTP response Content-Length header.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Ensure these attributes are provided by HEAD requests for datastream dissemination via the REST API.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
