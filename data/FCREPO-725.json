     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Solution for this should ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "strong"
           }
          ],
          "text": "not",
          "type": "text"
         },
         {
          "text": " require that all configurations of Fedora get these size values (e.g, it's a lot of extra work+cost to do this if they're already known)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
