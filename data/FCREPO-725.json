       "48x48": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png"
      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Work-around for this is to use the REST API.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "For E datastreams, HEAD does show the content size (without actually retrieving the stream, tested by referencing a 1GB file and doing a HEAD).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "For R datastreams it would be necessary to follow the redirect, and do a HEAD on the destination URL.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
