      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/628068f58d175962c7274ca5ca03993f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAS-3.png",
       "24x24": "https://secure.gravatar.com/avatar/628068f58d175962c7274ca5ca03993f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAS-3.png",
       "32x32": "https://secure.gravatar.com/avatar/628068f58d175962c7274ca5ca03993f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAS-3.png",
       "48x48": "https://secure.gravatar.com/avatar/628068f58d175962c7274ca5ca03993f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAS-3.png"
      },
      "displayName": "A. Soroka",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A24c578cc-15e9-4649-9f68-5eace85735e0",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The current test for URL-encoding is:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "dissURL.indexOf(\"=(\") != -1",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Changing this to:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "dissURL.indexOf(\"(\" + bindingKeyPattern + \")\") > 0",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "will create the following changes in behavior:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Input pattern 1:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "dissURL?queryparameter=(bindingKey)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Old output pattern:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "dissURL?queryparameter=URL-encoded-datastream-URL",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "New output pattern:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Same.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Input pattern 2:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "dissURL/(bindingKey)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Old output pattern:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "dissURL/NON-URL-encoded-datastream-URL",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "New output pattern:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "dissURL/URL-encoded-datastream-URL",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Input pattern 3:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "(bindingKey)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Old output pattern:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "URL-encoded-datastream-URL",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "New output pattern:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "NON-URL-encoded-datastream-URL",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The immediate advantage is that using datastream URLs as part of the ultimate dissemination URL becomes practical. This allows for the storage of service addresses as external datastreams, and the ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "em"
           }
          ],
          "text": "form",
          "type": "text"
         },
         {
          "text": " of action against them to be encoded in dissemination metadata.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
