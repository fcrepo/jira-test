  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Doing some testing on Fedora 5.1.0:Given /fcrepo/rest/parent and  /fcrepo/rest/resource/child:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "If  userA has read and write access to parent but no access to child,  userA can issue a delete to /fcrepo/rest/parent and delete the child as well.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "#Create a resource and child",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -X PUT ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/resource"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/resource",
       "type": "text"
      },
      {
       "text": " -u fedoraAdmin:secret3",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -X PUT ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/resource/child"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/resource/child",
       "type": "text"
      },
      {
       "text": " -u fedoraAdmin:secret3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "PUT the following ACLs: ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "unrestricted-parent.ttl:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "@prefix webac: <http://fedora.info/definitions/v4/webac#> .\r\n@prefix acl: <http://www.w3.org/ns/auth/acl#> .\r\n<> a webac:Acl .\r\n<#auth1> a acl:Authorization;\r\nacl:mode acl:Read, acl:Write;\r\nacl:accessTo </fcrepo/rest/resource>;\r\n acl:agent \"testuser\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "curl -X PUT ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/resource/fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/resource/fcr:acl",
       "type": "text"
      },
      {
       "text": " -H \"Content-Type:text/turtle\" -d \"@unrestricted-parent.ttl\" -u fedoraAdmin:secret3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "restricted-child.ttl:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "@prefix webac: <http://fedora.info/definitions/v4/webac#> . @prefix acl: <http://www.w3.org/ns/auth/acl#> .<> a webac:Acl .<#child> a acl:Authorization; acl:mode acl:Read; acl:accessTo </fcrepo/rest/resource/child>; acl:agent \"testuser\" .",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "curl -X PUT ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/resource/child/fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/resource/child/fcr:acl",
       "type": "text"
      },
      {
       "text": " -H \"Content-Type:text/turtle\" -d \"@restricted-child.ttl\" -u fedoraAdmin:secret3 -v",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Try to delete the child with the test user - you should get a 403:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X DELETE -u testuser:password1 ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/resource/child"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/resource/child",
       "type": "text"
      },
      {
       "text": " -v",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Now delete the parent (204):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X DELETE -u testuser:password1 ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/resource"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/resource",
       "type": "text"
      },
      {
       "text": " -v ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
