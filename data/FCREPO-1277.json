     "body": {
      "content": [
       {
        "content": [
         {
          "text": "@awoods in terms of debug logging, do you suggest following Sonar's suggestion to \"Guard Debug Logging\" ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://sonar.fcrepo.org/drilldown/issues/4666"
            },
            "type": "link"
           }
          ],
          "text": "http://sonar.fcrepo.org/drilldown/issues/4666",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "if (LOGGER.isDebugEnabled()) {",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "LOGGER.debug(\"foo\");",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "or just do seems to be the existing convention in the f4 codebase (without the guards):",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "LOGGER.debug(\"foo\");",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
