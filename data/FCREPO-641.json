     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fixed for 3.3.1 by ensuring Constant.FEDORA_HOME is set properly in CleanupContextListener, which runs before any servlet filters or servlets are started.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
