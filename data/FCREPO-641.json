      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As Eddie pointed out in ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-660#icft=FCREPO-660"
          },
          "type": "inlineCard"
         },
         {
          "text": " (a dupe of this bug), for trunk, this was serendipitously addressed by r8516 (done for FCREPO-630: move to slf4j), with the addition of org.fcrepo.server.utilities.LogSetupContextListener which now houses the code in ServletController that was responsible for setting servlet.fedora.home.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
