     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The implementation is part of the existing datastream profile method.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "It has the URL: objects/datastreams/{dsId}?validateChecksum=true",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "The datastream profile contains a new element:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<datastreamProfile ...>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "..",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<dsChecksumType>MD5</dsChecksumType>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<dsChecksum>a0983389fede930...</dsChecksum>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<dsChecksumValid>true</dsChecksumValid>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</datastreamProfile>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
