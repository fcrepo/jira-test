            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-server/src/main/java/org/fcrepo/server/rest/DefaultSerializer.java",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I'd expect the test to be in:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-integrationtest/fcrepo-integrationtest-core/src/main/java/org/fcrepo/test/api/TestRESTAPI.java"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo/fcrepo/blob/master/fcrepo-integrationtest/fcrepo-integrationtest-core/src/main/java/org/fcrepo/test/api/TestRESTAPI.java",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "but I don't see this parameter tested in testGetDatastreamProfile.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
