  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The current FeSL debug message definition (commented out by default):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<layout class=\"ch.qos.logback.classic.PatternLayout\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<Pattern>%p %d{yyyy-MM-dd' 'HH:mm:ss.SSS} [%t] (%c{0}",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ") %m%n</Pattern>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</layout>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "...does not log useful information:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INFO 2012-12-14 10:40:16.546 [localhost-startStop-1] (AuthFilterJAAS\\INFO 2012-12-14 10:40:16.547 [localhost-startStop-1] (AuthFilterJAAS\\DEBUG 2012-12-14 10:40:50.783 [http-bio-8080-exec-1] (AuthFilterJAAS\\DEBUG 2012-12-14 10:40:50.822 [http-bio-8080-exec-1] (AuthFilterJAAS\\DEBUG 2012-12-14 10:41:05.232 [http-bio-8080-exec-2] (AuthFilterJAAS\\DEBUG 2012-12-14 10:41:05.232 [http-bio-8080-exec-2] (AuthFilterJAAS\\DEBUG 2012-12-14 10:41:05.237 [http-bio-",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "If the <layout> stanza is changed to the <encoder> pattern used earlier in the file:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<encoder>                                                           ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<pattern>%p %d{yyyy-MM-dd' 'HH:mm:ss.SSS} [%t] (%c{0}) %m%n</pattern>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</encoder>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "...then useful log information is shown:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INFO 2012-12-14 10:49:43.737 [localhost-startStop-1] (AuthFilterJAAS) initialised servlet filter: org.fcrepo.server.security.jaas.AuthFilterJAAS",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "DEBUG 2012-12-14 10:50:12.552 [http-bio-8080-exec-1] (AuthFilterJAAS) incoming filter: org.fcrepo.server.security.jaas.AuthFilterJAAS",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "DEBUG 2012-12-14 10:50:12.559 [http-bio-8080-exec-1] (AuthFilterJAAS) session-id: E5CDACC6C976F548887FAB498B7E717D",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "DEBUG 2012-12-14 10:50:12.564 [http-bio-8080-exec-1] (AuthFilterJAAS) auth username: admin",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
