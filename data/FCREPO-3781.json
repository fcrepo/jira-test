   "comments": [
    {
     "author": {
      "accountId": "6089a55c52a3d400690692f7",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a55c52a3d400690692f7/7a62c587-b0f1-4cd4-982c-21b3837dc64a/16",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a55c52a3d400690692f7/7a62c587-b0f1-4cd4-982c-21b3837dc64a/24",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a55c52a3d400690692f7/7a62c587-b0f1-4cd4-982c-21b3837dc64a/32",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a55c52a3d400690692f7/7a62c587-b0f1-4cd4-982c-21b3837dc64a/48"
      },
      "displayName": "Ralf Claussnitzer",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a55c52a3d400690692f7",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I’m not absolutely sure how Spring Boot looks for components, but I think a drop-in directory that contains JARs should be possible to some extend.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This brings up some more intricate questions:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "What must be provided for the development of such extensions (provided dependencies)?",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "What is the packaging format for extensions, if they themselves depend on other libraries (SpringBoot format)?",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Security considerations",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "The Karaf OSGI runtime had this covered. What’s the solution for Spring Boot?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
