      "displayName": "Danny Bernstein",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785e2552404d0070bf1d34",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "When upgrading from f5 to f6,  the base uri's (which context the context root) are replaced with an internal fedora ID prefix.  Thus it is not necessary to translate the context root on export since all base uris on fedora resources are stripped out anyway in the process of being written to OCFL. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
