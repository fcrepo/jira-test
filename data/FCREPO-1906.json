       "48x48": "https://secure.gravatar.com/avatar/1d2a87f5e6a357f4cfbfe28673c56d2e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FYC-1.png"
      },
      "displayName": "Yinlin Chen",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Acc6016b1-6dae-4b52-922c-9076d2e8b96d",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Success!",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Steps: ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1. a Fedora with LevelDB, create two containers and one binary",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "2. backup: curl -X POST \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/fcrepo4/rest/fcr:backup"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/fcrepo4/rest/fcr:backup",
          "type": "text"
         },
         {
          "text": "\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "3. a new Fedora server with MySQL, verify table ispn is created",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "4. restore: curl -X POST --data-binary \"/home/ubuntu/1455291318495-0\" \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/fcrepo4/rest/fcr:restore"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/fcrepo4/rest/fcr:restore",
          "type": "text"
         },
         {
          "text": "\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "5. Verify containers and binary file. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
