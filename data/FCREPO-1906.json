  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Migrate backup dump from LevelDB to a Fedora repo with MySQL.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Steps:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1. Create backup dump from a Fedora with LevelDB",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. Create a Fedora with MySQL",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. Restore backup to that Fedora with MySQL",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "4. Verify the data consistency with these two Fedora servers.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
