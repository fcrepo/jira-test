       "32x32": "https://secure.gravatar.com/avatar/91ba3ae46b5ff6357fbe55622c5d3f9a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDD-4.png",
       "48x48": "https://secure.gravatar.com/avatar/91ba3ae46b5ff6357fbe55622c5d3f9a?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDD-4.png"
      },
      "displayName": "Daniel Davis",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A19472d6c-63f5-479e-9de0-57b80681cff8",
      "timeZone": "America/New_York"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: fcswa",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=1855086",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: NO",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This is just to track SRB module issues prior to the \"official\" target release",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "with Fedora 2.2.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "I have been unable to get the SRB module to work when Fedora (2.1.1) is",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "located behind a NAT'ed router. If you are behind a firewall, you must open a",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "minimum range of 16 ports and specify that port range in fedora.fcfg.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "The rebuilder utility does not yet work with an SRB lowlevel store.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "There appear to be two regression bugs: one related to Multipart POSTs when",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "ssl is not configured and a one related to the",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "DisseminationService/ExternalContentManager returning 500/403 errors.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
     },
