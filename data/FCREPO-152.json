  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Use fedora.common.Constants for public constants that don't clearly belong to a single interface or class.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We should also have more specific guidelines in this area as part of the coding standards.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Look into all classes, but here are some specific ones to investigate:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora.server.storage.types.Datastream",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora.server.storage.types.DigitalObject",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
