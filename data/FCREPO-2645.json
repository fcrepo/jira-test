  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently you can't use fedora: namespaced properties but you can create fedora namespaced resources.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This ticket is to block interaction with any URI with ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "/fedora:",
       "type": "text"
      },
      {
       "text": " inside.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Use of the hasFedoraNamespace predicate can be useful",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-kernel-api/src/main/java/org/fcrepo/kernel/api/RdfLexicon.java#L258-L259"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-kernel-api/src/main/java/org/fcrepo/kernel/api/RdfLexicon.java#L258-L259",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Return a 409 Conflict with an appropriate explanation.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
