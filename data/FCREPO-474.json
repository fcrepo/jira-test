  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Richard Green reports:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We have recently had a small issue with oaiprovider when the British Library tried to harvest our thesis metadata.  Using the ListRecords verb results in a set of records each wrapped as",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<record xmlns=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.openarchives.org/OAI/2.0/"
         },
         "type": "link"
        }
       ],
       "text": "http://www.openarchives.org/OAI/2.0/",
       "type": "text"
      },
      {
       "text": " <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.openarchives.org/OAI/2.0/"
         },
         "type": "link"
        }
       ],
       "text": "http://www.openarchives.org/OAI/2.0/",
       "type": "text"
      },
      {
       "text": ">  \">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</record>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Instead of just",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<record>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</record>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This caused them some problems because one of their transforms wasn't set up to deal with this response which seems, from the OAI-PMH spec, to be non-standard.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To fix this issue, Simon removed the following from Line 173 of FedoraOAIDriver.java :-",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "out.println(\"<record xmlns=\\\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.openarchives.org/OAI/2.0/"
         },
         "type": "link"
        }
       ],
       "text": "http://www.openarchives.org/OAI/2.0/\\",
       "type": "text"
      },
      {
       "text": "\">\");",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "And replaced with:-",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "out.println(\"<record>\");  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
