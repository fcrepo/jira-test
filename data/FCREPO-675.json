  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently the REST api does not provide a way to get a datastream's version history – you've got to parse the foxml to get that info.  getDatastreamHistory should be exposed at",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/objects/{pid}/datastreams/{dsID}/versions",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
