  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently, GET-ting a binary resource always includes the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "em"
        }
       ],
       "text": "content-disposition: attachment",
       "type": "text"
      },
      {
       "text": " header (plus other related information), triggering a download prompt in the browser and making it impossible to examine suitable resources directly inline. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "There is also an old Fedora 4.X issue concerning this: ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-1843"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
