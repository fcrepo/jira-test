  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Fedora is difficult to work with in a CRUD workflow. There are no way to create a new object. This fix would provide an api function, that allow the user to copy a fedora object. Thus, certain objects can be specified as template objects with default values.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
