   "content": [
    {
     "content": [
      {
       "text": "I tried creating an archival group with",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -i -ufedoraAdmin:fedoraAdmin -H\"Slug: test1\" -H'Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#ArchivalGroup"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#ArchivalGroup",
       "type": "text"
      },
      {
       "text": ">;rel=\"type\"' -H\"Content-type: text/turtle\" -XPOST ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "and then creating a child object with",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -i -ufedoraAdmin:fedoraAdmin -H\"Slug: child1\" -H\"Content-type: text/turtle\" -XPOST ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test1"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Then I stopped and restarted the server and tried to delete the child object with",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -ufedoraAdmin:fedoraAdmin -i ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/test1/child1"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/test1/child1",
       "type": "text"
      },
      {
       "text": " -XDELETE",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "and got",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "HTTP/1.1 500 Internal Server Error",
