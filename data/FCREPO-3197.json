  "description": {
   "content": [
    {
     "content": [
      {
       "text": "In-line XML datastreams migrated from Fedora 3 to OCFL do not contain an XML declaration. This declaration is is optional in XML 1.0, but common practice.  It is mandatory in XML 1.1. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Please consider adding a declaration such as:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
