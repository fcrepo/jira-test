     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This is now possible on a single-object basis by base64-encoding managed content (Fedora 2.2), or using the new AtomZip ingest format (Fedora 3.0)",
          "type": "text"
         }
        ],
