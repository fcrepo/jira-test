  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As a follow-on to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.lyrasis.org/browse/FCREPO-3232,"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.lyrasis.org/browse/FCREPO-3232,",
       "type": "text"
      },
      {
       "text": " the following wiki documentation pages must be updated:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://wiki.lyrasis.org/display/FEDORA6x/Versioning"
             },
             "type": "link"
            }
           ],
           "text": "https://wiki.lyrasis.org/display/FEDORA6x/Versioning",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "marks": [
            {
             "attrs": {
              "href": "https://wiki.lyrasis.org/display/FEDORA6x/RESTful+HTTP+API+-+Versioning"
             },
             "type": "link"
            }
           ],
           "text": "https://wiki.lyrasis.org/display/FEDORA6x/RESTful+HTTP+API+-+Versioning",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "In addition to other documentation updates, the following note should be include:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> The memento API has second level granularity. If you attempt to create multiple mementos within the same second, then only the last memento created will be accessible.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
