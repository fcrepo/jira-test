     "author": {
      "accountId": "6089a594bb0b0500707c78d8",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/16",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/24",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/32",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/48"
      },
      "displayName": "Dan Field",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a594bb0b0500707c78d8",
      "timeZone": "Europe/London"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Do we actually use java-jsonld? I’m struggling to find it used in the codebase and commenting it out on the pom.xml results in a clean build and I can query successfully for an application/ld+json response ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "EDIT: It looks to be coming in via jena 4. jena 5 has moved to titanium but 4 includes the following in their pom",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "     <!-- JSON-LD 1.0 -->\n    <!-- jsonld-java depends on depends on Jackson core\n         and Jackson databind. databind has had a few CVEs\n         so we exclude from jsonldjava and select the version\n         ourselves.\n         When upgrading jsonld, consult jsonld-java's\n         POM for the correct dependency versions\n         and use that or later.\n    -->\n    <ver.jsonldjava>0.13.6</ver.jsonldjava>\n    ...\n           <!-- jsonld-java for JSON-LD 1.0 -->\n       <dependency>\n         <groupId>com.github.jsonld-java</groupId>\n         <artifactId>jsonld-java</artifactId>\n         <version>${ver.jsonldjava}</version>",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
      "type": "doc",
      "version": 1
     },
