       {
        "content": [
         {
          "text": "fedora.client.utility.AutoFinder is passing in values of null/null for username/password when it attempts to create an instance of FedoraClient. A null value for username is not allowed downstream which is generating the error message: \"Username may not be null\".",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
