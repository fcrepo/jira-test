      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Updated the fedora-find utility to require a username and password, which is passed to FedoraClient, enabling it to work correctly. Requiring credentials for use of the fedora-find utility is expected when API-A authentication is turned on, but these changes require credentials in all cases in order to get around needing to perform a check of the server configuration before operating.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
