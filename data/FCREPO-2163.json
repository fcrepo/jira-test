      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Note: When implementing this, the integration-tests will need the following configuration:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "ExampleIT.java",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "client = FcrepoClient.client().credentials(\"fedoraAdmin\", \"password\").authScope(\"localhost\").build();",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "web.xml",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "<!--filter to add test auth to grizzly -->\r\n  <filter>\r\n    <filter-name>TestAuth</filter-name>\r\n    <filter-class>org.fcrepo.http.commons.test.util.TestAuthenticationRequestFilter</filter-class>\r\n  </filter>\r\n\r\n  <filter-mapping>\r\n    <filter-name>TestAuth</filter-name>\r\n    <url-pattern>/rest/*</url-pattern>\r\n  </filter-mapping>",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "test-repository.json",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "\"security\" : {\r\n        \"anonymous\" : {\r\n            \"roles\" : [\"readonly\",\"readwrite\",\"admin\"],\r\n            \"useOnFailedLogin\" : false\r\n        },\r\n        \"providers\" : [\r\n            { \"classname\" : \"org.fcrepo.auth.common.ServletContainerAuthenticationProvider\" }\r\n        ]\r\n    },",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
      "type": "doc",
      "version": 1
     },
