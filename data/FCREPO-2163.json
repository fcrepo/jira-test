      "timeZone": "America/Halifax"
     },
     "body": "<p>Note: When implementing this, the integration-tests will need the following configuration:</p>\n\n<p>ExampleIT.java</p>\n<div class=\"code panel\" style=\"border-width: 1px;\"><div class=\"codeContent panelContent\">\n<pre class=\"code-java\">\r\n        client = FcrepoClient.client().credentials(<span class=\"code-quote\">\"fedoraAdmin\"</span>, <span class=\"code-quote\">\"password\"</span>).authScope(<span class=\"code-quote\">\"localhost\"</span>).build();\r\n</pre>\n</div></div>\n\n<p>web.xml</p>\n<div class=\"code panel\" style=\"border-width: 1px;\"><div class=\"codeContent panelContent\">\n<pre class=\"code-java\">\r\n   &lt;!--filter to add test auth to grizzly --&gt;\r\n  &lt;filter&gt;\r\n    &lt;filter-name&gt;TestAuth&lt;/filter-name&gt;\r\n    &lt;filter-<span class=\"code-keyword\">class&</span>gt;org.fcrepo.http.commons.test.util.TestAuthenticationRequestFilter&lt;/filter-<span class=\"code-keyword\">class&</span>gt;\r\n  &lt;/filter&gt;\r\n\r\n  &lt;filter-mapping&gt;\r\n    &lt;filter-name&gt;TestAuth&lt;/filter-name&gt;\r\n    &lt;url-pattern&gt;/<span class=\"code-keyword\">rest</span>/*&lt;/url-pattern&gt;\r\n  &lt;/filter-mapping&gt;\r\n</pre>\n</div></div>\n\n<p>test-repository.json</p>\n<div class=\"code panel\" style=\"border-width: 1px;\"><div class=\"codeContent panelContent\">\n<pre class=\"code-java\">\r\n    <span class=\"code-quote\">\"security\"</span> : {\r\n        <span class=\"code-quote\">\"anonymous\"</span> : {\r\n            <span class=\"code-quote\">\"roles\"</span> : [<span class=\"code-quote\">\"readonly\"</span>,<span class=\"code-quote\">\"readwrite\"</span>,<span class=\"code-quote\">\"admin\"</span>],\r\n            <span class=\"code-quote\">\"useOnFailedLogin\"</span> : <span class=\"code-keyword\">false</span>\r\n        },\r\n        <span class=\"code-quote\">\"providers\"</span> : [\r\n            { <span class=\"code-quote\">\"classname\"</span> : <span class=\"code-quote\">\"org.fcrepo.auth.common.ServletContainerAuthenticationProvider\"</span> }\r\n        ]\r\n    },\r\n</pre>\n</div></div>",
     "created": "02/Sep/16 7:00 PM",
     "id": "17366",
     "jsdPublic": true,
