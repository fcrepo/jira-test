  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The LDP Working Group is currently leaning towards using LDPatch as the preferred LDP PATCH language:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/TR/ldpatch/"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/TR/ldpatch/",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We should investigate supporting LDPatch and add support if possible.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "BananaRDF (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/w3c/banana-rdf)"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/w3c/banana-rdf)",
       "type": "text"
      },
      {
       "text": " supports LDPatch.",
       "type": "text"
      }
     ],
     "type": "paragraph"
