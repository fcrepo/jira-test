     "body": {
      "content": [
       {
        "content": [
         {
          "text": "\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "curl -i -X POST \"http://localhost:8080/rest/fcr:tx/fd4f48c4-7c47-46ee-8907-af6411ae4215\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Returns a ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "atomic-expires:",
          "type": "text"
         },
         {
          "text": " header with the new expiration date. Each POST adds 3 minutes to the expiration date, so you can add 9 minutes just calling it 3 times.”",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
