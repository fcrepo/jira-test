  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to review and update the audit logging logic to avoid output like the following:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2017-01-08 10:59:39,544 import /import-export-testing/data/fcrepo/rest/collection0.ttl to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/collection0"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/collection0/../collection0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Note above: \"/rest/collection0/../collection0\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce the above output:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1. Create a resource in your Fedora repo (collection0)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. Export that resource:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -jar fcrepo-import-export-0.1.0.jar -b -a -d data -m export -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/f4/rest/collection0"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/f4/rest/collection0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. Import that resource:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -jar fcrepo-import-export-0.1.0.jar -b -a -d data -m import -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/f4/rest/collection0"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/f4/rest/collection0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "4. Inspect log, see:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "/rest/collection0/../collection0",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FF/Sprint+3+Feedback+-+A+Woods"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FF/Sprint+3+Feedback+-+A+Woods",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
