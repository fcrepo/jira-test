  "description": {
   "content": [
    {
     "content": [
      {
       "text": "After installation, configuration parameters regarding Fedora host name and OAI contact information is not reflected in Fedora configuration after start.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Although the settings in server/conf/fedora.fcfg are in place, Fedora (namely DescribeRepositoryServlet) shows default properties from deployed WEB-INF/classes/applicationContext.xml.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
