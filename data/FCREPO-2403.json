     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This one is fixed.  I tested by uploading a 1GB file.  The sha256 checksum took a few seconds while passing an invalid digest algorithm resulted in an immediate 400.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
