     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Difficult to implement without transactioning.  See ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-842#icft=FCREPO-842"
          },
          "type": "inlineCard"
         },
         {
          "text": " instead, which is for the safest way of handling this - ie changes always get committed to the datastream, even if the DBXML indexing fails (handle policy index add/update/delete in a \"safe\" way)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
