  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Adding/editing an invalid FESLPOLICY datastream results in a failure of the API call, however the changes are saved.  This is due to the order in which policies are propagated to dbxml - after the main API call has been made.  Need to cater for the situation where both the API call and/or the propagation to dbxml (where the validation takes place) could fail.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Probably not a blocker for 3.4.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
