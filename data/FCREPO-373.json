     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Bill and I decided that the upgrade from 3.0 should require a fresh install of Fedora, while pointing at the old data/configuration (no rebuild required).  The system objects will be auto-upgraded on the first run of this new instance. The exact process the user needs to follow will be hashed out in the 3.1 upgrade guide.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
