    {
     "content": [
      {
       "text": "When attempting to rebuild the fedora db, I am getting the following error on my very first object:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "none"
     },
     "content": [
      {
       "text": "ERROR 18:53:10.880 [ReindexWorker-2] (ReindexWorker) Reindexing of OCFL id info:fedora/17/db/8e/98/17db8e98-3746-4cc1-9a65-5e967c2c47a4 failed\nfcrepo_1      | org.fcrepo.storage.ocfl.exception.ValidationException: OCFL object info:fedora/17/db/8e/98/17db8e98-3746-4cc1-9a65-5e967c2c47a4 is not a valid Fedora 6 object. The following problems were identified:\nfcrepo_1      |   1. [Version v1] Missing root header file at .fcrepo/fcr-root.json\nfcrepo_1      | \tat org.fcrepo.storage.ocfl.exception.ValidationException.createForObject(ValidationException.java:60)\nfcrepo_1      | \tat org.fcrepo.storage.ocfl.validation.Context.throwValidationException(Context.java:76)\nfcrepo_1      | \tat org.fcrepo.storage.ocfl.validation.ObjectValidator$ObjectValidatorInner.validate(ObjectValidator.java:118)\nfcrepo_1      | \tat org.fcrepo.storage.ocfl.validation.ObjectValidator.validate(ObjectValidator.java:85)\nfcrepo_1      | \tat org.fcrepo.persistence.ocfl.impl.ReindexService.indexOcflObject(ReindexService.java:109)\nfcrepo_1      | \tat org.fcrepo.persistence.ocfl.impl.ReindexWorker.lambda$run$0(ReindexWorker.java:118)\nfcrepo_1      | \tat org.fcrepo.common.db.DbTransactionExecutor.lambda$doInTx$3(DbTransactionExecutor.java:91)\nfcrepo_1      | \tat org.springframework.transaction.support.TransactionOperations.lambda$executeWithoutResult$0(TransactionOperations.java:68)\nfcrepo_1      | \tat org.springframework.transaction.support.TransactionTemplate.execute(TransactionTemplate.java:140)\nfcrepo_1      | \tat org.springframework.transaction.support.TransactionOperations.executeWithoutResult(TransactionOperations.java:67)\nfcrepo_1      | \tat org.fcrepo.common.db.DbTransactionExecutor.doInTx(DbTransactionExecutor.java:90)\nfcrepo_1      | \tat org.fcrepo.common.db.DbTransactionExecutor.lambda$doInTxWithRetry$2(DbTransactionExecutor.java:74)\nfcrepo_1      | \tat net.jodah.failsafe.Functions.lambda$toSupplier$10(Functions.java:240)\nfcrepo_1      | \tat net.jod