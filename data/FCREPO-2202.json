  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "export a resource from Fedora using the export utility.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "delete that resource (a tombstone is left behind).",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "try to import back into the same repository.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Currently, this does not work. The export utility could be enhanced to allow for this use case, perhaps by having a flag for 'remove tombstone' or 'overwrite existing resource' ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
