     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Demo code that uses ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-603#icft=FCREPO-603"
          },
          "type": "inlineCard"
         },
         {
          "text": " sounds good to me.  If it doesn't currently work at the very least it should be removed as it's potentially misleading to people (or consuming their time uneccesarily)",
