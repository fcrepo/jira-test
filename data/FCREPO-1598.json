  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When the fcrepo camel component autoloads in a route, the following exception is issued: Could not initialize class org.apache.http.conn.ssl.SSLConnectionSocketFactory.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Seems to have to do with a dependency failing to declare an export.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
