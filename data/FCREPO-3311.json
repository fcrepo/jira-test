  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When PATCHing with a statement like",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "color": "#6a8759"
         },
         "type": "textColor"
        }
       ],
       "text": "prefix ldp: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#"
         },
         "type": "link"
        },
        {
         "attrs": {
          "color": "#6a8759"
         },
         "type": "textColor"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "color": "#6a8759"
         },
         "type": "textColor"
        }
       ],
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "color": "#6a8759"
         },
         "type": "textColor"
        }
       ],
       "text": "DELETE { <> ldp:membershipResource ?o }",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "color": "#6a8759"
         },
         "type": "textColor"
        }
       ],
       "text": "INSERT { <> ldp:membershipResource </rest/someResource> }",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "color": "#6a8759"
         },
         "type": "textColor"
        }
       ],
       "text": "WHERE { <> ldp:membershipResource ?o }",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "The final graph contains",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "(triple <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:59512/rest/f7407624-da02-4617-acca-3b5d30e3a70b/322fd97b-3b0d-4237-86f2-9ff98ce86b85"
         },
         "type": "link"
        },
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "http://localhost:59512/rest/f7407624-da02-4617-acca-3b5d30e3a70b/322fd97b-3b0d-4237-86f2-9ff98ce86b85",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#membershipResource"
         },
         "type": "link"
        },
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#membershipResource",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "> <info:/rest/someResource>)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "color": "#172b4d"
         },
         "type": "textColor"
        }
       ],
       "text": "There is soon to be code in the HttpIdentifierConverter to account for these as external Ids and correctly convert them to internal IDs.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
