    {
     "author": {
      "accountId": "60785ded115da6006f540529",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "In trying to reproduce the issue described in this ticket, I perform the following steps:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1. Create basic container",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$ curl -i -XPUT -H'Link: <",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/ns/ldp#BasicContainer"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/ns/ldp#BasicContainer",
          "type": "text"
         },
         {
          "text": ">; rel=\"type\"' -H\"Content-type: text/turtle\" --data-binary @body.rdf localhost:8080/rest/box",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Where body.rdf is:",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "```",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "<> <",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://awoods.com/#title"
                },
                "type": "link"
               }
              ],
              "text": "http://awoods.com#title",
              "type": "text"
             },
             {
              "text": "> \"A title\"",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "```",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "2. Verify the user-triple was created",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$ curl localhost:8080/rest/box",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "3. Update the container with a new triple",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$ curl -i -XPATCH -H\"Content-type: application/sparql-update\" --data-binary @update.su localhost:8080/rest/box",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Where update.su is:",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "```",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "INSERT { <> <",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://awoods.com/#relation"
                },
                "type": "link"
               }
              ],
              "text": "http://awoods.com#relation",
              "type": "text"
             },
             {
              "text": "> <",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://localhost:8080/rest/someOtherResource"
                },
                "type": "link"
               }
              ],
              "text": "http://localhost:8080/rest/someOtherResource",
              "type": "text"
             },
             {
              "text": "> } WHERE {}",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "```",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "4. Verify the triple was inserted",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$ curl localhost:8080/rest/box",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "..all is well. Should the test be different to demonstrate the issue?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
