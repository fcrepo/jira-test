       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a594bb0b0500707c78d8/e0c89ba4-1407-406d-af50-dc665f216277/48"
      },
      "displayName": "Dan Field",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a594bb0b0500707c78d8",
      "timeZone": "Europe/London"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "marks": [
           {
            "type": "em"
           }
          ],
          "text": "On one of our instances which has about 70k objects, uploading suddenly started to take more than 1min. I tracked this down to Fedora committing a transaction (which we use to reduce OCFL versions).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "attrs": {
           "url": "https://fedora-project.slack.com/archives/C8B5TSR4J/p1750791389094999"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
