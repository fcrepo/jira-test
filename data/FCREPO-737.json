     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The WSDL schema have been inlined in the content model. The demo objects are now validated. All validate, after I fixed them. Have not looked at the examples on the wiki",
          "type": "text"
         }
        ],
        "type": "paragraph"
