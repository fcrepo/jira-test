     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The following returns a 500 response. We need better exception handling such that this is a 400 response:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "curl -i -H\"digest: sha1:1234\" -XPUT -H\"Content-Type: image/jpeg\" --data-binary @image.jpg localhost:8080/rest/image.jpg",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "Here is a minor PR against your working branch:",
