  "description": {
   "content": [
    {
     "content": [
      {
       "text": "org.fcrepo.client.FedoraClient internally uses a instance of org.apache.http.impl.client.CloseableHttpClient to execute requests.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The development tutorial for HttpClient 4.5.x states in section 1.2.2 (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://hc.apache.org/httpcomponents-client-4.5.x/current/tutorial/html/fundamentals.html#d5e217):"
         },
         "type": "link"
        }
       ],
       "text": "https://hc.apache.org/httpcomponents-client-4.5.x/current/tutorial/html/fundamentals.html#d5e217):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "\"When an instance ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "CloseableHttpClient",
       "type": "text"
      },
      {
       "text": " is no longer needed and is about to go out of scope the connection manager associated with it must be shut down by calling the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "CloseableHttpClient#close()",
       "type": "text"
      },
      {
       "text": " method.\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Therefore FedoraClient should implement java.io.Closable to correctly shutdown the connection manager associated with the HttpClient.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
