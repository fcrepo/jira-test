  "description": {
   "content": [
    {
     "content": [
      {
       "text": "currently, migration-utils will use the FOXML datastream \"ID\" value for the filename property. It would be useful if for specific datastreams (e.g. OBJ), the datastream \"LABEL\" (technically the datastreamVersion LABEL) could be used instead. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
