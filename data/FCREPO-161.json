     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: pangloss",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=487398",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: YES",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I believe this behavior was introduced with the RI refactoring in 2.2. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "BaseTripleGenerator.add(SubjectNode subject, PredicateNode predicate, Date dateValue, Set<Triple> set) is calling DateUtility.convertDateToString() which (rightfully) isn't mindful of XSD dateTime considerations.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I'll commit a fix for this in dev-143888 (Update Trippi for Mulgara).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
