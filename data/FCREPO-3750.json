  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The membership indexing is done in a single tx. If the indexing takes too long, the tx expires, causing a failure.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ERROR 01:48:27.887 [ReindexWorker-2] (ReindexWorker) Reindexing of OCFL id info:fedora/uva-lib:301613 failed",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "org.fcrepo.kernel.api.exception.TransactionClosedException: Transaction 1b72a75e-8256-44a2-8a06-e77b02ab37d7 expired!",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "    at org.fcrepo.kernel.impl.TransactionImpl.failIfExpired(TransactionImpl.java:333)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "    at org.fcrepo.kernel.impl.TransactionImpl.doInTx(TransactionImpl.java:175)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "    at org.fcrepo.kernel.impl.ContainmentIndexImpl.addContainedBy(ContainmentIndexImpl.java:562)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "    at jdk.internal.reflect.GeneratedMethodAccessor54.invoke(Unknown Source)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "...",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ERROR 03:11:10.387 [main] (ReindexManager) Error while rebuilding index",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "org.fcrepo.kernel.api.exception.TransactionClosedException: Transaction 1cc7411c-b3d8-4456-8480-55147697864e cannot be committed because it is in state ROLLEDBACK!",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.kernel.impl.TransactionImpl.failIfNotOpen(TransactionImpl.java:350)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.kernel.impl.TransactionImpl.commit(TransactionImpl.java:90)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.persistence.ocfl.impl.ReindexManager.indexMembership(ReindexManager.java:182)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.persistence.ocfl.impl.ReindexManager.start(ReindexManager.java:119)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.persistence.ocfl.impl.IndexBuilderImpl.rebuild(IndexBuilderImpl.java:107)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.persistence.ocfl.impl.IndexBuilderImpl.rebuildIfNecessary(IndexBuilderImpl.java:89)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.persistence.ocfl.RepositoryInitializer.initialize(RepositoryInitializer.java:94)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "...",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
