  "description": {
   "content": [
    {
     "content": [
      {
       "text": "With the new fcrepo-camel-ldpath service, some of the fields sent to Solr have changed. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Because this is vagrant, I suggest adding a catch all dynamic text field. This will create a field for any value field name submitted.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "So not great for production, but better for development and testing.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
