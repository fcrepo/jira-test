     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This is not specific enough.  It's probably out of scope for Fedora to include a generic workflow integration (quite a big task), but is definitely in scope to add functionality to Fedora to make it more easily integrate with workflow engines (see ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-454#icft=FCREPO-454"
          },
          "type": "inlineCard"
         },
         {
          "text": " as an example)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
