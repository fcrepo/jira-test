  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The task here is to upgrade fcrepo-fixity in the camel toolbox by doing the following:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1. upgrade to camel 3.9.0 and fix tests (following the pattern in fcrepo-indexing-solr)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. ensure compatible with java 11",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. remove karaf / osgi dependencies and tests.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "4. remove blueprint/fcrepo-fixity-blueprint",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
