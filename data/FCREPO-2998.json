  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Related to: RDF namespaces",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "There appears to be a potential issue with \"xs: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema",
       "type": "text"
      },
      {
       "text": "\" as a predefined namespace binding. It may be missing \"#\" at the end? ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When defining a data type for objects of a triple, using the Fedora UI's SPARQL update feature, with the following insert: `<> dc:date \"2019-05-22\"^^xs:dateTime .`",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The resulting triple (n-triples) is: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://annadora.tacc.utexas.edu:8080/fcrepo/rest/2019-03-15-sparql-test"
         },
         "type": "link"
        }
       ],
       "text": "http://annadora.tacc.utexas.edu:8080/fcrepo/rest/2019-03-15-sparql-test",
       "type": "text"
      },
      {
       "text": "> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/date"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/date",
       "type": "text"
      },
      {
       "text": "> \"2019-05-22\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchemadateTime"
         },
         "type": "link"
        },
        {
         "type": "strong"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchemadateTime",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "However, all fedora-generated triples with dateTime data types are serialized as:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://annadora.tacc.utexas.edu:8080/fcrepo/rest/2019-03-15-sparql-test"
         },
         "type": "link"
        }
       ],
       "text": "http://annadora.tacc.utexas.edu:8080/fcrepo/rest/2019-03-15-sparql-test",
       "type": "text"
      },
      {
       "text": "> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#lastModified"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#lastModified",
       "type": "text"
      },
      {
       "text": "> \"2019-05-22T20:07:16.187Z\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        },
        {
         "type": "strong"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
