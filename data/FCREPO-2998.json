    {
     "author": {
      "accountId": "5ed02d2a7d0c250c236c34d9",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/362a60c7c1f37ec3362a1f5d4f2b7eb5?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBS-0.png",
       "24x24": "https://secure.gravatar.com/avatar/362a60c7c1f37ec3362a1f5d4f2b7eb5?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBS-0.png",
       "32x32": "https://secure.gravatar.com/avatar/362a60c7c1f37ec3362a1f5d4f2b7eb5?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBS-0.png",
       "48x48": "https://secure.gravatar.com/avatar/362a60c7c1f37ec3362a1f5d4f2b7eb5?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBS-0.png"
      },
      "displayName": "Bethany Seeger",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5ed02d2a7d0c250c236c34d9",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "From some testing I've done, it appears that the namespace is pulled from the SPARQL command, not the nicely handed in Model.  Meaning if I change the namespace in the model before the execute() call, it does nothing to fix the issue.  Unless the Model does something when the prefixes are set.   I'll do more research next week. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
