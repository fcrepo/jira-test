   "comments": [
    {
     "author": {
      "accountId": "5ed02cb2dacd410c1f9e56ae",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png",
       "24x24": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png",
       "32x32": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png",
       "48x48": "https://secure.gravatar.com/avatar/8e627ad1f07d2a95bfd257d6c78c26a6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAB-6.png"
      },
      "displayName": "Aaron Birkland",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5ed02cb2dacd410c1f9e56ae",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It may also be an option to leave it in its separate repo, declare it as a (non-optional) dependency, but still change the various webxml and spring files in the main repo so as to enable webac from the default build",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This may take some judgement calls.  Leaving it as a separate repo (but as a hard dependency) would be the most conservative approach.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
     "created": "2017-09-15T18:05:17.657-0300",
