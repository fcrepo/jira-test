  "customfield_10053": null,
  "customfield_10054": null,
  "customfield_10087": null,
  "customfield_10121": null,
  "customfield_10154": null,
  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "WebAC is now part of the API specification, and should not be an add-on module.  Move it into the fcrepo4 repository",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo-module-auth-webac"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo-module-auth-webac",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Apparently, fcrepo-module-auth-webac depends on some classes from rbacl, which is in fcrepo4-exts.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-exts/fcrepo-module-auth-rbacl"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-exts/fcrepo-module-auth-rbacl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Move all necessary code from those external repositories into the core code base.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
