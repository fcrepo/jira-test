  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently when I request an RDF type I get a header like this:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Content-Type: text/turtle",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It would be more complete if Fedora also included the encoding:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Content-Type: text/turtle; charset=utf-8",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
