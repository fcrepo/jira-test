       "32x32": "https://secure.gravatar.com/avatar/34cd24b6a5178b45e45b73c3c9f71e6f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FU-0.png",
       "48x48": "https://secure.gravatar.com/avatar/34cd24b6a5178b45e45b73c3c9f71e6f?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FU-0.png"
      },
      "displayName": "Unknown",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a48d248ef60073948d92",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "My reading of various W3C documents suggests that RDF should always be UTF-8; however, that conflicts with the HTTP/1.1 specification that states that any content type of \"text/\" is, by default (w/o a charset parameter), ISO-8859-1. The suggested resolution is that, for all RDF serializations that begin with \"text/\", there should be a charset=utf-8 parameter in the Content-Type header. For serializations that begin with \"application/\", the utf-8 charset is implied (e.g. application/ld+json or application/n-triples).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I would suggest that for any Fedora response that begins with \"text/\", there should also be a charset=utf-8 parameter. This would apply to:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "text/turtle",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "text/plain (n-triples)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "text/n3",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "text/rdf+n3",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "text/html",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Here are the relevant documents:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://www.w3.org/2008/01/rdf-media-types"
            },
            "type": "link"
           }
          ],
          "text": "https://www.w3.org/2008/01/rdf-media-types",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://www.w3.org/TR/turtle/#sec-mime"
            },
            "type": "link"
           }
          ],
          "text": "https://www.w3.org/TR/turtle/#sec-mime",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://www.w3.org/International/articles/http-charset/index"
            },
            "type": "link"
           }
          ],
          "text": "https://www.w3.org/International/articles/http-charset/index",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://www.w3.org/TeamSubmission/n3/#encoding"
            },
            "type": "link"
           }
          ],
          "text": "https://www.w3.org/TeamSubmission/n3/#encoding",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
