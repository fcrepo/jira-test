     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Discovered while testing that proxy authentication wasn't working with original checkin due to typo; fix committed.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Tested with Squid, with proxy authentication enabled and disabled, both work now.",
          "type": "text"
         }
        ],
        "type": "paragraph"
