       "32x32": "https://secure.gravatar.com/avatar/0f212807d7bbe91a49a7c4620c5bfdac?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBP-1.png",
       "48x48": "https://secure.gravatar.com/avatar/0f212807d7bbe91a49a7c4620c5bfdac?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBP-1.png"
      },
      "displayName": "Ben Pennell",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5bba58f3eb6f6e2ccfd097c6",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've put together a tool to automate locating and fixing the names of resources in pairtrees with same name siblings. Its not perfect, for instance it will create a basic container instead of a pairtree in some situations since I was unable to create empty pairtrees:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/UNC-Libraries/fedora-repair-siblings"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/UNC-Libraries/fedora-repair-siblings",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
