  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://hub.docker.com/_/openjdk"
         },
         "type": "link"
        }
       ],
       "text": "openjdk image",
       "type": "text"
      },
      {
       "text": " has been deprecated, the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://hub.docker.com/_/tomcat"
         },
         "type": "link"
        }
       ],
       "text": "tomcat image",
       "type": "text"
      },
      {
       "text": " has switched to Eclipse Temurin by default now.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The following image should be used from now on: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "tomcat:9-jdk11",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/docker-library/tomcat/blob/4ef8521605121c14062319c9b8688fa4de044ba0/9.0/jdk11/temurin-noble/Dockerfile"
         },
         "type": "link"
        }
       ],
       "text": "⁠",
       "type": "text"
      },
      {
       "text": " (or ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "tomcat:9-jdk11-temurin",
       "type": "text"
      },
      {
       "text": " if it should be explicit that Eclipse Temurin is used as JDK).⁠",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It should also be considered to switch to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "tomcat:9-jre11",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/docker-library/tomcat/blob/4ef8521605121c14062319c9b8688fa4de044ba0/9.0/jre11/temurin-noble/Dockerfile"
         },
         "type": "link"
        }
       ],
       "text": "⁠",
       "type": "text"
      },
      {
       "text": " (or ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "tomcat:9-jre11-temurin",
       "type": "text"
      },
      {
       "text": ") to for the final Image as a JDK should not be necessary to run it.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
