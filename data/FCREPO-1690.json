     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've changed my thinking on this and would like to close this one. While these changes do reduce the amount of output in travis, the result is still well over 10,000 lines, and it comes at the expense of potentially useful logging.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
