  "description": {
   "content": [
    {
     "content": [
      {
       "text": "A standard fedora build in travis includes over 10,000 lines of output. This seems excessive; setting the log levels to WARN will significantly reduce the amount of output and make it easier to find real build errors.",
       "type": "text"
      }
     ],
     "type": "paragraph"
