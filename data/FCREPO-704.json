     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Thanks for logging this, Steve.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Just to note for others' benefit Steve's quick fix against trunk:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "org.fcrepo.server.rest.RestUtil.:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Line 108 - change Integer.ParseInt to Long.parseLong",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Line 119 - change the type of size from int to long",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "line 138 - change the return type of method getSize() from int to long",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Graeme",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
