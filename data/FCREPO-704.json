  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Reported by Graeme West",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora-commons.1317035.n2.nabble.com/Large-datastream-ingest-issue-Bad-request-unable-to-fulfill-REST-API-request-java-lang-NumberFormatE-td5094256.htm"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora-commons.1317035.n2.nabble.com/Large-datastream-ingest-issue-Bad-request-unable-to-fulfill-REST-API-request-java-lang-NumberFormatE-td5094256.htm",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Ingesting a file larger than 2GB fails with java.lang.NumberFormatException.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The source of this is in RestUtil - ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rContent.size = Integer.parseInt(lengthHeaders.get(0));",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This should be long rather than int (along with inner class RequestContent size field and related methods).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
