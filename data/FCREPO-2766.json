  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As a follow on to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2732"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2732",
       "type": "text"
      },
      {
       "text": " the \"self\" link should include range information so that the resulting link should look as follows: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/resource/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/resource/fcr:versions",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "; rel=\"self\";type=\"application/link-format\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "; from=\"Tue, 20 Jun 2000 18:02:59 GMT\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "; until=\"Wed, 09 Apr 2008 20:30:51 GMT\",",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "These extra parameters are specified in ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://tools.ietf.org/html/rfc7089#section-5.1.1"
         },
         "type": "link"
        }
       ],
       "text": "https://tools.ietf.org/html/rfc7089#section-5.1.1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/dbernstein/fcrepo4/blob/7cb27f4912e0c9f08c5f074f25fa5658964b18a8/fcrepo-http-api/src/main/java/org/fcrepo/http/api/FedoraVersioning.java#L277"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/dbernstein/fcrepo4/blob/7cb27f4912e0c9f08c5f074f25fa5658964b18a8/fcrepo-http-api/src/main/java/org/fcrepo/http/api/FedoraVersioning.java#L277",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
