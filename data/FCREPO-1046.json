     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As of 539a62ad3ce72d68d4f9d37a9d481d1455658a3a on master, fcrepo with Eclipse is pretty close to where it was at for me prior to m2e 0.13.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "For posterity, here are the install steps I used:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Download Eclipse Indigo (3.7.1)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.eclipse.org/downloads/"
            },
            "type": "link"
           }
          ],
          "text": "http://www.eclipse.org/downloads/",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Select \"Eclipse IDE for Java EE Developers\" Mac OS X 64 Bit",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Install m2e",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Open Eclipse Marketplace",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "search for \"m2e\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "select \"Maven Integration for Eclipse\" for installation",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Confirm installation (version 1.0.100.20110804-1717)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "m2e - Maven Integration for Eclipse",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "m2e - slf4j over logback logging",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Open Eclipse Marketplace",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "search for \"m2e\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Select \"Maven Integration for Eclipse WTP\" for installation",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Install EGit",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "search for \"git\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Select \"EGit - Git Team Provider\" for installation",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Confirm installation",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Eclipse EGit",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Eclipse JGit",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
