     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Just try to reproduce it, get  /foo#contributor as expect.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "1. curl -X PUT \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/foo"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/foo",
          "type": "text"
         },
         {
          "text": "\"",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "2. curl -i -X PATCH -H \"Content-Type: application/sparql-update\" --data-binary \"@body.rdf\" \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/foo"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/foo",
          "type": "text"
         },
         {
          "text": "\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Screenshot and body.rdf attached.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
