  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Given the following sparql-update command:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INSERT {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/foo"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/foo",
       "type": "text"
      },
      {
       "text": "> dc:contributor <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/foo#contributor"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/foo#contributor",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/foo#contributor"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/foo#contributor",
       "type": "text"
      },
      {
       "text": "> a foaf:Person ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "foaf:name \"me\" .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "} WHERE {}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The JMS system sends out two messages (this makes sense). But the one referring to the hash container has a strangely formatted IDENTIFIER: in this case it would be /foo/#/contributor, which doesn't seem right. I would expect /foo#contributor",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
