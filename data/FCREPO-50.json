       },
       {
        "content": [
         {
          "text": "Fixed in svn maintenance-2.2 branch (rev 6003).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Details: ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "src/java/fedora/utilities/install/FedoraHome.java, line 114, now reads:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "dbPoolName = \"localPostgreSQLPool\";",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
