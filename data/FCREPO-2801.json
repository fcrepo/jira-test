     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The proper ConstrainedBy link is returned correctly in the case of 'handling' being invalid.  All is well with this and it meets the spec.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The ConstrainedBy information will also be returned if the ExternalContent Link is malformed in other ways, though that's implementation specific.  Just mentioning that here. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
