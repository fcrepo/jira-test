     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Part of this has been tested - the proper constrained by link is returned in this scenario: \"In the case that the specified handling cannot be respected, the restrictions causing the request to fail must be described in a resource indicated by a rel=\"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.w3.org/ns/ldp#constrainedBy"
            },
            "type": "link"
           }
          ],
          "text": "http://www.w3.org/ns/ldp#constrainedBy",
          "type": "text"
         },
         {
          "text": "\" link in the Link response header.\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
