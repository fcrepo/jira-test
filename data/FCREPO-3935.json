  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Scenario: directly accessing content in OCFL root on disk (for initial testing as well as restoration/portability)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Cannot search in S3 except via known identifier",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Have to manually calculate the hash of the Fedora ID using a specific formatting of the Fedora ID in order to navigate to the OCFL object in S3 (info:fedora/the/id/etc)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "To simplify this, having the Fedora UI display the hash it generates for the persisted OCFL object will be very useful",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
   "type": "doc",
   "version": 1
  },
