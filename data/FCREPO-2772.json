  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As a follow-on to: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2393"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2393",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This task is to consolidate the spring configuration files of tests into a single \"fcrepo-config.xml\"... as done for the main build:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-webapp/src/main/resources/spring/fcrepo-config.xml"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/blob/master/fcrepo-webapp/src/main/resources/spring/fcrepo-config.xml",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The modules that need to be updated are:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "./fcrepo-http-api",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "./fcrepo-auth-webac",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "./fcrepo-kernel-modeshape",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "./fcrepo-integration-rdf",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
