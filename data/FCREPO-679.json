      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I believe the reason this error occurred was due to ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-396#icft=FCREPO-396"
          },
          "type": "inlineCard"
         },
         {
          "text": " (tomcat 6 installation issues), which was fixed in Fedora 3.3.  Closed for now....can re-open if Matteo continues to have trouble installing the latest version with the latest instructions, as indicated above.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
