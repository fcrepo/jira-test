     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The updates to the wiki page looks good. The one suggestion I would make is to clearly detail the mapping between the Fedora resources and their serialization on disk.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "For example, including in the wiki something like:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://host/fcrepo/rest/album"
            },
            "type": "link"
           }
          ],
          "text": "http://host/fcrepo/rest/album",
          "type": "text"
         },
         {
          "text": " --> /tmp/descriptions/albums",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://host/fcrepo/rest/album/ea/50/12/93/ea501293-64bf-430e-bf97-abcd64fda0c4"
            },
            "type": "link"
           }
          ],
          "text": "http://host/fcrepo/rest/album/ea/50/12/93/ea501293-64bf-430e-bf97-abcd64fda0c4",
          "type": "text"
         },
         {
          "text": " --> /tmp/descriptions/albums/ea/50/12/93/ea501293-64bf-430e-bf97-abcd64fda0c4.ttl",
          "type": "text"
