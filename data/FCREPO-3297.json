  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug is seen when trying to create a basic container with a \"charset\" included in the \"Content-Type\" header.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example, the following execution returns successfully:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$ curl -i -X PUT localhost:8080/rest/test -H'Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#BasicContainer"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#BasicContainer",
       "type": "text"
      },
      {
       "text": ">; rel=\"type\"' -H\"Content-Type: text/turtle\" -d \"<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.com/title"
         },
         "type": "link"
        }
       ],
       "text": "http://example.com/title",
       "type": "text"
      },
      {
       "text": "> 'Hello'\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "However, by adding the charset parameter to the Content-Type, we get a 500 response:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -i -X PUT localhost:8080/rest/test -H'Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#BasicContainer"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#BasicContainer",
       "type": "text"
      },
      {
       "text": ">; rel=\"type\"' -H\"Content-Type: text/turtle; charset=ISO-8859-1\" -d \"<> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.com/title"
         },
         "type": "link"
        }
       ],
       "text": "http://example.com/title",
       "type": "text"
      },
      {
       "text": "> 'Hello'\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
