     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I was just trying some google fu for publically available fedora repos ( “inurl:fcrepo/rest” ) and I came across this ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://sandbox.dams.library.ucdavis.edu/fcrepo/rest/item/ark:/87287/d76067"
            },
            "type": "link"
           }
          ],
          "text": "https://sandbox.dams.library.ucdavis.edu/fcrepo/rest/item/ark:/87287/d76067",
          "type": "text"
         },
         {
          "text": " which demonstrates the issue. A quick look via the browser web developer tools shows that all static content is receiving a 403",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
