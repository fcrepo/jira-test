  "customfield_10087": null,
  "customfield_10121": null,
  "customfield_10154": null,
  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If no ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fcrepo.github.io/fcrepo-specification/#dfn-ldprm"
         },
         "type": "link"
        }
       ],
       "text": "LDPRm",
       "type": "text"
      },
      {
       "text": " is appropriate to the Accept-Datetime value, an implementation should return a 406 (Unacceptable).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. create an LDPRv:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -X PUT ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/versioned_resource"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/versioned_resource",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2. Perform get on the resource with Accept-Datetime header",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -v -X GET ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/versioned_resource"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/versioned_resource",
       "type": "text"
      },
      {
       "text": "  -H \"Accept-Datetime: Thu, 1 Jan 1970 00:00:00 GMT\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Confirm the result is 404 (there are no LDPRm).  The status should be 406 according to the spec (section 4.1.1)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
