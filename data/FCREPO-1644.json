  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The fcrepo-related integration tests for fcrepo-camel-toolbox currently use a downloaded war file run inside a Jetty container. Instead, those tests should be implemented using spring configurations. This will become important as more extension modules are removed from the fedora core.",
       "type": "text"
      }
     ],
