     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This is a bug, however our goal is to be able to remove the swing-based administrator in an upcoming release, so it is recommended that, when possible, the web admin be used to perform repository administration. The XML of the RELS-EXT datastream can be edited directly using the web admin, which gets around this issue.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
