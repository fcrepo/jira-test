     "content": [
      {
       "text": "With the removal of support for DELETE on LDPCv's (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2889),"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2889),",
       "type": "text"
      },
      {
       "text": " we should also remove the value \"DELETE\" from an OPTIONS response on an LDPCv.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
