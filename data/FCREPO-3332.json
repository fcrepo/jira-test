  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Implement and Document Side-Loading based on this design document: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://docs.google.com/document/d/1oqKZvpEBqPR9ddHbl8dMBFRUYgizvWuKVI-RBBpIyLY/edit#"
         },
         "type": "link"
        }
       ],
       "text": "https://docs.google.com/document/d/1oqKZvpEBqPR9ddHbl8dMBFRUYgizvWuKVI-RBBpIyLY/edit#",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "make an http POST to initiate the indexing of side-loaded OCFL ID/object.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "If the OCFL Object is not Fedora Ready an appropriate HTTP error code and explanation should be returned.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "On success,  object creation messages should be emitted.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
