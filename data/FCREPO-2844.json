  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When creating an ACL with PUT and an RDF body with undefined prefix, Fedora returns a stacktrace to the client.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create resource:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -ufedoraAdmin:fedoraAdmin ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/test"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/test",
           "type": "text"
          },
          {
           "text": " -XPUT",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create ACL:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -ufedoraAdmin:fedoraAdmin ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/test/fcr:acl"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/test/fcr:acl",
           "type": "text"
          },
          {
           "text": " -XPUT -H\"Content-Type: text/turtle\" --data-binary @body.ttl",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "..where body.ttl is:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> a junk:Object ;",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "BOOM!",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "Notice: When creating a non-ACL RDF-Source with the same \"body.ttl\", no stacktrace is returned.",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
