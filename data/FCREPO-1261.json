  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The fedora ontology at: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository",
       "type": "text"
      },
      {
       "text": " contains triples for owl:Individual, but AFAIK, this is not a valid owl property (it isn't in the spec for the owl v2 schema: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2002/07/owl#)"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2002/07/owl#)",
       "type": "text"
      },
      {
       "text": ". These triples are not visible in the HTML view, so you must use `curl` to request the application/rdf+xml representation in order to see these values.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It is quite possible that owl:NamedIndividual is meant for the \"active\" and \"deleted\" values so that the ontology would read like this:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<owl:NamedIndividual rdf:about=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#active"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#active",
       "type": "text"
      },
      {
       "text": "\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<rdfs:label xml:lang=\"en\">active</rdfs:label>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<rdfs:comment xml:lang=\"en\">The resource is active.</rdfs:comment>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<rdf:type rdf:resource=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#ResourceStatus"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#ResourceStatus",
       "type": "text"
      },
      {
       "text": "\"/>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</owl:NamedIndividual>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
