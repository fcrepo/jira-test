  "description": {
   "content": [
    {
     "content": [
      {
       "text": "fcrepo-server/src/main/resources/properties/resources/install.properties contains entries such as",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "install.jdbc.mysql              = mysql-connector-java-5.1.20.jar",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "install.jdbc.derby              = derby-10.8.2.2.jar",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Rather than hardcoding the dependency filenames, they should be tokens (e.g. $mysql) that are replaced with the actual value during the Maven build.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This would prevent install.properties getting out of sync every time the dependencies are updated.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
