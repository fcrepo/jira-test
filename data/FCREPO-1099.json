     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "noting options that ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "strong"
           }
          ],
          "text": "don't",
          "type": "text"
         },
         {
          "text": " work:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "maven-resources-plugin resource filtering doesn't seem to resolve dependency names ( also see ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://jira.codehaus.org/browse/MRESOURCES-118"
            },
            "type": "link"
           }
          ],
          "text": "http://jira.codehaus.org/browse/MRESOURCES-118",
          "type": "text"
         },
         {
          "text": " )",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "maven-replacer-plugin (com.google.code.maven-replacer-plugin) doesn't seem to have a way to resolve dependency names (e.g. ${org.fcrepo:foo})",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "maven-antrun-plugin seems the closest: ${asm:asm:jar} or ${maven.dependency.asm.asm.jar} gives an absolute path to the dependency, but we only want the filename",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
