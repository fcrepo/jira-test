  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This is essentially the same as issue FCREPO-1102.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When 1102 was fixed in ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo/fcrepo/commit/2aa71e3db6f2aba5b66b22783594b035fbe0119d"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/fcrepo/commit/2aa71e3db6f2aba5b66b22783594b035fbe0119d",
       "type": "text"
      },
      {
       "text": " the VALID_PID_PART regular expression constant was added to FedoraObjectsResource and DatastreamResource, but the original (problematic) regular expression is still present in RelationshipResource. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Currently it uses ([A-Za-z0-9]|",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strike"
        }
       ],
       "text": "|",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "strike"
        }
       ],
       "text": ".)+:(([A-Za-z0-9])|",
       "type": "text"
      },
      {
       "text": "|",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ".|~|_|(%[0-9A-F]{2}))+ which matches \"test:1234\" but not \"test:%3a1234\" (see ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fiddle.re/pp0m"
         },
         "type": "link"
        }
       ],
       "text": "http://fiddle.re/pp0m",
       "type": "text"
      },
      {
       "text": " ). The VALID_PID_PART regular expression correctly matches either PID.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
