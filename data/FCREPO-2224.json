       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "{\r\n   \"BagIt-Profile-Info\":{\r\n      \"BagIt-Profile-Identifier\":\"http://fedora.info/fcrepoBagProfile.json\",\r\n      \"Source-Organization\":\"Duraspace\",\r\n      \"Contact-Name\":\"Nick Ruest\",\r\n      \"Contact-Email\":\"ruestn@yorku.ca\",\r\n      \"External-Description\":\"Default Bag Profile for Fedora.\",\r\n      \"Version\":\"1.2\"\r\n   },\r\n   \"Bag-Info\":{\r\n      \"Source-Organization\":{\r\n         \"required\":true\r\n      },\r\n      \"Organization-Address\":{\r\n         \"required\":false\r\n      },\r\n      \"Contact-Name\":{\r\n         \"required\":false\r\n      },\r\n      \"Contact-Phone\":{\r\n         \"required\":false\r\n      },\r\n      \"Contact-Email\":{\r\n         \"required\":false\r\n      },\r\n      \"External-Description\":{\r\n         \"required\":false\r\n      },\r\n      \"External-Identifier\":{\r\n         \"required\":false\r\n      },\r\n      \"Bag-Size\":{\r\n         \"required\":true\r\n      },\r\n      \"Bag-Group-Identifier\":{\r\n         \"required\":false\r\n      },\r\n      \"Bag-Count\":{\r\n         \"required\":false\r\n      },\r\n      \"Internal-Sender-Identifier\":{\r\n         \"required\":false\r\n      },\r\n      \"Internal-Sender-Description\":{\r\n         \"required\":false\r\n      },\r\n      \"Bagging-Date\":{\r\n         \"required\":true\r\n      },\r\n      \"Payload-Oxum\":{\r\n         \"required\":true\r\n      }\r\n   },\r\n   \"Manifests-Required\":[\r\n      \"sha1\"\r\n   ],\r\n   \"Allow-Fetch.txt\":false,\r\n   \"Serialization\":\"optional\",\r\n   \"Tag-Manifests-Required\":[\r\n     \"sha1\"\r\n   ],\r\n   \"Accept-BagIt-Version\":[\r\n      \"0.97\"\r\n   ]\r\n}",
          "type": "text"
         }
