          },
          "type": "mention"
         },
         {
          "text": " ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a5019889d5006a6c0d5f",
           "text": "@Mark Jordan"
          },
          "type": "mention"
         },
         {
          "text": ", let me know what you think. ...and ",
          "type": "text"
