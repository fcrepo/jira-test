     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Here is a first pass for review. I guess we should figure where to put this for version control. fcrepo-import-export seems like the obvious option. Other consideration, is do we actually want to publish it at ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora.info/fcrepoBagProfile.json,"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora.info/fcrepoBagProfile.json,",
          "type": "text"
         },
         {
          "text": " and what the filename should be.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Stakeholders: ",
          "type": "text"
         },
         {
