      },
      "displayName": "Rebecca Sutton Koeser",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4e8b233c8006ba9915a",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "This would be nice - I've been wanting to add indexing on the user ids in the audit trail so we could easily display to users the objects they've created or modified (this is in a curation system, where the users aren't actually set as owners on the fedora objects they create). ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
