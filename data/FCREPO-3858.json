  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Fedora4 allowed DirectContainers to include both ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "ldp:hasMemberRelation",
       "type": "text"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "ldp:isMemberOfRelation",
       "type": "text"
      },
      {
       "text": " predicates.  This allowed for convenient inverse properties: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "@prefix ldp:   <http://www.w3.org/ns/ldp#> .\n@prefix schema: <http://schema.org/> .\n<>\n    ldp:hasMemberRelation   schema:associatedMedia ;\n    ldp:isMemberOfRelation  schema:encodesCreativeWork ;\n    .",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " F6 does not allow both failing with: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "Direct and Indirect containers must specify exactly one ldp:hasMemberRelation or ldp:isMemberOfRelation property, but multiple were present",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Not sure if there is a technical reason these can no longer exist together",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
