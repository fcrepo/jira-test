  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to resolve the following issue where a non-admin user is unable to PUT or POST a new resource... regardless of the ACL in effect.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To replicate:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create resource",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -ufedoraAdmin:secret3 -XPUT localhost:8080/fcrepo/rest/test",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create an ACL",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -ufedoraAdmin:secret3 -XPUT localhost:8080/fcrepo/rest/acls",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -ufedoraAdmin:secret3 -XPUT localhost:8080/fcrepo/rest/acls/acl",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "curl -i -ufedoraAdmin:secret3 -XPUT -H\"Content-Type: text/turtle\" --data-binary @auth.ttl localhost:8080/fcrepo/rest/acls/acl/auth",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "where auth.ttl is:",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "==============",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "@prefix rdfs: <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://www.w3.org/2000/01/rdf-schema#"
                 },
                 "type": "link"
                }
               ],
               "text": "http://www.w3.org/2000/01/rdf-schema#",
               "type": "text"
              },
              {
               "text": "> .",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "@prefix acl: <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://www.w3.org/ns/auth/acl#"
                 },
                 "type": "link"
                }
               ],
               "text": "http://www.w3.org/ns/auth/acl#",
               "type": "text"
              },
              {
               "text": "> .",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "@prefix foaf: <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://xmlns.com/foaf/0.1/"
                 },
                 "type": "link"
                }
               ],
               "text": "http://xmlns.com/foaf/0.1/",
               "type": "text"
              },
              {
               "text": "> .",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "@prefix fedora: <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://fedora.info/definitions/v4/repository#"
                 },
                 "type": "link"
                }
               ],
               "text": "http://fedora.info/definitions/v4/repository#",
               "type": "text"
              },
              {
               "text": "> .",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "<> a acl:Authorization ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "acl:agent \"adminuser\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "acl:mode acl:Write, acl:Read ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "acl:accessTo <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/test",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "==============",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Associate ACL with test resource",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -ufedoraAdmin:secret3 -H\"Content-Type: application/sparql-update\" --data-binary @link.su -XPATCH localhost:8080/fcrepo/rest/test",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "where link.su is:",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "==============",
               "type": "text"
              },
              {
               "type": "hardBreak"
              },
              {
               "text": "PREFIX acl: <",
               "type": "text"
              },
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://www.w3.org/ns/auth/acl#"
                 },
                 "type": "link"
                }
               ],
               "text": "http://www.w3.org/ns/auth/acl#",
               "type": "text"
              },
              {
               "text": ">",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "INSERT {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> acl:accessControl <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/acls/acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/acls/acl",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "} WHERE {}",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "==============",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Verify READ protection:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
