  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Thanks to ",
       "type": "text"
      },
      {
       "attrs": {
        "accessLevel": "",
        "id": "60e6dea128780700684084e6",
        "localId": "0fb1baf3-0a58-4592-a0a1-c038ffb67d73",
        "text": "@John Gostick"
       },
       "type": "mention"
      },
      {
       "text": " for bringing this CRITICAL RCE to our attention. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "attrs": {
        "url": "https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2025-24813"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We’re targeting ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "tomcat:9-jdk11-temurin",
       "type": "text"
      },
      {
       "text": " so a refresh of the docker build should incorporate the patch from upstream which is now 9.0.102 which includes the fix ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/docker-library/tomcat/blob/4ef8521605121c14062319c9b8688fa4de044ba0/9.0/jdk11/temurin-noble/Dockerfile#L19"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "attrs": {
        "url": "https://github.com/fcrepo-exts/fcrepo-docker/blob/dcea4bf3539d116da568f9e3e84edffa12b319f3/Dockerfile#L1"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
