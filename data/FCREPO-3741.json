       "48x48": "https://secure.gravatar.com/avatar/21c1d174519bf2720dc4edf000a76668?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FPW-5.png"
      },
      "displayName": "Peter Winckles",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5b44cac50a894e589871012b",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The code currently attempts to identify the mime type using javascript: ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://developer.mozilla.org/en-US/docs/Web/API/File/type"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The problem is that only works based on file extension for well-known extensions, and will otherwise return an empty string. Our code is not defaulting an empty string to “application/octet-stream”.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
