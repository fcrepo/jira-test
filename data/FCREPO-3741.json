  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Steps to reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. Navigate to a binary in the web console",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. Select a file and click \"update\"",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. The operation fails with a 400",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The root cause is that the HTTP request is passing an empty Content-Type header. Relevant code: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-webapp/src/main/webapp/static/js/common.js#L242"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-webapp/src/main/webapp/static/js/common.js#L242",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This should likely be addressed by giving the user a way to specify the desired mime type. Ideally, prepopulated with the current type.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
