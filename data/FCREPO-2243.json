  "description": {
   "content": [
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://www.w3.org/TR/json-ld/#flattened-document-form"
         },
         "type": "link"
        }
       ],
       "text": "https://www.w3.org/TR/json-ld/#flattened-document-form",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The response from a request with this header: -H\"Accept: application/ld+json; profile=\\\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/json-ld#flattened"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/json-ld#flattened\\",
       "type": "text"
      },
      {
       "text": "\"\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "does not return the flattened JSON-LD profile. Instead, it returns the expanded JSON-LD profile. This is likely a problem with the underlying serialization library and may be solved with this issue: FCREPO-2242.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
