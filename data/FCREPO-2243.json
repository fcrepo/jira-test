      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "24x24": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "32x32": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png",
       "48x48": "https://secure.gravatar.com/avatar/45c30a3354c38331cc42d11962474554?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJW-1.png"
      },
      "displayName": "Jared Whiklo",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4c12a753d0071341edb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "In testing/learning some JSON-LD for CLAW I used the data from ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://jira.duraspace.org/browse/FCREPO-2390"
            },
            "type": "link"
           }
          ],
          "text": "https://jira.duraspace.org/browse/FCREPO-2390",
          "type": "text"
         },
         {
          "text": " and performed GETs with ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "Accept: application/ld+json; profile=",
          "type": "text"
         },
         {
          "text": " using compacted, expanded and flattened.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I am using 4.7.1",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The results are here ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://gist.github.com/whikloj/914aaff77758c5817fbe0b031a5e2c78"
            },
            "type": "link"
           }
          ],
          "text": "https://gist.github.com/whikloj/914aaff77758c5817fbe0b031a5e2c78",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "In a discussion with ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a50883b8c6006bf90212",
           "text": "@Diego Pino Navarro"
          },
          "type": "mention"
         },
         {
          "text": " he mentioned that the flattened did not appear correct.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "As I said I'm new to this, but I figured I should bring it to your attention for confirmation or education.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
