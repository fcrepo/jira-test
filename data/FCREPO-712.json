      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I'll note that I only caught this because the purgeDatastream tests for fedora-client were intermittently failing, as fedora-client does handle xsd:dateTimes correctly. See ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://github.com/mediashelf/fedora-client/blob/master/src/main/java/com/yourmediashelf/fedora/util/DateUtility.java"
            },
            "type": "link"
           }
          ],
          "text": "http://github.com/mediashelf/fedora-client/blob/master/src/main/java/com/yourmediashelf/fedora/util/DateUtility.java",
          "type": "text"
         },
         {
          "text": " for what I believe is a correct implementation, but it's a complete re-write that doesn't use SimpleDateFormat.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
