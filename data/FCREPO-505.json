  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Two relationships specified in the Fedora ontology (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.fedora.info/definitions/1/0/fedora-relsext-ontology.rdfs)"
         },
         "type": "link"
        }
       ],
       "text": "http://www.fedora.info/definitions/1/0/fedora-relsext-ontology.rdfs)",
       "type": "text"
      },
      {
       "text": " have inconsistent casing:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "HasDescription",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "HasMetadata",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "All the other relationships start with a lower-case character (e.g. hasPart, isAnnotationOf).  This will potentially cause some confusion, since RDF is case-sensitive. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
