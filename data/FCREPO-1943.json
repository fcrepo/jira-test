  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create release testing procedures document: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FF/Release+Testing+Procedures"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FF/Release+Testing+Procedures",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Create automated or manual tests tool against fcrepo4, multiple combinations of  fcrepo4-vagrant configuration options and webapp-plus with combinations of:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "a. audit",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "b. webac",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "c. audit and webac",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "d. neither",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
