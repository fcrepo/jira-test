     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Sorry, the solution was that when you create a version of a binary without providing a new body it automatically versions both the binary and the metadata. So I was then trying to version the metadata and correctly getting a 409 as there was a version with that time/date.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
