  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Guava offers utilities:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/google/guava/wiki/ReflectionExplained#dynamic-proxies"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/google/guava/wiki/ReflectionExplained#dynamic-proxies",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "that make dynamic proxy classes more readable and predictable. We ought to use them. The example available is org.fcrepo.kernel.modeshape.TxAwareSession.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
