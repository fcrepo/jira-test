  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Add the current 4.7.x permission checks to the WebACFilter as Shiro role and permission checks. Authenticated users with the role \"fedoraAdmin\" must be allowed to do anything, while authenticated users with the role \"fedoraUser\" must be subject to authorization check of a specific permission.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Current (4.7.x) permission checks:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "GET requires an acl:read mode permission on the request resource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "PUT/POST/PATCH/DELETE requires an acl:write mode permission on the request resource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "other modes (acl:append, acl:control) are not yet implemented",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
