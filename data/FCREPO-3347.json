  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen by performing the following steps:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Start Fedora (either deploying the war into Tomcat or using the one-click)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Note: Using \"mvn jetty:run\" does not show the error because it gets restarted by the build in the next step",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Build Fedora, noting that it hangs in the fcrepo-webapp project prior to the integration tests when Maven is starting up Jetty.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "The issue is not seen prior to the following ticket/commit:",
