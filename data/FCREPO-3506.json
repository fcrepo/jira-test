  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen when performing a GET request on the repository root, when there are many direct child containers of the root.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This issue was identified by using the HTML UI to make the GET request, and there were ~10M child containers of the root.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See attached stacktrace (oom-get-root.txt) from error scenario.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
