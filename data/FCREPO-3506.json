     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I wonder if this same request would fail if performed via the REST API. It could be that text/turtle is the problem because you must hold ALL triples in memory before it can serialize and return them.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
