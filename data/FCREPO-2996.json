  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently you can delete just the description from a binary. But once it is gone you can't recreate it.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://gist.github.com/whikloj/22747a594194da6072c8c1fd745760ea"
         },
         "type": "link"
        }
       ],
       "text": "https://gist.github.com/whikloj/22747a594194da6072c8c1fd745760ea",
       "type": "text"
      },
      {
       "text": " for demonstration.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Questions:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Should you be able to delete the description?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "If yes, then how do we re-create it?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "If no, then what is the response?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
