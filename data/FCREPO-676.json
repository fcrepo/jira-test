  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When generating triples for an object in the resource index, include a triple that specifies the PID namespace.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Requested by Janna Wemekamp -see ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://sourceforge.net/mailarchive/message.php?msg_name=4BB65010.8040806%40gmail.com"
         },
         "type": "link"
        }
       ],
       "text": "http://sourceforge.net/mailarchive/message.php?msg_name=4BB65010.8040806%40gmail.com",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$pid <fedora-model:hasPIDNamespace> 'c4oc'",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The namespace and predicate will need to be decided.  The Fedora model namespace seems appropriate as this includes other object properties, comments welcomed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
