            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-audit/pull/17"
            },
            "type": "link"
           }
          ],
          "text": "this",
          "type": "text"
         },
         {
          "text": " pull request, and open up one with the appropriate branch name.",
