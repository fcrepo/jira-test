     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Renaming to more accurately reflect the work planned.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This work should allow an sdep implementation to be indicated by the sdep object's content model, and for the relevant implementation to be loaded via Spring.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
