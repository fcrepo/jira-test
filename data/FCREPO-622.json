     "body": {
      "content": [
       {
        "content": [
         {
          "text": "melcoe.* packages in FeSL have retained their existing package naming structure.  These are not explicitly in the scope for this issue.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Testing has been done on Linux x86_64. config{A,B,Q} tests seem to work, as do the flash and java admin clients.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
