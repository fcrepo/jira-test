       "24x24": "https://secure.gravatar.com/avatar/3707b443358c8c223f9eec7a7d29ba88?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-4.png",
       "32x32": "https://secure.gravatar.com/avatar/3707b443358c8c223f9eec7a7d29ba88?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-4.png",
       "48x48": "https://secure.gravatar.com/avatar/3707b443358c8c223f9eec7a7d29ba88?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FDB-4.png"
      },
      "displayName": "Danny Bernstein",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785e2552404d0070bf1d34",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "When I do this:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "curl -i -X POST \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/fcr:tx"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/fcr:tx",
          "type": "text"
         },
         {
          "text": "\" -u fedoraAdmin:fedoraAdmin",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I get this:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "HTTP/1.1 201 Created",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Expires: Wed, 20 May 2020 23:26:46 GMT",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Location: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/fcr:tx/f481b5f7-c019-4f0e-863a-ee0ba44bcaf0*"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/fcr:tx/f481b5f7-c019-4f0e-863a-ee0ba44bcaf0",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Link: <",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/fcr:tx/f481b5f7-c019-4f0e-863a-ee0ba44bcaf0*/commit*"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/fcr:tx/f481b5f7-c019-4f0e-863a-ee0ba44bcaf0/commit",
          "type": "text"
         },
         {
          "text": ">; rel=\"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedora.info/definitions/v4/transaction#commitEndpoint"
            },
            "type": "link"
           }
          ],
          "text": "http://fedora.info/definitions/v4/transaction#commitEndpoint",
          "type": "text"
         },
         {
          "text": "\" ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "To commit - I must use the commitEndpoint url:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "curl -u fedoraAdmin:fedoraAdmin  -X PUT ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/fcr:tx/b99ca362-d1f3-4cec-91ed-e225efb59346"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8080/rest/fcr:tx/",
          "type": "text"
         },
         {
          "text": " ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8080/rest/fcr:tx/f481b5f7-c019-4f0e-863a-ee0ba44bcaf0*/commit*"
            },
            "type": "link"
           }
          ],
          "text": "f481b5f7-c019-4f0e-863a-ee0ba44bcaf0/commit",
          "type": "text"
         },
         {
          "text": "\"",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I've updated the  documentation accordingly.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
