  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When attempting to install fcrepo-camel using an OSGi feature, you get the following error: Could not find artifact org.apache.commons:commons-codec:jar:1.9 in central (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://repo1.maven.org/maven2/)"
         },
         "type": "link"
        }
       ],
       "text": "http://repo1.maven.org/maven2/)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This also prevents any of the fcrepo-camel-toolbox projects from deploying as features, as well.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
