  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The migration utils write files to disk before moving them into ocfl. On windows systems, these paths need to be encoded to make sure that they are can be safely written. Additionally, each file name must be decoded when it's added to ocfl so that its logical path is the original, unencoded value.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
