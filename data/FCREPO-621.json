      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I sent out a survey to the fedora-users list in early January.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.surveymonkey.com/s/DLRSFF5"
            },
            "type": "link"
           }
          ],
          "text": "http://www.surveymonkey.com/s/DLRSFF5",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This survey was open for a week.  Here are the final results:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "31 people took the survey.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Q1: Which of the following apply to you?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "24 (77%) use Fedora in production",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "28 (90%) develop software that uses the SOAP/REST apis.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "16 (52%) develop software that uses Fedora's Java interfaces.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "3 (10%) are Fedora committers",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Q2: Which app server(s) do you deploy with?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "17 (55%) deploy with the bundled version of Tomcat",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "9 deploy with a non-bundled Tomcat 6.x (1 of those said they were moving toward JBoss)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "5 deploy with a non-bundled Tomcat 5.5",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "4 deploy with a non-bundled Tomcat but did not specify a version",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Q3: Which version of Java do you run Fedora with?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "12 (39%) said Java 5",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "25 (81%) said Java 6",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Q4: Do you foresee a problem if future versions of Fedora require Java 6?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "30 (97%) said no",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1 (3%) said yes, \"My App Server is not Java 6 compatible\", but this person also said they were only deploying with the bundled version of Tomcat (which is Java 6 compatible), and declined to provide contact information.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
