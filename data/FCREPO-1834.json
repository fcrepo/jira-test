  "description": {
   "content": [
    {
     "content": [
      {
       "text": "fcrepo-kernel-api should not depend on modeshape. The only remaining dependency exists in the RepositoryService class, where the backup and restore methods return an org.modeshape.jcr.api.Problems object. This should instead be wrapped in a Collection<Throwable>.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
