  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When using the import-export-utility, the utility will fail to import a bag when the directory passed in is of the form '",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "./path-to-bag",
       "type": "text"
      },
      {
       "text": "'. When using a relative path like this, the path's representation looks like ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "/storage/bags/./path-to-bag",
       "type": "text"
      },
      {
       "text": " which causes a MaliciousPathException to occur when the bagit-java library attempts to read the bag.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
