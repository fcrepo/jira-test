     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I reviewed the messaging documentation (",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://wiki.lyrasis.org/display/FEDORA6x/Messaging"
          },
          "type": "inlineCard"
         },
         {
          "text": ") so queue and topic configuration info is highlighted.  I also moved the sections around, pushing the camel stuff to the bottom and adding some links to related resources to the first sections.  Additionlly I removed the information on Karaf as we’re no longer recommending it.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
