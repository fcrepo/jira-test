  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Camel reindexing endpoint provided a usage message with examples. The generated links in those examples should contain the services hostname in the URLs. When running in a Docker environment resolving the local hostname fails, leading to unresolvable URLs e.g:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "Configured REST endpoint: 0f4c88fb87f6:9080/reindexing",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "How to reproduce",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "shell"
     },
     "content": [
      {
       "text": "$ git clone git@github.com:fcrepo-exts/fcrepo-camel-toolbox.git\n$ cd fcrepo-camel-toolbox/docker-compose\n$ docker-compose up\n$ curl localhost:9080/reindexing",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    }
   ],
   "type": "doc",
   "version": 1
  },
