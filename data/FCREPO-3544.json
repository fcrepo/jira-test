     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Seems to be a user error. I started the migration with: ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "--source-type=legacy",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": " instead of ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "attrs": {
         "language": "java"
        },
        "content": [
         {
          "text": "--source-type=akubra",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": " against Fedora 3.8.1.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "When using the Akubra source type everything is fine. Just some OCFL hash errors on objects with fixity problems.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Side note: I noticed a directory \".run\" which is created in the project root when executing the migration in IntelliJ. This should probably be mentioned in the .gitignore file.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
