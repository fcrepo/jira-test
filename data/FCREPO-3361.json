  "description": {
   "content": [
    {
     "content": [
      {
       "text": "After the import-export-utility runs an import it will hang briefly before exiting to the command line. This has been observed when importing BagIt bags and should be looked at to see if the cause can be found + fixed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "example bagit import:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "java -jar target/fcrepo-import-export-0.4.0-SNAPSHOT.jar --mode import --resource http://localhost:8080/fcrepo/rest/ --dir fcrepo-bag --binaries --bag-profile beyondtherepository --bag-config bag-config.yml -u fedoraAdmin:secret3",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
