  "description": {
   "content": [
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Fire up fedora on top of a fedora generated ocfl ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "You can use: `./fcrepo-http-api/src/test/resources/ocfl-root`",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -Dfcrepo.ocfl.staging.dir=target/fcrepo-data/staging -Dfcrepo.ocfl.storage.root.dir=fcrepo-http-api/src/test/resources/ocfl-root-Dfcrepo.ocfl.work.dir=target/fcrepo-data/work -jar fcrepo-webapp/target/fcrepo-webapp-6.0.0-SNAPSHOT-jetty-console.jar --headless",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "``` ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Verify that rebuild succeeded : ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Stop Fedora",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Start Fedora",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Verify that the containment relationships are gone.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    }
