  "description": {
   "content": [
    {
     "content": [
      {
       "text": "See ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.postgresql.org/docs/current/static/runtime-config-compatible.html#GUC-STANDARD-CONFORMING-STRINGS"
         },
         "type": "link"
        }
       ],
       "text": "http://www.postgresql.org/docs/current/static/runtime-config-compatible.html#GUC-STANDARD-CONFORMING-STRINGS",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PostgreSQL 9.1 now \"treat[s] backslashes literally, as specified in the SQL standard.\" This makes the default value of:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<param name=\"backslashIsEscape\" value=\"true\"/>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "for the ILowLevelStore module in fcfg inappropriate.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
