     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Attached is a patch to allow batch purging of objects from the command line, as well as an integration test for the new functionality.  The integration test has passed when run with the ConfigA, ConfigB, and ConfigQ configurations.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The patch was generated against the 3.4 tagged release.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
