              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "Fcrepo community impl extension module",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Add support for transactions (we have done so locally at unc, but its ugly and we can probably wait for sidecar spec)",
              "type": "text"
             }
            ],
