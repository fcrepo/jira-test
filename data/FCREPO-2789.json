                 "href": "http://mementoweb.org/ns#Memento"
                },
                "type": "link"
               }
              ],
              "text": "http://mementoweb.org/ns#Memento",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Link rels, original timegate timemap (acl)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Constants for link header rels",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "   * ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://www.w3.org/ns/ldp#constrainedBy"
                },
                "type": "link"
               }
              ],
              "text": "http://www.w3.org/ns/ldp#constrainedBy",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
