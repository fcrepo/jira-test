  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When doing mvn jetty:run from the fcrepo-webapp directory, inspecting the headers for the repository root resource reveals an acl link relation that points to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest//fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest//fcr:acl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This seems to be incorrect",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Doing a GET on this resource results in a 405 (Method not allowed)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Doing a HEAD against this resource reveals no LDP headers",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The correct ACL link is likely ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest//fcr:acl"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/fcr:acl",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "N.B.  Due to a bug present in FCREPO-2825, the \"correct\" ACL link results in a 404.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
