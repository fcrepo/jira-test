     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Or easier using gits version sorting mechanism:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "git tag --list --sort=-version:refname 'fcrepo-*' | head -n1",
          "type": "text"
         }
