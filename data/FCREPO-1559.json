      "timeZone": "America/Halifax"
     },
     "body": "<p>Isn't this a good thing? Do we <em>want</em> mutations to partially succeed?</p>",
     "created": "29/Oct/15 1:01 PM",
     "id": "15610",
     "jsdPublic": true,
     "self": "https://fedora-repository.atlassian.net/rest/api/3/issue/11551/comment/15610",
     "updateAuthor": {
