  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When issuing SPARQL updates, deletion of non-existent properties prevents the rest of the query from executing.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example, if you have a container with dc:title, and attempt to issue a delete query on dc:title and dc:author, the missing dc:author stops the query from deleting the dc:title.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Example SPARQL update queries to issue on a new resource to test:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PREFIX  dc:   <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INSERT DATA {",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> dc:title \"Stuff\" .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Followed by",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "PREFIX  dc:   <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "DELETE WHERE",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "{",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> dc:title ?o0 .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<> dc:author ?o1 .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "} ;",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
