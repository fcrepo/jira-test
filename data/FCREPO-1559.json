     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Should the SPARQL be?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "PREFIX dc: <http://purl.org/dc/elements/1.1/> \r\n  \r\nDELETE { \r\n  <> dc:title ?o0 . \r\n  <> dc:author ?o1 . \r\n} \r\nWHERE {\r\n  <> dc:title ?o0 .\r\n  <> dc:author ?o1 .\r\n}",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       }
      ],
      "type": "doc",
      "version": 1
     },
