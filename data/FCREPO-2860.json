  "description": {
   "content": [
    {
     "content": [
      {
       "text": "According to the spec, if an implementation chooses to reject requests concerning remote Group Listings, it must advertise the restriction with a rel=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#constrainedBy"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#constrainedBy",
       "type": "text"
      },
      {
       "text": "\" link in the Link response header.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce the problem:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "//Create a resource:\r\ncurl -v -u fedoraAdmin:fedoraAdmin -X POST http://localhost:8080/rest\r\n//Create the following file: cross-domain.ttl \r\n@prefix acl: <http://www.w3.org/ns/auth/acl#> .\r\n<#restricted> a acl:Authorization ;\r\n acl:agentGroup <https://example.com/acl> ;\r\n acl:mode acl:Read .\r\n\r\n //create the acl using the following \r\ncurl -v -u fedoraAdmin:fedoraAdmin -X POST resourceUri/fcr:acl --data-binary \"@cross-domain.ttl\" -H \"Content-Type: text/turtle\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
