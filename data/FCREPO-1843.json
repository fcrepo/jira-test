  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When responding to a request for a Non-RDF Resource, Fedora always adds a \"content-disposition: attachment\" header, with filename and other details. This forces the browser to display a download dialog, making it impossible to serve/display/stream binary content directly from the repository.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
