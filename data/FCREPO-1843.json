       "24x24": "https://secure.gravatar.com/avatar/010c261cd3ec86eb2b15db9e0bd1f9fa?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FMK-6.png",
       "32x32": "https://secure.gravatar.com/avatar/010c261cd3ec86eb2b15db9e0bd1f9fa?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FMK-6.png",
       "48x48": "https://secure.gravatar.com/avatar/010c261cd3ec86eb2b15db9e0bd1f9fa?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FMK-6.png"
      },
      "displayName": "Michael B. Klein",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A4fac9ba4-ab49-400b-81c4-9ce0204129bf",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Requesting a particular content disposition will have to happen through the URL itself, as opposed to a request header, since it will have to be usable within a ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "rel",
          "type": "text"
         },
         {
          "text": ", ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "src",
          "type": "text"
         },
         {
          "text": ", or ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "href",
          "type": "text"
         },
         {
          "text": ".",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Possible resolutions:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Change the default behavior to ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "content-disposition: inline",
              "type": "text"
             },
             {
              "text": " and add an ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "fcr:attachment",
              "type": "text"
             },
             {
              "text": " URL extension (similar to ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "fcr:metadata",
              "type": "text"
             },
             {
              "text": ") to force the download",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Keep the existing default behavior, and add an ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "fcr:content",
              "type": "text"
             },
             {
              "text": " URL extension to allow inline retrieval",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Similar to the above, but use a query string parameter (e.g., ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "inline=true",
              "type": "text"
             },
             {
              "text": ") to alter the response",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "orderedList"
       }
      ],
      "type": "doc",
      "version": 1
     },
