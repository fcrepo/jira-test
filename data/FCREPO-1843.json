     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Couldn't this be solved with a reverse proxy that strips that header from the response? Isn't this only a concern if you are exposing fedora directly to the internet (without any sort of reverse proxy)?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
