     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Doing a bit of digging revealed the ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://tomcat.apache.org/tomcat-8.5-doc/config/valve.html#Remote_IP_Valve"
            },
            "type": "link"
           }
          ],
          "text": "RemoteIpValve",
          "type": "text"
         },
         {
          "text": ", which resolved this for me when I added it to my server.xml for Tomcat. We’ll need to get the documentation updated for anyone with a reverse proxy that goes from https → http in order to get this resolved.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
