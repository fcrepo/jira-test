  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Enhanced content models.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The real discussion about these can be found in ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora-commons.org/confluence/display/FCREPO/Enhanced+Content+Models"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora-commons.org/confluence/display/FCREPO/Enhanced+Content+Models",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Enhanced Content Models add several new features to the CMA of Fedora.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. Ability to specify an ontology for the object relations",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. Ability to specify ontologies for the datastream relations",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. Ability to specify schemas for the datastreams",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "4. Ability to specify optional datastreams",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
