  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to ensure that URIs of versioned resources are exposed as their version label, not their JCR UUID.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a binary resource in the HTML UI ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "marks": [
                {
                 "attrs": {
                  "href": "http://localhost:8080/rest/image"
                 },
                 "type": "link"
                }
               ],
               "text": "http://localhost:8080/rest/image",
               "type": "text"
              },
              {
               "text": " ",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a version of that resource ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPOST -H\"slug: v0\" ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/image/fcr:versions"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/image/fcr:versions",
           "type": "text"
          },
          {
           "text": " ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Get a listing of the resources versions",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i  ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/image/fcr:versions"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/image/fcr:versions",
           "type": "text"
          }
         ],
         "type": "paragraph"
        },
        {
         "content": [
          {
           "content": [
            {
             "content": [
              {
               "text": "Notice the UUID of the versioned resource is returned in the listing",
               "type": "text"
              }
             ],
             "type": "paragraph"
            }
           ],
           "type": "listItem"
          }
         ],
         "type": "bulletList"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
