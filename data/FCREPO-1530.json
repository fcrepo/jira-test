     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Ideally, we would move API development forward in a way that aligns with LDP (and other appropriate standards). \"/fcr:batch\" does not exactly support that approach. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Could you provide one or more example \"batch\" requests to help further inform the desires of this ticket?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
