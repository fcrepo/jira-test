  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently indexing on demand of side-loaded content is allowed. However calls to /fcr:reindex endpoints on existing resources is not allowed. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task here is implement reindexing on demand of extant resources. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
