  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This bug can be seen when submitting the following erroneous request:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -i localhost:8080/rest/ag -H\"Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#ArchivalGroup"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#ArchivalGroup",
       "type": "text"
      },
      {
       "text": ">;'rel=type'\" -XPUT",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      }
