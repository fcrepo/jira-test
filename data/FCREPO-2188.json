  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Setup per: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2187"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2187",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "After successful export, start an empty F4.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Perform the same operation as on export but changing the mode:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> java -jar fcrepo-import-export-driver-0.0.1-SNAPSHOT.jar -b /tmp/bin -m import -d /tmp/rdf -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "! Notice immediately:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "INFO 16:59:25.473 (ArgParser) Configuration file exists, new file will NOT be created: /tmp/importexport.config",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "INFO 16:59:25.478 (Importer) Running importer...",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "WARN 16:59:25.889 (riot) [line: 31, col: 10] Lexical form '10/23/2014 17:02:32' not valid for datatype ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "type": "hardBreak"
