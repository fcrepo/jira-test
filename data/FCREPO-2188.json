     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The external URI is retrieved by the export client and saved to disk.  Since the request is redirected, then it doesn't see the original response, so the binary description with the metadata (including the mime type with the external link) is never seen or retrieved.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
