  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The fedora auditing schema (fedora-auditing.xsd) does not reflect the actual structure used to read/write audit information in foxml/mets.  It needs to be updated to reflect this structure, and uploaded to the appropriate endpoint on the website.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Here is the actual structure used for audit information:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "(auditTrail)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[1 or more records]",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(/auditTrail)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "(record [optional ID=\"string])",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(process type=\"string\"/)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(action)string(/action)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(componentID)string(/componentID)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(responsibility)string(/responsibility)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(date)dateTime(/date)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(justification)string(/justification)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(/record)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The schema is currently published at the following endpoint:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.fedora.info/definitions/1/0/fedora-auditing.xsd"
         },
         "type": "link"
        }
       ],
       "text": "http://www.fedora.info/definitions/1/0/fedora-auditing.xsd",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
