      "timeZone": "America/Moncton"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fedora is an open source project supported entirely by it’s users. To continue the on-going maintenance of the software and ensure Fedora is meeting the needs of the community, we are working to gather information on current installations. We strongly encourage all users to register their instance in the DuraSpace Community Supported Program Registry hosted by LYRASIS. Register your installation today: (insert link)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
