  "description": {
   "content": [
    {
     "content": [
      {
       "text": "In the HTML UI, when creating a named resource at the root of the repository within a transaction, an error is thrown.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "To reproduce in HTML UI:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Start a transaction",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "At the root, create a resource \"test\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "See error",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
