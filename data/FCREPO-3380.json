  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Whenever I create a resource in Fedora 6.0.0 I get a warning in the console saying the OCFL staging directory was not deleted. For example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "WARN 16:18:35.791 (DefaultOCFLObjectSession) Failed to delete staging directory: data/fedora-home/data/staging/ce4b56ca-e592-4dde-b6d3-a02fbadc4515/19234c9b63f9d18b1726e5f499d1d5ee6206d285d5de38aa55eba84b95346e27",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This occurrs using the Jetty console with the latest build on the main branch (6.0.0-SNAPSHOT | Build #3555b046 (2020-07-10)).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
