  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently the request context resources are built from (a) the PID (and dsID) of the object and (b) the same with all parents.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "According to the XACML 2.0 spec, multiple parent lineages should be included, ie if a resource test:res is a member of test:col1 and test:col2, then we should be generating",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "test:res",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "test:col1/test:res",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "test:col2/test:res",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Currently only a single parent lineage is calculated (using the first parent relationship discovered in the relationships).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This would allow resources to be members of multiple collections, and to use policies from all parent collections.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
