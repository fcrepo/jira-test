     "body": {
      "content": [
       {
        "content": [
         {
          "text": "PR ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://github.com/fcrepo/fcrepo/pull/2089"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "There was mention of possibly using a URL shortening service or a DOI/Handle for this but for now I’ve just updated the URL as requested. I’m not aware of us having access to ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://handle.net"
            },
            "type": "link"
           }
          ],
          "text": "handle.net",
          "type": "text"
         },
         {
          "text": " or being registered for DOIs. If someone else knows more, it could be useful to go that route",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
