  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When you create a resource the resource and its parent are locked. This means that it isn't possible to concurrently create child resources in separate transactions because only one transaction can lock the parent. It would be nice if it was possible to lock the parent so that it could not be deleted, but still allow children to be concurrently created.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
