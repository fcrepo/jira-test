  "description": {
   "content": [
    {
     "attrs": {
      "level": 3
     },
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "This ticket depends on ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2877"
         },
         "type": "link"
        },
        {
         "type": "strong"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2877",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "   being completed first.",
       "type": "text"
      }
     ],
     "type": "heading"
    },
    {
     "content": [
      {
       "text": "When retrieving a memento with SMTs omitted,  the results should mirror the Original Resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "create versioned resource",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -X POST -H \"Link: <http://mementoweb.org/ns#OriginalResource>; rel=\\\"type\\\"\" http://localhost:8080/rest/ -H \"slug: testxyz\" -u fedoraAdmin:fedoraAdmin",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "create memento of versioned resource",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -i -X POST -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/testxyz/fcr:versions;",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Get the original resource without SMTs",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/testxyz -H \"Prefer: return=representation; omit=\\\"http://fedora.info/definitions/v4/repository#ServerManaged\\\"\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "No triples should be returned.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Get the memento without SMTs",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin http://localhost:8080/rest/testxyz/fcr:versions/20181001231451 -H \"Prefer: return=representation; omit=\\\"http://fedora.info/definitions/v4/repository#ServerManaged\\\"\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Notice some SMTs are returned: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "<http://localhost:8080/rest/testxyz2>  \r\n                            rdf:type ldp:RDFSource ; \r\n                            rdf:type ldp:Container ; \r\n                            rdf:type ldp:BasicContainer .",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task at hand it to ensure that the SMTs are suppressed in exactly the same way as they are in the Original Resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
