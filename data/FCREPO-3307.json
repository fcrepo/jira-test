        }
       ],
       "text": "http://localhost:8080/rest/fcr:search?condition=fedora_id%3D*",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Include should be the ability to page through results using max_results and offset query parameters.",
