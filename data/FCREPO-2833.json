  "description": {
   "content": [
    {
     "content": [
      {
       "text": "It should be possible to delete and ACL resource.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When this ticket is complete, the following must be true: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "An HTTP OPTIONS call to the ACL resource should return \"Allow: DELETE\" header.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "An HTTP DELETE call to the ACL resource should delete the resource. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
