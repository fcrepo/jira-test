  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Setup: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Download dataset: ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://github.com/fcrepo4-labs/fcrepo-sample-dataset/blob/master/lubm/LUBM.tar.gz"
             },
             "type": "link"
            }
           ],
           "text": "https://github.com/fcrepo4-labs/fcrepo-sample-dataset/blob/master/lubm/LUBM.tar.gz",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Start up an empty F4 ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Upload the sample dataset: ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> curl -i -XPOST --data-binary /path/to/LUBMbackup localhost:8080/rest/fcr:restore ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Export the repository: ",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> java -jar fcrepo-import-export-driver-0.0.1-SNAPSHOT.jar -b /tmp/bin -m export -d /tmp/rdf -r ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/",
           "type": "text"
          },
          {
           "text": " ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Start up an empty F4",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Import the exported content:",
           "type": "text"
          },
          {
           "type": "hardBreak"
