     "content": [
      {
       "text": "Testsuite test failed:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "isNumberColumnEnabled": false,
      "layout": "default"
     },
     "content": [
      {
       "content": [
        {
         "attrs": {},
         "content": [
          {
           "content": [
            {
             "marks": [
              {
               "attrs": {
                "href": "https://fedora.info/2018/11/22/spec/#link-acl-on-create"
               },
               "type": "link"
              }
             ],
             "text": "5.4-B",
             "type": "text"
            }
           ],
           "type": "paragraph"
          }
         ],
         "type": "tableCell"
        },
        {
         "attrs": {},
         "content": [
          {
           "content": [
            {
             "text": "MUST",
             "type": "text"
            }
           ],
           "type": "paragraph"
          }
         ],
         "type": "tableCell"
        },
        {
         "attrs": {},
         "content": [
          {
           "content": [
            {
             "text": "FAIL",
             "type": "text"
            }
           ],
           "type": "paragraph"
          }
         ],
         "type": "tableCell"
        },
        {
         "attrs": {},
         "content": [
          {
           "content": [
            {
             "text": "The server must reject the request and respond with a 4xx or 5xx range status code, such as 409 (Conflict) if it isn't able to create the LDPR with the specified LDP-RS as the ACL. In that response, the restrictions causing the request to fail must be described in a resource indicated by a rel=\"",
             "type": "text"
            },
            {
             "marks": [
              {
               "attrs": {
                "href": "http://www.w3.org/ns/ldp#constrainedBy"
               },
               "type": "link"
              }
             ],
             "text": "http://www.w3.org/ns/ldp#constrainedBy",
             "type": "text"
            },
            {
             "text": "\" link in the Link response header",
             "type": "text"
            }
           ],
           "type": "paragraph"
          }
         ],
         "type": "tableCell"
        }
       ],
       "type": "tableRow"
      }
     ],
     "type": "table"
    },
