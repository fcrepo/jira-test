       "48x48": "https://secure.gravatar.com/avatar/eaebed23b99270858f5b29f9bd1499a3?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FGT-6.png"
      },
      "displayName": "Gerard Torrent",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4c55797db006993ff53",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "In any of the html pages responded by:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://fedoraserver/fedora/get/pid/fedora-system:3/viewItemIndex"
                },
                "type": "link"
               }
              ],
              "text": "http://fedoraserver/fedora/get/pid/fedora-system:3/viewItemIndex",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://fedoraserver/fedora/get/pid/DS"
                },
                "type": "link"
               }
              ],
              "text": "http://fedoraserver/fedora/get/pid/DS",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://fedoraserver/fedora/get/pid/fedora-system:3/viewMethodIndex"
                },
                "type": "link"
               }
              ],
              "text": "http://fedoraserver/fedora/get/pid/fedora-system:3/viewMethodIndex",
              "type": "text"
             },
             {
              "text": " ",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "we found tags like this:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<a href='",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://fedoraserver:8015/fedora/xxx'"
            },
            "type": "link"
           }
          ],
          "text": "http://FEDORASERVER:8015/fedora/xxx'",
          "type": "text"
         },
         {
          "text": ">blablabla</a>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This href is an absolute reference with the port of the last hop (http://FEDORASERVER:8015). We can't access to this port from outside, we only can access to port 80. We propose to change these references in a relative form, like this:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<a href='/fedora/xxx'>blablabla</a>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
