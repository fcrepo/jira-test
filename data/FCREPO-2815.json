  "description": {
   "content": [
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "Creating a versioned external binary works, as well as creating a memento from the current version. However, creating an external historic memento fails. See the following commands:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "curl -i -XPOST -H \"Slug:logov\"",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
