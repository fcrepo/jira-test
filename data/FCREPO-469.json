     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The installation options will now be set as follows when running \"quick\" install:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "FEDORA_SERVERHOST = localhost",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "APIA_AUTH_REQUIRED = false",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "SSL_AVAILABLE = true",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "APIA_SSL_REQUIRED = false",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "APIM_SSL_REQUIRED = true",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "SERVLET_ENGINE = included",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "TOMCAT_HOME = fedoraHome/tomcat",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "TOMCAT_HTTP_PORT = 8080",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "TOMCAT_SHUTDOWN_PORT = 8005",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "TOMCAT_SSL_PORT = 8443",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "KEYSTORE_FILE = included",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "DATABASE = included",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "DATABASE_DRIVER = included",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "DATABASE_USERNAME = fedoraAdmin",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "DATABASE_PASSWORD = fedoraAdmin",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "XACML_ENABLED = true",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "RI_ENABLED = false",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "REST_ENABLED = false",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "MESSAGING_ENABLED = false",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "DEPLOY_LOCAL_SERVICES = true",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note: These settings happen to provide for the ability to successfully run:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "$ant junit -Dtest=fedora.test.AllSystemTestsConfigA",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "after installation has completed.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
