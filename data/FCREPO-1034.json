       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a5689889d5006a6c137f/ea193e07-67ee-4d7a-93a0-7ba659aa2a97/32",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/6089a5689889d5006a6c137f/ea193e07-67ee-4d7a-93a0-7ba659aa2a97/48"
      },
      "displayName": "Olivier Narat",
