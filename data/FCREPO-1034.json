  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Get 'Did not understand \"MustUnderstand\" header(s)' in the response when calling a Fedora web service with soapUI 4.0.1: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Request: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "--------\n<soapenv:Envelope xmlns:soapenv=\"",
       "type": "text"
      },
      {
       "marks": [
