         "attrs": {
          "href": "http://schemas.xmlsoap.org/soap/envelope/"
         },
         "type": "link"
        }
       ],
       "text": "http://schemas.xmlsoap.org/soap/envelope/",
       "type": "text"
      },
      {
       "text": "\" xmlns:typ=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.fedora.info/definitions/1/0/types/"
         },
         "type": "link"
        }
       ],
       "text": "http://www.fedora.info/definitions/1/0/types/",
       "type": "text"
      },
      {
       "text": "\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<soapenv:Header><wsse:Security soapenv:mustUnderstand=\"1\" xmlns:wsse=\"",
       "type": "text"
      },
      {
