         "type": "link"
        }
       ],
       "text": "http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd",
       "type": "text"
      },
      {
       "text": "\"><wsu:Timestamp wsu:Id=\"Timestamp-75\" xmlns:wsu=\"",
