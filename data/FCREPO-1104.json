     "body": {
      "content": [
       {
        "content": [
         {
          "text": "On a new EC2 64-bit small instance running Ubuntu 12.04, I was able to replicate similar failures, see:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://gist.github.com/2996183"
            },
            "type": "link"
           }
          ],
          "text": "https://gist.github.com/2996183",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "However, switching the instance type to \"large\" allowed the tests to pass.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
