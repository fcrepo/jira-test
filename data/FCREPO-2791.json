  "description": {
   "content": [
    {
     "content": [
      {
       "text": "It appears that an untranslated URI is appearing in the response: *ns001:describes          <fedora:uribase/versioned_resource> ;*",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Also it is not clear why the iana prefix is not used since it should be a built in prefix.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1.create a versioned resource with a memento:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "#create binary resource\r\ncurl -i -XPOST  -H \"Slug: versioned_resource\" -H \"Link: <http://mementoweb.org/ns#OriginalResource>; rel=\\\"type\\\"\" \"http://localhost:8080/rest\" -H \"Content-Type: text/plain\" --data-binary \"Test\";\r\n#create memento:\r\ncurl -v -X POST  \"http://localhost:8080/rest/versioned_resource/fcr:versions\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2. retrieve the description memento: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -X GET http://localhost:8080/rest/versioned_resource/fcr:metadata/fcr:versions/<memento>",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "3. confirm two triples in the response: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "ns001:describes          <fedora:uribase/versioned_resource> ;",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "and",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "ns001:describes          <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/versioned_resource"
         },
         "type": "link"
        },
        {
         "type": "strong"
        }
       ],
       "text": "http://localhost:8080/rest/versioned_resource",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "(full response)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "<http://localhost:8080/rest/versioned_resource>\r\n rdf:type ldp:NonRDFSource ;\r\n rdf:type fedora:NonRdfSourceDescription ;\r\n rdf:type fedora:Binary ;\r\n rdf:type fedora:Resource ;\r\n ns001:describes <fedora:uribase/versioned_resource> ;\r\n fedora:created \"2018-05-04T21:47:02.192Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\r\n fedora:writable true ;\r\n premis:hasSize \"4\"^^<http://www.w3.org/2001/XMLSchema#long> ;\r\n ebucore:hasMimeType \"text/plain\" ;\r\n fedora:lastModified \"2018-05-04T21:47:02.192Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\r\n premis:hasMessageDigest <urn:sha1:640ab2bae07bedc4c163f679a746f7ab7fb5d1fa> ;\r\n ebucore:filename \"\" ;\r\n fedora:lastModifiedBy \"bypassAdmin\" ;\r\n fedora:createdBy \"bypassAdmin\" ;\r\n rdf:type ldp:NonRDFSource ;\r\n fedora:writable true ;\r\n ns001:describes <http://localhost:8080/rest/versioned_resource> .",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
