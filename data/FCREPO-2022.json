  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When performing a GET on a resource with Mime-Type: external-body, it returns a 302 redirect.  But doing a HEAD on the same resource returns 200.  It should also redirect.",
       "type": "text"
      }
