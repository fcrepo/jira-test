       "48x48": "https://secure.gravatar.com/avatar/f53ee0691ccb59ede3ec232c18af4e16?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCW-5.png"
      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fixed in master. This was indeed caused by a failure to properly shut down the embedded Derby database. The problem was introduced in March of this year, as part of the merge of FCREPO-504. As part of that commit, the reference to the embedded driver class was changed to the wrong value, which ultimately prevented the ConnectionPool.close() method from detecting that we were running the embedded db...so it didn't attempt to shut it down as it should have.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
