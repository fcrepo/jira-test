     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: pangloss",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=487398",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: YES",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "For the shutdown error, see:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://issues.apache.org/bugzilla/show_bug.cgi?id=41939"
            },
            "type": "link"
           }
          ],
          "text": "https://issues.apache.org/bugzilla/show_bug.cgi?id=41939",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://issues.apache.org/bugzilla/show_bug.cgi?id=42172"
            },
            "type": "link"
           }
          ],
          "text": "https://issues.apache.org/bugzilla/show_bug.cgi?id=42172",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "To address the startup error, we need to initialize log4j on startup, e.g.:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1) log4j.properties on the classpath (e.g. fedora/WEB-INF/classes)",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "2) log4j initialization servlet",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If #2, need to consider changes in servlet loading order (for servlet 2.4, listeners should be loaded first).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
