     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Refactoring to re-use the REST serializers for these two methods.  There are other methods here that should probably be worked into a standard serialization package (see ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-936#icft=FCREPO-936"
          },
          "type": "inlineCard"
         },
         {
          "text": ") - not sure if these other serializations are provided by the REST API, and as they are not causing problems I am leaving alone for the moment.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
