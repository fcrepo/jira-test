      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I see that it is even simpler to reproduce this error:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Start an empty fedora",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Create a container ",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "content": [
             {
              "content": [
               {
                "content": [
                 {
                  "text": "curl -i -XPUT localhost:8686/f4/rest/test",
                  "type": "text"
                 }
                ],
                "type": "paragraph"
               }
              ],
              "type": "listItem"
             }
            ],
            "type": "orderedList"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Version the container",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "content": [
             {
              "content": [
               {
                "content": [
                 {
                  "text": "curl -i -XPOST -H\"slug: v0\" localhost:8686/f4/rest/test/fcr:versions",
                  "type": "text"
                 }
                ],
                "type": "paragraph"
               }
              ],
              "type": "listItem"
             }
            ],
            "type": "orderedList"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Export the repository",
              "type": "text"
             }
            ],
            "type": "paragraph"
           },
           {
            "content": [
             {
              "content": [
               {
                "content": [
                 {
                  "text": "java -jar target/fcrepo-import-export-0.1.1-SNAPSHOT.jar -m export -b -d data -r ",
                  "type": "text"
                 },
                 {
                  "marks": [
                   {
                    "attrs": {
                     "href": "http://localhost:8686/f4/rest"
                    },
                    "type": "link"
                   }
                  ],
                  "text": "http://localhost:8686/f4/rest",
                  "type": "text"
                 },
                 {
                  "text": " -V",
                  "type": "text"
                 }
                ],
                "type": "paragraph"
               },
               {
                "content": [
                 {
                  "content": [
                   {
                    "content": [
                     {
                      "text": "BOOM!",
                      "type": "text"
                     }
                    ],
                    "type": "paragraph"
                   }
                  ],
                  "type": "listItem"
                 }
                ],
                "type": "orderedList"
               }
              ],
              "type": "listItem"
             }
            ],
            "type": "orderedList"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "orderedList"
       }
      ],
