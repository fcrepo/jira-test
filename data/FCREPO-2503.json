  "description": {
   "content": [
    {
     "content": [
      {
       "text": "To reproduce: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. fire up fcrep4: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "java -Dfcrepo.dynamic.jms.port=61717 -Dfcrepo.dynamic.stomp.port=61713 -jar fcrepo-webapp-4.8.0-SNAPSHOT-jetty-console-a07a1a46.jar --port 8686 --headless --contextPath /f4",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "2.  Create a container and add a binary.  (test/binary1)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "3. create a version  (v1)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "4.  create a second version (v2)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "5.  Do an export:  ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(commit 7f0d76)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java -jar target/fcrepo-import-export-0.1.1-SNAPSHOT.jar -d ~/import-export-sprint-3/data-export-versioned-binaries  -a -m export  -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8686/f4/rest"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8686/f4/rest",
       "type": "text"
      },
      {
       "text": " -b -V",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "6.  Verify that the importer outputs the following error: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ERROR 15:17:27.170 (ImportExportDriver) Error performing import/export: Export operation failed: unexpected status 500 for ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8686/f4/rest/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8686/f4/rest/fcr:versions",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Fcrepo4 puts out the following: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ERROR 15:17:27.165 (WildcardExceptionMapper) Exception intercepted by WildcardExceptionMapper: 1",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
