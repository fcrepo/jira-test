  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to change the auto-versioning policy to enabled by default.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This will include updating the configuration property from:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-Dfcrepo.autoversioning.enabled=true",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "to",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-Dfcrepo.autoversioning.disabled=true",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
