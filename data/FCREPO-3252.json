  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Mementos are granular to the second. F5 returns a 409 when multiple mementos are created within the same second. F6 currently allows it, but only the state of the last memento created is retrievable.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/mem-test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/mem-test",
       "type": "text"
      },
      {
       "text": " -H \"Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#NonRDFSource"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#NonRDFSource",
       "type": "text"
      },
      {
       "text": ">; rel=type\" -v -H \"Content-Type: text/plain\" -X PUT --data-binary \"testing\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin -X POST -v ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/mem-test/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/mem-test/fcr:versions",
       "type": "text"
      },
      {
       "text": " && curl -u fedoraAdmin:fedoraAdmin ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/mem-test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/mem-test",
       "type": "text"
      },
      {
       "text": " -H \"Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#NonRDFSource"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#NonRDFSource",
       "type": "text"
      },
      {
       "text": ">; rel=type\" -v -H \"Content-Type: text/plain\" -X PUT --data-binary \"testing-update\" && curl -u fedoraAdmin:fedoraAdmin -X POST -v ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/mem-test/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/mem-test/fcr:versions",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
