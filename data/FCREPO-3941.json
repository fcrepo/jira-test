  "description": {
   "content": [
    {
     "content": [
      {
       "text": "We updated Tombstone behavior in Archival Groups in ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3883"
       },
       "type": "inlineCard"
      },
      {
       "text": ", but never updated the documentation for this. The docs should be updated in order to show the new header as well as updating the expected HTTP response codes when issuing a PUT over a tombstone. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
