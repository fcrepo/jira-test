     "body": {
      "content": [
       {
        "content": [
         {
          "text": "A few additional updates made per review:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Removed archival group only note about overwriting tombstones",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Added additional status responses to PUT when create/overwriting an archival group (201) or trying to change the interaction model (409)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "I also updated the page to try and make it easier to update in the future by creating an ",
              "type": "text"
             },
             {
              "marks": [
               {
                "type": "code"
               }
              ],
              "text": "excerpt",
              "type": "text"
             },
             {
              "text": " for each HTTP request rather than having them all be in one.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
