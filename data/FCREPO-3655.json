  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If you make multiple changes or create multiple versions within a second you should only get the last one for each second.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This works for RDF serializations.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "> curl -ufedoraAdmin:fedoraAdmin http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions\r\n \r\n@prefix memento: <http://mementoweb.org/ns#> .\r\n@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\r\n@prefix fedora: <http://fedora.info/definitions/v4/repository#> .\r\n@prefix ldp:   <http://www.w3.org/ns/ldp#> .\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions>\r\n        ldp:contains           <http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions/20210225134305> ;\r\n        memento:original       <http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac> ;\r\n        fedora:created         \"2021-02-25T13:43:05.215950Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\r\n        fedora:lastModified    \"2021-02-25T13:43:05.215950Z\"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;\r\n        fedora:createdBy       \"fedoraAdmin\" ;\r\n        fedora:lastModifiedBy  \"fedoraAdmin\" ;\r\n        rdf:type               ldp:Resource ;\r\n        rdf:type               ldp:Container ;\r\n        rdf:type               ldp:RDFSource .",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "But not for ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "application/link-format",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "> curl -ufedoraAdmin:fedoraAdmin http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions -H\"Accept: application/link-format\"\r\n\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac>; rel=\"original\",\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac>; rel=\"timegate\",\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions/20210225134305>; rel=\"memento\"; datetime=\"Thu, 25 Feb 2021 13:43:05 GMT\",\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions/20210225134305>; rel=\"memento\"; datetime=\"Thu, 25 Feb 2021 13:43:05 GMT\",\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions/20210225134305>; rel=\"memento\"; datetime=\"Thu, 25 Feb 2021 13:43:05 GMT\",\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions/20210225134305>; rel=\"memento\"; datetime=\"Thu, 25 Feb 2021 13:43:05 GMT\",\r\n<http://localhost:8080/rest/test_version/bb4351ba-1293-4082-8a1e-aeb010be2aac/fcr:versions>; rel=\"self\"; from=\"Thu, 25 Feb 2021 13:43:05 GMT\"; until=\"Thu, 25 Feb 2021 13:43:05 GMT\"; type=\"application/link-format\",",
       "type": "text"
      }
