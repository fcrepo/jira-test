  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to update the fcrepo4-vagrant README.md to provide more details regarding the components installed within this Vagrant box.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo4-vagrant"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo4-vagrant",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
