  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Updating properties using the fcrepo4-client doesn't work because it was written before the whole fcr:metadata semantics were implemented in fedora.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Fix it, and add a basic integration test so we know when it breaks next time.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
