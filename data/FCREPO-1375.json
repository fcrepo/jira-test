     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Sorry, but the wording above isn't clear to me. How do I do a PUT on a resource before the parent is created? I've always seen the cases where the parent always exists (or is created) before the child is created.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
