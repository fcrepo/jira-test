     "body": {
      "content": [
       {
        "content": [
         {
          "text": "That is a good point, ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "557058:5665ee66-7fc9-476a-ba31-3a9e2e39feee",
           "text": "@Osman Din"
          },
          "type": "mention"
         },
         {
          "text": ". The following PUT works just fine:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "`curl -i -XPUT localhost:8080/rest/not-exist/new-resource`",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Unless ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "5fca89e97cc1030069d4e167",
           "text": "@justin"
          },
          "type": "mention"
         },
         {
          "text": " has more details, we should close this ticket as \"Can not reproduce\".",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
