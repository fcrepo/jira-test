     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Regarding which predicate(s) are being used in the course of an export, that seems like useful information to have in the config file regardless of whether the value was provided by the user or as a default by the tool.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
