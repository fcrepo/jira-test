     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've done some testing of the Modeshape 5.0 branch, summarized in the wiki: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FF/Testing+-+Modeshape+5"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FF/Testing+-+Modeshape+5",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "So far, Hydra rspec test suites pass and JMeter tests show performance equal to Mode 5.0.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
