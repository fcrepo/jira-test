  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This was noticed when working with working on METS/FOXML versioning for 3.0 – there are a lot of hardcoded namespace and schemaLocation constants, particularly in the serializer/deserializers.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "These should be declared in and used from common constants instead of being declared/used in each individual class that uses them.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
