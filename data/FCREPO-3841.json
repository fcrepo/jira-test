  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The idea is to add two headers to all API responses to help call attention to the importance of user registration. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "USER-REGISTRATION: “{user registration call to action here including link}“",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "Link: <{user registration link}>; rel=\"user-regisration”",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Text to be determined by ",
       "type": "text"
      },
      {
       "attrs": {
        "accessLevel": "",
        "id": "611688a84f9756006acc770b",
        "text": "@Arran Griffith"
       },
       "type": "mention"
      },
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "If would be nice to add a system property such as fcrepo.user-registration-header.enabled (default to true) so that users can turn these messages off.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
