     "body": {
      "content": [
       {
        "content": [
         {
          "text": "It was decided that we do not wish to polute API responses with additional data. We propose to governance to not implement the API headers. Awaiting the next meeting of governance to get this passed ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
