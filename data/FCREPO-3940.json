     "body": {
      "content": [
       {
        "content": [
         {
          "text": "All work done by ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "5b44cac50a894e589871012b",
           "text": "@Peter Winckles"
          },
          "type": "mention"
         },
         {
          "text": " in this thread ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-project.slack.com/archives/C8B5TSR4J/p1714621364944479"
          },
          "type": "inlineCard"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "To recap, he suggested",
          "type": "text"
         },
         {
          "type": "hardBreak"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "    @Override\n    public Integer call() {\n\n        if (configurationFilePath != null) {\n            System.setProperty(FCREPO_CAMEL_CONFIG_FILE_PROPERTY, configurationFilePath.toFile().getAbsolutePath());\n        }\n        final var appContext = new AnnotationConfigApplicationContext(\"org.fcrepo.camel\");\n\n        final var latch = new CountDownLatch(1);\n\n        Runtime.getRuntime().addShutdownHook(new Thread(() -> {\n            LOGGER.info(\"Shut down requested\");\n            appContext.stop();\n            latch.countDown();\n        }));\n\n        appContext.start();\n        LOGGER.info(\"fcrepo-camel-toolbox started.\");\n\n        try {\n            latch.await();\n        } catch (InterruptedException e) {\n            // Ignore interrupt because we're exiting already\n        }\n\n        return 0;\n    }",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "instead of the existing camel-toolbox-app main block.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
