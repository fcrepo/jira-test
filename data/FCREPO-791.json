     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Put in the 3.5 bucket and \"un-opened\" so that we can discuss + get closure on one particular gotcha with switching to the fedora-cli project: It's written in Groovy.  Are other committers ok with taking on maintenance of this code in the core?",
          "type": "text"
         }
