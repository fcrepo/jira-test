      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fixed by updating these predicates in oaiprovider/branches/maintenance-1.1.  OAIProvider 1.1.1 has been released with this change.  Note that 1.1.1 it is not backward-compatible with Fedora 2.2.3 – it only works with Fedora 2.2.4.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Download OAIProvider 1.1.1 here:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://downloads.sourceforge.net/fedora-commons/oaiprovider-1.1.1.zip"
            },
            "type": "link"
           }
          ],
          "text": "http://downloads.sourceforge.net/fedora-commons/oaiprovider-1.1.1.zip",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Source distribution:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://downloads.sourceforge.net/fedora-commons/oaiprovider-1.1.1-src.zip"
            },
            "type": "link"
           }
          ],
          "text": "http://downloads.sourceforge.net/fedora-commons/oaiprovider-1.1.1-src.zip",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "To upgrade from OAIProvider 1.1:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "make a copy of your original WEB-INF/classes/proai.properties file",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "install the new web app in place of the old one",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "copy your old proai.properties back into WEB-INF/classes/",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
