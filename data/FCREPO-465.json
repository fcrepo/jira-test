  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Because Fedora 2.2.4 uses Mulgara instead of Kowari, the OAIProvider (v1.1) isn't forward-compatbile.  The tucana#before and tucana#after predicates have changed to mulgara#before and mulgara#after, so the date-related queries don't work.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
