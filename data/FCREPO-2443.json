  "description": {
   "content": [
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo-import-export/blob/master/src/main/java/org/fcrepo/importexport/importer/Importer.java#L127"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo-import-export/blob/master/src/main/java/org/fcrepo/importexport/importer/Importer.java#L127",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "has",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "final Path manifestPath = Paths.get(bagdir.getAbsolutePath()).resolve(\"manifest-SHA1.txt\");",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "which prevents it from finding the file named manifest-sha1.txt (at least it does prevent it from working on Linux (Ubuntu 14.04) which doesn't consider the two to be the same)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The exporter exports this file named as a lowercase \"manifest-sha1.txt and I think that's what the BagIT specification calls for.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
