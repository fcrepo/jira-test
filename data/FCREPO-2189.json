  "description": {
   "content": [
    {
     "content": [
      {
       "text": "To facilitate the use of the plantpatents sample dataset for testing and verifying integrity of the repository, add baseline information and instructions:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "1. README explaning the structure of the dataset",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2. list of URIs for patent and file nodes in the repository",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "3. filenames and checksums for all binary assets stored internally",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
