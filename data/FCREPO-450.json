     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Specifically, GenericOperationsImpl.getFoxmlFromPid() is using FOXML1_0 format to perform object exports. This format needs to be updated to FOXML1_1, and any code which relies on the exported XML needs to be checked to make sure that it will work with FOXML 1.1.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
