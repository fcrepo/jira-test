        },
        "content": [
         {
          "text": "Site is now updated at 0300 UST. a new image is deployed from ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "fcrepo/fcrepo:7.1-SNAPSHOT",
          "type": "text"
         },
         {
          "text": " and the s3 bucket is wiped. ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "We probably want to add a 7:nightly or 7:SNAPSHOT tag to the docker push action as we are currently pegged to 7.1 ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
