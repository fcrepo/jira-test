       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo4-docker",
       "type": "text"
      },
      {
       "text": " to provide additional three Fcrepo settings:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Default setting: Fedora with a file-based objects database",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "MySQL setting: Fedora with a MySQL database",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "PostgreSQL setting: Fedora with a PostgreSQL database",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
