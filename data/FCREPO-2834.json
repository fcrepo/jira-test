   "content": [
    {
     "content": [
      {
       "text": "Add docker-compose to fcrepo4-docker: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo4-docker"
