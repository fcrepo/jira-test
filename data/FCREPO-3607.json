  "description": {
   "content": [
    {
     "content": [
      {
       "text": "I cannot migrate from 5.1.1 to Fedora 6:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "When I  do",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "strike"
        }
       ],
       "text": "jar fcrepo-upgrade-utils",
       "type": "text"
      },
      {
       "text": "<latest-version>.jar \\\r",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "  -i my-5.1.1-export \\\r",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "  -o my-fcrepo-6-home \\\r",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "  -s 5+ \\\r",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "  -t 6+ \\\r",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "  -u ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "I get a NullPointerException:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java.lang.NullPointerException: null",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.ResourceMigrator.calculateStateToken(ResourceMigrator.java:516)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.ResourceMigrator.createCommonHeaders(ResourceMigrator.java:458)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.ResourceMigrator.createContainerHeaders(ResourceMigrator.java:470)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.ResourceMigrator.migrateContainerVersion(ResourceMigrator.java:179)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.ResourceMigrator.migrateContainer(ResourceMigrator.java:167)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.ResourceMigrator.migrate(ResourceMigrator.java:126)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.MigrateResourceTask.run(MigrateResourceTask.java:59)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at org.fcrepo.upgrade.utils.f6.MigrationTaskManager.lambda$submit$0(MigrationTaskManager.java:66)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at java.base/java.util.concurrent.Executors$RunnableAdapter.call(Executors.java:515)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at java.base/java.util.concurrent.FutureTask.run(FutureTask.java:264)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at java.base/java.util.concurrent.ThreadPoolExecutor.runWorker(ThreadPoolExecutor.java:1128)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at java.base/java.util.concurrent.ThreadPoolExecutor$Worker.run(ThreadPoolExecutor.java:628)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "        at java.base/java.lang.Thread.run(Thread.java:835)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "This structured is created in the target directory",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ".",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "└── data",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    ├── ocfl-root",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    │   ├── 0003-hashed-n-tuple-trees.json",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    │   ├── 0=ocfl_1.0",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    │   ├── ocfl_1.0.txt",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    │   └── ocfl_layout.json",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    ├── ocfl-temp",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "    └── staging",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "but nothing more. I am using Java 12 and 6.0.0-alpha-2. of the fcrepo-upgrade-utils, no Fedora running. More ideas?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
