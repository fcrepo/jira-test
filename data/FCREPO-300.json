     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Comment from Sourceforge Task]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Comment Submitter: rwayland3",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Fixes parser issue so default xml namespaces are now handled correctly. Also fixes undiscovered bug where attribute values were being ignored on root element of in-line xml in BatchModify.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Added an extra example to modify directives file that includes",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "sample xml file from Tufts University that demonstrated original problem.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This addition now is included in junit tests as part of CommandLineUtilitites",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "testing. Updated modify directives count in junit tests to reflect the new",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "additions.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Opened a new refactoring feature item:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "[ 1839529 ] Refactor of BatchModifyParser",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "to note that it is desirable to bring BatchModifyParser up-to-date with other",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "parsers in codebase for consistency in handling of in-line xml content when time permits.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Committed to maintenance branch (rev 6306)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "committed to trunk (rev 6307)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
