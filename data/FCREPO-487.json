  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Implementing solution (b) from FCREPO-486.  Will adopt relative-path conventions to signify URLs that point within the fedora app server context, or outside it (but on the same server/port).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Will use following conventions:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "absolute path = same server port, but NOT in app server context",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "relative path = in app server context",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Notes:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "This solution will, at a minimum,  affect WSDL interpretation, object translation, and validation.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "relative URLs were previously NOT allowed in referenced content datastreams.  This will force exported foxml using the relative-path conventions to be INCOMPATIBLE with previous fedora versions. ",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
