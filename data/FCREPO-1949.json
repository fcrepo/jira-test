  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create a JMeter test for Test 6 - Number of mixed resources - files and containers",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The test should:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a mix of resources representative of a typical LDP model including containers and files",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "After every 1000 requests, performance requests should be made",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "The fcrepo-jmeter GitHub repo is available here: ",
       "type": "text"
      },
      {
       "marks": [
        {
