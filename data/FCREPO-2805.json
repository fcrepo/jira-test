     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fedora 5.x supports setting a default checksum algorithm. See ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FEDORA4x/RESTful+HTTP+API+-+Fixity#RESTfulHTTPAPI-Fixity-DefaultFixityAlgorithm"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FEDORA4x/RESTful+HTTP+API+-+Fixity#RESTfulHTTPAPI-Fixity-DefaultFixityAlgorithm",
          "type": "text"
         },
         {
          "text": " for details.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
