     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Removing from Fedora 5.1 fix version, I do not believe there is a great way to perform this other than manually editing the web.xml file and adding your roles there.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Unless someone knows something this could just be a documentation ticket.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
