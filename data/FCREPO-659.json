  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently, DOManager is responsible for creating database tables for field search, pid generator, etc.  In order to reduce this unnecessarily coupling, these maintenance tasks should be the responsibility of their native modules.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
