     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've updated the link on the website to work; it now redirects to latest documentation in the wiki regarding Fedora identifiers.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I also attempted to update the registry entry using my more current email address and organization name for completeness, but the feedback form on the site is currently broken.  I've emailed HerbertV directly to attempt to get this updated.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
