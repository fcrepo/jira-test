  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When making a GET request to a LDPCv (timemap) with \"Accept: application/link-format\" the response must include links to each memento contained by the LDPCv.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://tools.ietf.org/html/rfc7089#page-37"
         },
         "type": "link"
        }
       ],
       "text": "https://tools.ietf.org/html/rfc7089#page-37",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "There should be a link for each memento with rel=\"memento\" and datetime=\"<memento datetime of the memento in RFC-1123 format.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
