     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Sorry, that description is very sparse and doesn't address one of Andrew's specific questions from the email thread. What I am suggesting is that he event UUID be returned either in the response body (like the object URI is) or in a custom response header.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
