  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Results formats are supposed to be nested (according to the Mulgara docs) where there are subqueries (ie results of one query nested within another results set).  This doesn't seem to be the case, eg:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "select $dcidentifier",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "subquery (",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "select $s $o",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "from <#ri>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "where $s <info:fedora/fedora-system:def/model#state> $o",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": ")",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "from <#ri>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "where $s <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/identifier"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/identifier",
       "type": "text"
      },
      {
       "text": "> $dcidentifier",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
