  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The change in ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3584#icft=FCREPO-3584"
       },
       "type": "inlineCard"
      },
      {
       "text": " made it so you could not delete a resource if another process was adding a child to it. But this also does not allow you to concurrently add multiple children. This ticket is to change the locks to differentiate between locks that restrict any type of action and locks that restrict deleting the resource.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
