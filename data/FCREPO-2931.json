  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The timemap is not returning any Accept headers.  In order to comply with the Memento specification it should at the very least return \"Accept: application/link-format\".  The server does respond correctly when the \"Accept:application/link-format\" is sent with the request.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
