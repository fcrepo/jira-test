      "content": [
       {
        "content": [
         {
          "text": "ACLs were never managed/displayed via the HTML UI in Fedora 5 and before. This is a good idea but I'd suggest it is an improvement and not a bug which can be done after Beta.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
