    {
     "author": {
      "accountId": "60785ded115da6006f540529",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "When I create and ACL and navigate to it in the HTML UI, I am seeing the ACL content and properties. This appears to no longer be an issue.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Steps:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "mvn jetty:run -pl fcrepo-webapp/",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "curl -XPUT -u fedoraAdmin:fedoraAdmin  localhost:8080/rest/box  -i",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "curl -XPUT -u fedoraAdmin:fedoraAdmin -H\"Content-Type: text/turtle\" --data-binary @acl.ttl localhost:8080/rest/box/fcr:acl  -i",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Where acl.ttl is:",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "   ```",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "   @prefix acl: <",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://www.w3.org/ns/auth/acl#"
                },
                "type": "link"
               }
              ],
              "text": "http://www.w3.org/ns/auth/acl#",
              "type": "text"
             },
             {
              "text": ">.",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "   <#authz> a acl:Authorization;",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "      acl:accessTo </rest/box>;",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "      acl:agent \"user1\";",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "      acl:mode acl:Read.",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "   ```",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Open browser to: ",
              "type": "text"
             },
             {
              "marks": [
               {
                "attrs": {
                 "href": "http://localhost:8080/rest/box/fcr:acl"
                },
                "type": "link"
               }
              ],
              "text": "http://localhost:8080/rest/box/fcr:acl",
              "type": "text"
             },
             {
              "text": " – all good",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
