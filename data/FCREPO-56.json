      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "[Followup from Sourceforge Tracker]",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Followup Submitter: sjw46",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Logged In: YES ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "user_id=1709161",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Originator: YES",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "When running an itql query like so:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "select $tpackage $relDate",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "from <#ri>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "where $tpackage",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8880/NCCS/ontologies/relationships#isDistributedBy"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8880/NCCS/ontologies/relationships#isDistributedBy",
          "type": "text"
         },
         {
          "text": ">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<info:fedora/test:target1>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "and $tpackage",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://localhost:8880/NCCS/ontologies/relationships#hasReleaseDate"
            },
            "type": "link"
           }
          ],
          "text": "http://localhost:8880/NCCS/ontologies/relationships#hasReleaseDate",
          "type": "text"
         },
         {
          "text": "> $relDate",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "and $relDate <",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://tucana.org/tucana#gt"
            },
            "type": "link"
           }
          ],
          "text": "http://tucana.org/tucana#gt",
          "type": "text"
         },
         {
          "text": "> '12' in <#xsd>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "... it only works if the datatype of #hasReleaseDate is defined as xsd:double",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "(not int) in RELS-EXT.  This may be a bug in the version of Kowari we're",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "currently using (1.0.5).  In the mean time, if people need to do numeric",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "comparisons, they can use xsd:double rather than int.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
