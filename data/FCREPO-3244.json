  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Triples in HTTP response currently reference internal Fedora IDs rather than their external URI. Here's an example of what's currently returned for a TimeMap:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "```<info:fedora/version-test/fcr:versions>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ldp:contains         <info:fedora/version-test/fcr:versions/20200306203708> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "memento:original     <info:fedora/version-test> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora:created       \"2020-03-06T20:36:58.579161Z\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora:lastModified  \"2020-03-06T20:36:58.579161Z\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdf:type             fedora:TimeMap ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdf:type             memento:TimeMap .```",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "And what a TimeMap looks like in F5:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "```<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/version-test/fcr:versions"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/version-test/fcr:versions",
       "type": "text"
      },
      {
       "text": ">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdf:type               fedora:TimeMap ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdf:type               fedora:Resource ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdf:type               memento:TimeMap ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora:lastModifiedBy  \"bypassAdmin\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora:createdBy       \"bypassAdmin\" ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora:created         \"2020-03-06T20:41:16.101Z\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "text": "> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "fedora:lastModified    \"2020-03-06T20:41:57.176Z\"^^<",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/XMLSchema#dateTime"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/XMLSchema#dateTime",
       "type": "text"
      },
      {
       "text": "> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "memento:original       <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/version-test"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/version-test",
       "type": "text"
      },
      {
       "text": "> ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdf:type               ldp:RDFSource ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ldp:contains           <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/version-test/fcr:versions/20200306204157"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/version-test/fcr:versions/20200306204157",
       "type": "text"
      },
      {
       "text": "> .```",
       "type": "text"
      }
