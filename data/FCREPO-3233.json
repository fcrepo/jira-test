  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Extract the BagIt code from the import export utility into a Duraspace repository for general use: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/duraspace/bagit-support"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/duraspace/bagit-support",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Note: this won't be merged until work finishes integrating the BagIt code with the DSpace replication task suite. That way code can continue to be moved into the bagit-support library as needed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
