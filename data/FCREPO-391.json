  "description": {
   "content": [
    {
     "content": [
      {
       "text": "In order to complete the new web-based Fedora Administrative Client using the REST API as the back end, there are several updates and additions that are needed in the API. These updates should be completed in parallel with the Administrative Client. A few of the items to be included:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Include object state information as part of object properties",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Include more information in the return value of listDatastreams",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Implement the API-M getDatastream method",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Update the createObject method to return the PID of the newly created object",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
