  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When I run the ActiveFedora test suite I see this message dozens of times: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "WARN 00:37:08.772 (DefaultMessageFactory) MessageFactory event UserData is empty!",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "```",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "What does it mean?  The warning doesn't tell me how to react, but it appears to be very important! ",
       "type": "text"
      },
      {
       "attrs": {
        "id": "1f609",
        "shortName": ":wink:",
        "text": "😉"
       },
       "type": "emoji"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://travis-ci.org/projecthydra/active_fedora/jobs/108171935#L282"
         },
         "type": "link"
        }
       ],
       "text": "https://travis-ci.org/projecthydra/active_fedora/jobs/108171935#L282",
       "type": "text"
      }
     ],
