     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The messages currently have the fedora object URI, timestamp, and event type (although in a different vocabulary which will require some mapping).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It looks easy to add the userID (which is populated in the JCR Event instance automatically), and it shouldn't be too hard to pass the client user agent like we currently pass the baseURL.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
     "created": "2015-03-30T17:15:58.608-0300",
