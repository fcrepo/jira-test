    },
    {
     "author": {
      "accountId": "6089a13a248ef600739455eb",
      "accountType": "atlassian",
      "active": false,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/default/default-avatar.png"
      },
      "displayName": "Former user",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a13a248ef600739455eb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I've added userID and userAgent to the JMS events being emitted:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/760"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/760",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "However, the userAgent is passed using the ObservationManager which has caused problems in the past.  I believe ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "5fca8a549592df00764ce49c",
           "text": "@cb"
          },
          "type": "mention"
         },
         {
          "text": "'s fix for this will continue to work (see ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/537),"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/537),",
          "type": "text"
         },
         {
          "text": " and I haven't been able to trigger a problem by doing thousands of POSTs like in the past.  But we should be careful to avoid a regression here.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
