       "48x48": "https://secure.gravatar.com/avatar/8285187b23d5d8ea87a1ecc2e6d456d6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBB-1.png"
      },
      "displayName": "Bill Branan",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5d83b5f927bbf40c2c32ceeb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-391#icft=FCREPO-391"
          },
          "type": "inlineCard"
         },
         {
          "text": " introduces a new verb for retrieving datastream content, in order to allow a datastream's \"profile\" to also be available. The datastream profile includes the information provided by APIM.getDatastream. The profile will be available at the url http://host:port/fedora/objects/PID/datastreams/DSID, appending /content to this url will return the datastream contents.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
