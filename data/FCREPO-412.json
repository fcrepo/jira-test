     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Consider providing the information in the response header for appropriate verms instead of adding verbs to REST-API.  If verbs are needed then this information still would be useful in the response header.  Also returning the PID and a good last modified date could be made available.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
