  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Asger pointed out that it is currently necessary to parse FOXML or perform a field search in order to determine the state of an object or datastream.  It's also necessary to use API-M in order to determine the format uri of a datastream. Better would be to provide all this information via the REST api, where appropriate.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
