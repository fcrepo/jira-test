       "32x32": "https://secure.gravatar.com/avatar/362a60c7c1f37ec3362a1f5d4f2b7eb5?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBS-0.png",
       "48x48": "https://secure.gravatar.com/avatar/362a60c7c1f37ec3362a1f5d4f2b7eb5?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBS-0.png"
      },
      "displayName": "Bethany Seeger",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5ed02d2a7d0c250c236c34d9",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I think we can close this bug. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This is implemented in the code: ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-import-export-verify/blob/master/verify.py#L190-L200"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/fcrepo-import-export-verify/blob/master/verify.py#L190-L200",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "And here: ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-import-export-verify/blob/master/verify.py#L222"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/fcrepo-import-export-verify/blob/master/verify.py#L222",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "As well as comparisons: ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo-import-export-verify/blob/master/verify.py#L362-L369"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-labs/fcrepo-import-export-verify/blob/master/verify.py#L362-L369",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "There will always be a sha1, right?  I know there are other algorithms that one can use in Fedora, but I think this is a modeshape one and should just be there (for the time being)?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If that's not the case, then this needs to be more flexible, eventually. ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
