     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The resolution to this:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "Added handling of the link rel=type header to explicitly set interaction model",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Removed handling of Content-Disposition in requests.  This was the former mechanism for forcing an LDP-NR model",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
