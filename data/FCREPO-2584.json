  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "CRUD capabilities need to be updated, such that in a successful resource creation request, if a Link: rel=\"type\" request header specifies the LDP-NR interaction model (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#NonRDFSource,"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#NonRDFSource,",
       "type": "text"
      },
      {
       "text": " regardless of Content-Type: value), then the server should handle subsequent requests to the newly created resource as if it is an LDP-NR.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
