     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Discussed at 2025-01-30 tech meeting, needs some review of whether we could separate the database actions from the OCFL actions while allowing some handling of failures.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
