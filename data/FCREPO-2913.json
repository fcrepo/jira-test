  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Test 4.3.6-B of the Fedora Test Suite states that \"An implementation that does support DELETE should do so by both removing the LDPCv and removing the versioning interation model from the original LDPRv\". This test fails when run against the master branch of fcrepo4 using the method described in FCREPO-2902.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
