  "description": {
   "content": [
    {
     "content": [
      {
       "text": "In order to send content to the preservation service, as a repository administrator I would like to:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Select a group of resources in Fedora to export as bags",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "Definition of done:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Select resource(s) to export",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Select resource(s) to export based on membership, e.g. ldp:contains, pcdm:hasMember",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Allow for a BagIt bag for all resources in a collection, and/or individual bags for each resource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Resources exported to valid BagIt bag(s)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a BagIt bag that adheres to a given BagIt Profile",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Configurable path for exported BagIt Bags",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
