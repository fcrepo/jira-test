  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The task at hand is to address the following warnings in the fcrepo-http-commons  module.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Once these issues are resolved when you build the module using this command",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "mvn clean install -pl fcrepo-http-commons",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "the following warnings should no longer appear in the output:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "[INFO] ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1 warning",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] Javadoc Warnings",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] /Users/danny/code/fcrepo4/fcrepo-http-commons/src/main/java/org/fcrepo/http/commons/responses/HtmlTemplate.java:39: warning: no @return",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] String value();",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] ^",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
