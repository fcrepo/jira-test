  "description": {
   "content": [
    {
     "attrs": {
      "localId": "4969c087fbcf"
     },
     "content": [
      {
       "text": "The GitHub actions workflow “Rebuild latest release image version” seems to build Docker images in the deploy job, but never pushes them to Docker Hub.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "localId": "7f61adc06333"
     },
     "content": [
      {
       "text": "The script ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo-exts/fcrepo-docker/blob/main/build-and-push-to-dockerhub.sh"
         },
         "type": "link"
        }
       ],
       "text": "build-and-push-to-dockerhub.sh from fcrepo-exts/fcrepo-docker",
       "type": "text"
      },
      {
       "text": " used to build the Docker image, only pushes the Image to Docker Hub, when the command line flag ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "--push",
       "type": "text"
      },
      {
       "text": " as been specified. This flag is currently missing in the workflow.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
