     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Yes, it's valid for ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "em"
           }
          ],
          "text": "updating",
          "type": "text"
         },
         {
          "text": ". So, if there is a PUT on a fcr:metadata resource that does not exist, it should be rejected.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
