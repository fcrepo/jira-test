  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Hi!",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " the utils produce a log with lines that start with:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INFO 08:57:39.366 ...",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "there’s no date, so for a migration that last across several days (or use ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "--resume ",
       "type": "text"
      },
      {
       "text": " or later ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "--pid-file",
       "type": "text"
      },
      {
       "text": ") it can be useful to have the date (for example: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "INFO 2025-03-14 08:57:39.366 ...",
       "type": "text"
      },
      {
       "text": ").",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
