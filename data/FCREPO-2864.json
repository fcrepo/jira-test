  "description": {
   "content": [
    {
     "content": [
      {
       "text": " According to the example in ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/solid/web-access-control-spec#groups-of-agents"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/solid/web-access-control-spec#groups-of-agents",
       "type": "text"
      },
      {
       "text": "  acl:agentGroup predicates should be able to reference hash URI's identifying groups of users.  Currently Fedora does not recognize lists under hash URIs.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
