  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Create an object:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Add a title with a /",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "INSERT DATA { <> dc:title \"test/value\" . }",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Try to delete all titles:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "DELETE { <> dc:title ?title }",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "WHERE { }",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "You get a successful response, but the title remains.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
