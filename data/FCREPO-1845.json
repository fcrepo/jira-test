     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The behavior you see here is expected, given the SPARQL query you list. That is, the SPARQL query listed here will not delete the triple. Instead, I suspect you mean either of these queries:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "DELETE WHERE { <> dc:title ?title }",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "or",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "DELETE { <> dc:title ?title }",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "WHERE { <> dc:title ?title }",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Both of those queries will remove the title, whether it contains a \"/\" or not.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
