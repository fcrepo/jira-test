    {
     "author": {
      "accountId": "60785ded115da6006f540529",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "24x24": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "32x32": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png",
       "48x48": "https://secure.gravatar.com/avatar/6d51465aa828084aeddbf6d03c81fdc4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FAW-3.png"
      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/978"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/978",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "As of this update, the default backend is still LevelDB.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "To use the MySQL object store, you need to:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "1. Install an instance of MySQL",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "2. Run Fedora with the following JAVA_OPTS:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "JAVA_OPTS=\"${JAVA_OPTS} -Dfcrepo.modeshape.configuration=classpath:/config/jdbc-mysql/repository.json\"\r\nJAVA_OPTS=\"${JAVA_OPTS} -Dfcrepo.ispn.mysql.username=<username>\"\r\nJAVA_OPTS=\"${JAVA_OPTS} -Dfcrepo.ispn.mysql.password=<password>\"\r\nJAVA_OPTS=\"${JAVA_OPTS} -Dfcrepo.ispn.mysql.host=<default=localhost>\"\r\nJAVA_OPTS=\"${JAVA_OPTS} -Dfcrepo.ispn.mysql.port=<default=3306>\"",
          "type": "text"
         }
        ],
        "type": "codeBlock"
       },
       {
        "content": [
         {
          "text": "Note, the database and table used by ISPN are auto-created.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
