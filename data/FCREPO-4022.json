     "content": [
      {
       "text": "After the changes to Jersey (2 to 3) there seem to be some changes to encoding/decoding support. Now the test ExternalContentPathValidatorIT#testPathModifiers is failing on Windows",
       "type": "text"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
