  "description": {
   "content": [
    {
     "content": [
      {
       "text": "RDF with subjects or objects prefixed by",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "info:fedora",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "are automatically translated on retrieval such that \"info:fedora\" is replaced with the base Fedora URI.  In some cases users may want to see the internal resource identifiers instead of the translated ones.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task here is to provide a means for indicating in the request that the user would like to suppress the translation behavior.  Whether this ability is accomplished by means of a query param, header, or some other means is up for discussion.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
