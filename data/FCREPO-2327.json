  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Repository resources that make use of the external redirect feature of Fedora will appear in serialized form on disk as a zero-length binary. ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-2296#icft=FCREPO-2296"
       },
       "type": "inlineCard"
      },
      {
       "text": " will implement the addition of the extension \".external\" to all such resources in order to mark them as redirects.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task of this ticket is to make import-export-verify handle such resources (i.e. recognize the extension, and skip over checksum verification since the resource is not part of the exported set),",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
