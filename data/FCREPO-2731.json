  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to change the 500 response that currently occurs in the following scenario to a '406 Not Acceptable'.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a versioned resource",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl -i -XPOST -H \"Slug: obj\" -H \"Link: <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://mementoweb.org/ns#OriginalResource"
             },
             "type": "link"
            }
           ],
           "text": "http://mementoweb.org/ns#OriginalResource",
           "type": "text"
          },
          {
           "text": ">; rel=\\\"type\\\"\" \"",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/",
           "type": "text"
          },
          {
           "text": "\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Request the resultant TimeMap with a bad \"Accept\" header",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "curl  ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/obj/fcr:versions"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/obj/fcr:versions",
           "type": "text"
          },
          {
           "text": " -H\"Accept: application/format-junk\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "> Response: 500",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Note: Non-TimeMap resource respond with the correct 406.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Also, the above scenario responds correctly when using \"Accept: junk\".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
