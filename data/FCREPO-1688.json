  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Jena 2.13.0 has a transitive dependency on commons-lang3, and fcrepo currently uses v2.x of commons-lang, meaning the codebase depends on both versions. This would be a good opportunity to upgrade the (minimal) existing usage of commons-lang from 2 to 3.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
