  "description": {
   "content": [
    {
     "content": [
      {
       "text": "GH Issue was raised ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo/fcrepo/pull/2184"
       },
       "type": "inlineCard"
      },
      {
       "text": "  ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "User was experiencing different behaviour between file uploads to S3 backed Fedora. Peter Winkles identified the issue was a lack of path style support for the s3crtClient. I provided a PR ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/fcrepo/fcrepo/pull/2184"
       },
       "type": "inlineCard"
      },
      {
       "text": "  to add this and the user confirmed that this resolved the issue for them. ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    }
