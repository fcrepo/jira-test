  "description": {
   "content": [
    {
     "content": [
      {
       "text": "SPARQL ASK queries return False, regardless to actual match and the response format is not compliant to the SPARQL guidelines for ASK responses.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Spec:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/TR/rdf-sparql-query/#ask"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/TR/rdf-sparql-query/#ask",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "From a basic query, the following is found (manually) to exist in the triplestore:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<info:fedora/dataset:1> <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/dc/elements/1.1/identifier"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/dc/elements/1.1/identifier",
       "type": "text"
      },
      {
       "text": "> \"dataset:1\" .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Performing a SPARQL query:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "ASK { <info:fedora/dataset:1> dc:identifier \"dataset:1\" }",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "via: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://databank.ouls.ox.ac.uk:8080/fedora/risearch?lang=sparql&format=sparql&type=tuples&query=ASK%20"
         },
         "type": "link"
        }
       ],
       "text": "http://databank.ouls.ox.ac.uk:8080/fedora/risearch?lang=sparql&format=sparql&type=tuples&query=ASK%20",
       "type": "text"
      },
      {
       "text": "{%20%3Cinfo:fedora/dataset:1%3E%20dc:identifier%20%22dataset:1%22%20}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Response:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<sparql xmlns=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/sw/DataAccess/rf1/result"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/sw/DataAccess/rf1/result",
       "type": "text"
      },
      {
       "text": "\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<head>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<variable name=\"k0\"/>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</head>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<results>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "<result>",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
