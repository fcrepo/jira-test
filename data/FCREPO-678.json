  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The following sparql query uses a filter to select all the objects having the dc:title expressed in italian (\"it\") language:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "select ?o ?t",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "from <#ri> ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "where {?o <dc:title> ?t .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "filter( langMatches( lang(?t), \"it\") )}",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The query executed by ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/risearch"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/risearch",
       "type": "text"
      },
      {
       "text": " returns 0 results, while the same query without the filter condition gives the following results:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(note: there are several nodes with xml:lang = 'it')",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<sparql xmlns=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/2001/sw/DataAccess/rf1/result"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/2001/sw/DataAccess/rf1/result",
       "type": "text"
      },
      {
       "text": "\">",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
