     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Hmm in FieldSearchResultSQLImpl.java there is this bit:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "if (terms.indexOf(\"'\") != -1) {",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "throw new QueryParseException(\"Query cannot contain the ' character.\");",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "which suggests that using single quotes is a no-no.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
