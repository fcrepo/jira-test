     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As discussed yesterday in the committer meeting this should not be a problem since fedora switched to using PreparedStatements.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "PreparedStatement is used in FieldSearchResultSQLImpl.java but single quotes were escaped with a backslash instead of a second single quote, which lead to a invalid query.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "source: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.postgresql.org/docs/current/static/sql-syntax-lexical.html#SQL-SYNTAX-CONSTANTS"
            },
            "type": "link"
           }
          ],
          "text": "http://www.postgresql.org/docs/current/static/sql-syntax-lexical.html#SQL-SYNTAX-CONSTANTS",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "Note: although link goes to postgresql doc using a second single quote to escape single quotes is ANSI sql.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
