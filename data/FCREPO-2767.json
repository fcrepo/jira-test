  "description": {
   "content": [
    {
     "content": [
      {
       "text": "In order to create versions of a resource the resource must be created with the",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://mementoweb.org/ns#OriginalResource"
         },
         "type": "link"
        }
       ],
       "text": "http://mementoweb.org/ns#OriginalResource",
       "type": "text"
      },
      {
       "text": ">; rel=\"type\" header. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task is to ensure that the above link header is include on POST to create new resources in the HTML UI.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
