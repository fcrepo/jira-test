  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The task at hand is to address the following warnings in the fcrepo-auth-webac module.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The fix will likely entail replacing any references to the deprecated method \"anyObject()\" with \"any()\".",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Once this issue is resolved when you build the module using this command",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "mvn clean install -pl fcrepo-auth-webac",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "the following warning should no longer appear in the output:",
       "type": "text"
      }
     ],
