  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If the fcrepo-ldpath is not loaded as a dependency (which it should) this tries to install the feature. This is throwing an error during `vagrant up`",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "\"==> default: Error executing command: No matching features for fcrepo-camel-ldpath/0.0.0\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
