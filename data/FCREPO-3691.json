  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently search queries returning the rdf_type field gets very slow as the database grows.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example this query is relatively fast (.3 secs) on a fedora with 1 million resources.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin \"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/fcr:search?fields=fedora_id,mime_type,modified&max_results=10"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/fcr:search?fields=fedora_id,mime_type,modified&max_results=10",
       "type": "text"
      },
      {
       "text": "\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "However this takes 19 seconds.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -u fedoraAdmin:fedoraAdmin \"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fcrepo/rest/fcr:search?fields=fedora_id,mime_type,modified,rdf_type&max_results=10"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fcrepo/rest/fcr:search?fields=fedora_id,mime_type,modified,rdf_type&max_results=10",
       "type": "text"
      },
      {
       "text": "\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
