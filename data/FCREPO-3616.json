  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As of a few days ago, ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/fcrepo#ServerManaged"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/fcrepo#ServerManaged ",
       "type": "text"
      },
      {
       "text": "can now be specified in the Prefer Header (e.g. with \"omit=\")",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The task here is to update the old one , ie ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/repository#ServerManaged"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/repository#ServerManaged,",
       "type": "text"
      },
      {
       "text": "to use the new one.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
