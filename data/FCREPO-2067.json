  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to replicate and resolve the issue identified by the test steps detailed in the following comments:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2055?focusedCommentId=50536&page=com.atlassian.jira.plugin.system.issuetabpanels:comment-tabpanel#comment-50536"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2055?focusedCommentId=50536&page=com.atlassian.jira.plugin.system.issuetabpanels:comment-tabpanel#comment-50536",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Under certain circumstances, the HTML UI responds with: \"SyntaxError: Unexpected end of JSON input\" when browsing through HTML resources.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The issue appears to be related to the fact that HEAD operations respond with application/ld+json that is unparseable... which is not surprising, since HEAD should have an empty body.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
