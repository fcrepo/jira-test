       "48x48": "https://secure.gravatar.com/avatar/9c216fdd7cb93a81bea8fb9ffc640f8e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSL-3.png"
