  "description": {
   "content": [
    {
     "content": [
      {
       "text": "There appears to be a missing console attribute in the error handling routine at line 56 in resources.py.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Traceback (most recent call last):",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "File \"/Library/Frameworks/Python.framework/Versions/3.6/lib/python3.6/site-packages/fcrepo_verify/verifier.py\", line 135, in execute",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "original.filter_binary_refs()",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "File \"/Library/Frameworks/Python.framework/Versions/3.6/lib/python3.6/site-packages/fcrepo_verify/resources.py\", line 98, in filter_binary_refs",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "FedoraResource(o, self.config, self.logger).is_binary():",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "File \"/Library/Frameworks/Python.framework/Versions/3.6/lib/python3.6/site-packages/fcrepo_verify/resources.py\", line 56, in init",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "self.console.error(\"Unexpected response from Fedora\")",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "AttributeError: 'FedoraResource' object has no attribute 'console'",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
