  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When you pass a filename header with an unescaped quote in it. It's fine for this to be an error, but is the java specific exception appropriate?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "I set a header like this:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Content-Disposition: attachment; filename=\" \"Value Added\" in Editorial Acquisitions.pdf\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The following example provokes the situation:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "curl -XPOST -i --data-binary @file.txt -H\"Content-Disposition: attachment; filename=\"some\" junk.txt\" localhost:8080/f4/rest",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4/fcrepo4/issues/687"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4/fcrepo4/issues/687",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
