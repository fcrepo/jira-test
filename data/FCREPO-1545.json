      },
      "displayName": "Andrew Woods",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=60785ded115da6006f540529",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The goal of this ticket is attractive, but looking more deeply into Git submodules, it is not clear that their use in this case would increase developer happiness. Likewise, no other option is immediately obvious beyond the current status of maintaining individual copies in each project.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "I would suggest we close this ticket as \"Won't Fix\" unless there actually is an appealing way forward.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
