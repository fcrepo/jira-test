  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Via the use of Git submodules or some similar functionality, the metadata in the travis.yml file of individual projects should be factored out into some easily-updated master file.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The common .travis.yml should also check for javadoc errors:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn javadoc:jar",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "mvn javadoc:test-aggregate",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
