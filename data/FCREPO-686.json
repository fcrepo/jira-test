     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Proposal:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Add API method setDatastreamControlGroup.  For release 3.4, restrict this to setting the control group of \"X\" datastreams to \"M\".  REST API implementation would involve additional parameters on the existing datastream methods for modifying datastreeams.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
