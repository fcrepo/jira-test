    {
     "author": {
      "accountId": "6089a4cb543264006867626e",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "24x24": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "32x32": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png",
       "48x48": "https://secure.gravatar.com/avatar/ddfaabcc9635974ebed182e89941a947?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSB-2.png"
      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "fedora-modify-control-group scripts in server/bin, takes parameters",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "protocol",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "user",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "password",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "pid:  single pid, comma-separated list, or file:///path/to/file specifying list of pids",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "dsID: single datastream identifier or comma-separated list of datastream identifiers",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "controlGroup: desired control group (only M is accepted)",
              "type": "text"
             },
             {
              "type": "hardBreak"
             },
             {
              "text": "Additional parameters:",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "addXMLHeader - add an XML declaration including the UTF-8 character set",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "reformat - reformat the XML (indenting)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "setMIMETypeCharset - add charset=UTF-8 to the MIMEType (this will be returned in http headers when getting the datastream content)",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       },
       {
        "content": [
         {
          "text": "Web service call",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "/management/control?action=modifyDatastreamControlGroup",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "with additional query parameters as above, excluding protocol, user and password",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
