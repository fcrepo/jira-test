   "content": [
    {
     "content": [
      {
       "text": "Specifically to address ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-492#icft=FCREPO-492"
       },
       "type": "inlineCard"
      },
      {
       "text": " - allo DC, RELS-EXT etc to be managed content.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The tool needs to migrate existing \"X\" datastreams to \"M\" to address this (we may consider making its scope more general)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The tool needs to migrate all datastream versions, and should record the change in the audit trail.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
