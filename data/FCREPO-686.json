     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Discussed on committer call 2010-08-10",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "don't add to main APIs, but follow a pattern similar to \"reload policies\", ie a /management call",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "integrate with AuthZ, including existing XACML and FeSL",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
