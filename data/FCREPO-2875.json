      "content": [
       {
        "content": [
         {
          "text": "Thanks Kevin! I did some light editing and added a note referencing the memento spec (its a little redundant with the first paragraph of that document, but it seems appropriate to mention the memento datetime negotiation pattern used in the datetime negotiation section).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Think we just need to link to the section then we're good to go.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
