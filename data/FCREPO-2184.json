  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to ensure that RDF prefixes that are defined in PUT and POST requests as new Containers are registered within Fedora.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example, the following request should result in the registration of both the 'pcdm' and 'bibo' prefixes.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "— body.ttl",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "@prefix pcdm: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://pcdm.org/models#"
         },
         "type": "link"
        }
       ],
       "text": "http://pcdm.org/models#",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "@prefix bibo: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://purl.org/ontology/bibo/"
         },
         "type": "link"
        }
       ],
       "text": "http://purl.org/ontology/bibo/",
       "type": "text"
      },
      {
       "text": "> .",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<> a pcdm:Object ;",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "bibo:shortTitle 'Fedora4 Site Initialization Page' .",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "—",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Request:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "> curl -i -XPUT -H\"Content-Type: text/turtle\" --data-binary @body.ttl localhost:8080/rest/test",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Note: When this ticket is completed, the following wiki page should be updated: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FEDORA4x/Best+Practices+-+RDF+Namespaces"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FEDORA4x/Best+Practices+-+RDF+Namespaces",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
