     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The desired behavior appears to be implemented. Creating resources using POST and PUT with text/turtle bodies with defined prefixes resulted in those prefixes being registered in the repository. Furthermore, the documentation for 5.x has been updated to reflect this behavior: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://wiki.duraspace.org/display/FEDORA5x/Best+Practices+-+RDF+Namespaces"
            },
            "type": "link"
           }
          ],
          "text": "https://wiki.duraspace.org/display/FEDORA5x/Best+Practices+-+RDF+Namespaces",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note, however, that depending in the outcome of FCREPO-2785, this may no longer be of as much concern.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
