  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to enable the migration-utils to run in the case where the destination F4 repository has authz enabled. ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "This will likely include an update to fcrepo4-client to accept username/password.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To demonstrate that this issue has been resolved, run the migration-utils against the webac-enabled fcrepo4-vagrant:",
       "type": "text"
      },
