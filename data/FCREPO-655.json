  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Based on the GET URIs exposed in the REST API, support use of these URIs as resource identifiers in the resource index.  See ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora-commons.org/confluence/display/DEV/Supporting+the+Semantic+Web+and+Linked+Data"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora-commons.org/confluence/display/DEV/Supporting+the+Semantic+Web+and+Linked+Data",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This could involve",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "rewriting of query output to convert info:fedora/ URIs to HTTP resource URIs",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "rewriting of query input to convert HTTP URIs to info:fedora URIs",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "The info:fedora URI form should be retained for portability etc",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
