     "body": {
      "content": [
       {
        "content": [
         {
          "text": "As part of this we should take into account that the info URI registry is now closed, and they recommend long term moving away from them to more \"web friendly\" identifier schemes.  ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://info-uri.info/"
            },
            "type": "link"
           }
          ],
          "text": "http://info-uri.info/",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
