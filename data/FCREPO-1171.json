    {
     "content": [
      {
       "text": "The version of ActiveMQ that has been included with Fedora is not compatible with Java 7. It must be upgraded for Fedora 3.7 and the consequences to Fedora's dependency profile must be considered and corrected.",
       "type": "text"
      }
     ],
