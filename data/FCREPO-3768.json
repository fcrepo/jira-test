  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This ticket serve to capture bug I have found in testing fcrepo-migration-validator-1.1.0-20210902.184602-2 build when the parameter is set to output result in csv format there is no csv files in output folder, result directory seems only consists of result.json files in the corresponding ocfl tuple subfolder. Here's the command I have used:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/usr/lib/jvm/java-11-amazon-corretto/bin/java -jar fcrepo-migration-validator-1.1.0-SNAPSHOT-driver.jar  -d=/fedora/data/datastreams -o=/fedora/data/objects -c=/dev_061521_full/data/ocfl-root -H --debug -r=/dev_061521_full/validation_result --source-type=legacy --algorithm=sha512 -R=csv > /dev_061521_full/validation.log",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
