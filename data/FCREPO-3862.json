  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This ticket is to add a configuration option to allow users to choose between upgrading existing objects (on write) to the current version of OCFL implemented by Fedora or leave them as the older version.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This uses the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": ".setUpgradeObjectsOnWrite(true)",
       "type": "text"
      },
      {
       "text": " flag described at ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://github.com/UW-Madison-Library/ocfl-java#upgrading-ocfl-repositories"
       },
       "type": "inlineCard"
      }
     ],
     "type": "paragraph"
    }
   ],
