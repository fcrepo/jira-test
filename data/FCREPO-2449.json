     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I have added handling for 401, 403, and 404. (Previously handled only 200 and 307)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Any other response (including 500) will cause the verifier to fail out.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
