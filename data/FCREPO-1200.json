  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Following the instructions at:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora-commons.org/documentation/3.3/Installation%20and%20Configuration%20Guide.html"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora-commons.org/documentation/3.3/Installation%20and%20Configuration%20Guide.html",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "it tells you to run:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Create the database. For example, to create a database named \"fedora3\", enter:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "CREATE DATABASE fedora3;",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "which by default created a latin1 encoded database:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "mysql> status",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "--------------\nmysql  Ver 14.14 Distrib 5.1.67, for redhat-linux-gnu (x86_64) using readline 5.1",
       "type": "text"
      }
