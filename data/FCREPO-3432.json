  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When upgrading from 4. to 6 in two steps - ie F4->F5 and then F5->F6 you'll see the following error in the second step (F5->F6):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "```",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ERROR 11:13:54.063 (MigrateResourceTask) Failed to process ResourceInfo{parentId='info:fedora', fullId='info:fedora/container1', nameEncoded='container1', outerDirectory=/Users/danielbernstein/tmp/fcrepo-4.7.5-to-5.1.1-upgrade/rest, innerDirectory=/Users/danielbernstein/tmp/fcrepo-4.7.5-to-5.1.1-upgrade/rest/container1, type=CONTAINER}",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "java.lang.IllegalStateException: Failed to identify interaction model for resource info:fedora/container1",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.upgrade.utils.f6.ResourceMigrator.identifyInteractionModel(ResourceMigrator.java:423)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.upgrade.utils.f6.ResourceMigrator.migrateContainerVersion(ResourceMigrator.java:175)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.upgrade.utils.f6.ResourceMigrator.migrateContainer(ResourceMigrator.java:165)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.upgrade.utils.f6.ResourceMigrator.migrate(ResourceMigrator.java:124)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.upgrade.utils.f6.MigrateResourceTask.run(MigrateResourceTask.java:59)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at org.fcrepo.upgrade.utils.f6.MigrationTaskManager.lambda$submit$0(MigrationTaskManager.java:66)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.base/java.util.concurrent.Executors$RunnableAdapter.call(Executors.java:515)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "at java.base/java.util.concurrent.FutureTask.run(FutureTask.java:264)",
