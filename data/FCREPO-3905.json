     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I’ve updated ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://wiki.lyrasis.org/display/FEDORA6x/Migrate+to+Fedora+6"
          },
          "type": "inlineCard"
         },
         {
          "text": "  to add an FAQ about this problem, and also added a note under the upgrade util command to clarify what the base-uri option is:",
