     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Test payloads for RdfStreamingOutputTest#testJsonLdExpanded, RdfStreamingOutputTest#testJsonLdFlattened and RdfStreamingOutputTest#testJsonLdCompacted were taken from the JSON-LD specification and use real names and URLs for spec authors. It would be good to remove these and replace them with generic identifiers and URLs.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
