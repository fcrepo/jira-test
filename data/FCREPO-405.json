     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I like this idea, at York we have implemented IIPImage streaming server ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://iipimage.sourceforge.net/,"
            },
            "type": "link"
           }
          ],
          "text": "http://iipimage.sourceforge.net/,",
          "type": "text"
         },
         {
          "text": " while integrating fedora with this service, I found the process implementing a proxy using SDefs/SDeps really onerous when all that was need is a simple way of proxying.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
