     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Checked into this and the group resource is a NonRDFSource object. I'm guessing because the http client appends a charset to the content-type and then ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-3312#icft=FCREPO-3312"
          },
          "type": "inlineCard"
         },
         {
          "text": " takes over. I have tested the same behaviour in fcrepo4-tests without a charset in the content-type and it seems to work.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
