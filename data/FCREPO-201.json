       "48x48": "https://secure.gravatar.com/avatar/8285187b23d5d8ea87a1ecc2e6d456d6?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBB-1.png"
      },
      "displayName": "Bill Branan",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5d83b5f927bbf40c2c32ceeb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The class that is being used to write to objects in DefaultManagement is a DOWriter which extends DOReader in order to provide writing capability. A class which implements the DOReader interface simply guarantees that the methods included in the interface will be available; no assertions are made regarding any other methods that the class might include. In this case, the DOWriter simply extends the capabilities of the DOReader, which does not violate the DOReader contract.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
