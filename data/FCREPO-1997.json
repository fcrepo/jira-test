  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to remove the leaked JCR details exposed when GETting a tombstone.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "To reproduce:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -XPUT localhost:8080/rest/collection",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -XDELETE localhost:8080/rest/collection",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "curl -XGET localhost:8080/rest/collection",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "—",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "Discovered tombstone resource at /collection {jcr:createdBy=bypassAdmin, jcr:primaryType=fedora:Tombstone, jcr:created=2016-04-17T12:45:49.151-04:00}",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "—",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "As a follow-on ticket, an HTML UI view for tombstones should be created.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
