     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Fixed in 6f500ad5bd71e22d5549833abb1b471235e96df5.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "FYI, for Jetty 6.x, creating a contexts/fedora.xml with the following contents will do (substituting your own relative path to FEDORA_HOME for \"fedora/default\"):",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "<?xml version=\"1.0\"  encoding=\"ISO-8859-1\"?>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<!DOCTYPE Configure PUBLIC \"-//Mort Bay Consulting//DTD Configure//EN\" \"",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://jetty.mortbay.org/configure.dtd"
            },
            "type": "link"
           }
          ],
          "text": "http://jetty.mortbay.org/configure.dtd",
          "type": "text"
         },
         {
          "text": "\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Configure class=\"org.mortbay.jetty.webapp.WebAppContext\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Set name=\"contextPath\">/fedora</Set>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Set name=\"war\"><SystemProperty name=\"jetty.home\" default=\".\"/>/webapps/fedora</Set>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Set name=\"initParams\">",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Map>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Entry>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Item>fedora.home</Item>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "<Item><SystemProperty name=\"jetty.home\" default=\".\"/>/fedora/default</Item>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</Entry>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</Map>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</Set>",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "</Configure>",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
