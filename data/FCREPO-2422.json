  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The following functionality used to be supported:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "$ mvn clean install -pl fcrepo-webapp -Pone-click",
