  "customfield_10154": null,
  "customfield_10187": null,
  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Fedora should not allow the use of `ldp:contains` for the `ldp:hasMemberRelation` Object on Direct and Indirect containers.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "In the example of Direct Containers, the following scenario should be prohibited:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a resource",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> curl -i -u fedoraAdmin:fedoraAdmin -XPUT ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/dresource"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/dresource",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Create a Direct Container:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> curl -i -u fedoraAdmin:fedoraAdmin -XPUT ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/d"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/d",
           "type": "text"
          },
          {
           "text": " -H \"Link: <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://www.w3.org/ns/ldp#DirectContainer"
             },
             "type": "link"
            }
           ],
           "text": "http://www.w3.org/ns/ldp#DirectContainer",
           "type": "text"
          },
          {
           "text": ">;rel=\\\"type\\\"\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Add Direct Container triples to the new container:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "> curl -i -u fedoraAdmin:fedoraAdmin -XPATCH ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/rest/d"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/rest/d",
           "type": "text"
          },
          {
           "text": " -H \"Content-Type: application/sparql-update\" --data-binary @direct.su",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "...where direct.su is:",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "INSERT {",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "<> <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://www.w3.org/ns/ldp#membershipResource"
             },
             "type": "link"
            }
           ],
           "text": "http://www.w3.org/ns/ldp#membershipResource",
           "type": "text"
          },
          {
           "text": "> </rest/dresource> ;",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "<",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://www.w3.org/ns/ldp#hasMemberRelation"
             },
             "type": "link"
            }
           ],
           "text": "http://www.w3.org/ns/ldp#hasMemberRelation",
           "type": "text"
          },
          {
           "text": "> <",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://www.w3.org/ns/ldp#contains"
             },
             "type": "link"
            }
           ],
           "text": "http://www.w3.org/ns/ldp#contains",
           "type": "text"
          },
          {
           "text": "> .",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "} WHERE {}",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "```",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "The above PUT should fail because \"ldp:hasMemberRelation\" is set to \"ldp:contains\"",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "orderedList"
    },
    {
     "content": [
      {
       "text": "Currently, in the above scenario, any resource that is added to </rest/d> will result in a triple on </rest/dresource> of the form:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "</rest/dresource> ldp:contains <child-of-d>",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "...which is bad",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Note 1: The above scenario should also be prevented for Indirect Containers.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Note 2: If using PUT in the above scenario with the Direct Container triples, the PUT fails as expected.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
