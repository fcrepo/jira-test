  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Filtering of search results by access constraints.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This was part of the plan in ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://conferences.tdl.org/or/OR2011/OR2011main/paper/view/416/127"
         },
         "type": "link"
        }
       ],
       "text": "https://conferences.tdl.org/or/OR2011/OR2011main/paper/view/416/127",
       "type": "text"
      },
      {
       "text": " for GSearch 2.4.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Based on work presented at OR2008 : ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://pubs.or08.ecs.soton.ac.uk/104/"
         },
         "type": "link"
        }
       ],
       "text": "http://pubs.or08.ecs.soton.ac.uk/104/",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Problem: Search results contain hits that the user does not have the access rights to see ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Solution: Extend access rights to search results by filtering",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
