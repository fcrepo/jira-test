     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "PR: ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/718"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/718",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Changes made to address 2 design choices:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "(1) public static utility classes should not abstract:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "org.fcrepo.kernel.utils.NamespaceTools ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "src/main/java/org/fcrepo/kernel/utils/ContentDigest.java",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "org.fcrepo.kernel.services.functions.JcrPropertyFunctions",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "(2) classes should not be abstract when no implementation is given:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "src/main/java/org/fcrepo/kernel/impl/services/AbstractService.java",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "src/main/java/org/fcrepo/kernel/impl/services/ServiceHelpers.java",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "src/main/java/org/fcrepo/http/commons/AbstractResource.java",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
