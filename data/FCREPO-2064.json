  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Implementations of javax.ws.rs.ext.ExceptionMapper in org.fcrepo.http.commons.exceptionhandlers need to have consistent approaches to logging, and must have a way to configure logging of stacktraces for the mapped exceptions. The unavailability of the stacktraces is an impediment to debugging.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
