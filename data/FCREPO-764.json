     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I completely agree with this suggested improvement.  As someone trying to code a robust PHP interface into the REST API it would be extremely helpful. In addition, going through the process of looking at errors the REST API will naturally get more standardized (i.e. xml=true vis format=xml).  If possible I would like to see this documented in a similar format to the OAI specification ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://www.openarchives.org/OAI/openarchivesprotocol.html#ProtocolMessages"
            },
            "type": "link"
           }
          ],
          "text": "http://www.openarchives.org/OAI/openarchivesprotocol.html#ProtocolMessages",
          "type": "text"
         },
         {
          "text": ".",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
