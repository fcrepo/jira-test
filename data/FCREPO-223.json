  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As reported on the dev list, if a dc element in the DC datastream contains an xml:lang attribute (e.g. \"<dc:subject xml:lang=\"da\">Tidsinterval</dc:subject>\"), the xml:lang attribute is dropped during ingest.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Additionally, the xml:lang attribute is not dropped if the DC datastream is added via addDatastream.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This was reported against 3.0b1, but I believe this affects all versions of Fedora.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
