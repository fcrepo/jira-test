   "content": [
    {
     "content": [
      {
       "text": "With the change in transaction handling the HTML UI no longer can handle transactions in its current form. Now we need to track the transaction ID and pass it as a header on each request until submit or roll back is called.",
       "type": "text"
      }
     ],
     "type": "paragraph"
