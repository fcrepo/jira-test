      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Oops, missed that \"test\" is used in two places! (Bad smell? :)). Anyhow, here's a quick fix:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private final String ZIP_FILE = TMP_DIR + File.separator + \"test\" + System.nanoTime() + \".zip\";",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "private final String TEST_STR = \"test\" + System.nanoTime();",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "private final String TEST_DIR = TMP_DIR + File.separator + TEST_STR;",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
