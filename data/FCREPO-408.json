  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Fedora repository homepage at ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/",
       "type": "text"
      },
      {
       "text": " has the following content:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Apache-AXIS",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Hello! Welcome to Apache-Axis.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "What do you want to do today?",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Administer Axis [link #1]",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Visit the Axis Servlet [link #2]",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Link #1 above links to ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/servlet/AdminServlet"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/servlet/AdminServlet",
       "type": "text"
      },
      {
       "text": ". But this link is broken: it returns a 404 error page (rather, it should – see also bug ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCSUPPORT-33#icft=FCSUPPORT-33"
       },
       "type": "inlineCard"
      },
      {
       "text": "). ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Either this link should be made to work, or it should be removed entirely. Thanks!",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
