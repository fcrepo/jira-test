  "description": {
   "content": [
    {
     "content": [
      {
       "text": "For large documents when streamCaching() is in effect, errors are encountered. This is probably due to the file-spooled stream being removed prematurely. The relevant function in FcrepoProducer should be fixed, and some tests should be written to test for this situation.",
       "type": "text"
      }
     ],
     "type": "paragraph"
