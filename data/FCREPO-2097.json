  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Fedora ontology is available online, but LDP clients have a hard time parsing it since it doesn't include a Content-Type header. It really MUST return a Content-Type header. I see that most other ontologies will redirect clients to a URL with a .rdf extension.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For example:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "$ curl -i ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora.info/definitions/v4/2016/03/01/repository"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora.info/definitions/v4/2016/03/01/repository",
