  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently none of the LDP-RSs return following header. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "Link: <http://www.w3.org/ns/ldp#RDFSource>; rel=\"type\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "To complete this ticket, ensure that the link header returned for all",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "LDP-RS's including LDPRv (versioned resources), LDPCv (timemaps),  and ACLs.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "CTS Test ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://fedora.info/2018/06/25/spec/#solid-ldp-acls"
         },
         "type": "link"
        }
       ],
       "text": "5.1",
       "type": "text"
      },
      {
       "text": " should pass once this issue is resolved.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
