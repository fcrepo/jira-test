       "32x32": "https://secure.gravatar.com/avatar/447aa9c3d096ee8b4dc9aa9a27fddbbe?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png",
       "48x48": "https://secure.gravatar.com/avatar/447aa9c3d096ee8b4dc9aa9a27fddbbe?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FM-5.png"
      },
      "displayName": "Martin",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a522f9def1006ab12578",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "A prettier patch might be the following or something of the like:",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "private File createTempDirectory(String name) {",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "File directory = File.createTempFile(name, System.nanoTime(), System.getProperty(\"java.io.tmpdir\") );",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "directory.mkdir();",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "cleanOutDirectory(directory);",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "directory.deleteOnExit();",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "return directory;",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "}",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
