  "description": {
   "content": [
    {
     "content": [
      {
       "text": "As reported on the mailing list (",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://comments.gmane.org/gmane.comp.cms.fedora-commons.devel/2540),"
         },
         "type": "link"
        }
       ],
       "text": "http://comments.gmane.org/gmane.comp.cms.fedora-commons.devel/2540),",
       "type": "text"
      },
      {
       "text": " selecting the legacy-fs store still results in akubra-fs being used.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Removing $FEDORA_HOME/server/config/spring/akubra-llstore.xml before first start is a workaround, but Fedora should respect the original install option.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
