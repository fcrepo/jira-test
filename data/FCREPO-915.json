     "body": {
      "content": [
       {
        "content": [
         {
          "text": "POST to /objects is equivalent to POST to /objects/new - this is not picked up in the handler mappings in ObjectsFilter.getHandler.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Additionally POST to /objects/[pid] is not mapped (only POST to /objects/new)",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
