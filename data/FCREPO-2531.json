  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to create a new fcrepo-config.xml in the fcrepo-webapp-plus project (src/main/webapp/WEB-INF/classes/spring/fcrepo-audit-config.xm) that has the \"InternalAuditor\" uncommented.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Additionally, this new fcrepo-audit-config.xml file should be enabled in f4-vagrant:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "install_scripts/fedora4.sh",
           "type": "text"
          }
