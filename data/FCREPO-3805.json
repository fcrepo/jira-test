  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Maven Shade plugin for packaging classes on the class path into a single uberjar has some problems. Results may vary and lead to obscure class path issues. It generates Maven build warnings and might break Java 9 module descriptors for some libraries in the future. Also generating uberjars is not common anymore in containerized applications.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "type": "strong"
        }
       ],
       "text": "Options",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Switch to ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://docs.spring.io/spring-boot/docs/current-SNAPSHOT/reference/htmlsingle/#build-tool-plugins.maven"
             },
             "type": "link"
            }
           ],
           "text": "https://docs.spring.io/spring-boot/docs/current-SNAPSHOT/reference/htmlsingle/#build-tool-plugins.maven",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Use ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "https://docs.spring.io/spring-boot/docs/current-SNAPSHOT/reference/htmlsingle/#executable-jar"
             },
             "type": "link"
            }
           ],
           "text": "https://docs.spring.io/spring-boot/docs/current-SNAPSHOT/reference/htmlsingle/#executable-jar",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Don't generate an uberjar at all",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
