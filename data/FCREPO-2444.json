      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/716de6574b1704204b895e09d95ac345?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-0.png",
       "24x24": "https://secure.gravatar.com/avatar/716de6574b1704204b895e09d95ac345?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-0.png",
       "32x32": "https://secure.gravatar.com/avatar/716de6574b1704204b895e09d95ac345?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-0.png",
       "48x48": "https://secure.gravatar.com/avatar/716de6574b1704204b895e09d95ac345?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBA-0.png"
