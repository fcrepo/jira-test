     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Impact (3) needs careful consideration - this could potentially affect a lot of external code written against Fedora using the resource index; we'd need to ensure the justification is good enough if we're expecting people to modify existing code.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
