  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When a client is allowed to perform acl:Append operations on an LDP-RS",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "1) a PATCH request that deletes triples must be denied with a 401 (Unauthorized code)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "2)  PATCH request that only adds triples should be allowed.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
