       "48x48": "https://secure.gravatar.com/avatar/e1a895887848b2343e35b3edabb18d34?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FCX-1.png"
      },
      "displayName": "Calvin Xu",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3A2e87e1c9-44d7-4a83-ae7b-b16b225ed7a4",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I compiled the webapp and tested in our environment, however we are still on tomcat 9.0.102 and Java 11, and looks like the new webapp war file is only compatible with tomcat 10 and Java 17, we get error messages : ‘NoClassDefFoundError: jakarta/servlet/ServletContextListener and UnsupportedClassVersionError ... class file’ version 61.0 which is Java 17 bytecode, is there a way to include Java 11 and earlier Tomcat version in this fix? thanks ",
          "type": "text"
         },
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a594bb0b0500707c78d8",
           "text": "@Dan Field"
          },
          "type": "mention"
         },
         {
          "text": " ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
