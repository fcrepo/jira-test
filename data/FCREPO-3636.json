  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently we are not validating RDF on rebuild.  A problem could arise if the internal RDF subject and object URIs do not conform to Fedora's expectations.  We will index the object but then choke when trying to access it.  ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "To be defined:  the validation rules",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
