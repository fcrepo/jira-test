     "body": {
      "content": [
       {
        "content": [
         {
          "text": "*Side Note:* ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "attrs": {
           "accessLevel": "",
           "id": "6089a55c52a3d400690692f7",
           "text": "@Ralf Claussnitzer"
          },
          "type": "mention"
         },
         {
          "text": " raised the issue on Slack: ",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://fedora-project.slack.com/archives/CM74BAYS3/p1612985485114000?thread_ts=1612960462.097700&cid=CM74BAYS3"
            },
            "type": "link"
           }
          ],
          "text": "https://fedora-project.slack.com/archives/CM74BAYS3/p1612985485114000?thread_ts=1612960462.097700&cid=CM74BAYS3",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It sounds like he is looking for a mechanism to configure custom RDF validation rules which we believe could best be handled by API-X.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
