     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Per discussion in slack.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "All actions within a transaction will result in the creation of a single version, if auto-versioning is enabled.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "If auto-versioning is not enabled, the updates go in mutable-head.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Requests to create versions within transactions are prohibited.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "Specifying a timestamp and POST content is no longer supported.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
      ],
      "type": "doc",
      "version": 1
     },
