  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is to enable the creation of a Fedora resource version/memento via the HTTP API (POST /fcr:versions).",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The result of the request should be a newly created OCFL version.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It is possible/likely, that initial exploration of this task (org.fcrepo.http.api.FedoraVersioning) will reveal that a number of sub-tasks must be accomplished first.",
