     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Does anyone still need this functionality?  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "PCDM has been fleshed out greatly since the creation of this ticket, and it's no longer an issue since indirect containers are used for membership.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It's still a possibility someone might need it, so please speak up if you do.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
