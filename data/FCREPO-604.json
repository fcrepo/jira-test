  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Wherever HTTP GET is used and the optional asOfDateTime URL parameter is accepted, Fedora should also be able to deal with the X-Accept-Datetime http request header, as specified by memento: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://arxiv.org/abs/0911.1112"
         },
         "type": "link"
        }
       ],
       "text": "http://arxiv.org/abs/0911.1112",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
