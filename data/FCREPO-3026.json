  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The task at hand is to address the following warnings in the fcrepo-auth-webac module.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Once these issues are resolved when you build the module using this command",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "mvn clean install -pl fcrepo-auth-webac",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "the following warnings should no longer appear in the output:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "[WARNING] Javadoc Warnings",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] warning: unknown enum constant ThreadingBehavior.IMMUTABLE",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "[WARNING] reason: class file for org.apache.http.annotation.ThreadingBehavior not found",
       "type": "text"
