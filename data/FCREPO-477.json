       "24x24": "https://secure.gravatar.com/avatar/a27b189f53110c93b66a08557fa79dee?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRK-0.png",
