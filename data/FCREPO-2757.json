  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Explore code changes involved in splitting descriptions from the jcr:content node in order to resolve pathing issues and assist with binary memento creation/resolution.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Proposed design:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://drive.google.com/file/d/1AEXRliMcBJUR1WFC6Z7cHKE4SEM4ykH5/view?usp=sharing"
         },
         "type": "link"
        }
       ],
       "text": "https://drive.google.com/file/d/1AEXRliMcBJUR1WFC6Z7cHKE4SEM4ykH5/view?usp=sharing",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "External paths are unchanged.  Internal paths are modified with different node types, and roles of classes are adjusted.",
       "type": "text"
