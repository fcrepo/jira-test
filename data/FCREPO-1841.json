     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Update: islandora updates the datastream TN using two concurrent processes.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "And indeed, if you use two concurrent threads, this problem occurs.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Can this be prevented, or is this fixed in another version of Fedora?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "cf. ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://jira.duraspace.org/browse/FCREPO-1284"
            },
            "type": "link"
           }
          ],
          "text": "https://jira.duraspace.org/browse/FCREPO-1284",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
