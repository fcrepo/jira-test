      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "One solution is to always include ",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "strong"
           }
          ],
          "text": "all",
          "type": "text"
         },
         {
          "text": " policies in each evaluation.  However this is likely to be costly in terms of performance.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
