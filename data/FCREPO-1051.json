  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When running the installer, if user selects MySQL as the database platform, the installer doesn't allow the user to proceed if they enter an empty string for 'password' even though this is allowed by MySQL and is the default behaviour for many desktop development environments.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Database",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "--------\nPlease select the database you will be using with   ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Fedora. The supported databases are Derby, MySQL, Oracle and Postgres.     ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "If you do not have a database ready for use by Fedora or would prefer to   ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "use the embedded version of Derby bundled with Fedora, enter 'included'.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Options : derby, mysql, oracle, postgresql, included",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Enter a value ==> mysql",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "MySQL JDBC driver",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-----------------\nYou may either use the included JDBC driver or your own copy.              ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Enter 'included' to use the included JDBC driver, or, enter the location   ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(full path) of the driver.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Enter a value [default is included] ==>   ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Database username",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-----------------\nEnter the database username Fedora will use to connect to the Fedora database.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Enter a value ==> drupaluser",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Database password",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "-----------------\nEnter the database password Fedora will use to connect to the Fedora database.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Enter a value ==> ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Error: Must specify a value",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Enter a value ==> ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Logging into the database with no password is allowed in MySQL.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
