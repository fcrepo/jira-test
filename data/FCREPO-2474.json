  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If I point import-export at ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/pcdm"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/pcdm",
       "type": "text"
      },
      {
       "text": " it will recurse through the repository according to ldp:contains relationships.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "If I point it at ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest",
       "type": "text"
      },
      {
       "text": " it will export that top container only, even though there are two resources (and many more contained within those) in that container:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "<",
       "type": "text"
      },
      {
