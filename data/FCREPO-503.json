     "content": [
      {
       "text": "When performing a custom installation on the Oracle platform, the default driver is oracle.jdbc.driver.OracleDriver.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "In current Oracle JDBC releases, this has been deprecated / removed. The default should be updated to oracle.jdbc.OracleDriver",
       "type": "text"
      }
     ],
