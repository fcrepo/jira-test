  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Ben O'Steen reported on the users list that the rebuilder was failing with a ClassNotFoundException against his remote instance of Mulgara.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "mulgara-core-2.0.6.jar is missing the client-rdf package (org.mulgara.client.jrdf), which was present prior to 2.0.5. Need to fix this upstream and rebuild mulgara-core. Trippi will also require the updated mulgara-core package.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
