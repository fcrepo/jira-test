  "description": {
   "content": [
    {
     "content": [
      {
       "text": "I’ve been seeing errors when building Fedora locally in the ExternalContentHandlerFactoryTest with the following exception:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "org.fcrepo.kernel.api.exception.ExternalMessageBodyException: Unable to access external binary at URI http://test.com\n        at org.fcrepo.http.api.ExternalContentHandlerFactoryTest.testValidLinkHeader(ExternalContentHandlerFactoryTest.java:56)\nCaused by: org.apache.http.conn.HttpHostConnectException: Connect to test.com:80 [test.com/34.224.149.186, test.com/3.18.255.247] failed: Connection timed out (Connection timed out)\n        at org.fcrepo.http.api.ExternalContentHandlerFactoryTest.testValidLinkHeader(ExternalContentHandlerFactoryTest.java:56)\nCaused by: java.net.ConnectException: Connection timed out (Connection timed out)\n        at org.fcrepo.http.api.ExternalContentHandlerFactoryTest.testValidLinkHeader(ExternalContentHandlerFactoryTest.java:56)",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "This is one of the few places where ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://test.com"
         },
         "type": "link"
        }
       ],
       "text": "test.com",
       "type": "text"
      },
      {
       "text": " is used instead of ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.com"
         },
         "type": "link"
        }
       ],
       "text": "example.com",
       "type": "text"
      },
      {
       "text": ". It should be updated to use ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://example.com"
         },
         "type": "link"
        }
       ],
       "text": "example.com",
       "type": "text"
      },
      {
       "text": " instead of test.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
