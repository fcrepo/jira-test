  "description": {
   "content": [
    {
     "content": [
      {
       "text": " This problem exists at the API layer and thus impacts that HTML UI as well (on clicking the \"Fixity\" button on a binary resource view.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The following method needs to be implemented.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-kernel-impl/src/main/java/org/fcrepo/kernel/impl/services/FixityServiceImpl.java#L52-L55"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-kernel-impl/src/main/java/org/fcrepo/kernel/impl/services/FixityServiceImpl.java#L52-L55",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "We'll likely need to test against resource.getContentDigest().",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The results of the above method need to be integrated here:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-http-api/src/main/java/org/fcrepo/http/api/FedoraFixity.java#L106-L117"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo/fcrepo/blob/main/fcrepo-http-api/src/main/java/org/fcrepo/http/api/FedoraFixity.java#L106-L117",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
