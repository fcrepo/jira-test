      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Config now via system property:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "fedora.fesl.pep_nocache=true",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "This will override PEP_NOCACHE environment variable if it is set.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "If the system property is not set, then the PEP_NOCACHE environment variable will still be used (ie existing installations will work as before).",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The PEP_NOCACHE environment variable configuration should be removed in a post-3.6 release, ",
          "type": "text"
         },
         {
          "attrs": {
           "url": "https://fedora-repository.atlassian.net/browse/FCREPO-1053#icft=FCREPO-1053"
          },
          "type": "inlineCard"
         },
         {
          "text": " raised for this",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
