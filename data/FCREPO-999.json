  "description": {
   "content": [
    {
     "content": [
      {
       "text": "FeSL's XACML caches policy evaluation results, so that policies are not re-evaluated for repeated access to the same resource etc.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This is currently configurable - the caching can be disabled by setting PEP_NOCACHE=true as an environment variable.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This should instead be an option in a config file, FeSL should not depend on environment variables.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
