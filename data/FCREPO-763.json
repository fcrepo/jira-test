  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The validate-policy.sh/.bat script that comes with Fedora assumes the v1 XACML schema, but FeSL policies use the v2 XACML schema.  Although FeSL Authorization is still considered experimental, it would be good to have a way for people to validate the newer-style policies.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
