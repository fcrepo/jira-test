      },
      "displayName": "Stephen Bayliss",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=6089a4cb543264006867626e",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "FESLPOLICY datastream contents is validated on create/update against xacml 2.0 schema - should we close this issue?  The script is useful for legacy xacml policies but doesn't seem useful for FeSL now that policies are stored in object datastreams.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
