  "description": {
   "content": [
    {
     "content": [
      {
       "text": "If the ONTOLOGY datastream specifies a mandatory relationship and specifies the type (CModel) of the target, and the target object is missing, the validate method returns a 404 and text specifying the missing object.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "It would be better if this could be reported as part of the XML message.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
