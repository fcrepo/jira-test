  "description": {
   "content": [
    {
     "content": [
      {
       "text": "HTTP ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "Prefer:",
       "type": "text"
      },
      {
       "text": " header ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "omits",
       "type": "text"
      },
      {
       "text": " and ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "includes",
       "type": "text"
      },
      {
       "text": " do not function on the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "fcr:versions",
       "type": "text"
      },
      {
       "text": " endpoint as they do on plain resource endpoints.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Example ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "PreferContainment",
       "type": "text"
      },
      {
       "text": " results on resource (works):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "$ curl -H \"Accept: application/rdf+xml\" -H \"Prefer: return=representation; omit=\\\"http://www.w3.org/ns/ldp#PreferMinimalContainer\\\"; include=\\\"http://www.w3.org/ns/ldp#PreferContainment\\\"\" \"http://localhost:8080/rest/myresource\"",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "<rdf:RDF\r\n    xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"\r\n    xmlns:ldp=\"http://www.w3.org/ns/ldp#\" > \r\n  <rdf:Description rdf:about=\"http://localhost:8080/rest/myresource\">\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/TECH0\"/>\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/RELS-INT\"/>\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/RELS-EXT\"/>\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/MASTER0\"/>\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/DC\"/>\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/AUDIT\"/>\r\n    <ldp:contains rdf:resource=\"http://localhost:8080/rest/myresource/ADMINMD\"/>\r\n  </rdf:Description>\r\n</rdf:RDF>",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": " Example ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "PreferContainment",
       "type": "text"
      },
      {
       "text": " results on resource versions (does not return results):",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "curl -H \"Accept: application/rdf+xml\" -H\"Prefer: return=representation; omit=\\\"http://www.w3.org/ns/ldp#PreferMinimalContainer\\\"; include=\\\"http://www.w3.org/ns/ldp#PreferContainment\\\"\" \"http://localhost:8080/rest/myresource/fcr:versions\"",
       "type": "text"
      }
     ],
