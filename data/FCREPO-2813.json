  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When developing against Fedora, fcrepo/rest UI provides a quick way to check if a resource has been created, updated or deleted. Current UI is very limited. For instance, it does not have paging mechanism.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Providing a better fcrepo/rest UI would be helpful for developers, system administrators and repository administrators.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "For start the following would be very helpful:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Paging mechanism",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Tabular view with additional fields/properties, ability to sort on fields/properties",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": " ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
