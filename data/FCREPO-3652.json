  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently when making a request to a URI in fedora that does not exist, it returns a 404 response with the message",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "\"Error: No OCFL mapping found for info:fedora/somenode\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "OCFL seems irrelevant at this tier of the platform, not to mention its showing the internal fedora id. It would be good to give a cleaner message back that does not include these two things, maybe just \"not found\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
