  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The following note incorrectly suggests that an unimplemented feature is in fact implemented:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "Note: All fcrepo 3 DC (Dublin Core) datastream values are mapped as dcterms properties on the Object in fcrepo 6+. The same goes for any properties in the RELS-EXT and RELS-INT datastreams.",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "It should be removed until it is actually implemented.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
