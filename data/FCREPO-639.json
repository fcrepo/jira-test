  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Allow users to change Fedora's log configuration (e.g. from INFO to DEBUG) without having to restart.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This capability is directly supported by Logback.  The default logback.xml configuration shipped with the Fedora server should do this.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
