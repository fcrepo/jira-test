     "body": {
      "content": [
       {
        "content": [
         {
          "text": "REST API documentation corrected.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "The intention with the endpoint was to explicitly keep it outside the main REST endpoint as it is in essence a utility method that will at some point go away, and it doesn't logically belong within the REST URI syntax.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
