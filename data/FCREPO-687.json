     "body": {
      "content": [
       {
        "content": [
         {
          "text": "What REST endpoint should we use for this?  It has been previously discussed that defining a \"repository\" object would be a good idea - if we could settle on a PID for this maybe the endpoint could be on this object.  Otherwise it probably lives outside the /objects URI path.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
