      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/DK-3.png"
      },
      "displayName": "Demian Katz",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=5db386745304a60c3a769d36",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I would think that option 1 would be preferred if it’s feasible – at least, I’d rather have my data agree everywhere rather than have one value in one place and a potential override in a different place, which seems like a recipe for potentially inconsistent behavior.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
