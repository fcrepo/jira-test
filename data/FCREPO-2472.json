  "description": {
   "content": [
    {
     "content": [
      {
       "text": "I exported my repo using the following command:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "java -jar target/fcrepo-import-export-0.1.1-SNAPSHOT.jar -d ~/import-export-sprint-3/data-export-as-bag  -m export -a -b -r ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8686/f4/rest"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8686/f4/rest",
       "type": "text"
      },
      {
       "text": " -g default -G ~/import-export-sprint-3/config-files/bagit-profile.yml ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The resulting importexport.yml looks like this: ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "mode: export",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "external: false",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "predicates: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://www.w3.org/ns/ldp#contains"
         },
         "type": "link"
        }
       ],
       "text": "http://www.w3.org/ns/ldp#contains",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "overwriteTombstones: false",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "resource: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/1"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/1",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "bag-profile: default",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "bag-config: path/config.yaml",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "dir: /tmp/rdf",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "binaries: false",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "rdfLang: text/turtle",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Notice resource, binaries, bag-config, resource, and possibly predicates are simply using default values not the ones specified by the command line.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
