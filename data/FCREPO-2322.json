     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Ok so we need to know when the export started and possibly when it ended, then we need to walk the Fedora repo down from the chosen resource for any resources that existed before either of date/times and see if they exist on disk.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
