    {
     "author": {
      "accountId": "557058:bfcf2b10-5443-4304-afe6-3aff38ddf271",
      "accountType": "atlassian",
      "active": true,
      "avatarUrls": {
       "16x16": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/JW-4.png",
       "24x24": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/JW-4.png",
       "32x32": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/JW-4.png",
       "48x48": "https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/initials/JW-4.png"
      },
      "displayName": "Joshua Allan Westgard",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Abfcf2b10-5443-4304-afe6-3aff38ddf271",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "After discussion it was agreed that we would provide documentation explaining that the verification tool only works against the resources that are in the tree in the location specified by the config file submitted.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "If users add resources after export, they will get an error because the added resource won't be present in the exported set.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "If users delete resources from the original tree after export, the tool will not notice that they have been deleted, even though \"extra\" resources would be present in the export.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "orderedList"
       },
       {
        "content": [
         {
          "text": "This ticket should be closed as \"will not fix\" and a new ticket for documentation opened.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
