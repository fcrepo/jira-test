          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "all \"access\" API calls testing for unauthorized wrapped in If (getAuthAccess()) to only execute test under ConfigB",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         },
         {
          "content": [
           {
            "content": [
             {
              "text": "all \"management\" calls as before (auth required for A and B)",
              "type": "text"
