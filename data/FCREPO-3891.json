      "active": true,
      "avatarUrls": {
       "16x16": "https://secure.gravatar.com/avatar/197ffd07aaaff1f530d60f433130ae24?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJA-3.png",
       "24x24": "https://secure.gravatar.com/avatar/197ffd07aaaff1f530d60f433130ae24?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJA-3.png",
       "32x32": "https://secure.gravatar.com/avatar/197ffd07aaaff1f530d60f433130ae24?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJA-3.png",
       "48x48": "https://secure.gravatar.com/avatar/197ffd07aaaff1f530d60f433130ae24?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FJA-3.png"
      },
      "displayName": "James Alexander",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ad68ad01c-c97b-42a0-8679-bae8450078ab",
      "timeZone": "Europe/London"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I ran the script and I get a “version not found” error: so on ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://main.tf"
            },
            "type": "link"
           }
          ],
          "text": "main.tf",
          "type": "text"
         },
         {
          "text": ", line 365, the Linux version should be updated to the latest (\"64bit Amazon Linux 2 v3.5.7 running Docker\"). ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "It would be good to update the supported database versions in the description - ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "http://variables.tf"
            },
            "type": "link"
           }
          ],
          "text": "variables.tf",
          "type": "text"
         },
         {
          "text": ", line 44, something like “postgresql 12.14, mariadb 10.6.10, mysql 8.0.32”. Also, the readme file needs the postgres version updating.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
