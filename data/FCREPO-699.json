  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Reported by Jasper Op de Coul - ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://fedora-commons.1317035.n2.nabble.com/versionable-attribute-on-modifyDatastream-td5066130.html#a5066130"
         },
         "type": "link"
        }
       ],
       "text": "http://fedora-commons.1317035.n2.nabble.com/versionable-attribute-on-modifyDatastream-td5066130.html#a5066130",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Test case:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "(1) curl -u fedoraAdmin:fedoraAdmin -T dc.xml -v ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/fedora/objects/changeme:1/datastreams/DC?dsState=A&versionable=false"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/fedora/objects/changeme:1/datastreams/DC?dsState=A\\&versionable=false",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "verify datastream versionable is set to false",
           "type": "text"
          },
          {
           "type": "hardBreak"
          },
          {
           "text": "(2) curl -u fedoraAdmin:fedoraAdmin -T dc.xml -v ",
           "type": "text"
          },
          {
           "marks": [
            {
             "attrs": {
              "href": "http://localhost:8080/fedora/objects/changeme:1/datastreams/DC"
             },
             "type": "link"
            }
           ],
           "text": "http://localhost:8080/fedora/objects/changeme:1/datastreams/DC",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "datastream state has now been updated to true (it should not have been)",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    },
    {
     "content": [
      {
       "text": "See ",
       "type": "text"
      },
      {
       "attrs": {
        "url": "https://fedora-repository.atlassian.net/browse/FCREPO-608#icft=FCREPO-608"
       },
       "type": "inlineCard"
      },
      {
       "text": " for a similar issue with object state.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
