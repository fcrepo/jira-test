  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Various parts of the code base refer to \"transactions\" as either transactions or sessions. There is a one-to-one relationship between API transactions and persistence sessions, and the transaction id is used as the persistence session id. Perhaps the language can be unified to avoid confusion.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
