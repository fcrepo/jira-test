     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Depends on this issue as policies will need to be able to test for the individual relationships API methods (as XACML actions); currently they can't as the individual methods are not exposed as actions in the PEP.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
