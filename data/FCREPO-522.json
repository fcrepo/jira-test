  "description": {
   "content": [
    {
     "content": [
      {
       "text": "It is possible to create a new datastream terminating in .xml - eg file.xml",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The html page for this datastream is unobtainable -> eg /objects/pid/datastreams/file.xml  as it incorrectly looks for a datastream without the .xml eg 'file' and states that 'file' doesn't exist.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/objects/pid/datastreams/file.xml.xml does resolve to the xml version of the file.xml ds properties.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
  "duedate": null,
  "environment": {
   "content": [
    {
     "content": [
      {
       "text": "Usual environ - linux, any JRE, tomcat 5",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
