      },
      "displayName": "Chris Wilper",
      "self": "https://fedora-repository.atlassian.net/rest/api/3/user?accountId=557058%3Ae25d94d0-bd50-4c2c-906c-14cdf85801fb",
      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Discussed on Sept 15th committer call.  Agreement that \".xml\" shortcut should be dropped for this URL (which actually gets the datastream properties)...same for get object profile, since people can have PIDs that end in .extension.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Post to list: to use the ?format=xml form for these.",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "text": "To get the content, use the dsid/content URL.  ",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Highlight in release notes as potentially breaking change.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Check admin gui for which form it uses.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
