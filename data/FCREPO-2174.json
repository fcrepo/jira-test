  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The Java client should be able to parse Link headers with three or more parts, such as the Link from a newly-created binary to its description, which has the form:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Link: <",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/file1/fcr:metadata"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/file1/fcr:metadata",
       "type": "text"
      },
      {
       "text": ">; rel=\"describedby\"; anchor=\"",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://localhost:8080/rest/file1"
         },
         "type": "link"
        }
       ],
       "text": "http://localhost:8080/rest/file1",
       "type": "text"
      },
      {
       "text": "\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
