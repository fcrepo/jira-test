  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Currently migration-utils is configured in the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "logback.xml",
       "type": "text"
      },
      {
       "text": " file to show DEBUG output for the ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "org.fcrepo.migration",
       "type": "text"
      },
      {
       "text": " classes:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "language": "java"
     },
     "content": [
      {
       "text": "<logger name=\"org.fcrepo.migration\" additivity=\"false\" level=\"DEBUG\">\r\n <appender-ref ref=\"STDOUT\"/>\r\n </logger>",
       "type": "text"
      }
     ],
     "type": "codeBlock"
    },
    {
     "content": [
      {
       "text": "Change the level to \"INFO\", then verify that the level is set to DEBUG only when the utility is run with the  ",
       "type": "text"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "--debug",
       "type": "text"
      },
      {
       "text": " flag.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
