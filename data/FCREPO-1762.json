           "text": "@andy.wagner"
          },
          "type": "mention"
         },
         {
          "text": ", in case clarification was needed, I left the following comment:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-labs/fcrepo4-client/pull/31/files#r47974346"
