  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When the Aduna Maven repository was taken offline in mid-April 2014, fcrepo maven build broke, as required dependencies were no longer available.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Fix:  remove the Aduna repository from the the pom, remove/replace sesame artifacts with transitive dependencies to artifacts in the Aduna repo.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
