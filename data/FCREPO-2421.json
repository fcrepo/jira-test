  "description": {
   "content": [
    {
     "content": [
      {
       "text": "This task is a follow-on to: ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://jira.duraspace.org/browse/FCREPO-2402"
         },
         "type": "link"
        }
       ],
       "text": "https://jira.duraspace.org/browse/FCREPO-2402",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "The work of this task should include:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Update: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FEDORA4x/Best+Practices+-+Fedora+Configuration"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FEDORA4x/Best+Practices+-+Fedora+Configuration",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Update: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://wiki.duraspace.org/display/FEDORA4x/Configuring+JDBC+Object+Store"
         },
         "type": "link"
        }
       ],
       "text": "https://wiki.duraspace.org/display/FEDORA4x/Configuring+JDBC+Object+Store",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Create: new AWS/S3 page",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "Create: Readme in 'fcrepo-configs/src/main/resources/config' that references the appropriate wiki pages.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "In terms of content, the recommendations are:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "content": [
        {
         "content": [
          {
           "text": "Externalize configuration files, and include passwords directly therein",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      },
      {
       "content": [
        {
         "content": [
          {
           "text": "Only use system properties for passwords if you are fully comfortable with the risk of exposing that information to others who have access to the system.",
           "type": "text"
          }
         ],
         "type": "paragraph"
        }
       ],
       "type": "listItem"
      }
     ],
     "type": "bulletList"
    }
   ],
