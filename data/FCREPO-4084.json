  "description": {
   "content": [
    {
     "attrs": {
      "localId": "aa9db18d9007"
     },
     "content": [
      {
       "text": "In:",
       "type": "text"
      },
      {
       "attrs": {
        "localId": "768dc92d2488",
        "url": "https://github.com/fcrepo/fcrepo/blob/0696b1830118b6f41091e65553b5589bb252daf4/fcrepo-persistence-ocfl/src/main/java/org/fcrepo/persistence/ocfl/impl/OcflPersistenceConfig.java#L174"
       },
       "type": "inlineCard"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "fcrepo.ocfl.s3.timeout.connection.seconds",
       "type": "text"
      },
      {
       "text": " is currently wired to a netty pool acquisition timeout. Should that instead be wired to a tcp connection timeout? (connectionTimeout in the builder)",
       "type": "text"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "localId": "aa9db18d9007"
     },
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "connectionAcquisitionTimeout(Duration connectionAcquisitionTimeout)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "localId": "af57903da72d"
     },
     "content": [
      {
       "text": "The amount of time to wait when acquiring a connection from the pool before giving up and timing out.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "type": "hardBreak"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "localId": "78d28807f236"
     },
     "content": [
      {
       "marks": [
        {
         "type": "code"
        }
       ],
       "text": "connectionTimeout(Duration timeout)",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "attrs": {
      "localId": "aa9db18d9007"
     },
     "content": [
      {
       "text": "The amount of time to wait when initially establishing a connection before giving up and timing out",
       "type": "text"
      },
      {
       "marks": [
