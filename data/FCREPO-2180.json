      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "Either assuages my concern, but I incline to the latter on the principle elsewhere espoused: as far as is practical, the output of this tool should be a image of the API at the time of export.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
