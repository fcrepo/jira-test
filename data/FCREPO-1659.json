  "description": {
   "content": [
    {
     "content": [
      {
       "text": "The travis-ci configuration has fcrepo and associated projects running on a \"legacy system\". This can be fixed by adding",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "sudo: false",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "to the .travis.yml file",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Here is an example: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/travis-ci/container-example/blob/master/.travis.yml"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/travis-ci/container-example/blob/master/.travis.yml",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "More information here: ",
       "type": "text"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://docs.travis-ci.com/user/migrating-from-legacy/?utm_source=legacy-notice&utm_medium=banner&utm_campaign=legacy-upgrade"
         },
         "type": "link"
        }
       ],
       "text": "http://docs.travis-ci.com/user/migrating-from-legacy/?utm_source=legacy-notice&utm_medium=banner&utm_campaign=legacy-upgrade",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
