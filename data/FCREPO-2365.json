  "description": {
   "content": [
    {
     "content": [
      {
       "text": "Exporting using a Bag config that doesn't include APTrust info throws an error:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "marks": [
        {
         "attrs": {
          "href": "https://github.com/fcrepo4-labs/fcrepo-import-export/pull/67#issuecomment-267594588"
         },
         "type": "link"
        }
       ],
       "text": "https://github.com/fcrepo4-labs/fcrepo-import-export/pull/67#issuecomment-267594588",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "When using a non-APTrust profile, those fields will not be provided.  Even when using the APTrust profile, not specifying the APTrust fields should result in a clear error message, not a parsing error.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
