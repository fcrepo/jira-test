      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I think getting status 400 is correct in this case, which is triggered by the bad day-of-week value in `",
          "type": "text"
         },
         {
          "marks": [
           {
            "type": "code"
           }
          ],
          "text": "Wed, 29 Aug 2017 15:47:50 GMT`",
          "type": "text"
         },
         {
          "text": ". The correct value should be `Tue{{, 29 Aug 2017 15:47:50 GMT}}`.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "I've added PR ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4/fcrepo4/pull/1396"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4/fcrepo4/pull/1396",
          "type": "text"
         },
         {
          "text": " to include the datetime parsing error in the message body that could help user identify the issue.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
