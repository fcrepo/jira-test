     "body": {
      "content": [
       {
        "content": [
         {
          "text": "I haven't heard any clamor for this improvement.  It seems like a good thing to do, but I don't know if people who feel strongly about their object identifiers also care strongly about their audit event identifiers or not.  So I'm fine with closing or just giving it a low priority.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
