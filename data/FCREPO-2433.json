  "description": {
   "content": [
    {
     "content": [
      {
       "text": "When accessing an object with a historic version, attempting to use the fixty service on the version via the web application generates a namespace error.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://ip:8080/fedora/path/location/object/files/binary/fcr:fixity"
         },
         "type": "link"
        }
       ],
       "text": "http://IP:8080/fedora/path/location/object/files/binary/fcr:fixity",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "functions normally for the object.",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "When accessing version1 in the versions, using",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "marks": [
        {
         "attrs": {
          "href": "http://ip:8080/fedora/path/location/object/files/binary/fcr:versions/versionid/fcr:fixity"
         },
         "type": "link"
        }
       ],
       "text": "http://IP:8080/fedora/path/location/object/files/binary/fcr:versions/versionid/fcr:fixity",
       "type": "text"
      },
      {
       "text": " ",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "generates an error.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "This has been tested with Fedora 4.7.0 and 4.7.1 on both postgres and the file-simple configuration. ",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "See attached document for the full error displayed on the site.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "Tomcat error logs also include the following line:",
       "type": "text"
      },
      {
       "type": "hardBreak"
      },
      {
       "text": "ERROR (WildcardExceptionMapper) Exception intercepted by WildcardExceptionMapper: Error converting \"fcr:fixity\" from String to a Name",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
  },
