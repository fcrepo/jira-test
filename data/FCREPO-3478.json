      "timeZone": "America/Halifax"
     },
     "body": {
      "content": [
       {
        "content": [
         {
          "text": "The testsuite test does not allow for constraints. This is the same as 3.6.1-A.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Either we (Fedora) shouldn't be returning server managed triples by default, should be handling server managed triples leniently by default or the test needs to accept a 409 Conflict with a constrained by header as a valid response.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
      ],
      "type": "doc",
      "version": 1
     },
