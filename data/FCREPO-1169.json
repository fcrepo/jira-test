  "description": {
   "content": [
    {
     "content": [
      {
       "text": "env-server.sh relies on Fedora being installed in a 'webapps' directory:",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "set WEBINF=\"%CATALINA_HOME%\\webapps%WEBAPP_NAME%\\WEB-INF\"",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "when it's installed separately from Tomcat (to allow easier upgrades), e.g.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "/WWW/domain.name/fedora",
       "type": "text"
      }
     ],
     "type": "paragraph"
    },
    {
     "content": [
      {
       "text": "the rebuild fails to run.",
       "type": "text"
      }
     ],
     "type": "paragraph"
    }
   ],
   "type": "doc",
   "version": 1
