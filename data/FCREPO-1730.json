     "body": {
      "content": [
       {
        "content": [
         {
          "text": "When testing this PR, I hit an issue with fcrepo-indexing-triplestore which may be related. See attached karaf.log",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note: I am a little bit surprised that integration tests do not flag issues like this.",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "text": "Note2: I see that fcrepo-camel-toolbox is pegged to the last release of fcrepo-camel:",
          "type": "text"
         },
         {
          "type": "hardBreak"
         },
         {
          "marks": [
           {
            "attrs": {
             "href": "https://github.com/fcrepo4-exts/fcrepo-camel-toolbox/blob/master/pom.xml#L178"
            },
            "type": "link"
           }
          ],
          "text": "https://github.com/fcrepo4-exts/fcrepo-camel-toolbox/blob/master/pom.xml#L178",
          "type": "text"
         }
        ],
        "type": "paragraph"
       },
       {
        "content": [
         {
          "content": [
           {
            "content": [
             {
              "text": "When I bump it to 4.3.1-SNAPSHOT, I get compilation errors.",
              "type": "text"
             }
            ],
            "type": "paragraph"
           }
          ],
          "type": "listItem"
         }
        ],
        "type": "bulletList"
       }
