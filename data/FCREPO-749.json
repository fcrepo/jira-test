      "content": [
       {
        "content": [
         {
          "text": "The REST API automatically adds the OwnerID property if no content is posted on an ingest (and no OwnerID is supplied as a method parameter).  Not sure if this is desired behaviour or not?",
          "type": "text"
         }
        ],
        "type": "paragraph"
       }
